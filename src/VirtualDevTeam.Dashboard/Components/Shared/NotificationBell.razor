@using VirtualDevTeam.Core.Notifications
@using VirtualDevTeam.Dashboard.Services
@using Microsoft.JSInterop
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IPlatformLinkService LinkService
@implements IDisposable

<div class="notification-container">
    <button class="notification-bell" @onclick="TogglePopup" title="Gate Notifications">
        <span class="bell-icon">🔔</span>
        @if (_unreadCount > 0)
        {
            <span class="notification-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
        }
    </button>

    @if (_showPopup)
    {
        <div class="notification-overlay" @onclick="ClosePopup"></div>
        <div class="notification-popup">
            <div class="notification-header">
                <h3>🚦 Gate Notifications</h3>
                @if (_unreadCount > 0)
                {
                    <button class="notification-mark-all" @onclick="MarkAllRead" title="Mark all as read">
                        ✓ Mark all read
                    </button>
                }
            </div>

            <div class="notification-filters">
                <button class="notification-filter-btn @(_currentFilter == NotificationFilter.Open ? "active" : "")"
                        @onclick="() => SetFilter(NotificationFilter.Open)">
                    Open
                    @if (_openCount > 0) { <span class="filter-count">@_openCount</span> }
                </button>
                <button class="notification-filter-btn @(_currentFilter == NotificationFilter.Resolved ? "active" : "")"
                        @onclick="() => SetFilter(NotificationFilter.Resolved)">
                    Resolved
                    @if (_resolvedCount > 0) { <span class="filter-count resolved">@_resolvedCount</span> }
                </button>
                <button class="notification-filter-btn @(_currentFilter == NotificationFilter.All ? "active" : "")"
                        @onclick="() => SetFilter(NotificationFilter.All)">
                    All
                </button>
            </div>

            <div class="notification-list">
                @if (!_notifications.Any())
                {
                    <div class="notification-empty">
                        @if (_currentFilter == NotificationFilter.Open)
                        {
                            <span class="empty-icon">✅</span>
                            <p>No pending gate approvals</p>
                            <p class="empty-sub">All gates are running in autonomous mode</p>
                        }
                        else if (_currentFilter == NotificationFilter.Resolved)
                        {
                            <span class="empty-icon">📭</span>
                            <p>No resolved notifications yet</p>
                        }
                        else
                        {
                            <span class="empty-icon">📭</span>
                            <p>No gate notifications</p>
                            <p class="empty-sub">Notifications appear when human gates are enabled</p>
                        }
                    </div>
                }
                else
                {
                    @foreach (var notification in _notifications)
                    {
                        var isProjectComplete = notification.GateId == "project-complete";
                        <div class="notification-item @(notification.IsRead ? "read" : "unread") @(notification.IsResolved ? "resolved" : "") @(isProjectComplete ? "project-complete" : "") @(notification.IsReworked ? "reworked" : "")"
                             @onclick="() => NavigateToApproval(notification)" style="cursor: pointer;" title="Click to view in Approvals page">
                            <div class="notification-item-header">
                                <span class="notification-gate-badge @(isProjectComplete ? "gate-complete" : notification.IsResolved ? "gate-resolved" : "")">
                                    @(isProjectComplete ? "🎉 " : "")@notification.GateName
                                </span>
                                @if (notification.IsReworked && !notification.IsResolved)
                                {
                                    <span class="notification-status-rework">🔄 Reworked</span>
                                }
                                else if (isProjectComplete)
                                {
                                    <span class="notification-status-complete">✅ Complete</span>
                                }
                                else if (notification.IsResolved)
                                {
                                    <span class="notification-status-resolved">✅ Approved</span>
                                }
                                else
                                {
                                    <span class="notification-status-pending">⏳ Awaiting</span>
                                }
                            </div>
                            <p class="notification-context">@notification.Context</p>
                            <div class="notification-item-footer">
                                <span class="notification-time">
                                    @if (notification.IsResolved && notification.ResolvedAt.HasValue)
                                    {
                                        @(isProjectComplete ? "Completed" : "Approved") <LocalTimeText Value="notification.ResolvedAt.Value" />
                                    }
                                    else
                                    {
                                        @:Created <LocalTimeText Value="notification.CreatedAt" />
                                    }
                                </span>
                                <div class="notification-actions">
                                    @if (!string.IsNullOrEmpty(notification.GitHubUrl))
                                    {
                                        var (notifHref, notifTarget, notifRel, notifTitle) = ResolveNotificationLink(notification, isProjectComplete);
                                        var notifArrow = LinkService.IsInternal(notifHref) ? "" : "↗";
                                        <a href="@notifHref"
                                           target="@notifTarget"
                                           rel="@notifRel"
                                           class="notification-link"
                                           title="@notifTitle"
                                           @onclick="() => OnLinkClicked(notification)"
                                           @onclick:stopPropagation="true">
                                            @if (isProjectComplete)
                                            {
                                                @($"📁 View Repo {notifArrow}")
                                            }
                                            else
                                            {
                                                @(notification.ResourceType == "PR" ? "🔀" : "📋")
                                                @($"#{notification.ResourceNumber} {notifArrow}")
                                            }
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Resolve the notification "open" link.  PR / Issue notifications route through internal
    /// <c>/repository/...</c> routes; the project-completion notification (links to the repo)
    /// stays external since there's no in-app "repo home" page.
    /// </summary>
    private (string href, string? target, string? rel, string title) ResolveNotificationLink(GateNotification notification, bool isProjectComplete)
    {
        string href = notification.GitHubUrl ?? "#";
        if (!isProjectComplete && notification.ResourceNumber is int n)
        {
            if (string.Equals(notification.ResourceType, "PR", StringComparison.OrdinalIgnoreCase))
                href = LinkService.BuildPullRequestUrl(n, notification.GitHubUrl);
            else if (string.Equals(notification.ResourceType, "Issue", StringComparison.OrdinalIgnoreCase))
                href = LinkService.BuildIssueUrl(n, notification.GitHubUrl);
        }
        var target = LinkService.TargetForUrl(href);
        var rel = target == "_blank" ? "noopener noreferrer" : null;
        var isInternal = LinkService.IsInternal(href);
        var title = isInternal ? "View in dashboard" : $"Open on {LinkService.PlatformDisplayName}";
        return (href, target, rel, title);
    }

    private bool _showPopup;
    private int _unreadCount;
    private int _openCount;
    private int _resolvedCount;
    private int _lastNotifiedCount;
    private bool _browserNotificationsEnabled;
    private NotificationFilter _currentFilter = NotificationFilter.Open;
    private IReadOnlyList<GateNotification> _notifications = Array.Empty<GateNotification>();

    // Support both in-process (Runner) and HTTP proxy (standalone) notification sources
    private GateNotificationService? _inProcessService;
    private HttpGateNotificationService? _httpService;

    protected override void OnInitialized()
    {
        _httpService = ServiceProvider.GetService<HttpGateNotificationService>();
        _inProcessService = ServiceProvider.GetService<GateNotificationService>();

        if (_httpService is not null)
            _httpService.OnChange += HandleNotificationChange;
        else if (_inProcessService is not null)
            _inProcessService.OnChange += HandleNotificationChange;

        RefreshData();
        _lastNotifiedCount = _unreadCount;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var result = await JS.InvokeAsync<string>("BrowserNotifications.requestPermission");
                _browserNotificationsEnabled = result == "granted";
            }
            catch { /* JS interop not available during prerender */ }
        }
    }

    private void HandleNotificationChange()
    {
        InvokeAsync(async () =>
        {
            var previousUnread = _unreadCount;
            RefreshData();

            // Fire browser notification for new gates
            if (_browserNotificationsEnabled && _unreadCount > previousUnread)
            {
                var newest = GetNewestUnread();
                if (newest is not null)
                {
                    try
                    {
                        var title = newest.IsReworked
                            ? "🔄 Rework Complete — Ready for Re-review"
                            : "🚦 Gate Approval Needed";
                        await JS.InvokeVoidAsync("BrowserNotifications.show",
                            title,
                            $"{newest.GateName}: {newest.Context}",
                            null,
                            newest.GitHubUrl);
                    }
                    catch { /* best effort */ }
                }
            }

            StateHasChanged();
        });
    }

    private GateNotification? GetNewestUnread()
    {
        IReadOnlyList<GateNotification> all;
        if (_httpService is not null)
            all = _httpService.GetByStatus(NotificationFilter.Open);
        else if (_inProcessService is not null)
            all = _inProcessService.GetByStatus(NotificationFilter.Open);
        else
            return null;

        return all.Where(n => !n.IsRead).OrderByDescending(n => n.CreatedAt).FirstOrDefault();
    }

    private void RefreshData()
    {
        if (_httpService is not null)
        {
            _unreadCount = _httpService.UnreadCount;
            _openCount = _httpService.OpenCount;
            _resolvedCount = _httpService.ResolvedCount;
            _notifications = _httpService.GetByStatus(_currentFilter);
        }
        else if (_inProcessService is not null)
        {
            _unreadCount = _inProcessService.UnreadCount;
            _openCount = _inProcessService.OpenCount;
            _resolvedCount = _inProcessService.ResolvedCount;
            _notifications = _inProcessService.GetByStatus(_currentFilter);
        }
    }

    private void SetFilter(NotificationFilter filter)
    {
        _currentFilter = filter;
        RefreshData();
    }

    private void TogglePopup()
    {
        _showPopup = !_showPopup;
        if (_showPopup)
            RefreshData();
    }

    private void ClosePopup() => _showPopup = false;

    private void MarkAllRead()
    {
        if (_httpService is not null)
            _httpService.MarkAllAsRead();
        else
            _inProcessService?.MarkAllAsRead();
    }

    private void OnLinkClicked(GateNotification notification)
    {
        if (_httpService is not null)
            _httpService.MarkAsRead(notification.Id);
        else
            _inProcessService?.MarkAsRead(notification.Id);
    }

    private void NavigateToApproval(GateNotification notification)
    {
        // Mark as read and close popup
        if (_httpService is not null)
            _httpService.MarkAsRead(notification.Id);
        else
            _inProcessService?.MarkAsRead(notification.Id);

        _showPopup = false;
        Navigation.NavigateTo($"/approvals?gate={notification.GateId}");
    }

    public void Dispose()
    {
        if (_httpService is not null)
            _httpService.OnChange -= HandleNotificationChange;
        else if (_inProcessService is not null)
            _inProcessService.OnChange -= HandleNotificationChange;
    }
}
