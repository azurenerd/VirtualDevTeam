@page "/develop"
@page "/develop/{StepSlug?}"
@using VirtualDevTeam.Core.Configuration
@using VirtualDevTeam.Core.DevPlatform.Capabilities
@using System.Timers
@using VirtualDevTeam.Core.DevPlatform.Config
@using System.Net.Http.Json
@using VirtualDevTeam.Dashboard.Services
@using VirtualDevTeam.Dashboard.Components.Wizard
@using VirtualDevTeam.Core.Scenarios
@using VirtualDevTeam.Core.Frameworks
@using Microsoft.Extensions.Options
@inject DevelopSettingsService SettingsService
@inject IWorkItemSearchService WorkItemSearch
@inject IRepositoryManagementService RepoService
@inject IConfigurationService ConfigService
@inject NavigationManager Navigation
@inject ILogger<Develop> Logger
@inject IServiceProvider ServiceProvider
@inject IOptions<VirtualDevTeamConfig> Config
@inject IJSRuntime JS
@inject ScenarioGenerationService ScenarioGenerationSvc
@rendermode InteractiveServer

<PageTitle>Develop — VirtualDevTeam</PageTitle>

<div class="page-header" data-testid="page-develop">
    <h1 class="page-title">🛠️ Develop</h1>
    <div class="header-badges">
        @if (_globalError is not null)
        {
            <span class="badge badge-error">⚠ Error</span>
        }
    </div>
</div>

@if (!_loading && _isFirstRun)
{
    <div class="config-card" style="margin-bottom:1.5rem; border-left:4px solid var(--accent-primary);">
        <div class="config-card-header" style="cursor:default;">
            <span class="config-card-icon">🚀</span>
            <span class="config-card-title">Welcome to VirtualDevTeam!</span>
        </div>
        <div class="config-card-content" style="display:block;">
            <p style="color:var(--text-secondary); margin-bottom:0.75rem;">
                Fill in the wizard below to configure your first project. You'll need:
            </p>
            <ul style="color:var(--text-secondary); margin:0 0 0.75rem 1.25rem; padding:0; list-style:disc;">
                <li>A project description (what you want the agents to build)</li>
                <li>A GitHub or Azure DevOps repository (will be created if it doesn't exist)</li>
                <li>GitHub CLI logged in (<code>gh auth login</code>) or Azure CLI (<code>az login</code>) for ADO</li>
            </ul>
            <p style="color:var(--text-tertiary); font-size:0.85rem; margin:0;">
                <strong>Prerequisites:</strong> .NET 8 SDK ✅ &nbsp;|&nbsp; GitHub Copilot CLI (required) &nbsp;|&nbsp; GitHub CLI (gh) &nbsp;|&nbsp; Azure CLI (az, for ADO) &nbsp;|&nbsp; Git CLI
            </p>
        </div>
    </div>
}

@if (_loading)
{
    <div class="config-loading" style="text-align:center; padding:3rem;">
        <div class="config-spinner"></div>
        <p style="color:var(--text-secondary); margin-top:1rem;">Loading settings…</p>
    </div>
}
else
{
    <!-- Step Indicator -->
    <div class="wizard-steps">
        @for (int i = 0; i < _stepLabels.Length; i++)
        {
            var step = i;
            var state = step < _currentStep ? "completed" : step == _currentStep ? "active" : "future";
            <div class="wizard-step @state" @onclick="() => JumpToStep(step)">
                <div class="wizard-step-circle">
                    @if (state == "completed")
                    {
                        <span>✓</span>
                    }
                    else
                    {
                        <span>@(step + 1)</span>
                    }
                </div>
                <span class="wizard-step-label">@_stepLabels[step]</span>
            </div>
            @if (step < _stepLabels.Length - 1)
            {
                <div class="wizard-step-line @(step < _currentStep ? "completed" : "")"></div>
            }
        }
    </div>

    @if (_globalError is not null)
    {
        <div class="config-pat-result config-pat-error" style="margin-bottom:1rem;">
            ⚠ @_globalError
            <button class="config-btn-remove" style="float:right;" @onclick="() => _globalError = null">✕</button>
        </div>
    }

    <div class="wizard-body">
        @* ───── Step 1: What to Build ───── *@
        @if (_currentStep == 1)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">💡</span>
                    <span class="config-card-title">What to Build</span>
                </div>
                <div class="config-card-body">
                    @* ── Source from Work Item (optional) ── *@
                    <div class="config-field">
                        <label>
                            🔍 Source from Work Item <span style="color:var(--text-muted, #616161);">(optional)</span>
                            <span class="wizard-tooltip" title="Search for an existing work item (Issue, Epic, Feature) to use as the project description source. The work item's title and body will populate the description.">ⓘ</span>
                        </label>

                        @if (_selectedSourceWi is null)
                        {
                            <input type="text" class="config-input" placeholder="Search work items by ID, title, or URL…"
                                   value="@_sourceWiQuery"
                                   @oninput="OnSourceWiSearchInput" />
                            @if (_sourceWiSearching)
                            {
                                <div style="margin-top:0.5rem; color:var(--text-secondary);">
                                    <span class="config-spinner-sm"></span> Searching…
                                </div>
                            }
                        }
                    </div>

                    @if (_sourceWiResults.Count > 0 && _selectedSourceWi is null)
                    {
                        <div class="wizard-search-results">
                            @foreach (var item in _sourceWiResults)
                            {
                                <div class="wizard-search-item" @onclick="() => SelectSourceWorkItem(item)">
                                    <span class="wizard-wi-type-badge @GetWorkItemBadgeClass(item.WorkItemType)">@item.WorkItemType</span>
                                    <span class="wizard-wi-id">#@item.Id</span>
                                    <span class="wizard-wi-title">@item.Title</span>
                                    <span class="wizard-wi-state">@item.State</span>
                                </div>
                            }
                        </div>
                    }

                    @if (_selectedSourceWi is not null)
                    {
                        <div class="wizard-selected-item">
                            <div style="display:flex; align-items:center; gap:0.75rem; flex:1;">
                                <span class="wizard-wi-type-badge @GetWorkItemBadgeClass(_selectedSourceWi.WorkItemType)">@_selectedSourceWi.WorkItemType</span>
                                <span style="font-weight:600; color:var(--accent-cyan);">#@_selectedSourceWi.Id</span>
                                <span style="color:var(--text-primary);">@_selectedSourceWi.Title</span>
                                <span class="wizard-wi-state">@_selectedSourceWi.State</span>
                            </div>
                            <button class="config-btn-remove" @onclick="RemoveSourceWorkItem" title="Remove source">✕</button>
                        </div>
                    }

                    @if (_sourceWiError is not null)
                    {
                        <div class="config-pat-result config-pat-error" style="margin-top:0.75rem;">
                            ⚠ @_sourceWiError
                        </div>
                    }

                    @* ── OR divider ── *@
                    <div class="wizard-or-divider">
                        <span>OR</span>
                    </div>

                    @* ── Description (disabled when source WI selected) ── *@
                    <div class="config-field">
                        <label title="This can be an entire application or a single feature. The AI agents will determine scope.">
                            📝 Description @(_selectedSourceWi is null ? "" : "(from work item)")
                            <span style="color:var(--accent-cyan);">*</span>
                            <span class="wizard-tooltip" title="This can be an entire application or a single feature. The AI agents will determine scope.">ⓘ</span>
                        </label>
                        <textarea id="vdt-description-textarea"
                                  @ref="_descriptionRef"
                                  class="config-textarea @(_selectedSourceWi is not null ? "config-textarea-disabled" : "")" rows="8"
                                  placeholder="Describe what you want built..."
                                  disabled="@(_selectedSourceWi is not null)"
                                  value="@_settings.Description"
                                  @oninput="OnDescriptionInput"
                                  @onpaste="OnDescriptionPaste"></textarea>
                    </div>
                    <div class="config-field">
                        <label title="Leave blank and the AI will choose. Or specify constraints.">
                            Tech Stack <span style="color:var(--text-muted, #616161);">(optional)</span>
                            <span class="wizard-tooltip" title="Leave blank and the AI will choose. Or specify constraints.">ⓘ</span>
                        </label>
                        <input type="text" class="config-input"
                               placeholder="e.g., .NET 8 Blazor, React + Node.js"
                               @bind="_settings.TechStack" @bind:event="oninput" />
                    </div>

                    <div class="config-field">
                        <label title="Folder in the repository where agent-generated documents (PMSpec, Architecture, Research) are stored.">
                            Agent Docs Folder <span style="color:var(--text-muted, #616161);">(optional)</span>
                            <span class="wizard-tooltip" title="Folder in the repository where agent-generated documents (PMSpec, Architecture, Research) are stored. A subfolder named after the working branch (e.g. AgentDocs/behumphr/) is created automatically.">ⓘ</span>
                        </label>
                        <input type="text" class="config-input"
                               placeholder="AgentDocs"
                               @bind="_settings.DocsFolderPath" @bind:event="oninput" />
                    </div>

                    <div class="config-field" style="margin-top: 0.5rem;">
                        <label>
                            Work Item Generation
                            <span class="wizard-tooltip" title="Controls how the PM breaks down your project description into trackable work items and how engineers deliver the code. These two settings work together to determine the pace and granularity of your project.">ⓘ</span>
                        </label>
                        <div class="wizard-workgen-row">
                            <div class="wizard-workgen-group">
                                <label class="wizard-radio-label" title="The PM creates separate GitHub/ADO issues for each user story identified in the spec. Each issue has its own acceptance criteria, making progress easy to track. Best for larger projects where you want granular visibility into what's being built.">
                                    <input type="radio" name="issueMode" checked="@(!_settings.SingleIssueMode)"
                                           @onchange='() => _settings.SingleIssueMode = false' />
                                    <span>📝 Broken Out User Stories</span>
                                </label>
                                <label class="wizard-radio-label" title="The PM creates a single Enhancement issue with links to PMSpec.md and Architecture.md. All user stories are embedded in the spec document rather than as separate issues. Best for small features or when you prefer minimal issue clutter.">
                                    <input type="radio" name="issueMode" checked="@(_settings.SingleIssueMode)"
                                           @onchange='() => _settings.SingleIssueMode = true' />
                                    <span>📌 Single User Story</span>
                                </label>
                            </div>
                            <div class="wizard-workgen-group">
                                <label class="wizard-radio-label" title="Delivers the entire project in one pull request. Best for simpler features under ~10 minutes of dev time — bug fixes, tightly-coupled changes, or small features where everything fits naturally into a single commit.">
                                    <input type="radio" name="deliveryMode" checked="@(_settings.PrMode == "SinglePR")"
                                           @onchange='() => _settings.PrMode = "SinglePR"' />
                                    <span>⚡ Single PR (Recommended)</span>
                                </label>
                                <label class="wizard-radio-label" title="Work is split into multiple PRs executed one at a time — each PR completes and merges before the next begins. Better for getting more detail on each step and ensuring each one is going as planned. More stable across multiple PRs since each builds on confirmed-merged code.">
                                    <input type="radio" name="deliveryMode" checked="@(_settings.PrMode == "MultiPRSerial")"
                                           @onchange='() => _settings.PrMode = "MultiPRSerial"' />
                                    <span>📦 Multiple PRs (Serial)</span>
                                </label>
                                <label class="wizard-radio-label" title="Work is split into parallel engineering tasks, each producing its own PR simultaneously. Can go faster than serial but runs the risk of potential merge conflicts if the engineering plan doesn't catch a dependency. More prone to errors throughout the end-to-end flow, but achieves maximum parallelism.">
                                    <input type="radio" name="deliveryMode" checked="@(_settings.PrMode == "MultiPRParallel")"
                                           @onchange='() => _settings.PrMode = "MultiPRParallel"' />
                                    <span>🔀 Multiple PRs (Parallel)</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="config-field" style="margin-top: 0.75rem;">
                        <label>
                            Pre-PR Clarification Questions
                            <span class="wizard-tooltip" title="When enabled, engineers pause before implementing each task to surface their assumptions as questions. You review and correct them in the Approvals page. When disabled, the AI still generates and logs the Q&A but proceeds without waiting.">ⓘ</span>
                        </label>
                        <div class="wizard-workgen-row">
                            <label class="wizard-radio-label" title="Engineers pause and wait for you to review their implementation assumptions before coding. Appears in Approvals page with bell notification.">
                                <input type="radio" name="preClarify" checked="@(_settings.PrePRClarificationGate)"
                                       @onchange='() => _settings.PrePRClarificationGate = true' />
                                <span>🛑 Require Approval</span>
                            </label>
                            <label class="wizard-radio-label" title="Engineers generate questions and answer them autonomously. Logged as decisions for later review on the Reasoning page, but don't block progress.">
                                <input type="radio" name="preClarify" checked="@(!_settings.PrePRClarificationGate)"
                                       @onchange='() => _settings.PrePRClarificationGate = false' />
                                <span>🚀 Auto-proceed</span>
                            </label>
                        </div>
                    </div>

                    <div class="config-field" style="margin-top: 0.75rem;">
                        <label>
                            Failing UI Tests
                            <span class="wizard-tooltip" title="UI tests (Playwright) often fail on test-selector strict-mode violations or timing flakes that the engineer cannot fix from review feedback. When set to Allow Merge (default), the PM still posts a warning about failing UI tests but does NOT block the merge — every bypass is logged as a Decision so it stays auditable. When set to Block Merge, the PM blocks force-approval; if the system detects an unrecoverable rework loop on a stuck PR it auto-bypasses with a logged Decision so the pipeline never deadlocks.">ⓘ</span>
                        </label>
                        <div class="wizard-workgen-row">
                            <label class="wizard-radio-label" title="PRs may merge even when UI tests report failures. Failures are logged but never block. Recommended for projects where UI test reliability isn't yet at production quality.">
                                <input type="radio" name="allowFailingUi" checked="@(_settings.AllowFailingUiTests)"
                                       @onchange='() => _settings.AllowFailingUiTests = true' />
                                <span>🚀 Allow Merge (default)</span>
                            </label>
                            <label class="wizard-radio-label" title="PR is blocked from merge while UI tests fail; the pipeline retries until they pass or a deadlock is detected. The system auto-bypasses unrecoverable deadlocks (rework cannot fix tests) with a logged Decision.">
                                <input type="radio" name="allowFailingUi" checked="@(!_settings.AllowFailingUiTests)"
                                       @onchange='() => _settings.AllowFailingUiTests = false' />
                                <span>🛑 Block Merge</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ───── Step 2: Clarifying Questions ───── *@
        @if (_currentStep == 2)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">❓</span>
                    <span class="config-card-title">Clarifying Questions</span>
                    <span style="color:var(--text-muted); font-size:0.8rem; margin-left:auto;">(optional)</span>
                </div>
                <div class="config-card-body">
                    @if (string.IsNullOrWhiteSpace(_settings.Description))
                    {
                        <div class="clarify-empty-state">
                            <span style="font-size:2rem;">💡</span>
                            <p>Enter a project description on the <strong>What to Build</strong> step first, then come back here for clarifying questions.</p>
                            <button class="wizard-nav-btn wizard-back-btn" @onclick="() => GoToStep(1)">← Go to What to Build</button>
                        </div>
                    }
                    else if (_initialClarifyLoading)
                    {
                        <div class="clarify-loading">
                            <div class="config-spinner"></div>
                            <p>Analyzing your project description…</p>
                            <p style="font-size:0.8rem; color:var(--text-muted);">Generating clarifying questions via AI</p>
                        </div>
                    }
                    else if (_clarifyError is not null)
                    {
                        <div class="clarify-error">
                            <p>⚠ @_clarifyError</p>
                            <p style="color:var(--text-secondary); font-size:0.85rem;">You can skip this step — the AI will use its best judgment for any ambiguous details.</p>
                            <button class="config-btn-secondary" @onclick="async () => await TryGenerateClarifyingQuestionsAsync()">Retry</button>
                        </div>
                    }
                    else if (_settings.ClarifyingAnswers.Count > 0)
                    {
                        <p style="color:var(--text-secondary); margin-bottom:1rem; font-size:0.85rem;">
                            Answer any questions that would help refine the project scope. Leave blank to let the AI decide.
                        </p>

                        @foreach (var round in _settings.ClarifyingAnswers.Select(q => q.Iteration).Distinct().OrderBy(i => i))
                        {
                            var roundQuestions = _settings.ClarifyingAnswers.Where(q => q.Iteration == round).ToList();
                            if (_settings.ClarifyingAnswers.Select(q => q.Iteration).Distinct().Count() > 1)
                            {
                                <div class="clarify-round-divider">
                                    <span class="clarify-round-badge">Round @round</span>
                                    <span class="clarify-round-count">@roundQuestions.Count question@(roundQuestions.Count != 1 ? "s" : "")</span>
                                </div>
                            }

                            foreach (var qa in roundQuestions)
                            {
                                var globalIdx = _settings.ClarifyingAnswers.IndexOf(qa);
                                <div class="clarify-question-card @(!string.IsNullOrWhiteSpace(qa.Answer) ? "answered" : "") @(_deepResearchInProgress.Contains(globalIdx) ? "researching" : "") @(_deepResearchComplete.Contains(globalIdx) ? "research-done" : "")">
                                    <div class="clarify-question-number">
                                        @if (_deepResearchInProgress.Contains(globalIdx))
                                        {
                                            <div class="config-spinner" style="width:1rem; height:1rem;"></div>
                                        }
                                        else if (_deepResearchComplete.Contains(globalIdx))
                                        {
                                            <span title="Deep research complete">🔬</span>
                                        }
                                        else
                                        {
                                            @(globalIdx + 1)
                                        }
                                    </div>
                                    <div class="clarify-question-content">
                                        <label class="clarify-question-text">@qa.Question</label>
                                        <textarea class="config-textarea clarify-answer"
                                                  rows="2"
                                                  placeholder="Edit the AI's answer or leave blank to let it decide"
                                                  @bind="_settings.ClarifyingAnswers[globalIdx].Answer"
                                                  @bind:event="oninput"></textarea>
                                    </div>
                                </div>
                            }
                        }

                        @* Ask More inline status *@
                        if (_askMoreLoading)
                        {
                            <div class="clarify-ask-more-loading">
                                <div class="config-spinner" style="width:1.2rem; height:1.2rem;"></div>
                                <span style="color:var(--text-muted); font-size:0.85rem;">Generating additional questions…</span>
                            </div>
                        }
                        else if (_askMoreMessage is not null)
                        {
                            <div class="clarify-ask-more-message">
                                @_askMoreMessage
                            </div>
                        }

                        <div style="margin-top:1rem; display:flex; flex-direction:column; gap:0.75rem;">
                            <div style="display:flex; align-items:center; gap:0.75rem; justify-content:space-between;">
                                <div style="display:flex; align-items:center; gap:0.75rem;">
                                    @if (_settings.ClarifyingIterationCount >= Config.Value.Limits.MaxWizardQuestionIterations || _settings.ClarifyingAnswers.Count >= 30)
                                    {
                                        <button class="config-btn-primary" disabled
                                                title="@(_settings.ClarifyingAnswers.Count >= 30 ? "Maximum of 30 questions reached" : $"Maximum question iterations reached ({Config.Value.Limits.MaxWizardQuestionIterations}). Configurable in Configuration → Limits.")">
                                            💬 Ask More Questions
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="config-btn-primary" disabled="@_askMoreLoading"
                                                @onclick="async () => await AskMoreQuestionsAsync()">
                                            💬 Ask More Questions
                                        </button>
                                    }
                                    @if (_settings.ClarifyingIterationCount > 0)
                                    {
                                        <span class="clarify-iteration-badge" title="You can request up to @Config.Value.Limits.MaxWizardQuestionIterations rounds of questions">
                                            Round @(_settings.ClarifyingIterationCount + 1) of @(Config.Value.Limits.MaxWizardQuestionIterations + 1)
                                        </span>
                                    }
                                </div>
                                <div style="display:flex; gap:0.5rem;">
                                    <button class="config-btn-secondary" @onclick="async () => await RegenerateQuestionsAsync()"
                                            disabled="@(_initialClarifyLoading || _askMoreLoading || _deepResearchRunning)"
                                            title="Re-analyze the project description and generate new questions (replaces all current questions)">
                                        🔄 Regenerate
                                    </button>
                                    <button class="config-btn-secondary" @onclick="ClearAllQuestions"
                                            disabled="@(_initialClarifyLoading || _askMoreLoading || _deepResearchRunning)"
                                            title="Remove all generated questions">
                                        🗑 Clear Questions
                                    </button>
                                </div>
                            </div>

                            @* Deep Research Answers button — only for local projects with existing code *@
                            @if (!_settings.CreateNewRepo && !string.IsNullOrWhiteSpace(_settings.ExistingRepoPath) && Directory.Exists(_settings.ExistingRepoPath ?? ""))
                            {
                                <div style="display:flex; align-items:center; gap:0.75rem; border-top:1px solid var(--border-color); padding-top:0.75rem;">
                                    @if (_deepResearchRunning)
                                    {
                                        <button class="config-btn-secondary" style="border-color:var(--warning-color); color:var(--warning-color);"
                                                @onclick="CancelDeepResearch"
                                                title="Stop all deep research — answers already received will be preserved">
                                            ⏹ Cancel Deep Research
                                        </button>
                                        <span style="font-size:0.85rem; color:var(--text-muted);">
                                            Researching @_deepResearchInProgress.Count / @_settings.ClarifyingAnswers.Count questions...
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="config-btn-primary"
                                                disabled="@(_initialClarifyLoading || _askMoreLoading || _settings.ClarifyingAnswers.Count == 0)"
                                                @onclick="async () => await DeepResearchAnswersAsync()"
                                                title="Launch parallel AI agents to explore the local codebase and provide evidence-based answers to each question">
                                            🔬 Deep Research Answers
                                        </button>
                                        <span style="font-size:0.8rem; color:var(--text-muted);">
                                            Launches parallel agents to explore your codebase for each question
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="clarify-empty-state">
                            <p style="color:var(--text-secondary);">No questions generated. Click below to analyze your project description.</p>
                            <button class="config-btn-secondary" @onclick="async () => await TryGenerateClarifyingQuestionsAsync()">Generate Questions</button>
                        </div>
                    }

                    @{
                        var recentClarifyActivity = _clarifyActivityEvents.TakeLast(50).ToList();
                    }
                    @if (_showActivityStream && recentClarifyActivity.Count > 0)
                    {
                        <div style="max-height: 300px; overflow-y: auto; background: var(--bg-secondary); border-radius: 8px; padding: 12px; margin-top: 16px; font-family: monospace; font-size: 0.85rem;">
                            @foreach (var evt in recentClarifyActivity)
                            {
                                <div style="margin-bottom: 4px; color: var(--text-secondary);">
                                    <LocalTimeText Value="evt.Timestamp" CssClass="develop-activity-time" IncludeSeconds="true" style="color: var(--text-muted); margin-right: 8px;" />
                                    <span style="color: @GetClarifyActivityColor(evt.Activity);">@FormatClarifyActivity(evt.Activity)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* ───── Step 3: Scenario Review ───── *@
        @if (_currentStep == 3)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">🎯</span>
                    <span class="config-card-title">Scenario Review</span>
                    <span style="color:var(--text-muted); font-size:0.8rem; margin-left:auto;">(optional)</span>
                </div>
                <div class="config-card-body">
                    @if (string.IsNullOrWhiteSpace(_settings.Description))
                    {
                        <div class="clarify-empty-state">
                            <span style="font-size:2rem;">🎯</span>
                            <p>Enter a project description on the <strong>What to Build</strong> step first.</p>
                            <button class="wizard-nav-btn wizard-back-btn" @onclick="() => GoToStep(1)">← Go to What to Build</button>
                        </div>
                    }
                    else
                    {
                        <p style="color:var(--text-secondary); margin-bottom:0.75rem; font-size:0.85rem;">
                            Review AI-generated end-to-end scenarios for your project. Approve, edit, or reject each one.
                            Approved scenarios become the verification contract that the final integration validation step uses after engineering is complete.
                        </p>
                        <ScenarioReview
                            ProjectDescription="@_settings.Description"
                            ProjectName="@(_settings.GitHub?.Repo ?? _settings.AzureDevOps?.Repository)"
                            QaPairs="@_settings.ClarifyingAnswers"
                            PersistedScenarios="@_settings.GeneratedScenarios"
                            PersistedScenarioHash="@_settings.ScenarioSourceHash"
                            WorkspaceRoot="@(Config.Value.Workspace?.RootPath)"
                            OnContinue="@(EventCallback.Factory.Create<IReadOnlyList<Scenario>>(this, async scenarios => { _approvedScenarios = scenarios; await GoToStep(4); }))"
                            OnSkip="@(EventCallback.Factory.Create(this, async () => await GoToStep(4)))" />
                    }
                </div>
            </div>
        }

        @* ───── Step 0: Repository & Auth (moved before What to Build) ───── *@
        @if (_currentStep == 0)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">📦</span>
                    <span class="config-card-title">Platform &amp; Repository</span>
                </div>
                <div class="config-card-body">
                    <!-- Platform selector -->
                    <div class="config-field">
                        <label>Platform</label>
                        <div class="wizard-radio-group">
                            <label class="wizard-radio @(_settings.Platform == "GitHub" ? "selected" : "")">
                                <input type="radio" name="platform" value="GitHub"
                                       checked="@(_settings.Platform == "GitHub")"
                                       @onchange="@(() => SetPlatform(PlatformGitHub))" />
                                <span>🐙 GitHub</span>
                            </label>
                            <label class="wizard-radio @(_settings.Platform == "AzureDevOps" ? "selected" : "")">
                                <input type="radio" name="platform" value="AzureDevOps"
                                       checked="@(_settings.Platform == "AzureDevOps")"
                                       @onchange="@(() => SetPlatform(PlatformAdo))" />
                                <span>🔷 Azure DevOps</span>
                            </label>
                        </div>

                        <!-- Local Dev Mode toggle (GitHub only — ADO support coming soon) -->
                        @if (_settings.Platform != "AzureDevOps")
                        {
                        <div style="margin-top: 1rem; padding: 0.75rem 1rem; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: rgba(255,255,255,0.03);"
                             title="When enabled, agents create lightweight virtual PRs and issues backed by SQLite + local git instead of creating real PRs on @(_settings.Platform). This avoids branch policy overhead, reduces API rate limit pressure, and keeps your repo clean during development. At project completion, one polished PR is submitted to @(_settings.Platform) for human review and merge.">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <label class="config-toggle">
                                    <input type="checkbox" checked="@_settings.UseLocalDevMode"
                                           @onchange="@(e => _settings.UseLocalDevMode = (bool)(e.Value ?? false))" />
                                    <span class="config-toggle-slider"></span>
                                </label>
                                <span style="font-weight: 600;">💻 Local Dev Mode</span>
                            </div>
                            <p style="margin: 0.4rem 0 0 0; font-size: 0.85em; opacity: 0.7; line-height: 1.4;">
                                Agents work locally using virtual PRs — no real PRs created on @(_settings.Platform) until the final result is ready.
                                Ideal for enterprise environments with strict branch policies or limited API quotas.
                            </p>
                        </div>
                        }
                    </div>

                    <!-- Repo mode -->
                    <div class="config-field">
                        <label>Repository</label>
                        <div class="wizard-radio-group">
                            <label class="wizard-radio @(!_settings.CreateNewRepo ? "selected" : "")">
                                <input type="radio" name="repoMode" checked="@(!_settings.CreateNewRepo)"
                                       @onchange="() => _settings.CreateNewRepo = false" />
                                <span>Use Existing</span>
                            </label>
                            <label class="wizard-radio @(_settings.CreateNewRepo ? "selected" : "")">
                                <input type="radio" name="repoMode" checked="@(_settings.CreateNewRepo)"
                                       @onchange="() => _settings.CreateNewRepo = true" />
                                <span>Create New</span>
                            </label>
                        </div>
                    </div>

                    @if (!_settings.CreateNewRepo)
                    {
                        <!-- Existing repo fields -->
                        @if (_settings.Platform == "GitHub")
                        {
                            <div class="config-field">
                                <label>Repository (owner/repo)</label>
                                <div class="config-pat-row">
                                    <input type="text" class="config-input" placeholder="owner/repo"
                                           @bind="_settings.GitHub.Repo" @bind:event="oninput" />
                                    <button class="config-validate-btn @(_repoVerified == true ? "config-validate-success" : "")"
                                            @onclick="VerifyRepoAsync" disabled="@_repoVerifying">
                                        @if (_repoVerifying) { <span class="config-spinner-sm"></span> }
                                        else { <span>Verify</span> }
                                    </button>
                                </div>
                                @if (_repoVerified == true)
                                {
                                    <div class="config-pat-result config-pat-success">✓ Repository found</div>
                                }
                                else if (_repoVerified == false)
                                {
                                    <div class="config-pat-result config-pat-error">✕ @(_repoError ?? "Repository not found")</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="config-field-row">
                                <div class="config-field">
                                    <label>Organization</label>
                                    <input type="text" class="config-input" placeholder="my-org"
                                           @bind="_settings.AzureDevOps.Organization" @bind:event="oninput" />
                                </div>
                                <div class="config-field">
                                    <label>Project</label>
                                    <input type="text" class="config-input" placeholder="my-project"
                                           @bind="_settings.AzureDevOps.Project" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="config-field">
                                <label>Repository</label>
                                <div class="config-pat-row">
                                    <input type="text" class="config-input" placeholder="my-repo"
                                           @bind="_settings.AzureDevOps.Repository" @bind:event="oninput" />
                                    <button class="config-validate-btn @(_repoVerified == true ? "config-validate-success" : "")"
                                            @onclick="VerifyRepoAsync" disabled="@_repoVerifying">
                                        @if (_repoVerifying) { <span class="config-spinner-sm"></span> }
                                        else { <span>Verify</span> }
                                    </button>
                                </div>
                                @if (_repoVerified == true)
                                {
                                    <div class="config-pat-result config-pat-success">✓ Repository found</div>
                                }
                                else if (_repoVerified == false)
                                {
                                    <div class="config-pat-result config-pat-error">✕ @(_repoError ?? "Repository not found")</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Create new repo -->
                        <div class="config-field">
                            <label>New Repository Name</label>
                            <div class="config-pat-row">
                                <input type="text" class="config-input" placeholder="my-new-project"
                                       @bind="_settings.NewRepoName" @bind:event="oninput" />
                                <button class="config-validate-btn @(_repoCreated ? "config-validate-success" : "")"
                                        @onclick="CreateRepoAsync"
                                        disabled="@(_repoCreating || string.IsNullOrWhiteSpace(_settings.NewRepoName))">
                                    @if (_repoCreating) { <span class="config-spinner-sm"></span> }
                                    else if (_repoCreated) { <span>✓ Created</span> }
                                    else { <span>Create Private Repo</span> }
                                </button>
                            </div>
                            @if (_repoCreated)
                            {
                                <div class="config-pat-result config-pat-success">✓ Repository created: @_repoCreatedUrl</div>
                            }
                            else if (_repoCreateError is not null)
                            {
                                <div class="config-pat-result config-pat-error">✕ @_repoCreateError</div>
                            }
                        </div>
                    }

                    <!-- Default Branch -->
                    <div class="config-field" style="margin-top:0.5rem;">
                        <label>Default Branch</label>
                        <input type="text" class="config-input" style="max-width:200px;"
                               @bind="CurrentDefaultBranch" @bind:event="oninput" />
                    </div>

                    <!-- Working Branch (optional) -->
                    <div class="config-field" style="margin-top:0.5rem;">
                        <label>Working Branch <span style="color:var(--text-secondary);font-size:0.75rem;">(optional)</span></label>
                        <input type="text" class="config-input" style="max-width:300px;"
                               placeholder="Leave empty to work on default branch"
                               @bind="_settings.WorkingBranch" @bind:event="oninput" />
                        <div style="font-size:0.7rem;color:var(--text-secondary);margin-top:0.25rem;">
                            All agent work targets this branch. A human merges to default branch when ready.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Auth Card -->
            <div class="config-card" style="margin-top:1rem;">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">🔐</span>
                    <span class="config-card-title">Authentication</span>
                </div>
                <div class="config-card-body">
                    <!-- Auth Method Toggle -->
                    <div class="config-field" style="margin-bottom:1rem;">
                        <label>Auth Method</label>
                        <div class="auth-method-toggle">
                            @if (_settings.Platform == PlatformGitHub)
                            {
                                <button type="button"
                                        class="auth-method-btn @(_settings.AuthMethod == "GhCli" ? "auth-method-active" : "")"
                                        @onclick='() => SwitchAuthMethod("GhCli")'>
                                    🐙 GitHub CLI
                                </button>
                            }
                            <button type="button"
                                    class="auth-method-btn @(_settings.AuthMethod == "Pat" ? "auth-method-active" : "")"
                                    @onclick='() => SwitchAuthMethod("Pat")'>
                                🔑 PAT
                            </button>
                            <button type="button"
                                    class="auth-method-btn @(_settings.AuthMethod == "AzureCliBearer" ? "auth-method-active" : "")"
                                    @onclick='() => SwitchAuthMethod("AzureCliBearer")'>
                                🎫 Bearer Token
                            </button>
                        </div>
                    </div>

                    @if (_settings.AuthMethod == "Pat")
                    {
                        <!-- PAT Input -->
                        <div class="config-field">
                            <label>Personal Access Token (PAT)</label>
                            @if (_hasUserSecretsPat && !_overridePat)
                            {
                                <div class="config-pat-result config-pat-success" style="margin-bottom:0.5rem;">
                                    ✓ PAT configured via User Secrets
                                </div>
                                <p class="config-hint">
                                    Your PAT is securely stored in .NET User Secrets and will be used automatically.
                                    <button class="config-btn-inline" style="margin-left:0.5rem;" @onclick="() => _overridePat = true" type="button">
                                        Use a different PAT
                                    </button>
                                </p>
                            }
                            else
                            {
                                <div class="config-pat-row">
                                    <div class="config-secret-field" style="flex:1;">
                                        <input type="@(_showPat ? "text" : "password")" class="config-input"
                                               placeholder="Paste your PAT here…"
                                               @bind="_patInput" @bind:event="oninput" />
                                        <button class="config-secret-toggle" @onclick="() => _showPat = !_showPat" type="button">
                                            @(_showPat ? "🙈" : "👁️")
                                        </button>
                                    </div>
                                    <button class="config-validate-btn @(_patVerified == true ? "config-validate-success" : "")"
                                            @onclick="VerifyPatAsync" disabled="@(_patVerifying || string.IsNullOrWhiteSpace(_patInput))">
                                        @if (_patVerifying) { <span class="config-spinner-sm"></span> }
                                        else { <span>Verify</span> }
                                    </button>
                                </div>
                                @if (_patVerified == true)
                                {
                                    <div class="config-pat-result config-pat-success">✓ PAT is valid</div>
                                }
                                else if (_patVerified == false)
                                {
                                    <div class="config-pat-result config-pat-error">✕ @(_patError ?? "PAT validation failed")</div>
                                }
                                @if (_overridePat)
                                {
                                    <p class="config-hint">
                                        <button class="config-btn-inline" @onclick="() => { _overridePat = false; _patInput = string.Empty; _patVerified = null; }" type="button">
                                            ← Keep using User Secrets
                                        </button>
                                    </p>
                                }
                                else
                                {
                                    <p class="config-hint">
                                        💡 Prefer User Secrets over pasting here:
                                        <code>dotnet user-secrets set "VirtualDevTeam:DevPlatform:@(_settings.Platform):Pat" "your-pat"</code>
                                    </p>
                                }
                            }
                        </div>
                    }
                    else if (_settings.AuthMethod == "GhCli")
                    {
                        <!-- GitHub CLI Auth -->
                        <div class="config-field">
                            <label>GitHub CLI Authentication</label>
                            <p class="config-hint" style="margin-bottom:0.75rem;">
                                Uses your logged-in <code>gh</code> CLI session. No PAT needed — ideal for EMU accounts where PATs are disabled.
                            </p>
                            <div class="config-pat-row">
                                <button class="config-validate-btn @(_ghCliVerified == true ? "config-validate-success" : "")"
                                        @onclick="VerifyGhCliAsync" disabled="@_ghCliVerifying">
                                    @if (_ghCliVerifying) { <span class="config-spinner-sm"></span> }
                                    else { <span>Verify gh CLI</span> }
                                </button>
                            </div>
                            @if (_ghCliVerified == true)
                            {
                                <div class="config-pat-result config-pat-success" style="margin-top:0.5rem;">
                                    ✓ Authenticated as <strong>@_ghCliUser</strong>
                                </div>
                            }
                            else if (_ghCliVerified == false)
                            {
                                <div class="config-pat-result config-pat-error" style="margin-top:0.5rem;">
                                    ✕ @(_ghCliError ?? "gh CLI authentication failed")
                                </div>
                                <p class="config-hint">
                                    Run <code>gh auth login</code> in your terminal, then try again.
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Bearer Token Input -->
                        <div class="config-field">
                            <label>Bearer Token</label>
                            @if (_hasUserSecretsBearer && !_overrideBearer)
                            {
                                <div class="config-pat-result config-pat-success" style="margin-bottom:0.5rem;">
                                    ✓ Bearer token configured via User Secrets
                                </div>
                                <p class="config-hint">
                                    Your bearer token is securely stored in .NET User Secrets and will be used automatically.
                                    <button class="config-btn-inline" style="margin-left:0.5rem;" @onclick="() => _overrideBearer = true" type="button">
                                        Use a different token
                                    </button>
                                </p>
                            }
                            else
                            {
                                <div class="config-pat-row">
                                    <div class="config-secret-field" style="flex:1;">
                                        <input type="@(_showBearer ? "text" : "password")" class="config-input"
                                               placeholder="Paste your bearer token here…"
                                               @bind="_bearerInput" @bind:event="oninput" />
                                        <button class="config-secret-toggle" @onclick="() => _showBearer = !_showBearer" type="button">
                                            @(_showBearer ? "🙈" : "👁️")
                                        </button>
                                    </div>
                                    <button class="config-validate-btn @(_bearerVerified == true ? "config-validate-success" : "")"
                                            @onclick="VerifyBearerAsync" disabled="@(_bearerVerifying || string.IsNullOrWhiteSpace(_bearerInput))">
                                        @if (_bearerVerifying) { <span class="config-spinner-sm"></span> }
                                        else { <span>Verify</span> }
                                    </button>
                                </div>
                                @if (_bearerVerified == true)
                                {
                                    <div class="config-pat-result config-pat-success">✓ Bearer token is valid — authenticated as @_bearerUser</div>
                                }
                                else if (_bearerVerified == false)
                                {
                                    <div class="config-pat-result config-pat-error">✕ @(_bearerError ?? "Bearer token validation failed")</div>
                                }
                                @if (_overrideBearer)
                                {
                                    <p class="config-hint">
                                        <button class="config-btn-inline" @onclick="() => { _overrideBearer = false; _bearerInput = string.Empty; _bearerVerified = null; }" type="button">
                                            ← Keep using User Secrets
                                        </button>
                                    </p>
                                }
                                else
                                {
                                    <p class="config-hint">
                                        💡 Prefer User Secrets over pasting here:
                                        <code>dotnet user-secrets set "VirtualDevTeam:DevPlatform:AzureDevOps:BearerToken" "your-token"</code>
                                    </p>
                                }
                            }
                            <div class="config-hint" style="margin-top:0.5rem; padding:0.5rem; background:var(--bg-card-alt, #1a1a2e); border-radius:6px;">
                                ⏱️ Bearer tokens expire in ~1 hour. Get one with:<br/>
                                <code style="font-size:0.8rem;">az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv</code>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ───── Project Location ───── *@
            <div class="config-card" style="margin-top:1rem;">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">📁</span>
                    <span class="config-card-title">Project Location</span>
                    <span style="margin-left:auto;font-size:0.7rem;color:var(--text-secondary);">Where your code lives on disk</span>
                </div>
                <div class="config-card-body">
                    <div style="font-size:0.8rem;color:var(--text-secondary);margin-bottom:0.75rem;">
                        💡 Point VDT at your local checkout. Agents work in lightweight git worktrees —
                        your files and uncommitted changes are <strong>never touched</strong>.
                        If you don't have the repo cloned yet, VDT will clone it automatically.
                    </div>

                    <div style="padding:0.75rem;background:var(--bg-card-alt, #1a1a2e);border-radius:8px;border:1px solid var(--border-color, #333);">
                        <div class="config-field" style="margin-bottom:0;">
                            <label style="font-weight:600;">📁 Local project path</label>
                            <div style="display:flex;gap:0.5rem;align-items:center;">
                                <input type="text" class="config-input" style="flex:1;"
                                       placeholder="C:\src\MyProject  or  ~/src/my-project"
                                       @bind="_settings.ExistingRepoPath" @bind:event="oninput"
                                       title="Path to your local git checkout. Leave empty to let VDT clone the repo automatically." />
                                @if (_folderPickerSupported)
                                {
                                    <button class="config-validate-btn" type="button"
                                            @onclick="BrowseForFolderAsync"
                                            title="Open folder picker (Chromium browsers only)">
                                        📂
                                    </button>
                                }
                                <button class="config-validate-btn" type="button"
                                        @onclick="ValidateInPlacePathAsync"
                                        disabled="@_inPlaceValidating">
                                    @if (_inPlaceValidating) { <span class="config-spinner-sm"></span> }
                                    else { <span>Verify</span> }
                                </button>
                            </div>
                            @if (_folderPickerName is not null)
                            {
                                <div style="font-size:0.7rem;color:var(--accent-blue, #60a5fa);margin-top:0.3rem;">
                                    📂 Selected: <strong>@_folderPickerName</strong> — paste the full path above if not auto-filled
                                </div>
                            }
                            @if (_inPlaceVerified == true)
                            {
                                <div class="config-pat-result config-pat-success" style="margin-top:0.4rem;">
                                    ✓ Valid git repo — @(_inPlaceFileCount) files, branch: @(_inPlaceBranch)
                                </div>
                            }
                            else if (_inPlaceVerified == false)
                            {
                                <div class="config-pat-result config-pat-error" style="margin-top:0.4rem;">
                                    ✕ @(_inPlaceError ?? "Not a valid git repository")
                                </div>
                            }
                            <div style="font-size:0.7rem;color:var(--text-secondary);margin-top:0.3rem;">
                                Leave empty for new projects — VDT will clone the repo for you.
                                For existing projects, paste the full path to your git checkout.
                            </div>
                        </div>
                    </div>

                    <details style="margin-top:0.5rem;">
                        <summary style="font-size:0.75rem;color:var(--text-secondary);cursor:pointer;">
                            ⚙️ Advanced: Worktree location
                        </summary>
                        <div class="config-field" style="margin-top:0.3rem;">
                            <label>Worktree Root <span style="color:var(--text-secondary);font-size:0.75rem;">(optional)</span></label>
                            <input type="text" class="config-input" placeholder="Auto — uses %LOCALAPPDATA%\VDT\worktrees"
                                   @bind="_settings.WorktreeRoot" @bind:event="oninput" />
                            <div style="font-size:0.65rem;color:var(--text-secondary);margin-top:0.2rem;">
                                Where agent worktrees are created. Must be on the same drive as the repo. Leave empty for auto.
                            </div>
                        </div>
                    </details>
                </div>
            </div>

            @* ───── Image Generation (Azure OpenAI) — collapsible footer of step 2 ───── *@
            <div class="config-card" style="margin-top:1rem;">
                <details>
                    <summary class="config-card-header" style="cursor:pointer; list-style:none;">
                        <span class="config-card-icon">🎨</span>
                        <span class="config-card-title">Image Generation (Azure OpenAI)</span>
                        <span style="margin-left:auto; display:flex; gap:0.5rem; align-items:center;">
                            @if (_imgGenValidating)
                            {
                                <span class="config-spinner-sm"></span>
                            }
                            else if (_imgGenReport is { OverallSuccess: true })
                            {
                                <span class="config-pat-result config-pat-success"
                                      style="margin:0; padding:0.15rem 0.6rem; font-size:0.75rem;">✓ Validated</span>
                            }
                            else if (_imgGenReport is { OverallSuccess: false })
                            {
                                <span class="config-pat-result config-pat-error"
                                      style="margin:0; padding:0.15rem 0.6rem; font-size:0.75rem;">✕ Issues</span>
                            }
                        </span>
                    </summary>
                    <div class="config-card-body">
                        <p style="color:var(--text-secondary); margin-bottom:1rem; font-size:0.85rem;">
                            Configure Azure OpenAI image-gen for reference images and Artist SME assets.
                            <strong>Optional</strong> — leave Endpoint blank if you don't need image generation.
                            Estimated cost: ~$0.20/image × up to 3 attempts; typical project uses ~5-10 images.
                        </p>

                        <div class="config-field">
                            <label>
                                Endpoint
                                <span class="wizard-tooltip" title="The Azure OpenAI resource URL for image generation. Leave blank to skip image generation entirely. Format: https://<your-resource>.openai.azure.com/">ⓘ</span>
                            </label>
                            <input type="text" class="config-input"
                                   placeholder="https://&lt;your-resource&gt;.openai.azure.com/"
                                   @bind="_settings.AzureOpenAIImage.Endpoint" @bind:event="oninput" />
                        </div>

                        <div class="config-field-row">
                            <div class="config-field">
                                <label>
                                    API Version
                                    <span class="wizard-tooltip" title="Azure OpenAI API version string. Use the latest preview version for newest model support.">ⓘ</span>
                                </label>
                                <input type="text" class="config-input"
                                       @bind="_settings.AzureOpenAIImage.ApiVersion" @bind:event="oninput" />
                            </div>
                            <div class="config-field">
                                <label>
                                    Primary Deployment
                                    <span class="wizard-tooltip" title="The deployment name of your primary image generation model (e.g., gpt-image-1.5). This is tried first for every image request.">ⓘ</span>
                                </label>
                                <input type="text" class="config-input"
                                       @bind="_settings.AzureOpenAIImage.PrimaryDeployment" @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="config-field">
                            <label>
                                Fallback Deployments
                                <span class="wizard-tooltip" title="One deployment name per line (not comma-separated). These backup deployments are tried in order when the primary fails with transient errors (429 rate-limit, 503 overloaded, or deployment-not-found). Example: gpt-image-1 on one line, gpt-image-1-mini on the next.">ⓘ</span>
                            </label>
                            <textarea class="config-input" rows="4" style="font-family:monospace; resize:vertical;"
                                      placeholder="gpt-image-1.5&#10;gpt-image-1&#10;gpt-image-1-mini"
                                      value="@_imgGenFallbacksText"
                                      @oninput="OnImgGenFallbacksChanged"></textarea>
                            <div style="font-size:0.7rem; color:var(--text-secondary); margin-top:0.25rem;">
                                One deployment name per line; tried in order on transient failures (429, 503, deployment-not-found).
                            </div>
                        </div>

                        <div style="border:1px solid rgba(255,255,255,0.08); border-radius:8px; padding:0.75rem 1rem; margin-top:0.5rem; background:rgba(255,255,255,0.02);">
                            <div style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:0.75rem; font-weight:500;">
                                🔍 Generation Quality Controls
                                <span class="wizard-tooltip" title="These settings control how many times VDT retries image generation and whether a vision-AI model verifies each image matches the prompt before accepting it.">ⓘ</span>
                            </div>

                            <div style="display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
                                <div class="config-field" style="margin-bottom:0; flex:0 0 auto;">
                                    <label style="font-size:0.8rem;">
                                        Max Attempts
                                        <span class="wizard-tooltip" title="Maximum number of generation attempts per image before giving up. Each attempt costs ~$0.20.">ⓘ</span>
                                    </label>
                                    <input type="number" min="1" max="10" class="config-input"
                                           style="max-width:80px;"
                                           @bind="_settings.AzureOpenAIImage.MaxAttemptsPerImage" @bind:event="oninput" />
                                </div>

                                @if (_settings.AzureOpenAIImage.EnableVerification)
                                {
                                    <div class="config-field" style="margin-bottom:0; flex:0 0 auto;">
                                        <label style="font-size:0.8rem;">
                                            Confidence Threshold
                                            <span class="wizard-tooltip" title="Minimum vision-AI score (0.0–1.0) for an image to be accepted. Below this → auto-regenerate. Default 0.75.">ⓘ</span>
                                        </label>
                                        <input type="number" min="0" max="1" step="0.05" class="config-input"
                                               style="max-width:80px;"
                                               @bind="_settings.AzureOpenAIImage.VerificationConfidenceThreshold"
                                               @bind:event="oninput" />
                                    </div>
                                }

                                <div style="display:flex; align-items:center; gap:0.5rem;">
                                    <label class="toggle-switch"
                                           title="When ON, a vision-AI model verifies each image matches the prompt. When OFF, images accepted if >5KB.">
                                        <input type="checkbox"
                                               checked="@_settings.AzureOpenAIImage.EnableVerification"
                                               @onchange="e => _settings.AzureOpenAIImage.EnableVerification = (bool)(e.Value ?? false)" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span style="font-size:0.85rem;">Enable <span class="wizard-tooltip" title="Vision-AI verification: after generating an image, a separate AI call scores how well it matches the prompt. Below the confidence threshold → refine and regenerate. ~$0.01 per check.">ⓘ</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="config-field">
                            <label>
                                Authentication Method
                                <span class="wizard-tooltip" title="How VDT authenticates with Azure OpenAI. DefaultAzureCredential uses your Azure CLI login (run 'az login' first if not authenticated — no key to manage, tokens rotate automatically). Static API Key reads from dotnet user-secrets (never stored in config files).">ⓘ</span>
                            </label>
                            <div class="auth-method-toggle">
                                <button type="button"
                                        class="auth-method-btn @(_settings.AzureOpenAIImage.AuthMethod == "DefaultAzureCredential" ? "auth-method-active" : "")"
                                        @onclick='() => _settings.AzureOpenAIImage.AuthMethod = "DefaultAzureCredential"'
                                        title="Uses your Azure CLI session for authentication — no API key needed. Run 'az login' in your terminal first if you haven't already. Tokens rotate automatically and never touch config files.">
                                    🔐 DefaultAzureCredential <span style="opacity:0.7;">(recommended, keyless)</span>
                                </button>
                                <button type="button"
                                        class="auth-method-btn @(_settings.AzureOpenAIImage.AuthMethod == "ApiKey" ? "auth-method-active" : "")"
                                        @onclick='() => _settings.AzureOpenAIImage.AuthMethod = "ApiKey"'>
                                    🔑 Static API Key
                                </button>
                            </div>
                        </div>

                        @if (_settings.AzureOpenAIImage.AuthMethod == "ApiKey")
                        {
                            <div class="config-field">
                                <label>API Key</label>
                                @if (_hasUserSecretsImageApiKey && string.IsNullOrEmpty(_imgGenApiKeyInput))
                                {
                                    <div class="config-pat-result config-pat-success" style="margin-bottom:0.5rem;">
                                        ✓ API key is securely stored — leave blank to keep it, or enter a new key below to replace it
                                    </div>
                                }
                                <input type="password" class="config-input"
                                       placeholder="Stored in dotnet user-secrets, never in develop-settings.json"
                                       @bind="_imgGenApiKeyInput" @bind:event="oninput" />
                                <p class="config-hint">
                                    💡 Stored under user-secret <code>VirtualDevTeam:AzureOpenAI:ImageApiKey</code>.
                                    Keyless via <strong>DefaultAzureCredential</strong> is strongly preferred.
                                </p>
                            </div>
                        }

                        <div class="config-pat-row" style="margin-top:0.75rem;">
                            <button class="config-validate-btn @(_imgGenReport is { OverallSuccess: true } ? "config-validate-success" : "")"
                                    @onclick="ValidateImageGenAsync"
                                    disabled="@(_imgGenValidating || string.IsNullOrWhiteSpace(_settings.AzureOpenAIImage.Endpoint))">
                                @if (_imgGenValidating) { <span class="config-spinner-sm"></span> <span>Validating…</span> }
                                else { <span>Validate Image Auth &amp; Models</span> }
                            </button>
                            <label style="display:flex; align-items:center; gap:0.35rem; color:var(--text-secondary); font-size:0.8rem;">
                                <input type="checkbox" @bind="_imgGenRunSmokeTest" />
                                Run smoke test (generates one 1024×1024 image — ~$0.20)
                            </label>
                        </div>

                        @if (_imgGenError is not null)
                        {
                            <div class="config-pat-result config-pat-error" style="margin-top:0.5rem;">✕ @_imgGenError</div>
                        }

                        @if (_imgGenReport is not null)
                        {
                            <div style="margin-top:0.75rem; display:flex; flex-direction:column; gap:0.35rem;">
                                @RenderCheck(_imgGenReport.AuthCheck)
                                @RenderCheck(_imgGenReport.EndpointReachable)
                                @RenderCheck(_imgGenReport.PrimaryDeploymentOnline)
                                @foreach (var fb in _imgGenReport.FallbackDeploymentsOnline)
                                {
                                    @RenderCheck(fb)
                                }
                                @if (_imgGenReport.SmokeTest is not null)
                                {
                                    @RenderCheck(_imgGenReport.SmokeTest)
                                    @if (_imgGenReport.SmokeTest.Passed && !string.IsNullOrEmpty(_imgGenReport.SmokeTest.SavedPath))
                                    {
                                        <div style="margin-top:0.25rem; padding:0.4rem 0.6rem; background:var(--bg-card-alt, #1a1a2e); border-radius:6px; font-size:0.75rem; color:var(--text-secondary);">
                                            Saved to: <code>@_imgGenReport.SmokeTest.SavedPath</code>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </details>
            </div>
        }

        @* ───── Step 4: Reviews ───── *@
        @if (_currentStep == 4)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">👥</span>
                    <span class="config-card-title">Agent Reviewers</span>
                </div>
                <div class="config-card-body">
                    <p style="color:var(--text-secondary); margin-bottom:1rem; font-size:0.85rem;">
                        Choose which agent roles review pull requests before merging. Disabling a reviewer skips that review step entirely.
                    </p>
                    <div class="agent-reviewer-row">
                        <div class="agent-reviewer-toggle" title="The Program Manager reviews every PR for business alignment — verifying that the code fulfills the acceptance criteria from the PMSpec, user stories are addressed, and no business requirements were missed. The PM adds the 'pm-approved' label when satisfied.">
                            <label class="toggle-switch">
                                <input type="checkbox" checked="@_settings.AgentReviewers.PmReviews"
                                       @onchange="e => _settings.AgentReviewers.PmReviews = (bool)(e.Value ?? false)" />
                                <span class="toggle-slider"></span>
                            </label>
                            <span class="agent-reviewer-label">🗂️ PM</span>
                        </div>
                        <div class="agent-reviewer-toggle" title="The Architect reviews every PR for design compliance — checking that the implementation follows the patterns, technologies, and structure defined in Architecture.md. Catches structural issues like wrong layering, missing abstractions, or deviation from the agreed design.">
                            <label class="toggle-switch">
                                <input type="checkbox" checked="@_settings.AgentReviewers.ArchitectReviews"
                                       @onchange="e => _settings.AgentReviewers.ArchitectReviews = (bool)(e.Value ?? false)" />
                                <span class="toggle-slider"></span>
                            </label>
                            <span class="agent-reviewer-label">🏗️ Architect</span>
                        </div>
                        <div class="agent-reviewer-toggle" title="Other Software Engineers review PRs for code quality, readability, and correctness — the same things a human engineer would check in a peer review. In Multi-PR mode, idle engineers review their peers' PRs while waiting for their own tasks.">
                            <label class="toggle-switch">
                                <input type="checkbox" checked="@_settings.AgentReviewers.EngineerReviews"
                                       @onchange="e => _settings.AgentReviewers.EngineerReviews = (bool)(e.Value ?? false)" />
                                <span class="toggle-slider"></span>
                            </label>
                            <span class="agent-reviewer-label">👨‍💻 Engineers</span>
                        </div>
                        <div class="agent-reviewer-toggle" title="The Test Engineer adds automated tests to every PR, runs them, and applies the 'tests-added' label. When disabled, the TE doesn't spawn — PRs flow straight from architect-approved to PM review/merge with no test-coverage gate. Useful for spike/research projects, fast prototypes, or when test work is handled out-of-band.">
                            <label class="toggle-switch">
                                <input type="checkbox" checked="@_settings.AgentReviewers.TestEngineerReviews"
                                       @onchange="e => _settings.AgentReviewers.TestEngineerReviews = (bool)(e.Value ?? false)" />
                                <span class="toggle-slider"></span>
                            </label>
                            <span class="agent-reviewer-label">🧪 Test Engineer</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="config-card" style="margin-top: 1rem;">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">🚦</span>
                    <span class="config-card-title">Human Review Gates</span>
                </div>
                <div class="config-card-body">
                    <p style="color:var(--text-secondary); margin-bottom:1rem; font-size:0.85rem;">
                        Choose which milestones require your approval before agents proceed.
                    </p>

                    <!-- Quick Presets -->
                    <div class="gate-presets-row">
                        <button class="gate-preset-btn @(_gatePreset == "auto" ? "active" : "")" @onclick='() => ApplyGatePreset("auto")'>
                            ⚡ Full Auto
                        </button>
                        <button class="gate-preset-btn @(_gatePreset == "supervised" ? "active" : "")" @onclick='() => ApplyGatePreset("supervised")'>
                            👁 Supervised
                        </button>
                        <button class="gate-preset-btn @(_gatePreset == "full" ? "active" : "")" @onclick='() => ApplyGatePreset("full")'>
                            🔒 Full Control
                        </button>
                    </div>

                    <!-- Common Gates (always visible) -->
                    <div class="gate-section">
                        <h4 class="gate-section-title">Common Gates</h4>
                        @foreach (var gate in _commonGateIds)
                        {
                            var info = GateIds.AllGates.FirstOrDefault(g => g.Id == gate);
                            if (info != default)
                            {
                                <div class="gate-toggle-row">
                                    <label class="gate-toggle-label">
                                        <span class="gate-toggle-name">@info.Name</span>
                                        <span class="gate-toggle-desc">@info.Description</span>
                                    </label>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@IsGateEnabled(gate)" @onchange="e => ToggleGate(gate, (bool)(e.Value ?? false))" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                </div>
                            }
                        }
                    </div>

                    <!-- Advanced Gates (accordion) -->
                    <div class="gate-advanced-section">
                        @{
                            var advancedEnabledCount = _advancedGateIds.Count(g => IsGateEnabled(g));
                        }
                        <button class="gate-advanced-toggle" @onclick="() => _showAdvancedGates = !_showAdvancedGates">
                            @(_showAdvancedGates ? "▼" : "▶") Advanced Gates (@_advancedGateIds.Length more)
                            @if (advancedEnabledCount > 0)
                            {
                                <span style="margin-left: 8px; color: #34d399; font-weight: 600;">● @advancedEnabledCount enabled</span>
                            }
                        </button>
                        @if (_showAdvancedGates)
                        {
                            <div class="gate-advanced-list">
                                @{
                                    string? lastPhase = null;
                                }
                                @foreach (var gate in _advancedGateIds)
                                {
                                    var info = GateIds.AllGates.FirstOrDefault(g => g.Id == gate);
                                    if (info != default)
                                    {
                                        @if (info.Phase != lastPhase)
                                        {
                                            lastPhase = info.Phase;
                                            <div class="gate-phase-divider">@info.Phase</div>
                                        }
                                        <div class="gate-toggle-row">
                                            <label class="gate-toggle-label">
                                                <span class="gate-toggle-name">@info.Name</span>
                                                <span class="gate-toggle-desc">@info.Description</span>
                                            </label>
                                            <label class="toggle-switch">
                                                <input type="checkbox" checked="@IsGateEnabled(gate)" @onchange="e => ToggleGate(gate, (bool)(e.Value ?? false))" />
                                                <span class="toggle-slider"></span>
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ───── Step 5: Work Item Linking ───── *@
        @if (_currentStep == 5)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">🔗</span>
                    <span class="config-card-title">Link to Existing Work Item (Optional)</span>
                </div>
                <div class="config-card-body">
                    <div class="config-field">
                        <label>
                            Search by ID, title, or URL
                            <span class="wizard-tooltip" title="Link this run to an existing work item (Epic, Feature, or User Story) so all agent-created issues and PRs are parented under it. This helps integrate agent work into your existing backlog and sprint tracking.">ⓘ</span>
                        </label>
                        <input type="text" class="config-input" placeholder="Search work items…"
                               value="@_workItemQuery"
                               @oninput="OnWorkItemSearchInput" />
                        @if (_workItemSearching)
                        {
                            <div style="margin-top:0.5rem; color:var(--text-secondary);">
                                <span class="config-spinner-sm"></span> Searching…
                            </div>
                        }
                    </div>

                    @if (_workItemResults.Count > 0 && _selectedWorkItem is null)
                    {
                        <div class="wizard-search-results">
                            @foreach (var item in _workItemResults)
                            {
                                <div class="wizard-search-item" @onclick="() => SelectWorkItem(item)">
                                    <span class="wizard-wi-type-badge @GetWorkItemBadgeClass(item.WorkItemType)">@item.WorkItemType</span>
                                    <span class="wizard-wi-id">#@item.Id</span>
                                    <span class="wizard-wi-title">@item.Title</span>
                                    <span class="wizard-wi-state">@item.State</span>
                                </div>
                            }
                        </div>
                    }

                    @if (_selectedWorkItem is not null)
                    {
                        <div class="wizard-selected-item">
                            <div style="display:flex; align-items:center; gap:0.75rem; flex:1;">
                                <span class="wizard-wi-type-badge @GetWorkItemBadgeClass(_selectedWorkItem.WorkItemType)">@_selectedWorkItem.WorkItemType</span>
                                <span style="font-weight:600; color:var(--accent-cyan);">#@_selectedWorkItem.Id</span>
                                <span style="color:var(--text-primary);">@_selectedWorkItem.Title</span>
                                <span class="wizard-wi-state">@_selectedWorkItem.State</span>
                            </div>
                            <button class="config-btn-remove" @onclick="RemoveWorkItem" title="Remove">✕</button>
                        </div>
                    }

                    @if (_workItemSearchError is not null)
                    {
                        <div class="config-pat-result config-pat-error" style="margin-top:0.75rem;">
                            ⚠ @_workItemSearchError
                        </div>
                    }

                    <div style="margin-top:1.5rem; text-align:center;">
                        <button class="wizard-skip-btn" @onclick="() => GoToStep(6)">
                            Skip this step →
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ───── Step 6: Review & Start ───── *@
        @if (_currentStep == 6)
        {
            <div class="config-card">
                <div class="config-card-header" style="cursor:default;">
                    <span class="config-card-icon">📋</span>
                    <span class="config-card-title">Review &amp; Start</span>
                </div>
                <div class="config-card-body">
                    <!-- Warnings -->
                    @if (string.IsNullOrWhiteSpace(_settings.Description))
                    {
                        <div class="wizard-warning">⚠ Description is empty — agents need to know what to build.</div>
                    }
                    @if (_patVerified != true && string.IsNullOrWhiteSpace(_patInput) && !_hasUserSecretsPat
                         && _bearerVerified != true && string.IsNullOrWhiteSpace(_bearerInput) && !_hasUserSecretsBearer
                         && _ghCliVerified != true)
                    {
                        <div class="wizard-warning">⚠ No authentication configured — agents may not be able to access the repository.</div>
                    }
                    @if (!_settings.CreateNewRepo && !_repoCreated && _repoVerified != true)
                    {
                        <div class="wizard-warning">⚠ Repository has not been verified.</div>
                    }

                    <!-- Summary -->
                    <div class="wizard-summary">
                        <div class="wizard-summary-section">
                            <div class="wizard-summary-section-header">
                                <span>💡 What to Build</span>
                                <button class="config-btn-inline" @onclick="() => GoToStep(1)">Edit</button>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Description</span>
                                <span class="wizard-summary-value">
                                    @if (_selectedSourceWi is not null)
                                    {
                                        <span>📎 From @_selectedSourceWi.WorkItemType #@_selectedSourceWi.Id — @_selectedSourceWi.Title</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(_settings.Description))
                                    {
                                        <span>—</span>
                                    }
                                    else
                                    {
                                        @(_settings.Description.Length > 200
                                            ? _settings.Description[..200] + "…"
                                            : _settings.Description)
                                    }
                                </span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Tech Stack</span>
                                <span class="wizard-summary-value">@(string.IsNullOrWhiteSpace(_settings.TechStack) ? "AI will choose" : _settings.TechStack)</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Docs Folder</span>
                                <span class="wizard-summary-value">@(string.IsNullOrWhiteSpace(_settings.DocsFolderPath) ? "AgentDocs" : _settings.DocsFolderPath)</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">PM Issue Mode</span>
                                <span class="wizard-summary-value">@(_settings.SingleIssueMode ? "📌 Single Issue" : "📝 Detailed User Stories")</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">PR Delivery</span>
                                <span class="wizard-summary-value">@(_settings.PrMode switch { "SinglePR" => "⚡ Single PR", "MultiPRParallel" => "🔀 Multiple PRs (Parallel)", "MultiPRSerial" => "📦 Multiple PRs (Serial)", _ => _settings.PrMode })</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Pre-PR Clarification</span>
                                <span class="wizard-summary-value">@(_settings.PrePRClarificationGate ? "🛑 Require Approval" : "🚀 Auto-proceed")</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Failing UI Tests</span>
                                <span class="wizard-summary-value">@(_settings.AllowFailingUiTests ? "🚀 Allow Merge" : "🛑 Block Merge")</span>
                            </div>
                        </div>

                        @{
                            var answeredCount = _settings.ClarifyingAnswers.Count(qa => !string.IsNullOrWhiteSpace(qa.Answer));
                        }
                        @if (_settings.ClarifyingAnswers.Count > 0)
                        {
                            <div class="wizard-summary-section">
                                <div class="wizard-summary-section-header">
                                    <span>❓ Clarifying Details</span>
                                    <button class="config-btn-inline" @onclick="() => GoToStep(2)">Edit</button>
                                </div>
                                <div class="wizard-summary-row">
                                    <span class="wizard-summary-label">Questions</span>
                                    <span class="wizard-summary-value">@answeredCount of @_settings.ClarifyingAnswers.Count answered</span>
                                </div>
                                @foreach (var qa in _settings.ClarifyingAnswers.Where(qa => !string.IsNullOrWhiteSpace(qa.Answer)))
                                {
                                    <div class="wizard-summary-row" style="flex-direction:column; align-items:flex-start; gap:0.15rem;">
                                        <span class="wizard-summary-label" style="font-size:0.8rem;">@qa.Question</span>
                                        <span class="wizard-summary-value" style="font-size:0.8rem; color:var(--accent-green);">@qa.Answer</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="wizard-summary-section">
                            <div class="wizard-summary-section-header">
                                <span>📦 Repository</span>
                                <button class="config-btn-inline" @onclick="() => GoToStep(0)">Edit</button>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Platform</span>
                                <span class="wizard-summary-value">@(_settings.Platform == "GitHub" ? "🐙 GitHub" : "🔷 Azure DevOps")</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Repository</span>
                                <span class="wizard-summary-value">@GetRepoDisplayName()</span>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Branch</span>
                                <span class="wizard-summary-value">@CurrentDefaultBranch</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_settings.WorkingBranch))
                            {
                                <div class="wizard-summary-row">
                                    <span class="wizard-summary-label">Working Branch</span>
                                    <span class="wizard-summary-value">🌿 @_settings.WorkingBranch</span>
                                </div>
                            }
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Auth</span>
                                <span class="wizard-summary-value">
                                    @if (_settings.AuthMethod == "AzureCliBearer")
                                    {
                                        @if (_bearerVerified == true) { <span style="color:var(--accent-green);">✓ Bearer verified (@_bearerUser)</span> }
                                        else if (!string.IsNullOrWhiteSpace(_bearerInput)) { <span style="color:#f0c674;">Bearer entered (not verified)</span> }
                                        else if (_hasUserSecretsBearer) { <span style="color:var(--accent-green);">✓ Bearer via User Secrets</span> }
                                        else { <span style="color:var(--text-secondary);">Not configured</span> }
                                    }
                                    else
                                    {
                                        @if (_patVerified == true) { <span style="color:var(--accent-green);">✓ PAT verified</span> }
                                        else if (!string.IsNullOrWhiteSpace(_patInput)) { <span style="color:#f0c674;">PAT entered (not verified)</span> }
                                        else if (_hasUserSecretsPat) { <span style="color:var(--accent-green);">✓ Configured via User Secrets</span> }
                                        else { <span style="color:var(--text-secondary);">Not configured</span> }
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="wizard-summary-section">
                            <div class="wizard-summary-section-header">
                                <span>🔗 Work Item</span>
                                <button class="config-btn-inline" @onclick="() => GoToStep(5)">Edit</button>
                            </div>
                            <div class="wizard-summary-row">
                                <span class="wizard-summary-label">Linked Item</span>
                                <span class="wizard-summary-value">
                                    @if (_selectedWorkItem is not null)
                                    {
                                        <span>@_selectedWorkItem.WorkItemType #@_selectedWorkItem.Id — @_selectedWorkItem.Title</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-secondary);">None</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Start Button -->
                    <div style="text-align:center; margin-top:2rem;">
                        @if (_pausedRunId is not null)
                        {
                            <div class="wizard-paused-banner">
                                <div class="wizard-paused-info">
                                    <span>⏸️ A previous run is paused</span>
                                    <span style="color:var(--text-secondary); font-size:0.8rem;">
                                        Run @_pausedRunId on @_pausedRunRepo
                                    </span>
                                </div>
                                <div class="wizard-paused-actions">
                                    <button class="wizard-nav-btn wizard-resume-btn" @onclick="ResumeExistingRunAsync"
                                            disabled="@_starting"
                                            title="Resume the paused run from where it left off. No new project will be created.">
                                        ▶ Resume
                                    </button>
                                    <button class="wizard-nav-btn wizard-cancel-run-btn" @onclick="CancelPausedRunAsync"
                                            disabled="@_starting"
                                            title="Cancel the paused run permanently. The run history is preserved but the run will not continue. You can then start a new project.">
                                        ✕ Cancel Run
                                    </button>
                                </div>
                            </div>
                        }
                        @if (_runningRunId is not null && !_showRunningConfirmation)
                        {
                            <div class="wizard-paused-banner" style="border-color:rgba(255,100,100,0.3); background:rgba(255,100,100,0.06);">
                                <div class="wizard-paused-info">
                                    <span>🔴 An active run is in progress</span>
                                    <span style="color:var(--text-secondary); font-size:0.8rem;">
                                        Run @_runningRunId on @_runningRunRepo — starting a new project will cancel it.
                                    </span>
                                </div>
                            </div>
                        }
                        @if (_showRunningConfirmation)
                        {
                            <div class="wizard-paused-banner" style="border-color:rgba(255,100,100,0.4); background:rgba(255,100,100,0.1);">
                                <div class="wizard-paused-info">
                                    <span style="font-weight:700; color:#ff6464;">⚠️ Confirm: Cancel active run?</span>
                                    <span style="color:var(--text-secondary); font-size:0.85rem;">
                                        Run <strong>@_runningRunId</strong> on <strong>@_runningRunRepo</strong> will be stopped
                                        and cancelled. All running agents will be shut down. This cannot be undone.
                                    </span>
                                </div>
                                <div class="wizard-paused-actions">
                                    <button class="wizard-nav-btn wizard-cancel-run-btn" @onclick="ConfirmForceRestartAsync"
                                            disabled="@_starting"
                                            style="background:#dc3545; border-color:#dc3545; color:#fff;">
                                        @if (_starting)
                                        {
                                            <span class="config-spinner-sm"></span>
                                            <span>Cancelling & Starting…</span>
                                        }
                                        else
                                        {
                                            <span>🔄 Yes, Cancel & Start New</span>
                                        }
                                    </button>
                                    <button class="wizard-nav-btn" @onclick="() => _showRunningConfirmation = false" disabled="@_starting">
                                        ← Go Back
                                    </button>
                                </div>
                            </div>
                        }
                        @if (_startSuccess)
                        {
                            <div class="config-pat-result config-pat-success" style="margin-bottom:1rem; text-align:center; font-size:1.1rem;">
                                🚀 Agents are starting! Redirecting to Overview…
                            </div>
                        }
                        else if (!_showRunningConfirmation)
                        {
                            <button class="wizard-start-btn" @onclick="HandleStartBuildingAsync"
                                    disabled="@(_starting || string.IsNullOrWhiteSpace(_settings.Description))"
                                    title="@(_pausedRunId is not null ? "This will cancel the paused run and start a new project." : _runningRunId is not null ? "This will cancel the active run and start a new project." : "Start the agent squad on this project.")">
                                @if (_starting)
                                {
                                    <span class="config-spinner-sm"></span>
                                    <span>Starting…</span>
                                }
                                else
                                {
                                    <span>🚀 @(_pausedRunId is not null ? "Cancel Paused & Start New" : _runningRunId is not null ? "Cancel Active & Start New" : "Start Building")</span>
                                }
                            </button>
                        }
                        @if (_startError is not null)
                        {
                            <div class="config-pat-result config-pat-error" style="margin-top:1rem;">
                                ✕ @_startError
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Wizard Navigation -->
    <div class="wizard-actions">
        @if (_currentStep > 0)
        {
            <button class="wizard-nav-btn wizard-back-btn" @onclick="() => GoToStep(_currentStep - 1)">
                ← Back
            </button>
        }
        else
        {
            <div></div>
        }

        @if (_currentStep < 6)
        {
            <button class="wizard-nav-btn wizard-next-btn" @onclick="() => GoToStep(_currentStep + 1)"
                    disabled="@(!CanAdvance())"
                    title="@GetAdvanceBlockedReason()">
                Next →
            </button>
        }
    </div>
}

@code {
    private static readonly string[] _stepLabels = { "Repo & Auth", "What to Build", "Clarify", "Scenarios", "Reviews", "Work Items", "Review" };
    private static readonly string[] _stepSlugs = { "auth", "build", "clarify", "scenarios", "reviews", "workitems", "review" };
    private const string PlatformGitHub = "GitHub";
    private const string PlatformAdo = "AzureDevOps";

    // Static cache for auth/repo validation results so they survive step navigation
    // and Blazor circuit reconnects within the same runner process.
