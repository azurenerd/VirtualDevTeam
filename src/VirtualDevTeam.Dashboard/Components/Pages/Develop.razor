    // ── Step 6: Start ──
    /// <summary>
    /// Gate for the Start Building button. If a running run exists, shows confirmation dialog.
    /// Otherwise proceeds directly to start.
    /// </summary>
    private async Task HandleStartBuildingAsync()
    {
        if (_runningRunId is not null)
        {
            _showRunningConfirmation = true;
            return;
        }
        await StartBuildingAsync();
    }

    /// <summary>
    /// User confirmed force-restart. Captures the run ID at confirmation time,
    /// then starts with forceRestart=true.
    /// </summary>
    private async Task ConfirmForceRestartAsync()
    {
        _showRunningConfirmation = false;
        await StartBuildingAsync(forceRestart: true);
    }

    private async Task StartBuildingAsync(bool forceRestart = false)
    {
        _starting = true;
        _startError = null;
        _startSuccess = false;
        try
        {
            await SettingsService.SaveAsync(_settings);

            // Persist PAT/bearer to user-secrets and inject into runtime config
            await ApplyAuthenticationAsync();

            // Start the project run via RunCoordinator
            var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
            if (coordinator is not null)
            {
                await coordinator.StartProjectAsync(forceRestart: forceRestart);
                _ = Task.Run(async () =>
                {
                    try { await coordinator.SpawnAgentsForRunAsync(); }
                    catch (Exception ex) { Logger.LogError(ex, "Failed to spawn agents after start"); }
                });
            }

            _startSuccess = true;
            _runningRunId = null;
            _runningRunRepo = null;
            _pausedRunId = null;
            _pausedRunRepo = null;
            Logger.LogInformation("Build started for: {Description}", _settings.Description[..Math.Min(80, _settings.Description.Length)]);

            // Brief delay then navigate to overview
            await Task.Delay(1500);
            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start build");
            _startError = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task ResumeExistingRunAsync()
    {
        _starting = true;
        _startError = null;
        try
        {
            var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
            if (coordinator is not null)
            {
                await coordinator.ResumeAsync();
                _ = Task.Run(async () =>
                {
                    try { await coordinator.SpawnAgentsForRunAsync(); }
                    catch (Exception ex) { Logger.LogError(ex, "Failed to spawn agents after resume"); }
                });
            }
            _startSuccess = true;
            await Task.Delay(1500);
            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resume run");
            _startError = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task CancelPausedRunAsync()
    {
        _startError = null;
        try
        {
            var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
            if (coordinator is not null)
            {
                await coordinator.CancelRunAsync();
            }
            _pausedRunId = null;
            _pausedRunRepo = null;
            Logger.LogInformation("Paused run cancelled from wizard");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel paused run");
            _startError = ex.Message;
        }
    }

    /// <summary>
    /// Persists entered PAT/bearer to user-secrets for future sessions and injects
    /// into the runtime config so the current run can use them immediately.
    /// </summary>
    private async Task ApplyAuthenticationAsync()
    {
        var config = ConfigService.GetCurrentConfig();
        string? ghToken = null;
        string? adoPat = null;
        string? adoBearer = null;

        if (_settings.Platform == "GitHub" && !string.IsNullOrWhiteSpace(_patInput))
        {
            ghToken = _patInput.Trim();
            config.Project.GitHubToken = ghToken;
        }
        else if (_settings.Platform == "AzureDevOps")
        {
            if (!string.IsNullOrWhiteSpace(_patInput))
            {
                adoPat = _patInput.Trim();
                config.DevPlatform ??= new DevPlatformConfig();
                config.DevPlatform.AzureDevOps ??= new AzureDevOpsConfig();
                config.DevPlatform.AzureDevOps.Pat = adoPat;
            }
            if (!string.IsNullOrWhiteSpace(_bearerInput))
            {
                adoBearer = _bearerInput.Trim();
                config.DevPlatform ??= new DevPlatformConfig();
                config.DevPlatform.AzureDevOps ??= new AzureDevOpsConfig();
                config.DevPlatform.AzureDevOps.BearerToken = adoBearer;
            }
        }

        // Persist to user-secrets so it survives restarts
        string? imageApiKey = null;
        if (_settings.AzureOpenAIImage.AuthMethod == "ApiKey" && !string.IsNullOrWhiteSpace(_imgGenApiKeyInput))
        {
            imageApiKey = _imgGenApiKeyInput.Trim();
        }

        if (ghToken is not null || adoPat is not null || adoBearer is not null || imageApiKey is not null)
        {
            try
            {
                await ConfigService.PersistSecretsOnlyAsync(ghToken, adoPat, adoBearer, imageApiKey);
                Logger.LogInformation("PAT/bearer/image-key persisted to user-secrets for future sessions");

                if (imageApiKey is not null)
                {
                    _imgGenApiKeyInput = "";
                    _hasUserSecretsImageApiKey = true;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to persist secrets to user-secrets — will use in-memory only");
            }
        }
    }

    /// <summary>Captures description input events (typing) reliably.</summary>
    private void OnDescriptionInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        // Guard: never overwrite a non-empty description with empty from a stale/dropped oninput
        // that arrives after a paste. The paste handler is the primary for large payloads.
        if (string.IsNullOrEmpty(val) && !string.IsNullOrEmpty(_settings.Description) && _pasteInProgress)
            return;
        _settings.Description = val;
    }

    /// <summary>
    /// Handles paste into the description textarea. Blazor Server can drop large oninput
    /// payloads that approach the SignalR MaximumReceiveMessageSize (32KB default, now 512KB).
    /// We read the full textarea DOM value after the browser finishes the paste, which
    /// preserves any text the user typed before pasting.
    /// NOTE: Do NOT use navigator.clipboard.readText() here — it returns only the pasted
    /// fragment, not the full textarea value, which would wipe pre-existing typed text.
    /// </summary>
    private async Task OnDescriptionPaste(ClipboardEventArgs e)
    {
        _pasteInProgress = true;
        try
        {
            // Wait for the browser to finish updating the DOM with the pasted content
            // inserted at the cursor position (preserving any existing text).
            await Task.Delay(150);
            try
            {
                var val = await JS.InvokeAsync<string>("eval",
                    "document.getElementById('vdt-description-textarea')?.value ?? ''");
                if (!string.IsNullOrEmpty(val))
                {
                    _settings.Description = val;
                    StateHasChanged();
                }
            }
            catch { /* Best-effort — oninput will still fire as fallback */ }
        }
        finally
        {
            _pasteInProgress = false;
        }
    }

    /// <summary>Updates the fallback-deployments list from the textarea (one entry per line).</summary>
    private void OnImgGenFallbacksChanged(ChangeEventArgs e)
    {
        _imgGenFallbacksText = e.Value?.ToString() ?? "";
        _settings.AzureOpenAIImage.FallbackDeployments = _imgGenFallbacksText
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrEmpty(line))
            .ToList();
    }

    /// <summary>
    /// Posts the in-memory wizard image-gen settings (and any newly-typed API key) to the
    /// Runner's <c>/api/dashboard/validate-image-gen</c> endpoint, then displays the
    /// per-check report. Mirrors the existing repo/PAT-validate UX.
    /// </summary>
    private async Task ValidateImageGenAsync()
    {
        _imgGenValidating = true;
        _imgGenError = null;
        _imgGenReport = null;
        try
        {
            OnImgGenFallbacksChanged(new ChangeEventArgs { Value = _imgGenFallbacksText });
            try { await SettingsService.SaveAsync(_settings); } catch { }

            var request = new ImageGenValidationRequest
            {
                RunSmokeTest = _imgGenRunSmokeTest,
                Settings = _settings.AzureOpenAIImage,
                ApiKey = (_settings.AzureOpenAIImage.AuthMethod == "ApiKey" && !string.IsNullOrWhiteSpace(_imgGenApiKeyInput))
                    ? _imgGenApiKeyInput.Trim()
                    : null,
            };

            _imgGenReport = await ConfigService.ValidateImageGenAsync(request);

            if (_imgGenReport.OverallSuccess && !string.IsNullOrWhiteSpace(_imgGenApiKeyInput))
            {
                _hasUserSecretsImageApiKey = true;
                _imgGenApiKeyInput = "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Image-gen validation failed");
            _imgGenError = ex.Message;
        }
        finally
        {
            _imgGenValidating = false;
        }
    }

    /// <summary>Renders a single per-check status row (green check / red X + label + detail + hint).</summary>
    private static RenderFragment RenderCheck(VirtualDevTeam.Core.AI.ValidationCheck check) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class",
            check.Passed ? "config-pat-result config-pat-success" : "config-pat-result config-pat-error");
        builder.AddAttribute(2, "style", "margin:0; display:flex; flex-direction:column; gap:0.15rem;");

        builder.OpenElement(3, "div");
        builder.AddContent(4, (check.Passed ? "✓ " : "✕ ") + check.Label);
        builder.CloseElement();

        if (!string.IsNullOrEmpty(check.Detail))
        {
            builder.OpenElement(5, "div");
            builder.AddAttribute(6, "style", "font-size:0.75rem; opacity:0.85;");
            builder.AddContent(7, check.Detail);
            builder.CloseElement();
        }
        if (!check.Passed && !string.IsNullOrEmpty(check.ActionHint))
        {
            builder.OpenElement(8, "div");
            builder.AddAttribute(9, "style", "font-size:0.75rem; font-style:italic; opacity:0.85;");
            builder.AddContent(10, "→ " + check.ActionHint);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _sourceWiDebounceTimer?.Dispose();
        _sourceWiSearchCts?.Cancel();
        _sourceWiSearchCts?.Dispose();
        _clarifyActivityCts?.Cancel();
        _clarifyActivityCts?.Dispose();
    }
}

