    /// <summary>Validates the InPlace checkout path — checks for .git, gets branch and file count.</summary>
    private async Task ValidateInPlacePathAsync()
    {
        _inPlaceValidating = true;
        _inPlaceVerified = null;
        _inPlaceError = null;
        StateHasChanged();

        try
        {
            var path = _settings.ExistingRepoPath?.Trim();
            if (string.IsNullOrWhiteSpace(path))
            {
                _inPlaceVerified = false;
                _inPlaceError = "Enter the path to your local git checkout.";
                return;
            }

            if (!Directory.Exists(path))
            {
                _inPlaceVerified = false;
                _inPlaceError = $"Directory not found: {path}";
                return;
            }

            var gitDir = Path.Combine(path, ".git");
            if (!Directory.Exists(gitDir) && !File.Exists(gitDir))
            {
                _inPlaceVerified = false;
                _inPlaceError = "Not a git repository — no .git directory found.";
                return;
            }

            // Get current branch
            var branchResult = await RunGitQuickAsync(path, "rev-parse --abbrev-ref HEAD");
            _inPlaceBranch = branchResult.success ? branchResult.output.Trim() : "unknown";

            // Count tracked files (quick estimate)
            var countResult = await RunGitQuickAsync(path, "ls-files --cached");
            _inPlaceFileCount = countResult.success
                ? countResult.output.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length
                : 0;

            _inPlaceVerified = true;

            // Fire-and-forget context gathering for local project
            _ = InvokeAsync(async () =>
            {
                await GatherExistingProjectContextAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "InPlace path validation failed");
            _inPlaceVerified = false;
            _inPlaceError = ex.Message;
        }
        finally
        {
            _inPlaceValidating = false;
            StateHasChanged();
        }
    }

    private static async Task<(bool success, string output)> RunGitQuickAsync(string workingDir, string args)
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo("git", args)
            {
                WorkingDirectory = workingDir,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true,
            };
            using var proc = System.Diagnostics.Process.Start(psi);
            if (proc is null) return (false, "");
            var output = await proc.StandardOutput.ReadToEndAsync();
            await proc.WaitForExitAsync();
            return (proc.ExitCode == 0, output);
        }
        catch { return (false, ""); }
    }

    /// <summary>
    /// Gathers existing project context by running an agentic CLI session.
    /// For local projects, the CLI explores the filesystem directly.
    /// For remote repos, key files are pre-fetched via REST API and included in the prompt.
    /// Skipped for new (greenfield) projects.
    /// </summary>
    private async Task GatherExistingProjectContextAsync()
    {
        // Skip for new projects — no existing code to analyze
        if (_settings.CreateNewRepo) return;

        // Skip if already gathered and not stale
        if (!string.IsNullOrWhiteSpace(_settings.ExistingProjectContext))
        {
            Logger.LogInformation("Wizard: Existing project context already gathered ({Len} chars), skipping",
                _settings.ExistingProjectContext.Length);
            return;
        }

        _contextGathering = true;
        _contextGatherStatus = "📁 Gathering project context...";
        _contextGatherCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var cliManager = ServiceProvider.GetService<VirtualDevTeam.Core.AI.CopilotCliProcessManager>();
            if (cliManager is null || !cliManager.IsAvailable)
            {
                Logger.LogWarning("Wizard: CLI not available for context gathering, skipping");
                _contextGatherStatus = "⚠ CLI not available — skipping context scan.";
                return;
            }

            var promptService = ServiceProvider.GetService<VirtualDevTeam.Core.Prompts.IPromptTemplateService>();
            string prompt;
            string? workingDirectory = null;

            var isLocalProject = !string.IsNullOrWhiteSpace(_settings.ExistingRepoPath)
                                 && Directory.Exists(_settings.ExistingRepoPath);

            if (isLocalProject)
            {
                // Local project: CLI explores the filesystem directly
                workingDirectory = _settings.ExistingRepoPath;
                if (promptService is not null)
                {
                    var vars = new Dictionary<string, string>
                    {
                        ["existing_repo_path"] = _settings.ExistingRepoPath!
                    };
                    var rendered = await promptService.RenderAsync("wizard/gather-project-context", vars);
                    prompt = !string.IsNullOrWhiteSpace(rendered) ? rendered
                        : "Explore this project directory and produce a structured summary of: Project Overview, Tech Stack & Dependencies, Architecture & Structure, Coding Patterns & Conventions, Build/Test/Deploy info, Existing Documentation Summary, and Notable Details for Feature Development. Do NOT modify any files. Cap your summary at 3000 words.";
                }
                else
                {
                    prompt = "Explore this project directory and produce a structured summary of: Project Overview, Tech Stack & Dependencies, Architecture & Structure, Coding Patterns & Conventions, Build/Test/Deploy info, Existing Documentation Summary, and Notable Details for Feature Development. Do NOT modify any files. Cap your summary at 3000 words.";
                }
            }
            else
            {
                // Remote project: pre-fetch key files via REST API, then summarize with CLI
                _contextGatherStatus = "📡 Reading remote repository files...";
                StateHasChanged();

                var (preFetchedFiles, repoTree) = await ReadRemoteRepoFilesAsync();

                if (string.IsNullOrWhiteSpace(preFetchedFiles) && string.IsNullOrWhiteSpace(repoTree))
                {
                    Logger.LogInformation("Wizard: No remote files fetched, skipping context gathering");
                    _contextGatherStatus = "ℹ No repo files accessible — skipping context scan.";
                    return;
                }

                _contextGatherStatus = "🤖 Analyzing project context...";
                StateHasChanged();

                var repoIdentifier = _settings.Platform == PlatformGitHub
                    ? _settings.GitHub?.Repo ?? "unknown"
                    : $"{_settings.AzureDevOps?.Organization}/{_settings.AzureDevOps?.Project}/{_settings.AzureDevOps?.Repository}";

                if (promptService is not null)
                {
                    var vars = new Dictionary<string, string>
                    {
                        ["pre_fetched_files"] = preFetchedFiles ?? "",
                        ["repo_tree"] = repoTree ?? "",
                        ["repo_identifier"] = repoIdentifier
                    };
                    var rendered = await promptService.RenderAsync("wizard/gather-project-context-remote", vars);
                    prompt = !string.IsNullOrWhiteSpace(rendered) ? rendered
                        : $"Analyze these pre-fetched repository files and directory tree, then produce a structured summary:\n\nRepository: {repoIdentifier}\n\nDirectory tree:\n{repoTree}\n\nFile contents:\n{preFetchedFiles}\n\nSummarize: Project Overview, Tech Stack, Architecture, Coding Patterns, Build/Test/Deploy, Docs Summary, Notable Details. Cap at 3000 words.";
                }
                else
                {
                    prompt = $"Analyze these pre-fetched repository files and directory tree, then produce a structured summary:\n\nRepository: {repoIdentifier}\n\nDirectory tree:\n{repoTree}\n\nFile contents:\n{preFetchedFiles}\n\nSummarize: Project Overview, Tech Stack, Architecture, Coding Patterns, Build/Test/Deploy, Docs Summary, Notable Details. Cap at 3000 words.";
                }
            }

            // Execute the CLI session
            var options = new VirtualDevTeam.Core.AI.CopilotCliRequestOptions
            {
                Pool = VirtualDevTeam.Core.AI.CopilotCliPool.Agentic,
                AllowAll = true,
                CloseStdinAfterPrompt = true,
                WorkingDirectory = workingDirectory ?? Path.Combine(
                    Config.Value.Workspace?.RootPath ?? Path.Combine(AppContext.BaseDirectory, ".agents"),
                    ".wizard"),
                WatchdogMode = VirtualDevTeam.Core.AI.CopilotCliWatchdogMode.Agentic,
            };
            Directory.CreateDirectory(options.WorkingDirectory);

            var result = await cliManager.ExecuteAgenticSessionAsync(prompt, options, _contextGatherCts.Token);

            if (result.Succeeded && !string.IsNullOrWhiteSpace(result.LogBuffer))
            {
                var textOutput = VirtualDevTeam.Core.AI.CliOutputParser.ParseJsonOutput(result.LogBuffer) ?? result.LogBuffer;

                // Truncate if excessively long (>15K chars ≈ ~4K tokens)
                if (textOutput.Length > 15000)
                    textOutput = textOutput[..15000] + "\n\n(truncated)";

                _settings.ExistingProjectContext = textOutput;
                _settings.ExistingProjectContextGatheredAt = DateTime.UtcNow;

                // Store HEAD SHA for staleness detection (local projects only)
                if (isLocalProject && !string.IsNullOrWhiteSpace(_settings.ExistingRepoPath))
                {
                    var shaResult = await RunGitQuickAsync(_settings.ExistingRepoPath, "rev-parse HEAD");
                    if (shaResult.success)
                        _settings.ExistingProjectContextCommitSha = shaResult.output.Trim();
                }

                await SettingsService.SaveAsync(_settings);
                _contextGatherStatus = "✅ Project context gathered";
                Logger.LogInformation("Wizard: Project context gathered ({Len} chars)", textOutput.Length);
            }
            else
            {
                _contextGatherStatus = "⚠ Could not gather project context — proceeding without it.";
                Logger.LogWarning("Wizard: Context gathering CLI failed: {Error}", result.ErrorMessage);
            }
        }
        catch (OperationCanceledException)
        {
            _contextGatherStatus = "⚠ Context gathering cancelled.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Wizard: Context gathering failed");
            _contextGatherStatus = "⚠ Context gathering failed — proceeding without it.";
        }
        finally
        {
            _contextGathering = false;
            _contextGatherCts?.Dispose();
            _contextGatherCts = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Pre-reads key files from the remote repository via REST API (GitHub or ADO).
    /// Returns (fileContents, directoryTree) — missing files are silently skipped.
    /// </summary>
    private async Task<(string? fileContents, string? directoryTree)> ReadRemoteRepoFilesAsync()
    {
        // Predefined list of high-value files to read
        var filesToRead = new[]
        {
            "README.md", "readme.md",
            ".github/copilot-instructions.md", ".copilot-instructions.md",
            "CONTRIBUTING.md", "ARCHITECTURE.md", "AGENTS.md", "CLAUDE.md",
            "package.json", "tsconfig.json",
            "pyproject.toml", "requirements.txt",
            "go.mod", "Cargo.toml",
            "Gemfile", "composer.json",
            ".editorconfig",
        };

        // Also look for .sln / .csproj but those need tree listing first
        var fetchedFiles = new Dictionary<string, string>();
        string? treeOutput = null;

        try
        {
            string? token = await ResolveCurrentAuthTokenAsync();
            if (string.IsNullOrWhiteSpace(token)) return (null, null);

            using var http = new HttpClient();
            http.DefaultRequestHeaders.UserAgent.ParseAdd("VirtualDevTeam/1.0");

            if (_settings.Platform == PlatformGitHub)
            {
                var repo = _settings.GitHub?.Repo;
                if (string.IsNullOrWhiteSpace(repo)) return (null, null);

                http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                http.DefaultRequestHeaders.Accept.ParseAdd("application/vnd.github+json");

                // Fetch tree listing for structure overview
                try
                {
                    var treeResp = await http.GetAsync($"https://api.github.com/repos/{repo}/git/trees/HEAD?recursive=1");
                    if (treeResp.IsSuccessStatusCode)
                    {
                        var treeJson = await treeResp.Content.ReadAsStringAsync();
                        var treeDoc = System.Text.Json.JsonDocument.Parse(treeJson);
                        var paths = treeDoc.RootElement.GetProperty("tree").EnumerateArray()
                            .Where(n => n.GetProperty("type").GetString() is "blob" or "tree")
                            .Select(n => $"{(n.GetProperty("type").GetString() == "tree" ? "📁" : "📄")} {n.GetProperty("path").GetString()}")
                            .Take(200); // cap at 200 entries
                        treeOutput = string.Join("\n", paths);

                        // Also check for .sln, .csproj, Directory.Build.props in tree
                        foreach (var node in treeDoc.RootElement.GetProperty("tree").EnumerateArray())
                        {
                            var path = node.GetProperty("path").GetString();
                            if (path is null) continue;
                            if (path.EndsWith(".sln") || path.EndsWith(".csproj") ||
                                path.Equals("Directory.Build.props", StringComparison.OrdinalIgnoreCase) ||
                                path.Equals("global.json", StringComparison.OrdinalIgnoreCase) ||
                                path.Contains("azure-pipelines", StringComparison.OrdinalIgnoreCase))
                            {
                                if (!filesToRead.Contains(path))
                                    filesToRead = [..filesToRead, path];
                            }
                        }
                    }
                }
                catch (Exception ex) { Logger.LogDebug(ex, "Tree listing failed for {Repo}", repo); }

                // Fetch individual files
                foreach (var filePath in filesToRead)
                {
                    try
                    {
                        var fileResp = await http.GetAsync($"https://api.github.com/repos/{repo}/contents/{filePath}");
                        if (!fileResp.IsSuccessStatusCode) continue;

                        var fileJson = await fileResp.Content.ReadAsStringAsync();
                        var fileDoc = System.Text.Json.JsonDocument.Parse(fileJson);
                        if (fileDoc.RootElement.TryGetProperty("content", out var contentProp))
                        {
                            var base64 = contentProp.GetString()?.Replace("\n", "");
                            if (!string.IsNullOrWhiteSpace(base64))
                            {
                                var decoded = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(base64));
                                // Cap individual files at 5K chars
                                if (decoded.Length > 5000) decoded = decoded[..5000] + "\n(truncated)";
                                fetchedFiles[filePath] = decoded;
                            }
                        }
                    }
                    catch { /* skip missing/failed files */ }
                }
            }
            else
            {
                // Azure DevOps
                var org = _settings.AzureDevOps?.Organization;
                var project = _settings.AzureDevOps?.Project;
                var repoName = _settings.AzureDevOps?.Repository;
                if (string.IsNullOrWhiteSpace(org) || string.IsNullOrWhiteSpace(project) || string.IsNullOrWhiteSpace(repoName))
                    return (null, null);

                http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                var baseUrl = $"https://dev.azure.com/{org}/{project}/_apis/git/repositories/{repoName}";

                // Fetch tree listing
                try
                {
                    var treeResp = await http.GetAsync($"{baseUrl}/items?recursionLevel=Full&api-version=7.0");
                    if (treeResp.IsSuccessStatusCode)
                    {
                        var treeJson = await treeResp.Content.ReadAsStringAsync();
                        var treeDoc = System.Text.Json.JsonDocument.Parse(treeJson);
                        if (treeDoc.RootElement.TryGetProperty("value", out var items))
                        {
                            var paths = items.EnumerateArray()
                                .Select(n =>
                                {
                                    var p = n.GetProperty("path").GetString() ?? "";
                                    var isFolder = n.TryGetProperty("isFolder", out var f) && f.GetBoolean();
                                    return $"{(isFolder ? "📁" : "📄")} {p}";
                                })
                                .Take(200);
                            treeOutput = string.Join("\n", paths);
                        }
                    }
                }
                catch (Exception ex) { Logger.LogDebug(ex, "Tree listing failed for ADO repo {Repo}", repoName); }

                // Fetch individual files
                foreach (var filePath in filesToRead)
                {
                    try
                    {
                        var fileResp = await http.GetAsync($"{baseUrl}/items?path=/{filePath}&api-version=7.0");
                        if (!fileResp.IsSuccessStatusCode) continue;

                        var content = await fileResp.Content.ReadAsStringAsync();
                        // ADO returns raw content directly for text files
                        if (content.Length > 5000) content = content[..5000] + "\n(truncated)";
                        if (!string.IsNullOrWhiteSpace(content))
                            fetchedFiles[filePath] = content;
                    }
                    catch { /* skip missing/failed files */ }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Remote repo file pre-fetch failed");
        }

        if (fetchedFiles.Count == 0 && string.IsNullOrWhiteSpace(treeOutput))
            return (null, null);

        // Format file contents for the prompt
        var sb = new System.Text.StringBuilder();
        foreach (var (path, content) in fetchedFiles)
        {
            sb.AppendLine($"--- {path} ---");
            sb.AppendLine(content);
            sb.AppendLine();
        }

        return (sb.ToString(), treeOutput);
    }

    /// <summary>Resolves a usable API token from the currently selected auth method.</summary>
    private async Task<string?> ResolveCurrentAuthTokenAsync()
    {
        switch (_settings.AuthMethod)
        {
            case "GhCli":
                try
                {
                    var psi = new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = "gh",
                        Arguments = "auth token",
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    };
                    using var process = System.Diagnostics.Process.Start(psi);
                    if (process is null) return null;
                    var token = await process.StandardOutput.ReadToEndAsync();
                    await process.WaitForExitAsync();
                    return process.ExitCode == 0 ? token.Trim() : null;
                }
                catch { return null; }

            case "Pat":
                // Use the PAT input from the form, or fall back to user-secrets
                if (!string.IsNullOrWhiteSpace(_patInput)) return _patInput.Trim();
                // Try reading from user-secrets via dotnet CLI
                try
                {
                    var secretKey = _settings.Platform == PlatformGitHub
                        ? "VirtualDevTeam:DevPlatform:GitHub:Pat"
                        : "VirtualDevTeam:DevPlatform:AzureDevOps:Pat";
                    var psi = new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = "dotnet",
                        Arguments = $"user-secrets list --project \"{Directory.GetCurrentDirectory()}\"",
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    };
                    using var process = System.Diagnostics.Process.Start(psi);
                    if (process is null) return null;
                    var output = await process.StandardOutput.ReadToEndAsync();
                    await process.WaitForExitAsync();
                    foreach (var line in output.Split('\n'))
                    {
                        if (line.Contains("GitHubToken") || line.Contains(secretKey))
                        {
                            var parts = line.Split('=', 2);
                            if (parts.Length == 2) return parts[1].Trim();
                        }
                    }
                }
                catch { }
                return null;

            case "AzureCliBearer":
                if (!string.IsNullOrWhiteSpace(_bearerInput)) return _bearerInput.Trim();
                return null;

            default:
                return null;
        }
    }

    private async Task VerifyPatAsync()
    {
        _patVerifying = true;
        _patVerified = null;
        _patError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_patInput) || _patInput.Length < 10)
            {
                _patVerified = false;
                _patError = "PAT appears too short. GitHub PATs start with 'ghp_', ADO PATs are 52+ characters.";
                return;
            }

            // Live verify: use the PAT to call the API and confirm identity
            using var http = new HttpClient();
            if (_settings.Platform == PlatformGitHub)
            {
                http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _patInput.Trim());
                http.DefaultRequestHeaders.UserAgent.ParseAdd("VirtualDevTeam/1.0");
                http.DefaultRequestHeaders.Accept.ParseAdd("application/vnd.github+json");
                var resp = await http.GetAsync("https://api.github.com/user");
                if (resp.IsSuccessStatusCode)
                {
                    _patVerified = true;
                }
                else
                {
                    _patVerified = false;
                    _patError = $"GitHub returned {(int)resp.StatusCode}. PAT may be invalid or expired.";
                }
            }
            else
            {
                var org = _settings.AzureDevOps?.Organization;
                if (string.IsNullOrWhiteSpace(org))
                {
                    _patVerified = false;
                    _patError = "Set the ADO organization first so we can verify the PAT.";
                    return;
                }
                var base64 = Convert.ToBase64String(System.Text.Encoding.ASCII.GetBytes($":{_patInput.Trim()}"));
                http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", base64);
                var resp = await http.GetAsync($"https://dev.azure.com/{org}/_apis/connectionData");
                if (resp.IsSuccessStatusCode)
                {
                    _patVerified = true;
                }
                else
                {
                    _patVerified = false;
                    _patError = $"ADO returned {(int)resp.StatusCode}. PAT may be invalid or expired.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "PAT verification failed");
            _patVerified = false;
            _patError = ex.Message;
        }
        finally
        {
            _patVerifying = false;
        }
    }

    private async Task VerifyGhCliAsync()
    {
        _ghCliVerifying = true;
        _ghCliVerified = null;
        _ghCliError = null;
        _ghCliUser = null;
        try
        {
            // Run gh auth token to verify CLI is authenticated
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "gh",
                Arguments = "auth token",
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var process = System.Diagnostics.Process.Start(psi);
            if (process is null)
            {
                _ghCliVerified = false;
                _ghCliError = "Failed to start gh CLI. Is GitHub CLI installed?";
                return;
            }

            var token = await process.StandardOutput.ReadToEndAsync();
            var stderr = await process.StandardError.ReadToEndAsync();
            await process.WaitForExitAsync();

            if (process.ExitCode != 0 || string.IsNullOrWhiteSpace(token))
            {
                _ghCliVerified = false;
                _ghCliError = string.IsNullOrWhiteSpace(stderr)
                    ? "gh CLI is not authenticated. Run 'gh auth login' first."
                    : stderr.Trim();
                return;
            }

            // Get the authenticated username
            var userPsi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "gh",
                Arguments = "api user --jq .login",
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var userProcess = System.Diagnostics.Process.Start(userPsi);
            if (userProcess is not null)
            {
                var username = await userProcess.StandardOutput.ReadToEndAsync();
                await userProcess.WaitForExitAsync();
                if (userProcess.ExitCode == 0 && !string.IsNullOrWhiteSpace(username))
                    _ghCliUser = username.Trim();
            }

            _ghCliVerified = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "GitHub CLI verification failed");
            _ghCliVerified = false;
            _ghCliError = ex.Message;
        }
        finally
        {
            _ghCliVerifying = false;
        }
    }

    private void SwitchAuthMethod(string method)
    {
        _settings.AuthMethod = method;
        // Reset verification state when switching
        _patVerified = null;
        _patError = null;
        _bearerVerified = null;
        _bearerError = null;
        _bearerUser = null;
        _ghCliVerified = null;
        _ghCliError = null;
        _ghCliUser = null;
        // Switching auth invalidates any prior repo verification
        _repoVerified = null;
        _repoError = null;
    }

    private async Task VerifyBearerAsync()
    {
        _bearerVerifying = true;
        _bearerVerified = null;
        _bearerError = null;
        _bearerUser = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_bearerInput) || _bearerInput.Length < 100)
            {
                _bearerVerified = false;
                _bearerError = "Bearer token appears too short. ADO bearer tokens are typically 2000+ characters.";
                return;
            }

            // Live verification: call ADO connection data API with the bearer token
            var org = _settings.AzureDevOps.Organization;
            if (string.IsNullOrWhiteSpace(org))
            {
                _bearerVerified = false;
                _bearerError = "Set the ADO organization first so we can verify the token.";
                return;
            }

            using var http = new HttpClient();
            http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _bearerInput.Trim());
            var resp = await http.GetAsync($"https://dev.azure.com/{org}/_apis/connectionData");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                _bearerUser = json.GetProperty("authenticatedUser")
                    .GetProperty("providerDisplayName").GetString() ?? "Unknown";
                _bearerVerified = true;
            }
            else
            {
                _bearerVerified = false;
                _bearerError = $"ADO returned {(int)resp.StatusCode}. Token may be expired or invalid for org '{org}'.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Bearer token verification failed");
            _bearerVerified = false;
            _bearerError = ex.Message;
        }
        finally
        {
            _bearerVerifying = false;
        }
    }

    private async Task CreateRepoAsync()
    {
        _repoCreating = true;
        _repoCreated = false;
        _repoCreateError = null;
        try
