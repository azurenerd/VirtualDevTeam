                _repoCreated = true;
                _repoCreatedUrl = result.RepositoryUrl;
            }
            else
            {
                _repoCreateError = result.ErrorMessage ?? "Failed to create repository";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Repo creation failed");
            _repoCreateError = ex.Message;
        }
        finally
        {
            _repoCreating = false;
        }
    }

    // ── Step 0: Source work item search with debounce ──
    private void OnSourceWiSearchInput(ChangeEventArgs e)
    {
        _sourceWiQuery = e.Value?.ToString() ?? "";
        _sourceWiDebounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(_sourceWiQuery))
        {
            _sourceWiResults.Clear();
            _sourceWiError = null;
            return;
        }

        var query = _sourceWiQuery;
        _sourceWiDebounceTimer = new Timer(300);
        _sourceWiDebounceTimer.AutoReset = false;
        _sourceWiDebounceTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                await SearchSourceWorkItemsAsync(query);
                StateHasChanged();
            });
        };
        _sourceWiDebounceTimer.Start();
    }

    private async Task SearchSourceWorkItemsAsync(string query)
    {
        _sourceWiSearchCts?.Cancel();
        _sourceWiSearchCts = new CancellationTokenSource();
        var ct = _sourceWiSearchCts.Token;

        _sourceWiSearching = true;
        _sourceWiError = null;
        try
        {
            var results = await WorkItemSearch.SearchAsync(query, maxResults: 10, ct);
            if (!ct.IsCancellationRequested)
            {
                _sourceWiResults = results.ToList();
            }
        }
        catch (OperationCanceledException) { /* expected */ }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Source work item search failed for query: {Query}", query);
            _sourceWiError = "Search failed: " + ex.Message;
        }
        finally
        {
            _sourceWiSearching = false;
        }
    }

    private async Task SelectSourceWorkItem(WorkItemSearchResult item)
    {
        // Save manual draft before overwriting
        if (_selectedSourceWi is null)
            _manualDescriptionDraft = _settings.Description;

        // Re-fetch by ID to get the full body
        try
        {
            var fullResults = await WorkItemSearch.SearchAsync(item.Id.ToString(), maxResults: 1);
            if (fullResults.Count > 0)
                item = fullResults[0];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to fetch full body for work item {Id}", item.Id);
        }

        _selectedSourceWi = item;
        _settings.SourceWorkItemId = item.Id;
        _settings.Description = string.IsNullOrWhiteSpace(item.Body)
            ? item.Title
            : $"{item.Title}\n\n{item.Body}";
        _sourceWiResults.Clear();
        _sourceWiQuery = "";

        // Invalidate clarifying state since description changed
        InvalidateClarifyingState();
    }

    private void RemoveSourceWorkItem()
    {
        _selectedSourceWi = null;
        _settings.SourceWorkItemId = null;
        _settings.Description = _manualDescriptionDraft;
        _manualDescriptionDraft = "";

        // Invalidate clarifying state since description changed back
        InvalidateClarifyingState();
    }

    private void InvalidateClarifyingState()
    {
        _settings.ClarifyingAnswers.Clear();
        _settings.ClarifyingIterationCount = 0;
        _settings.ClarifyingSourceHash = null;
        _lastClarifyDescriptionHash = null;
    }

    private async Task LoadSourceWorkItemAsync(int id)
    {
