    protected override void OnParametersSet()
    {
        // Resolve URL slug to step number on navigation / refresh
        if (!string.IsNullOrEmpty(StepSlug))
        {
            var idx = Array.FindIndex(_stepSlugs, s => s.Equals(StepSlug, StringComparison.OrdinalIgnoreCase));
            if (idx >= 0)
                _currentStep = idx;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Push the current step slug into the URL bar on initial load
            var slug = _stepSlugs[_currentStep];
            await JS.InvokeVoidAsync("history.replaceState", null, "", $"/develop/{slug}");

            // Check if native folder picker is available (Chromium browsers)
            try
            {
                _folderPickerSupported = await JS.InvokeAsync<bool>("isFolderPickerSupported");
                StateHasChanged();
            }
            catch { _folderPickerSupported = false; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await SettingsService.LoadAsync();

            // Initialize gate preferences from existing config if not set
            if (_settings.GatePreferences is null)
            {
                _settings.GatePreferences = new GatePreferences();
                try
                {
                    var cfg = ConfigService.GetCurrentConfig();
                    _settings.GatePreferences.Enabled = cfg.HumanInteraction.Enabled;
                    foreach (var gate in GateIds.AllGates)
                    {
                        _settings.GatePreferences.Gates[gate.Id] = cfg.HumanInteraction.RequiresHuman(gate.Id);
                    }
                }
                catch { /* Use defaults if config unavailable */ }
            }
            _gatePreset = DetectGatePreset();

            // Detect first-run: no description and no repo configured
            _isFirstRun = string.IsNullOrWhiteSpace(_settings.Description)
                && string.IsNullOrWhiteSpace(_settings.Platform == "GitHub"
                    ? _settings.GitHub?.Repo
                    : _settings.AzureDevOps?.Repository);

            if (_settings.ParentWorkItemId.HasValue)
            {
                _ = LoadLinkedWorkItemAsync(_settings.ParentWorkItemId.Value);
            }

            if (_settings.SourceWorkItemId.HasValue)
            {
                _ = LoadSourceWorkItemAsync(_settings.SourceWorkItemId.Value);
            }

            // Check if a PAT or Bearer token is already configured via User Secrets / runtime config
            try
            {
                var config = ConfigService.GetCurrentConfig();
                _hasUserSecretsPat = _settings.Platform switch
                {
                    "AzureDevOps" => !string.IsNullOrWhiteSpace(config.DevPlatform?.AzureDevOps?.Pat),
                    "GitHub" => !string.IsNullOrWhiteSpace(config.Project?.GitHubToken),
                    _ => false
                };
                _hasUserSecretsBearer = _settings.Platform == "AzureDevOps"
                    && !string.IsNullOrWhiteSpace(config.DevPlatform?.AzureDevOps?.BearerToken);

                // Image-gen API key — read via raw IConfiguration since this isn't a strong-typed field
                var rawCfg = ServiceProvider.GetService<IConfiguration>();
                _hasUserSecretsImageApiKey = !string.IsNullOrWhiteSpace(rawCfg?["VirtualDevTeam:AzureOpenAI:ImageApiKey"]);
            }
            catch
            {
                _hasUserSecretsPat = false;
                _hasUserSecretsBearer = false;
                _hasUserSecretsImageApiKey = false;
            }

            // Initialize the image-gen fallbacks textarea from the loaded settings
            _imgGenFallbacksText = string.Join("\n",
                _settings.AzureOpenAIImage.FallbackDeployments?.Where(d => !string.IsNullOrWhiteSpace(d))
                    ?? Enumerable.Empty<string>());

            // Restore auth validation state from static cache (survives step navigation + circuit reconnects)
            RestoreAuthValidationCache();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load develop settings");
            _globalError = "Failed to load settings: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }

        // Check for existing paused or running run
        try
        {
            var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
            if (coordinator?.ActiveRun is { Status: VirtualDevTeam.Core.Configuration.RunStatus.Paused } pausedRun)
            {
                _pausedRunId = pausedRun.RunId[..Math.Min(8, pausedRun.RunId.Length)];
                _pausedRunRepo = pausedRun.Repo;
            }
            else if (coordinator?.ActiveRun is { Status: VirtualDevTeam.Core.Configuration.RunStatus.Running or VirtualDevTeam.Core.Configuration.RunStatus.NotStarted } runningRun)
            {
                _runningRunId = runningRun.RunId[..Math.Min(8, runningRun.RunId.Length)];
                _runningRunRepo = runningRun.Repo;
            }
        }
        catch { /* coordinator may not be registered */ }
    }

    private bool IsGateEnabled(string gateId)
    {
        _settings.GatePreferences ??= new GatePreferences();
        return _settings.GatePreferences.Gates.TryGetValue(gateId, out var enabled) ? enabled : false;
    }

    private void ToggleGate(string gateId, bool enabled)
    {
        _settings.GatePreferences ??= new GatePreferences();
        _settings.GatePreferences.Gates[gateId] = enabled;
        _settings.GatePreferences.Enabled = _settings.GatePreferences.Gates.Values.Any(v => v);
        _gatePreset = DetectGatePreset();
    }

    private void ApplyGatePreset(string preset)
    {
        _settings.GatePreferences ??= new GatePreferences();
        var allIds = GateIds.AllGates.Select(g => g.Id).ToList();

        switch (preset)
        {
            case "auto":
                foreach (var id in allIds) _settings.GatePreferences.Gates[id] = false;
                _settings.GatePreferences.Enabled = false;
                break;
            case "supervised":
                var supervisedGates = new HashSet<string> {
                    GateIds.PMSpecification, GateIds.ArchitectureDesign, GateIds.SmeAgentSpawn,
                    GateIds.FinalPRApproval, GateIds.EngineeringPlan, GateIds.ReworkExhaustion,
                    GateIds.SourceBugEscalation
                };
                foreach (var id in allIds) _settings.GatePreferences.Gates[id] = supervisedGates.Contains(id);
                _settings.GatePreferences.Enabled = true;
                break;
            case "full":
                foreach (var id in allIds) _settings.GatePreferences.Gates[id] = true;
                _settings.GatePreferences.Enabled = true;
                break;
        }
        _gatePreset = preset;
    }

    private string DetectGatePreset()
    {
        if (_settings.GatePreferences is null) return "";
        var gates = _settings.GatePreferences.Gates;
        if (gates.Count == 0) return "";
        if (gates.Values.All(v => !v)) return "auto";
        if (gates.Values.All(v => v)) return "full";
        return "";
    }

    private async Task GoToStep(int step)
    {
        if (step >= 0 && step <= 6)
        {
            var previous = _currentStep;
            _currentStep = step;

            // Persist settings on every step transition so edits survive refresh/reconnect
            try { await SettingsService.SaveAsync(_settings); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to auto-save settings on step transition"); }

            // Cache auth validation state so green indicators survive navigation + reconnects
            SaveAuthValidationCache();

            // Update browser URL to reflect current step (enables refresh-resilience).
            // Use JS interop to replace URL without triggering Blazor navigation/re-render.
            var slug = _stepSlugs[step];
            _ = JS.InvokeVoidAsync("history.replaceState", null, "", $"/develop/{slug}");

            // Trigger question generation when entering Clarify step
            if (step == 2 && previous != 2)
            {
                // Check if description changed since last generation
                var hash = ComputeDescriptionHash();
                if (!string.IsNullOrEmpty(_settings.ClarifyingSourceHash) && _settings.ClarifyingSourceHash != hash)
                {
                    // Description changed — invalidate all clarifying state
                    _settings.ClarifyingAnswers.Clear();
                    _settings.ClarifyingIterationCount = 0;
                    _settings.ClarifyingSourceHash = null;
                    _lastClarifyDescriptionHash = null;
                    _askMoreMessage = null;
                }
                _ = TryGenerateClarifyingQuestionsAsync();
            }
        }
    }

    private async Task JumpToStep(int step)
    {
        if (step <= _currentStep || CanAdvanceToStep(step))
            await GoToStep(step);
    }

    private bool CanAdvance()
    {
        return _currentStep switch
        {
            0 => true,  // Repo & Auth — always advanceable (can configure later)
            1 => true,  // What to Build — always advanceable (description validated at start time)
            2 => true,  // Clarify — always advanceable (optional)
            3 => true,  // Scenarios — always advanceable (operator can skip)
            4 => true,  // Human Gates — always advanceable
            5 => true,
            _ => false
        };
    }

    private string GetAdvanceBlockedReason()
    {
        if (CanAdvance()) return $"Go to {(_currentStep + 1 < _stepLabels.Length ? _stepLabels[_currentStep + 1] : "next step")}";
        return _currentStep switch
        {
            1 => "Enter a project description before continuing",
            _ => "Complete this step before continuing"
        };
    }

    private bool CanAdvanceToStep(int target)
    {
        for (int i = 0; i < target; i++)
        {
            if (i == 1 && string.IsNullOrWhiteSpace(_settings.Description))
                return false;
        }
        return true;
    }

    // ─── Auth Validation Cache ──────────────────────────────────────────────

    private string GetCurrentRepoKey() => _settings.Platform == PlatformGitHub
        ? _settings.GitHub.Repo
        : $"{_settings.AzureDevOps.Organization}/{_settings.AzureDevOps.Project}/{_settings.AzureDevOps.Repository}";

    private void SaveAuthValidationCache()
    {
        _cachedAuth = new AuthValidationCache
        {
            PatVerified = _patVerified,
            PatError = _patError,
            GhCliVerified = _ghCliVerified,
            GhCliError = _ghCliError,
            GhCliUser = _ghCliUser,
            BearerVerified = _bearerVerified,
            BearerError = _bearerError,
            BearerUser = _bearerUser,
            RepoVerified = _repoVerified,
            RepoError = _repoError,
            RepoCreated = _repoCreated,
            RepoCreatedUrl = _repoCreatedUrl,
            InPlaceVerified = _inPlaceVerified,
            InPlaceError = _inPlaceError,
            InPlaceBranch = _inPlaceBranch,
            InPlaceFileCount = _inPlaceFileCount,
            Platform = _settings.Platform,
            AuthMethod = _settings.AuthMethod,
            RepoKey = GetCurrentRepoKey()
        };
    }

    private void RestoreAuthValidationCache()
    {
        if (_cachedAuth is null) return;

        // Only restore if platform, auth method, and repo haven't changed
        if (_cachedAuth.Platform != _settings.Platform ||
            _cachedAuth.AuthMethod != _settings.AuthMethod ||
            _cachedAuth.RepoKey != GetCurrentRepoKey())
        {
            _cachedAuth = null;
            return;
        }

        _patVerified = _cachedAuth.PatVerified;
        _patError = _cachedAuth.PatError;
        _ghCliVerified = _cachedAuth.GhCliVerified;
        _ghCliError = _cachedAuth.GhCliError;
        _ghCliUser = _cachedAuth.GhCliUser;
        _bearerVerified = _cachedAuth.BearerVerified;
        _bearerError = _cachedAuth.BearerError;
        _bearerUser = _cachedAuth.BearerUser;
        _repoVerified = _cachedAuth.RepoVerified;
        _repoError = _cachedAuth.RepoError;
        _repoCreated = _cachedAuth.RepoCreated;
        _repoCreatedUrl = _cachedAuth.RepoCreatedUrl;
        _inPlaceVerified = _cachedAuth.InPlaceVerified;
        _inPlaceError = _cachedAuth.InPlaceError;
        _inPlaceBranch = _cachedAuth.InPlaceBranch;
        _inPlaceFileCount = _cachedAuth.InPlaceFileCount;
    }

    // ─── Clarifying Questions ───────────────────────────────────────────────

    private sealed record WizardActivityEvent(DateTime Timestamp, FrameworkActivityEvent Activity);

    private (long RunId, CancellationTokenSource Cts, IProgress<FrameworkActivityEvent> Sink) StartClarifyActivityStream()
    {
        _clarifyActivityCts?.Cancel();

        var cts = new CancellationTokenSource();
        var runId = Interlocked.Increment(ref _clarifyActivityRunId);
        _clarifyActivityCts = cts;
        _clarifyActivityEvents.Clear();
        _showActivityStream = true;
        _lastActivityRenderUtc = DateTime.MinValue;

        var sink = new Progress<FrameworkActivityEvent>(evt => OnClarifyActivity(runId, cts.Token, evt));
        return (runId, cts, sink);
    }

    private void OnClarifyActivity(long runId, CancellationToken ct, FrameworkActivityEvent evt)
    {
        if (ct.IsCancellationRequested || runId != _clarifyActivityRunId)
            return;

        _clarifyActivityEvents.Add(new WizardActivityEvent(DateTime.UtcNow, evt));
        if (_clarifyActivityEvents.Count > 200)
        {
            _clarifyActivityEvents.RemoveRange(0, _clarifyActivityEvents.Count - 200);
        }

        var now = DateTime.UtcNow;
        if ((now - _lastActivityRenderUtc).TotalMilliseconds < 100)
            return;

        _lastActivityRenderUtc = now;
        _ = InvokeAsync(StateHasChanged);
    }

    private void FinishClarifyActivityStream(long runId, CancellationTokenSource cts)
    {
        if (runId == _clarifyActivityRunId)
        {
            _showActivityStream = false;
        }

        if (ReferenceEquals(_clarifyActivityCts, cts))
        {
            _clarifyActivityCts = null;
        }

        cts.Cancel();
        cts.Dispose();
    }

    private string GetClarifyActivityColor(FrameworkActivityEvent evt) => evt.Category switch
    {
        "intent" => "#00b0ff",
        "complete" => "#00e676",
        "error" => "#ff5252",
        "assistant" => "#ce93d8",
        "reasoning" => "#ce93d8",
        "warning" => "#ffd54f",
        _ => "var(--text-secondary)"
    };

    private string FormatClarifyActivity(FrameworkActivityEvent evt) => evt.Category switch
    {
        "intent" => $"🔧 {Truncate(evt.Message, 100)}",
        "complete" => $"✅ {Truncate(evt.Message, 120)}",
        "assistant" => $"💬 {Truncate(evt.Message, 120)}",
        "reasoning" => $"💬 {Truncate(evt.Message, 120)}",
        "error" => $"❌ {Truncate(evt.Message, 120)}",
        "warning" => $"⚠️ {Truncate(evt.Message, 120)}",
        _ => $"[{evt.Category}] {Truncate(evt.Message, 100)}"
    };

    private static string Truncate(string? value, int max)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        return value.Length <= max ? value : value[..max] + "…";
    }

    private string ComputeDescriptionHash()
    {
        // Hash includes description + tech stack. SourceWorkItemId excluded to maintain
        // backward compatibility with hashes saved before this field was added.
        var text = $"{_settings.Description?.Trim()}|{_settings.TechStack?.Trim()}";
        return Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(text)))[..16];
    }

    private async Task TryGenerateClarifyingQuestionsAsync(bool force = false)
    {
        if (string.IsNullOrWhiteSpace(_settings.Description))
            return;

        Logger.LogInformation("Wizard: TryGenerateClarifyingQuestionsAsync called (force={Force}, answersCount={Count}, descLength={Len})",
            force, _settings.ClarifyingAnswers.Count, _settings.Description?.Length ?? 0);

        var hash = ComputeDescriptionHash();
        // Skip if already generated: answers exist AND the hash matches (either in-memory
        // or persisted). If the persisted hash is missing (stale answers from a prior run
        // that survived a reset), we MUST regenerate — we can't prove they match the
        // current description.
        if (!force && _settings.ClarifyingAnswers.Count > 0)
        {
            if (_lastClarifyDescriptionHash == hash)
            {
                Logger.LogInformation("Wizard: Skipping — in-memory cache hit (hash={Hash})", hash);
                return; // in-memory cache hit
            }
            if (!string.IsNullOrEmpty(_settings.ClarifyingSourceHash) && _settings.ClarifyingSourceHash == hash)
            {
                _lastClarifyDescriptionHash = hash;
                Logger.LogInformation("Wizard: Skipping — persisted hash matches (hash={Hash})", hash);
                return; // persisted answers match current description
            }
        }

        Logger.LogInformation("Wizard: Starting question generation (hash={Hash}, force={Force})", hash, force);

        var (activityRunId, activityCts, activitySink) = StartClarifyActivityStream();

        _initialClarifyLoading = true;
        _clarifyError = null;
        _askMoreMessage = null;
        StateHasChanged();

        try
        {
            var cliManager = ServiceProvider.GetService<VirtualDevTeam.Core.AI.CopilotCliProcessManager>();
            if (cliManager is null || !cliManager.IsAvailable)
            {
                Logger.LogWarning("Wizard: CLI not available (manager={ManagerNull}, available={Available})",
                    cliManager is null, cliManager?.IsAvailable);
                _clarifyError = "Copilot CLI is not available. You can skip this step.";
                return;
            }

            var techContext = string.IsNullOrWhiteSpace(_settings.TechStack)
                ? ""
                : $"\n\nSpecified tech stack: {_settings.TechStack}";

            // Try loading from external template file (editable without recompilation)
            string prompt;
            var promptService = ServiceProvider.GetService<VirtualDevTeam.Core.Prompts.IPromptTemplateService>();
            if (promptService is not null)
            {
                var vars = new Dictionary<string, string>
                {
                    ["description"] = _settings.Description ?? "",
                    ["techContext"] = techContext,
                    ["existing_project_context"] = _settings.ExistingProjectContext ?? ""
                };
                var rendered = await promptService.RenderAsync("wizard/clarifying-questions", vars);
                prompt = !string.IsNullOrWhiteSpace(rendered) ? rendered : BuildClarifyPromptFallback(techContext);
                Logger.LogInformation("Wizard: Prompt built ({Source}, {Len} chars)",
                    !string.IsNullOrWhiteSpace(rendered) ? "template" : "fallback", prompt.Length);
            }
            else
            {
                prompt = BuildClarifyPromptFallback(techContext);
                Logger.LogInformation("Wizard: Prompt built (fallback, {Len} chars)", prompt.Length);
            }

            Logger.LogInformation("Wizard: Calling ExecutePromptAsync (activitySink={HasSink})...", activitySink is not null);
            // Pass the local project path so the CLI explores the target project, not VDT
            var localProjectDir = !_settings.CreateNewRepo ? _settings.ExistingRepoPath : null;
            var result = await ExecuteWizardCliPromptAsync(cliManager, prompt, activityCts.Token, activitySink, localProjectDir);
            Logger.LogInformation("Wizard: CLI returned (success={Success}, outputLen={Len})",
                result.IsSuccess, result.Output?.Length ?? 0);

            if (!result.IsSuccess || string.IsNullOrWhiteSpace(result.Output))
            {
                Logger.LogWarning("Wizard: CLI failed or empty output. Output: {Output}", result.Output?.Substring(0, Math.Min(200, result.Output?.Length ?? 0)));
                _clarifyError = "Failed to generate questions. You can skip this step.";
                return;
            }

            // CLI may return JSONL when JsonOutput is enabled — extract text content first
            var textOutput = VirtualDevTeam.Core.AI.CliOutputParser.ParseJsonOutput(result.Output) ?? result.Output;
            Logger.LogInformation("Wizard: Parsing questions (textLen={TextLen}, rawLen={RawLen})",
                textOutput?.Length ?? 0, result.Output?.Length ?? 0);

            var questions = ParseNumberedQuestions(textOutput);
            if (questions.Count == 0)
            {
                // Fallback: try parsing the raw output in case JSONL parsing stripped content
                questions = ParseNumberedQuestions(result.Output);
                Logger.LogInformation("Wizard: Fallback parsing found {Count} questions", questions.Count);
            }
            if (questions.Count == 0)
            {
                Logger.LogWarning("Wizard: Zero questions parsed. TextOutput preview: {Preview}",
                    textOutput?.Substring(0, Math.Min(200, textOutput?.Length ?? 0)));
                _clarifyError = "No clarifying questions needed — your description is clear! You can proceed.";
                return;
            }

            Logger.LogInformation("Wizard: Generated {Count} clarifying questions successfully", questions.Count);

            // Preserve existing answers if questions match (for non-force regenerations)
            var oldAnswers = _settings.ClarifyingAnswers.ToDictionary(qa => qa.Question, qa => qa.Answer);
            _settings.ClarifyingAnswers = questions.Select(q => new ClarifyingQA
            {
                Question = q.Question,
                ProposedAnswer = q.ProposedAnswer,
                // Pre-fill answer with AI proposal; user can edit or clear it
                Answer = oldAnswers.TryGetValue(q.Question, out var existing) ? existing : q.ProposedAnswer,
                Iteration = 1
            }).ToList();

            _lastClarifyDescriptionHash = hash;
            _settings.ClarifyingSourceHash = hash;
            _settings.ClarifyingIterationCount = 0; // Initial generation = iteration 0
            await SettingsService.SaveAsync(_settings);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to generate clarifying questions");
            _clarifyError = "An error occurred generating questions. You can skip this step.";
        }
        finally
        {
            FinishClarifyActivityStream(activityRunId, activityCts);
            _initialClarifyLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Runs a Copilot CLI prompt from the Develop wizard with a safe scratch CWD.
    /// The wizard runs pre-project (no agent workspace exists yet) and
    /// <see cref="VirtualDevTeam.Core.AI.CopilotCliProcessManager"/> intentionally
    /// refuses to spawn without an explicit working directory — see the
    /// <c>ValidateWorkingDirectoryCore</c> safeguard added after the 2026-05-11
    /// source-tree-leak incident. We provide a stable wizard-scratch directory
    /// under the configured workspace root.
    /// </summary>
    private async Task<VirtualDevTeam.Core.AI.CopilotCliResult> ExecuteWizardCliPromptAsync(
        VirtualDevTeam.Core.AI.CopilotCliProcessManager cliManager,
        string prompt,
        CancellationToken ct,
        IProgress<FrameworkActivityEvent>? activitySink = null,
        string? projectDir = null)
    {
        // When a local project path is available, use it as the CWD so the CLI agent
        // explores the TARGET project — not VDT's own source tree.
        string workingDir;
        if (!string.IsNullOrWhiteSpace(projectDir) && Directory.Exists(projectDir))
        {
            workingDir = projectDir;
        }
        else
        {
            var workspaceRoot = Config.Value.Workspace?.RootPath;
            if (string.IsNullOrWhiteSpace(workspaceRoot))
            {
                workspaceRoot = Path.Combine(AppContext.BaseDirectory, ".agents");
            }
            workingDir = Path.Combine(workspaceRoot, ".wizard");
            Directory.CreateDirectory(workingDir);
        }

        // Use agentic mode with --allow-all so the agent can use MCP tools to read documents.
        // The prompt template enforces READ-ONLY mode (no file creation/modification).
        var options = new VirtualDevTeam.Core.AI.CopilotCliRequestOptions
        {
            Pool = VirtualDevTeam.Core.AI.CopilotCliPool.Agentic,
            AllowAll = true,
            CloseStdinAfterPrompt = true,
            WorkingDirectory = workingDir,
            WatchdogMode = VirtualDevTeam.Core.AI.CopilotCliWatchdogMode.Agentic,
            ActivitySink = activitySink,
        };

        try
        {
            var result = await cliManager.ExecuteAgenticSessionAsync(prompt, options, ct);

            if (result.Succeeded)
                return VirtualDevTeam.Core.AI.CopilotCliResult.Success(result.LogBuffer ?? "", 0);
            else
                return VirtualDevTeam.Core.AI.CopilotCliResult.Failure(result.ErrorMessage ?? "Agentic session failed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Wizard TRACE: ExecuteAgenticSessionAsync threw");
            return VirtualDevTeam.Core.AI.CopilotCliResult.Failure($"Exception: {ex.Message}");
        }
    }

    private async Task AskMoreQuestionsAsync()
    {
        if (_askMoreLoading) return;
        if (string.IsNullOrWhiteSpace(_settings.Description)) return;

        var maxIterations = Config.Value.Limits.MaxWizardQuestionIterations;
        if (_settings.ClarifyingIterationCount >= maxIterations) return;
        if (_settings.ClarifyingAnswers.Count >= 30) return;

        var (activityRunId, activityCts, activitySink) = StartClarifyActivityStream();

        _askMoreLoading = true;
        _askMoreMessage = null;
        StateHasChanged();

        try
        {
            var cliManager = ServiceProvider.GetService<VirtualDevTeam.Core.AI.CopilotCliProcessManager>();
            if (cliManager is null || !cliManager.IsAvailable)
            {
                _askMoreMessage = "⚠ Copilot CLI is not available.";
                return;
            }

            var techContext = string.IsNullOrWhiteSpace(_settings.TechStack)
                ? ""
                : $"\n\nSpecified tech stack: {_settings.TechStack}";

            // Build existing questions list for exclusion
            var existingQuestionsList = string.Join("\n",
                _settings.ClarifyingAnswers.Select((qa, i) => $"{i + 1}. {qa.Question}"));

            // Try loading the "ask more" template
            string prompt;
            var promptService = ServiceProvider.GetService<VirtualDevTeam.Core.Prompts.IPromptTemplateService>();
            if (promptService is not null)
            {
                var vars = new Dictionary<string, string>
                {
                    ["description"] = _settings.Description ?? "",
                    ["techContext"] = techContext,
                    ["existingQuestions"] = existingQuestionsList,
                    ["existing_project_context"] = _settings.ExistingProjectContext ?? ""
                };
                var rendered = await promptService.RenderAsync("wizard/clarifying-questions-more", vars);
                prompt = !string.IsNullOrWhiteSpace(rendered)
                    ? rendered
                    : BuildAskMorePromptFallback(techContext, existingQuestionsList);
            }
            else
            {
                prompt = BuildAskMorePromptFallback(techContext, existingQuestionsList);
            }

            var localDir = !_settings.CreateNewRepo ? _settings.ExistingRepoPath : null;
            var result = await ExecuteWizardCliPromptAsync(cliManager, prompt, activityCts.Token, activitySink, localDir);
            if (!result.IsSuccess || string.IsNullOrWhiteSpace(result.Output))
            {
                _askMoreMessage = "⚠ Failed to generate additional questions.";
                return;
            }

            var textOutput = VirtualDevTeam.Core.AI.CliOutputParser.ParseJsonOutput(result.Output) ?? result.Output;
            var newQuestions = ParseNumberedQuestions(textOutput);
            if (newQuestions.Count == 0)
            {
                newQuestions = ParseNumberedQuestions(result.Output);
            }

            // Deduplicate against existing questions
            var existingNormalized = _settings.ClarifyingAnswers
                .Select(qa => NormalizeForDedup(qa.Question))
                .ToHashSet();

            var uniqueQuestions = new List<(string Question, string? ProposedAnswer)>();
            foreach (var q in newQuestions)
            {
                var norm = NormalizeForDedup(q.Question);
                if (existingNormalized.Contains(norm))
                    continue;
                if (HasHighTokenOverlap(norm, existingNormalized))
                    continue;
                uniqueQuestions.Add(q);
                existingNormalized.Add(norm); // Prevent dupes within the new batch too
            }

            // Enforce hard cap of 30 total questions
            var remaining = 30 - _settings.ClarifyingAnswers.Count;
            uniqueQuestions = uniqueQuestions.Take(remaining).ToList();

            if (uniqueQuestions.Count == 0)
            {
                _askMoreMessage = "💡 No additional unique questions could be generated. Your project description may be well-covered!";
                return;
            }

            var newIteration = _settings.ClarifyingIterationCount + 1;
            var newQAs = uniqueQuestions.Select(q => new ClarifyingQA
            {
                Question = q.Question,
                ProposedAnswer = q.ProposedAnswer,
                Answer = q.ProposedAnswer, // Pre-fill with AI proposal
                Iteration = newIteration + 1 // Round number (1-based: initial=1, first ask-more=2, etc.)
            }).ToList();

            _settings.ClarifyingAnswers.AddRange(newQAs);
            _settings.ClarifyingIterationCount = newIteration;
            _askMoreMessage = $"✅ Added {uniqueQuestions.Count} new question{(uniqueQuestions.Count != 1 ? "s" : "")}";
            await SettingsService.SaveAsync(_settings);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to generate additional clarifying questions");
            _askMoreMessage = "⚠ An error occurred generating additional questions.";
        }
        finally
        {
            FinishClarifyActivityStream(activityRunId, activityCts);
            _askMoreLoading = false;
            StateHasChanged();
        }
    }

    private async Task RegenerateQuestionsAsync()
    {
        var questionCount = _settings.ClarifyingAnswers.Count;
        var answeredCount = _settings.ClarifyingAnswers.Count(qa => !string.IsNullOrWhiteSpace(qa.Answer));

        if (questionCount > 0)
        {
            var message = answeredCount > 0
                ? $"This will remove all {questionCount} existing questions (including {answeredCount} with answers) and generate new ones. Are you sure?"
                : $"This will remove all {questionCount} existing questions and generate new ones. Are you sure?";

            var confirmed = await JS.InvokeAsync<bool>("confirm", message);
            if (!confirmed) return;
        }

        _settings.ClarifyingAnswers.Clear();
        _settings.ClarifyingIterationCount = 0;
        _settings.ClarifyingSourceHash = null;
        _lastClarifyDescriptionHash = null;
        _askMoreMessage = null;
        await TryGenerateClarifyingQuestionsAsync(force: true);
    }

    private async Task ClearAllQuestions()
    {
        if (_settings.ClarifyingAnswers.Count == 0) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Remove all {_settings.ClarifyingAnswers.Count} questions? This cannot be undone.");
        if (!confirmed) return;

        _settings.ClarifyingAnswers.Clear();
        _settings.ClarifyingIterationCount = 0;
        _settings.ClarifyingSourceHash = null;
        _lastClarifyDescriptionHash = null;
        _askMoreMessage = null;
        await SettingsService.SaveAsync(_settings);
        StateHasChanged();
    }

    private void CancelDeepResearch()
    {
        _deepResearchCts?.Cancel();
        _deepResearchRunning = false;
        _deepResearchInProgress.Clear();
        // _deepResearchComplete preserved so partial results stay visible
        StateHasChanged();
    }

    private async Task DeepResearchAnswersAsync()
    {
        if (_deepResearchRunning || _settings.ClarifyingAnswers.Count == 0) return;
        if (string.IsNullOrWhiteSpace(_settings.ExistingRepoPath)) return;

        var cliManager = ServiceProvider.GetService<VirtualDevTeam.Core.AI.CopilotCliProcessManager>();
        if (cliManager is null || !cliManager.IsAvailable)
        {
            _askMoreMessage = "⚠ Copilot CLI not available for deep research.";
            return;
        }

        _deepResearchRunning = true;
        _deepResearchInProgress.Clear();
        _deepResearchComplete.Clear();
        _deepResearchCts?.Dispose();
        _deepResearchCts = new CancellationTokenSource();
        var ct = _deepResearchCts.Token;
        StateHasChanged();

        try
        {
            // Launch parallel sub-agents — one per question
            var tasks = new List<Task>();
            for (int i = 0; i < _settings.ClarifyingAnswers.Count; i++)
            {
                var idx = i;
                var qa = _settings.ClarifyingAnswers[idx];
                _deepResearchInProgress.Add(idx);

                tasks.Add(Task.Run(async () =>
                {
                    try
                    {
                        ct.ThrowIfCancellationRequested();

                        var projectContext = _settings.ExistingProjectContext ?? "";
                        var promptService = ServiceProvider.GetService<VirtualDevTeam.Core.Prompts.IPromptTemplateService>();
                        string prompt;

                        if (promptService is not null)
                        {
                            var vars = new Dictionary<string, string>
                            {
                                ["question"] = qa.Question,
                                ["proposed_answer"] = qa.Answer ?? "(none)",
                                ["project_description"] = _settings.Description ?? "",
                                ["existing_project_context"] = projectContext
                            };
                            var rendered = await promptService.RenderAsync("wizard/deep-research-answer", vars);
                            prompt = !string.IsNullOrWhiteSpace(rendered) ? rendered
                                : BuildDeepResearchFallbackPrompt(qa, projectContext);
                        }
                        else
                        {
                            prompt = BuildDeepResearchFallbackPrompt(qa, projectContext);
                        }

                        var options = new VirtualDevTeam.Core.AI.CopilotCliRequestOptions
                        {
                            Pool = VirtualDevTeam.Core.AI.CopilotCliPool.Agentic,
                            AllowAll = true,
                            CloseStdinAfterPrompt = true,
                            WorkingDirectory = _settings.ExistingRepoPath!,
                            WatchdogMode = VirtualDevTeam.Core.AI.CopilotCliWatchdogMode.Agentic,
                        };

                        var result = await cliManager.ExecuteAgenticSessionAsync(prompt, options, ct);
                        var output = result.Succeeded && !string.IsNullOrWhiteSpace(result.LogBuffer)
                            ? VirtualDevTeam.Core.AI.CliOutputParser.ParseJsonOutput(result.LogBuffer) ?? result.LogBuffer
                            : null;

                        if (!ct.IsCancellationRequested && !string.IsNullOrWhiteSpace(output))
                        {
                            var answer = output.Trim();
                            if (answer.Length > 2000) answer = answer[..2000];

                            await InvokeAsync(() =>
                            {
                                if (idx < _settings.ClarifyingAnswers.Count)
                                {
                                    _settings.ClarifyingAnswers[idx].Answer = answer;
                                    _deepResearchInProgress.Remove(idx);
                                    _deepResearchComplete.Add(idx);
                                    StateHasChanged();
                                }
                            });
                        }
                        else
                        {
                            await InvokeAsync(() =>
                            {
                                _deepResearchInProgress.Remove(idx);
                                StateHasChanged();
                            });
                        }
                    }
                    catch (OperationCanceledException)
                    {
                        await InvokeAsync(() => { _deepResearchInProgress.Remove(idx); StateHasChanged(); });
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Deep research failed for question {Idx}", idx);
                        await InvokeAsync(() => { _deepResearchInProgress.Remove(idx); StateHasChanged(); });
                    }
                }, ct));
            }

            await InvokeAsync(StateHasChanged); // Show all loading spinners

            await Task.WhenAll(tasks);

            // Save answers after all complete
            if (!ct.IsCancellationRequested)
            {
                await InvokeAsync(async () =>
                {
                    await SettingsService.SaveAsync(_settings);
                    _askMoreMessage = $"🔬 Deep research complete — {_deepResearchComplete.Count} answers updated";
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { /* user cancelled */ }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Deep research failed");
            await InvokeAsync(() =>
            {
                _askMoreMessage = "⚠ Deep research encountered an error";
                StateHasChanged();
            });
        }
        finally
        {
            _deepResearchRunning = false;
            _deepResearchInProgress.Clear();
            await InvokeAsync(StateHasChanged);
        }
    }

    private string BuildDeepResearchFallbackPrompt(ClarifyingQA qa, string projectContext)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("## Deep Research Task");
        sb.AppendLine();
        sb.AppendLine("**Project Description:**");
        sb.AppendLine(_settings.Description ?? "");
        sb.AppendLine();
        sb.AppendLine("**Existing Project Context:**");
        sb.AppendLine(projectContext);
        sb.AppendLine();
        sb.AppendLine("**Question to Research:**");
        sb.AppendLine(qa.Question);
        sb.AppendLine();
        sb.AppendLine("**Current Proposed Answer:**");
        sb.AppendLine(qa.Answer ?? "(none)");
        sb.AppendLine();
        sb.AppendLine("## Instructions");
        sb.AppendLine("You are researching an existing codebase to provide a thorough, evidence-based answer to the question above.");
        sb.AppendLine();
        sb.AppendLine("1. Explore the project files, source code, configuration, and documentation to find concrete evidence");
        sb.AppendLine("2. Look at actual implementations, dependencies, patterns, and conventions used in the codebase");
        sb.AppendLine("3. If MCP tools are available, use them for additional context");
        sb.AppendLine("4. Produce a concise but specific answer (2-4 sentences) citing actual files, patterns, or configs you found");
        sb.AppendLine("5. Be specific - reference real file names, class names, config values, or dependency versions");
        sb.AppendLine();
        sb.AppendLine("Output ONLY the answer text, no preamble or explanation.");
        return sb.ToString();
    }

    private static string NormalizeForDedup(string text)
    {
        var lower = text.ToLowerInvariant();
        // Strip punctuation
        lower = System.Text.RegularExpressions.Regex.Replace(lower, @"[^\w\s]", "");
        // Collapse whitespace
        lower = System.Text.RegularExpressions.Regex.Replace(lower, @"\s+", " ").Trim();
        return lower;
    }

    private static bool HasHighTokenOverlap(string normalizedNew, HashSet<string> existingNormalized)
    {
        var newTokens = normalizedNew.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
        if (newTokens.Count < 3) return false; // Too short to reliably compare

        foreach (var existing in existingNormalized)
        {
            var existingTokens = existing.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
            var overlap = newTokens.Intersect(existingTokens).Count();
            var overlapRatio = (double)overlap / newTokens.Count;
            if (overlapRatio > 0.7)
                return true;
        }
        return false;
    }

    private static List<(string Question, string? ProposedAnswer)> ParseNumberedQuestions(string output)
    {
        var questions = new List<(string Question, string? ProposedAnswer)>();
        foreach (var line in output.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var trimmed = line.Trim();
            // Strip markdown bold/italic markers
            trimmed = trimmed.Replace("**", "").Replace("__", "");
            // Match patterns like "1. Question", "1) Question", "1: Question", "- Question", "• Question"
            var match = System.Text.RegularExpressions.Regex.Match(trimmed, @"^(?:\d+[\.\)\:]|[-•\*])\s*(.+)$");
            if (match.Success)
            {
                var content = match.Groups[1].Value.Trim();
                if (content.Length > 10) // Skip trivially short lines
                {
                    // Split on pipe delimiter for "Question | ProposedAnswer" format
                    var pipeIdx = content.IndexOf('|');
                    if (pipeIdx > 0 && pipeIdx < content.Length - 1)
                    {
                        var question = content[..pipeIdx].Trim();
                        var proposed = content[(pipeIdx + 1)..].Trim();
                        if (question.Length > 5 && proposed.Length > 3)
                            questions.Add((question, proposed));
                        else
                            questions.Add((content, null)); // Pipe was part of content
                    }
                    else
                    {
                        questions.Add((content, null));
                    }
                }
            }
        }
        return questions.Take(10).ToList();
    }

    private string BuildClarifyPromptFallback(string techContext)
    {
        var contextBlock = string.IsNullOrWhiteSpace(_settings.ExistingProjectContext) ? "" :
            $@"

Existing project context (this is an EXISTING codebase — use this context to ask MORE RELEVANT and SPECIFIC questions that account for the real architecture, patterns, and constraints already in place):
{_settings.ExistingProjectContext}";

        return $@"You are a senior technical product manager. A user has described a software project they want built. Analyze the description and generate clarifying questions that would help reduce ambiguity and improve the quality of the resulting specification.

Rules:
- Generate questions where the answer would materially affect architecture, scope, or implementation decisions
- Do NOT ask questions that are already clearly answered in the description
- Short descriptions (under 5 sentences) are inherently ambiguous — generate at LEAST 5 questions for them
- Maximum 10 questions
- Each question should be concise (1-2 sentences)
- For each question, also provide your best proposed answer based on the description and common best practices
- Focus on: scope boundaries, target audience, user roles, data requirements, integration points, specific features expected, design/UX preferences, performance expectations, deployment environment, and key behavioral decisions
- Output ONLY a numbered list in format: ""1. Question text | Proposed answer text"" (pipe-delimited, question first, then proposed answer)
- NEVER output an empty response — even well-described projects have decisions worth clarifying

Project description:
{_settings.Description}{techContext}{contextBlock}";
    }

    private string BuildAskMorePromptFallback(string techContext, string existingQuestions)
    {
        var contextBlock = string.IsNullOrWhiteSpace(_settings.ExistingProjectContext) ? "" :
            $@"

Existing project context (use this to ask deeper questions that probe aspects specific to this codebase's real architecture and patterns):
{_settings.ExistingProjectContext}";

        return $@"You are a senior technical product manager. A user has described a software project and already answered some initial clarifying questions. Your job is to generate NEW follow-up questions that dig deeper into aspects NOT yet covered.

Rules:
- Generate 3-5 NEW questions only
- Do NOT repeat or rephrase any of the existing questions listed below
- Focus on aspects the existing questions missed: integration points, edge cases, operational concerns, scaling strategy, security model, data model specifics, error handling philosophy, deployment targets, observability needs, user onboarding flow
- Each question should be concise (1-2 sentences)
- For each question, also provide your best proposed answer based on the description and common best practices
- Output ONLY a numbered list in format: ""1. Question text | Proposed answer text"" (pipe-delimited, question first, then proposed answer)
- NEVER output an empty response — there are always deeper aspects to probe

Project description:
{_settings.Description}{techContext}{contextBlock}

Questions already asked (DO NOT repeat these or ask similar variants):
{existingQuestions}";
    }

    private void SetPlatform(string platform)
    {
        _settings.Platform = platform;
        _repoVerified = null;
        _repoError = null;
    }

    private string GetRepoDisplayName()
    {
        if (_settings.CreateNewRepo)
            return string.IsNullOrWhiteSpace(_settings.NewRepoName) ? "—" : $"{_settings.NewRepoName} (new)";
        if (_settings.Platform == "GitHub")
            return string.IsNullOrWhiteSpace(_settings.GitHub.Repo) ? "—" : _settings.GitHub.Repo;
        var ado = _settings.AzureDevOps;
        return string.IsNullOrWhiteSpace(ado.Repository) ? "—" : $"{ado.Organization}/{ado.Project}/{ado.Repository}";
    }

    // ── Step 3: Repo verification — actually checks repo exists with the selected auth ──
    private async Task VerifyRepoAsync()
    {
        _repoVerifying = true;
        _repoVerified = null;
        _repoError = null;
        try
        {
            if (_settings.Platform == PlatformGitHub)
            {
                var repo = _settings.GitHub?.Repo;
                if (string.IsNullOrWhiteSpace(repo) || !repo.Contains('/'))
                {
                    _repoVerified = false;
                    _repoError = "Enter a valid repo in owner/repo format.";
                    return;
                }

                // Resolve token from the selected auth method
                string? token = await ResolveCurrentAuthTokenAsync();
                if (string.IsNullOrWhiteSpace(token))
                {
                    _repoVerified = false;
                    _repoError = _settings.AuthMethod switch
                    {
                        "GhCli" => "gh CLI is not authenticated. Verify gh CLI auth first.",
                        "Pat" => "No PAT available. Enter and verify a PAT first.",
                        _ => "No auth token available. Configure auth first."
                    };
                    return;
                }

                // Actually check the repo via GitHub API
                using var http = new HttpClient();
                http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                http.DefaultRequestHeaders.UserAgent.ParseAdd("VirtualDevTeam/1.0");
                http.DefaultRequestHeaders.Accept.ParseAdd("application/vnd.github+json");

                var resp = await http.GetAsync($"https://api.github.com/repos/{repo}");
                if (resp.IsSuccessStatusCode)
                {
                    _repoVerified = true;
                    await SettingsService.SaveAsync(_settings);
                    // Fire-and-forget context gathering for existing GitHub repo
                    _ = InvokeAsync(async () =>
                    {
                        await GatherExistingProjectContextAsync();
                        StateHasChanged();
                    });
                }
                else if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    _repoVerified = false;
                    _repoError = $"Repository '{repo}' not found. Check the name and that your auth ({_settings.AuthMethod}) has access.";
                }
                else if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                         resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    _repoVerified = false;
                    _repoError = $"Access denied ({(int)resp.StatusCode}). Your {_settings.AuthMethod} credentials may not have access to '{repo}'.";
                }
                else
                {
                    _repoVerified = false;
                    _repoError = $"GitHub returned {(int)resp.StatusCode} for '{repo}'.";
                }
            }
            else
            {
                // ADO platform
                var org = _settings.AzureDevOps?.Organization;
                var project = _settings.AzureDevOps?.Project;
                var repoName = _settings.AzureDevOps?.Repository;
                if (string.IsNullOrWhiteSpace(org) || string.IsNullOrWhiteSpace(project) || string.IsNullOrWhiteSpace(repoName))
                {
                    _repoVerified = false;
                    _repoError = "Fill in Organization, Project, and Repository first.";
                    return;
                }

                string? token = await ResolveCurrentAuthTokenAsync();
                if (string.IsNullOrWhiteSpace(token))
                {
                    _repoVerified = false;
                    _repoError = "No auth token available. Configure auth first.";
                    return;
                }

                using var http = new HttpClient();
                http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                var resp = await http.GetAsync(
                    $"https://dev.azure.com/{org}/{project}/_apis/git/repositories/{repoName}?api-version=7.0");
                if (resp.IsSuccessStatusCode)
                {
                    _repoVerified = true;
                    await SettingsService.SaveAsync(_settings);
                    // Fire-and-forget context gathering for existing ADO repo
                    _ = InvokeAsync(async () =>
                    {
                        await GatherExistingProjectContextAsync();
                        StateHasChanged();
                    });
                }
                else if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    _repoVerified = false;
                    _repoError = $"Repository '{repoName}' not found in {org}/{project}. Check names and auth access.";
                }
                else
                {
                    _repoVerified = false;
                    _repoError = $"ADO returned {(int)resp.StatusCode} for '{org}/{project}/{repoName}'.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Repo verification failed");
            _repoVerified = false;
            _repoError = ex.Message;
        }
        finally
        {
            _repoVerifying = false;
        }
    }

