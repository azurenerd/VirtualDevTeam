        _logAgentName = displayName ?? agentId;
        _showLogModal = true;
    }

    private void CloseLog()
    {
        _showLogModal = false;
        _logAgentId = null;
        _logAgentName = null;
    }

    // Per-agent restart methods (two-click confirm)
    private void RequestRestart(string agentId)
    {
        _restartConfirmAgentId = agentId;
    }

    private async Task ConfirmRestart(string agentId)
    {
        _restartConfirmAgentId = null;
        _restartingAgentId = agentId;
        StateHasChanged();

        try
        {
            // Prefer direct service call in bundled Dashboard mode (Runner serves the RCL)
            var spawnMgr = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.AgentSpawnManager>();
            if (spawnMgr is not null)
            {
                await spawnMgr.RespawnAgentAsync(agentId);
            }
            else
            {
                // Fallback: HTTP path for standalone Dashboard.Host mode
                var http = _runsHttp ?? new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
                if (http.BaseAddress is null)
                    http.BaseAddress = new Uri(Navigation.BaseUri);
                var response = await http.PostAsync($"api/dashboard/agents/{agentId}/restart", null);
                if (!response.IsSuccessStatusCode)
                {
                    var err = await response.Content.ReadAsStringAsync();
                    _runError = $"Restart failed: {err}";
                }
            }
        }
        catch (Exception ex)
        {
            _runError = $"Restart failed: {ex.Message}";
        }
        finally
        {
            _restartingAgentId = null;
            StateHasChanged();
        }
    }

    private void CloseChat()
    {
        _showChatModal = false;
        _chatAgentId = null;
    }

    // ── Role Editor ──

    private async Task OpenRoleEditor(string agentId)
    {
        var agent = _agents.FirstOrDefault(a => a.Id == agentId);
        if (agent is null) return;

        _roleAgentId = agentId;
        _roleAgentName = agent.DisplayName;

        var info = DataService.GetAgentRoleDescription(agentId);
        if (info is not null)
        {
            _roleDescription = info.EffectiveDescription ?? "";
            _roleHasOverride = info.HasOverride;
        }
        else
        {
            _roleDescription = "";
            _roleHasOverride = false;
        }

        // Show modal immediately, then try to load richer template content
        _showRoleModal = true;

        // If no override, try loading full description from prompt template
        if (!_roleHasOverride)
        {
            try
            {
                var templateDir = GetRoleTemplateDirectory(agent.Role);
                if (templateDir is not null)
                {
                    var content = await PromptTemplates.GetRawContentAsync($"{templateDir}/role-description");
                    if (!string.IsNullOrWhiteSpace(content))
                    {
                        _roleDescription = StripFrontmatter(content);
                        StateHasChanged();
                    }
                }
            }
            catch
            {
                // Template load failed — keep the fallback description
            }
        }
    }

    private void CloseRoleEditor()
    {
        _showRoleModal = false;
        _roleAgentId = null;
    }

    private void SaveRoleOverride()
    {
        if (_roleAgentId is null || string.IsNullOrWhiteSpace(_roleDescription)) return;
        DataService.SaveAgentRoleOverride(_roleAgentId, _roleDescription.Trim());
        _roleHasOverride = true;
    }

    private async Task ResetRoleToDefault()
    {
        if (_roleAgentId is null) return;
        DataService.ClearAgentRoleOverride(_roleAgentId);
        _roleHasOverride = false;

        // Load from prompt template file as the default
        var agent = _agents.FirstOrDefault(a => a.Id == _roleAgentId);
        if (agent is not null)
        {
            var templateDir = GetRoleTemplateDirectory(agent.Role);
            if (templateDir is not null)
            {
                var content = await PromptTemplates.GetRawContentAsync($"{templateDir}/role-description");
                if (!string.IsNullOrWhiteSpace(content))
                {
                    _roleDescription = StripFrontmatter(content);
                    return;
                }
            }
        }

        // Fallback to DashboardDataService configured description
        var info = DataService.GetAgentRoleDescription(_roleAgentId);
        _roleDescription = info?.ConfiguredDescription ?? "";
    }

    private void SetChatInput(string text)
    {
        _chatInput = text;
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_chatSending && !string.IsNullOrWhiteSpace(_chatInput))
        {
            await SendChat();
        }
    }

    private async Task SendChat()
    {
        if (_chatAgentId is null || string.IsNullOrWhiteSpace(_chatInput) || _chatSending) return;

        var message = _chatInput.Trim();
        _chatInput = "";
        _chatSending = true;
        StateHasChanged();

        try
        {
            await DataService.SendAgentChatAsync(_chatAgentId, message);
            _chatMessages = DataService.GetAgentChatHistory(_chatAgentId).ToList();
        }
        catch (Exception ex)
        {
            _chatMessages.Add(new AgentChatMessage
            {
                Role = "assistant",
                Content = $"Error: {ex.Message}",
                Timestamp = DateTime.UtcNow
            });
        }
        finally
        {
            _chatSending = false;
            StateHasChanged();
        }
    }

    // Gate notification helpers
    private IReadOnlyList<GateNotification> _openGates = Array.Empty<GateNotification>();
    private DateTime _lastGateRefresh = DateTime.MinValue;

    private IReadOnlyList<GateNotification> GetOpenGates()
    {
        // Cache for 2 seconds to avoid repeated lookups per render
        if ((DateTime.UtcNow - _lastGateRefresh).TotalSeconds > 2)
        {
            var svc = ServiceProvider.GetService<GateNotificationService>();
            var httpSvc = ServiceProvider.GetService<HttpGateNotificationService>();
            _openGates = svc?.GetByStatus(NotificationFilter.Open)
                      ?? httpSvc?.GetByStatus(NotificationFilter.Open)
                      ?? Array.Empty<GateNotification>();
            _lastGateRefresh = DateTime.UtcNow;
        }
        return _openGates;
    }

    private GateNotification? GetActiveGateForAgent(AgentSnapshot agent)
    {
        var gates = GetOpenGates();
        // Match by PR number if available
        var prNum = ExtractPrNumber(agent.StatusReason) ?? agent.AssignedPullRequest;
        if (prNum is not null && int.TryParse(prNum, out var num))
        {
            var match = gates.FirstOrDefault(g => g.ResourceNumber == num && !g.IsResolved);
            if (match is not null) return match;
        }
        // Fallback: match by gate name extracted from status
        var gateName = ExtractGateName(agent.StatusReason);
        if (gateName is not null)
            return gates.FirstOrDefault(g => g.GateName.Contains(gateName, StringComparison.OrdinalIgnoreCase) && !g.IsResolved);
        return null;
    }

    private static string? ExtractPrNumber(string? statusReason)
    {
        if (statusReason is null) return null;
        var match = System.Text.RegularExpressions.Regex.Match(statusReason, @"PR #(\d+)");
        return match.Success ? match.Groups[1].Value : null;
    }

    private static string ExtractGateName(string? statusReason)
    {
        if (statusReason is null) return "Unknown gate";
        // Pattern: "⏳ Awaiting human approval — gate-name" or "on PR #123"
        var dashIdx = statusReason.IndexOf('—');
        if (dashIdx >= 0 && dashIdx + 2 < statusReason.Length)
            return statusReason[(dashIdx + 2)..].Trim();
        var onIdx = statusReason.IndexOf("on PR", StringComparison.OrdinalIgnoreCase);
        if (onIdx >= 0)
            return statusReason[onIdx..].Trim();
        return "Approval required";
    }

    /// <summary>
    /// Resolve the gate-card "Review" link.  PR / Issue gates route through the internal
    /// <c>/repository/...</c> page (with the platform URL preserved as fallback when internal
    /// navigation is disabled); other gate types stay on the platform URL since they typically
    /// point at repo-level pages we don't render in-app.
    /// </summary>
    private (string href, string? target, string? rel, string title) ResolveGateLink(GateNotification gate)
    {
        string href = gate.GitHubUrl ?? "#";
        if (gate.ResourceNumber is int n)
        {
            if (string.Equals(gate.ResourceType, "PR", StringComparison.OrdinalIgnoreCase))
                href = LinkService.BuildPullRequestUrl(n, gate.GitHubUrl);
            else if (string.Equals(gate.ResourceType, "Issue", StringComparison.OrdinalIgnoreCase))
                href = LinkService.BuildIssueUrl(n, gate.GitHubUrl);
        }
        var target = LinkService.TargetForUrl(href);
        var rel = target == "_blank" ? "noopener" : null;
        var title = LinkService.IsInternal(href)
            ? $"Review in dashboard"
            : $"Review on {LinkService.PlatformDisplayName}";
        return (href, target, rel, title);
    }

    private (int completed, int total, string? currentName, string? tooltip) GetAgentStepInfo(string agentId)
    {
        if (_taskTracker is null)
            return (0, 0, null, null);
        var progress = _taskTracker.GetProgress(agentId);
        var currentStep = _taskTracker.GetCurrentStep(agentId);
        string? tooltip = null;
        if (currentStep is not null)
        {
            var parts = new List<string> { $"Current: {currentStep.Name}" };
            if (currentStep.Elapsed.HasValue)
                parts.Add($"Duration: {FormatDuration(currentStep.Elapsed.Value)}");
            if (!string.IsNullOrEmpty(currentStep.ModelUsed))
                parts.Add($"Model: {currentStep.ModelUsed}");
            if (currentStep.LlmCallCount > 0)
                parts.Add($"LLM calls: {currentStep.LlmCallCount}");
            if (!string.IsNullOrEmpty(currentStep.Description))
                parts.Add($"Details: {(currentStep.Description.Length > 120 ? currentStep.Description[..120] + "…" : currentStep.Description)}");
            parts.Add($"Progress: {progress.completed}/{progress.total} steps");
            tooltip = string.Join("\n", parts);
        }
        return (progress.completed, progress.total, currentStep?.Name, tooltip);
    }

    public void Dispose()
    {
        _disposed = true;
        DataService.OnChange -= OnDataChanged;
        _refreshTimer?.Dispose();
    }

    // ── Project Control Methods ──────────────────────────────────────

    private async Task LoadRunStateAsync()
    {
        // Prefer direct DI injection of RunCoordinator (works in Runner-embedded mode,
        // avoids HTTP self-call race where Kestrel isn't yet listening during OnInitialized).
        var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
        if (coordinator is not null)
        {
            var run = coordinator.ActiveRun;
            var profile = coordinator.ActiveProfile;
            _runState = run?.Status.ToString() ?? "Idle";
            _runMode = run?.Mode.ToString() ?? "";
            _runDisplayName = profile?.DisplayName ?? "";
            RefreshData(); // Re-evaluate _isProjectComplete now that _runState is known
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Fallback: HTTP path for standalone Dashboard.Host mode
        if (_runsHttp is null) return;

        try
        {
            var resp = await _runsHttp.GetAsync("/api/runs/active");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<RunActiveResponse>();
                if (json?.run is not null)
                {
                    _runState = json.run.StatusText;
                    _runMode = json.run.ModeText;
                    _runDisplayName = json.profile?.displayName ?? "";
                }
                else
                {
                    _runState = "Idle";
                    _runMode = "";
                    _runDisplayName = "";
                }
                RefreshData(); // Re-evaluate _isProjectComplete now that _runState is known
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* API not available yet */ }
    }

    private async Task PauseRunAsync()
    {
        _runActionPending = true;
        _runError = "";
        StateHasChanged();

        try
        {
            if (_runsHttp is not null)
            {
                var resp = await _runsHttp.PostAsync("/api/runs/stop", null);
                if (resp.IsSuccessStatusCode)
                {
                    _runState = "Paused";
                }
                else
                {
                    _runError = "Failed to pause run";
                }
            }
            else
            {
                var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
                if (coordinator is not null)
                {
                    await coordinator.StopAsync();
                    _runState = "Paused";
                }
            }
        }
        catch (Exception ex)
        {
            _runError = ex.Message;
        }
        finally
        {
            _runActionPending = false;
            StateHasChanged();
        }
    }

    private async Task ResumeRunAsync()
    {
        _runActionPending = true;
        _runError = "";
        StateHasChanged();

        try
        {
            if (_runsHttp is not null)
            {
                var resp = await _runsHttp.PostAsync("/api/runs/resume", null);
                if (resp.IsSuccessStatusCode)
                {
                    _runState = "Running";
                }
                else
                {
                    _runError = "Failed to resume run";
                }
            }
            else
            {
                var coordinator = ServiceProvider.GetService<VirtualDevTeam.Orchestrator.RunCoordinator>();
                if (coordinator is not null)
                {
                    await coordinator.ResumeAsync();
                    await coordinator.SpawnAgentsForRunAsync();
                    _runState = "Running";
                }
            }
        }
        catch (Exception ex)
        {
            _runError = ex.Message;
        }
        finally
        {
            _runActionPending = false;
            StateHasChanged();
        }
    }

    // DTOs for JSON deserialization (status/mode are int enums from the API)
    private record RunActiveResponse(RunInfo? run, ProfileInfo? profile);
    private record RunInfo(int? status, int? mode, string? runId)
    {
        public string StatusText => status switch
        {
            0 => "NotStarted",
            1 => "Running",
            2 => "Paused",
            3 => "Completed",
            4 => "Failed",
            5 => "Cancelled",
            _ => "Idle"
        };
        public string ModeText => mode switch
        {
            0 => "Project",
            1 => "Feature",
            _ => ""
        };
    }
    private record ProfileInfo(string? displayName, string? mode);

    private record AgentAssessmentIssue
    {
        public string? TargetType { get; init; }
        public string? TargetId { get; init; }
        public string? Severity { get; init; }
        public string? Description { get; init; }
    }
