<VirtualDevTeam.Dashboard.Components.Shared.AgentLogViewer
    AgentId="@_logAgentId"
    AgentDisplayName="@_logAgentName"
    IsVisible="@_showLogModal"
    OnClose="CloseLog" />

@code {
    private List<AgentSnapshot> _agents = [];
    private HashSet<string> _hiddenAgentIds = [];
    private bool _showAgentFilter;
    private List<AgentSnapshot> _visibleAgents => _agents
        .Where(a => !_hiddenAgentIds.Contains(a.Id))
        .Where(a => !_showOnlyWorking || a.Status == AgentStatus.Working)
        .ToList();

    // Project control state
    private string _runState = "Idle";
    private string _runMode = "";
    private string _runDisplayName = "";
    private string _runError = "";
    private bool _runActionPending;
    private HttpClient? _runsHttp;
    private string? _selectedAgentId;
    private bool _hasDeadlock;
    private List<string>? _deadlockCycle;
    private IDecisionLog? _decisionLog;
    private IAgentTaskTracker? _taskTracker;

    // Error modal state
    private bool _showErrorModal;
    private string? _errorModalAgentId;
    private string? _errorModalAgentName;
    private List<AgentLogEntry> _errorEntries = [];

    // Model editing state
    private string? _editingModelAgentId;
    private IReadOnlyList<string> _availableModels = [];

    // Chat modal state
    private bool _showChatModal;
    private string? _chatAgentId;
    private string? _chatAgentName;
    private AgentSnapshot? _chatAgent;
    private List<AgentChatMessage> _chatMessages = [];
    private string _chatInput = "";
    private bool _chatSending;
    private bool _refreshing;
    private bool _disposed;
    private bool _isProjectComplete;
    private bool _showOnlyWorking;

    // Per-agent restart state
    private string? _restartConfirmAgentId;
    private string? _restartingAgentId;

    // Role popover state
    private string? _rolePopoverId;
    private string? _rolePopoverDescription;

    // AI assessment badge data — per-agent issues from latest assessment
    private Dictionary<string, List<AgentAssessmentIssue>> _agentIssues = new(StringComparer.OrdinalIgnoreCase);

    // Role editor modal state
    private bool _showRoleModal;
    private string? _roleAgentId;
    private string? _roleAgentName;
    private string _roleDescription = "";
    private bool _roleHasOverride;

    // Log viewer modal state
    private bool _showLogModal;
    private string? _logAgentId;
    private string? _logAgentName;

    // Team composition state
    private string? _teamComposition;
    private string _teamCompSummary = "";
    private bool _teamCompExpanded;
    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        // Redirect to welcome wizard if flag is set
        if (DevelopSettingsService.Current.ShowWelcomeWizard)
        {
            Navigation.NavigateTo("/welcome", forceLoad: false);
            return;
        }

        _decisionLog = ServiceProvider.GetService<IDecisionLog>();
        _taskTracker = ServiceProvider.GetService<IAgentTaskTracker>();
        RefreshData();
        _availableModels = DataService.GetAvailableModels();
        DataService.OnChange += OnDataChanged;

        // Periodic refresh every 15s to keep "time ago" labels and task steps current
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                RefreshData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));

        // Set up HTTP client for run control API
        var factory = ServiceProvider.GetService<IHttpClientFactory>();
        if (factory is not null)
        {
            _runsHttp = factory.CreateClient("RunnerApi");
        }

        _ = LoadTeamCompositionAsync();
        _ = LoadRunStateAsync();
    }

    private void RefreshData()
    {
        _agents = DataService.GetAllAgentSnapshots().ToList();
        _hasDeadlock = DataService.HasDeadlock(out _deadlockCycle);
        var health = DataService.GetExecutionHealthAssessment();
        // Project-complete banner: workflow phase must be Completion AND no engineer
        // agents should still be Working. The phase can advance prematurely due to
        // HealthMonitor auto-detect matching "integration PR" status text too early
        // (Lesson #23). Adding an agent-status guard prevents the false-positive banner.
        var engineersStillWorking = _agents.Any(a =>
            a.Status == AgentStatus.Working &&
            (a.Role == AgentRole.SoftwareEngineer || a.Role == AgentRole.TestEngineer));
        _isProjectComplete = health.Phase == "Completion"
            && _runState is "Running" or "Completed"
            && !engineersStillWorking
            && _agents.All(a => a.Status != AgentStatus.Error);
        RefreshAgentAssessmentIssues();
    }

    private void RefreshAgentAssessmentIssues()
    {
        _agentIssues.Clear();
        try
        {
            var latest = AssessmentStore.GetLatestAssessment();
            if (latest?.IssuesJson is null) return;
            var issues = System.Text.Json.JsonSerializer.Deserialize<List<AgentAssessmentIssue>>(latest.IssuesJson);
            if (issues is null) return;
            foreach (var issue in issues)
            {
                if (!string.Equals(issue.TargetType, "agent", StringComparison.OrdinalIgnoreCase)
                    || string.IsNullOrEmpty(issue.TargetId)) continue;
                if (!_agentIssues.TryGetValue(issue.TargetId, out var list))
                {
                    list = new();
                    _agentIssues[issue.TargetId] = list;
                }
                list.Add(issue);
            }
        }
        catch { /* Non-fatal — badge is optional */ }
    }

    private async Task LoadTeamCompositionAsync()
    {
        try
        {
            var content = await RepoContent.GetFileContentAsync("TeamComposition.md");
            if (!string.IsNullOrWhiteSpace(content))
            {
                _teamComposition = content;
                // Extract summary line: "X built-in, Y SME agents" or role count
                var lines = content.Split('\n');
                var rationale = lines.FirstOrDefault(l => l.StartsWith("This is", StringComparison.OrdinalIgnoreCase)
                    || l.StartsWith("The project", StringComparison.OrdinalIgnoreCase));
                var roleCount = lines.Count(l => l.TrimStart().StartsWith("|") && !l.Contains("---") && !l.Contains("Role"));
                _teamCompSummary = roleCount > 0 ? $"{roleCount} roles assigned" : "View details";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* File not yet created — will appear after PM runs */ }
    }

    private void ToggleAgentFilter() => _showAgentFilter = !_showAgentFilter;

    private void ToggleAgentVisibility(string agentId)
    {
        if (!_hiddenAgentIds.Remove(agentId))
            _hiddenAgentIds.Add(agentId);
    }

    private async Task ForceRefreshAsync()
    {
        _refreshing = true;
        StateHasChanged();
        try
        {
            // Only reload display data — do NOT call ResetCaches() which clears
            // the agent registry and kills the dashboard's view of running agents.
            RefreshData();
        }
        finally
        {
            _refreshing = false;
            StateHasChanged();
        }
    }

    private async void OnDataChanged()
    {
        try
        {
            if (_disposed) return;
            // Load run state FIRST so RefreshData() has an up-to-date _runState
            // for the _isProjectComplete evaluation.
            await LoadRunStateAsync();
            RefreshData();
            // Re-check for TeamComposition.md if not yet loaded
            if (_teamComposition is null)
                await LoadTeamCompositionAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { /* Circuit disposed — ignore */ }
    }

    private void SelectAgent(string agentId)
    {
        _selectedAgentId = _selectedAgentId == agentId ? null : agentId;
    }

    private void NavigateToAgent(string agentId)
    {
        Navigation.NavigateTo($"/agent/{agentId}");
    }

    private int CountByStatus(AgentStatus status) =>
        _agents.Count(a => a.Status == status);

    private static bool IsAwaitingApproval(AgentSnapshot agent) =>
        agent.StatusReason?.Contains("Awaiting human approval", StringComparison.OrdinalIgnoreCase) == true;

    private string HealthClass => _hasDeadlock ? "danger" :
        _agents.Any(a => a.Status == AgentStatus.Blocked) ? "warning" : "healthy";

    private string HealthLabel => _hasDeadlock ? "Deadlock" :
        _agents.Any(a => a.Status == AgentStatus.Blocked) ? "Degraded" : "Healthy";

    private static string GetRoleInitials(AgentRole role, string? specialty = null) => role switch
    {
        AgentRole.ProgramManager => "PM",
        AgentRole.Researcher => "RS",
        AgentRole.Architect => "AR",
        AgentRole.SoftwareEngineer => "SWE",
        AgentRole.TestEngineer => "TE",
        AgentRole.SecurityAuditor => "SA",
        AgentRole.Custom when !string.IsNullOrEmpty(specialty) => GetInitialsFromName(specialty),
        _ => "??"
    };

    private static string GetInitialsFromName(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length >= 2
            ? $"{words[0][0]}{words[1][0]}".ToUpperInvariant()
            : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    private static string FormatRole(AgentRole role, string? specialty = null) => role switch
    {
        AgentRole.ProgramManager => "Program Manager",
        AgentRole.Researcher => "Researcher",
        AgentRole.Architect => "Architect",
        AgentRole.SoftwareEngineer => "Software Engineer",
        AgentRole.TestEngineer => "Test Engineer",
        AgentRole.SecurityAuditor => "Security Auditor",
        AgentRole.Custom when !string.IsNullOrEmpty(specialty) => "SME Specialist",
        _ => role.ToString()
    };

    private async Task ToggleRolePopover(string agentId)
    {
        if (_rolePopoverId == agentId)
        {
            _rolePopoverId = null;
            _rolePopoverDescription = null;
            return;
        }

        _rolePopoverId = agentId;

        // Try loading full role description from .md template file
        var agent = _agents.FirstOrDefault(a => a.Id == agentId);
        if (agent is not null)
        {
            try
            {
                var templateDir = GetRoleTemplateDirectory(agent.Role);
                if (templateDir is not null)
                {
                    var content = await PromptTemplates.GetRawContentAsync($"{templateDir}/role-description");
                    if (!string.IsNullOrWhiteSpace(content))
                    {
                        _rolePopoverDescription = StripFrontmatter(content);
                        return;
                    }
                }
            }
            catch
            {
                // Template load failed — fall through to fallback
            }
        }

        // Fall back to DashboardDataService (which reads config overrides)
        var info = DataService.GetAgentRoleDescription(agentId);
        _rolePopoverDescription = info?.EffectiveDescription;

        // Final fallback to static summary
        if (string.IsNullOrWhiteSpace(_rolePopoverDescription) && agent is not null)
            _rolePopoverDescription = GetRoleDescription(agent.Role);
    }

    private static string? GetRoleTemplateDirectory(AgentRole role) => role switch
    {
        AgentRole.ProgramManager => "pm",
        AgentRole.Researcher => "researcher",
        AgentRole.Architect => "architect",
        AgentRole.SoftwareEngineer => "software-engineer",
        AgentRole.TestEngineer => "test-engineer",
        AgentRole.SecurityAuditor => "security-auditor",
        AgentRole.Custom => "specialist-engineer",
        _ => null
    };

    private static string StripFrontmatter(string content)
    {
        if (!content.StartsWith("---"))
            return content.Trim();

        var endIndex = content.IndexOf("---", 3);
        if (endIndex < 0)
            return content.Trim();

        return content[(endIndex + 3)..].Trim();
    }

    private static string GetRoleDescription(AgentRole role) => role switch
    {
        AgentRole.ProgramManager => "Owns the product vision. Creates PM Spec from research, manages reviews, coordinates team, and escalates blockers to the Executive.",
        AgentRole.Researcher => "Investigates technologies, APIs, and design patterns. Produces Research.md that informs all downstream decisions.",
        AgentRole.Architect => "Designs system structure from PM Spec. Produces Architecture.md with component diagrams, data models, and integration patterns.",
        AgentRole.SoftwareEngineer => "Implements code from the engineering plan. Creates PRs with production-quality code, handles rework feedback, and runs local builds.",
        AgentRole.TestEngineer => "Validates implementations via automated tests. Writes integration/UI tests, reports source bugs, and verifies fixes.",
        AgentRole.SecurityAuditor => "Opt-in OWASP-focused reviewer. Audits ready-for-review PRs that match security triggers (auth, sessions, file upload, config drift) and posts severity-tagged findings; can block merge on high/critical defects.",
        AgentRole.Custom => "Subject-matter expert dynamically spawned for specialized parallel work (e.g., frontend, backend, game engine).",
        _ => "Agent role in the Virtual Dev Team."
    };

    private static string FormatDuration(TimeSpan ts) => ts.TotalHours >= 1
        ? $"{ts.Hours}h {ts.Minutes}m"
        : ts.TotalMinutes >= 1
            ? $"{ts.Minutes}m {ts.Seconds}s"
            : $"{ts.Seconds}s";

    private static string TruncateTask(string text) =>
        text.Length <= 40 ? text : string.Concat(text.AsSpan(0, 37), "...");

    private static string TruncateDiagnostic(string text) =>
        text.Length <= 80 ? text : string.Concat(text.AsSpan(0, 77), "...");

    private static readonly MarkdownPipeline _mdPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private static string RenderMarkdown(string markdown) =>
        Markdown.ToHtml(markdown ?? "", _mdPipeline);

    private void OnModelSelected(string agentId, ChangeEventArgs e)
    {
        var newModel = e.Value?.ToString();
        if (!string.IsNullOrEmpty(newModel))
        {
            DataService.SetAgentModel(agentId, newModel);
