@page "/"
@rendermode InteractiveServer
@using VirtualDevTeam.Core.Agents
@using VirtualDevTeam.Core.Agents.Decisions
@using VirtualDevTeam.Core.Agents.Steps
@using VirtualDevTeam.Core.Configuration
@using VirtualDevTeam.Core.Diagnostics
@using VirtualDevTeam.Core.GitHub
@using VirtualDevTeam.Core.DevPlatform.Capabilities
@using VirtualDevTeam.Core.Notifications
@using VirtualDevTeam.Core.Prompts
@using VirtualDevTeam.Dashboard.Services
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Markdig
@implements IDisposable
@inject IDashboardDataService DataService
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider
@inject IRepositoryContentService RepoContent
@inject IOptions<VirtualDevTeamConfig> Config
@inject IPromptTemplateService PromptTemplates
@inject IPlatformLinkService LinkService
@inject DevelopSettingsService DevelopSettingsService
@inject VirtualDevTeam.Core.HealthMonitor.PipelineAssessmentStore AssessmentStore

<PageTitle>Virtual Dev Team — Overview</PageTitle>

@if (string.IsNullOrWhiteSpace(Config.Value.Project.Name) && string.IsNullOrWhiteSpace(Config.Value.Project.GitHubRepo))
{
    <div style="background:var(--card-bg); border:1px solid var(--accent-primary); border-radius:8px; padding:1.25rem 1.5rem; margin-bottom:1.5rem; display:flex; align-items:center; gap:1rem;">
        <span style="font-size:1.5rem;">🚀</span>
        <div style="flex:1;">
            <strong style="color:var(--text-primary);">Welcome to VirtualDevTeam!</strong>
            <p style="color:var(--text-secondary); margin:0.25rem 0 0;">
                Get started by configuring your project in the Develop wizard.
            </p>
        </div>
        <a href="/develop" style="background:var(--accent-primary); color:white; padding:0.5rem 1rem; border-radius:6px; text-decoration:none; font-weight:500; white-space:nowrap;">
            Get Started →
        </a>
    </div>
}

<div class="dashboard-header" data-testid="page-agent-overview">
    <h1>Agent Overview</h1>
    <div class="header-badges">
        <span class="header-badge @HealthClass">
            @if (_hasDeadlock) { <span>⚠</span> } else { <span>●</span> }
            @HealthLabel
        </span>
        <div class="agent-filter-wrap">
            <button class="header-badge agent-filter-toggle" @onclick="ToggleAgentFilter" data-testid="agents-filter-toggle">
                🤖 @_visibleAgents.Count Agents@(_hiddenAgentIds.Count > 0 ? $", {_hiddenAgentIds.Count} Hidden" : "")
                <span class="agent-filter-chevron">▾</span>
            </button>
            @if (_showAgentFilter)
            {
                <div class="agent-filter-dropdown">
                    @foreach (var agent in _agents)
                    {
                        var isHidden = _hiddenAgentIds.Contains(agent.Id);
                        <button class="agent-filter-item @(isHidden ? "hidden-agent" : "")" @onclick="() => ToggleAgentVisibility(agent.Id)">
                            <span class="agent-filter-check">@(isHidden ? "☐" : "☑")</span>
                            <span class="agent-filter-name">@agent.DisplayName</span>
                            <span class="agent-filter-status status-@(agent.Status.ToString().ToLowerInvariant())">@agent.Status</span>
                        </button>
                    }
                </div>
            }
        </div>
        @{ var ncCount = _agents.Count(a => !a.DiagnosticCompliant); }
        @if (ncCount > 0)
        {
            <span class="header-badge danger">⚠ @ncCount Non-Compliant</span>
        }
        <button class="working-only-toggle @(_showOnlyWorking ? "active" : "")"
                @onclick="() => { _showOnlyWorking = !_showOnlyWorking; StateHasChanged(); }"
                title="@(_showOnlyWorking ? "Showing working agents only — click to show all" : "Click to show only working agents")">
            ⚡ Working Only @if (_showOnlyWorking) { <span>(@CountByStatus(AgentStatus.Working))</span> }
        </button>
    </div>
</div>

@if (_hasDeadlock)
{
    <div class="deadlock-banner">
        <span class="deadlock-icon">🔒</span>
        <span>Deadlock detected among agents: @(string.Join(" → ", _deadlockCycle ?? []))</span>
    </div>
}

@if (_isProjectComplete)
{
    <div class="project-complete-banner" data-testid="project-complete-banner">
        <div class="complete-icon">🎉</div>
        <div class="complete-content">
            <h2>Project Complete!</h2>
            <p>All PRs merged and all issues closed — the project has been delivered successfully.</p>
        </div>
    </div>
}

@* ── Project Control Card ── *@
<div class="project-control-card">
    <div class="project-control-header">
        <span class="project-control-icon">
            @switch (_runState)
            {
                case "Running": <span>🚀</span> break;
                case "Paused": <span>⏸️</span> break;
                case "Completed": <span>✅</span> break;
                case "Failed": <span>❌</span> break;
                default: <span>⏹️</span> break;
            }
        </span>
        <div class="project-control-info">
            <span class="project-control-title">
                @{
                    var repoName = Config.Value.Project.GitHubRepo;
                    var defaultBranch = Config.Value.Project.DefaultBranch ?? "main";
                    var workingBranch = DevelopSettingsService.Current?.WorkingBranch;
                }
                @if (!string.IsNullOrEmpty(repoName))
                {
                    @repoName
                }
                else if (!string.IsNullOrEmpty(_runDisplayName))
                {
                    @_runDisplayName
                }
                else
                {
                    <span>No Active Run</span>
                }
            </span>
            @if (!string.IsNullOrEmpty(workingBranch))
            {
                <span class="project-control-repo" title="Base branch → working branch">🔀 @defaultBranch → @workingBranch</span>
            }
            else if (!string.IsNullOrEmpty(repoName))
            {
                <span class="project-control-repo" title="Default branch">🔀 @defaultBranch</span>
            }
            <span class="project-control-status status-@_runState.ToLowerInvariant()">@_runState</span>
        </div>
        <div class="project-control-actions">
            @if (_runState is "Running")
            {
                <button class="btn-danger" @onclick="PauseRunAsync" disabled="@_runActionPending"
                        title="Pauses the current run. All agents will be stopped gracefully and workflow state will be checkpointed. You can resume later with the Continue button.">
                    @(_runActionPending ? "Pausing..." : "⏸ Pause")
                </button>
            }
            else if (_runState is "Paused")
            {
                <button class="btn-primary" @onclick="ResumeRunAsync" disabled="@_runActionPending"
                        title="Resumes the paused run. Agents will be respawned and continue from the last checkpointed workflow phase.">
                    @(_runActionPending ? "Resuming..." : "▶ Continue")
                </button>
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_runError))
    {
        <div class="project-control-error">⚠ @_runError</div>
    }
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-label">Total Agents</div>
        <div class="stat-value">@_agents.Count</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Idle</div>
        <div class="stat-value green">@CountByStatus(AgentStatus.Idle)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Working</div>
        <div class="stat-value cyan">@CountByStatus(AgentStatus.Working)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Blocked</div>
        <div class="stat-value red">@CountByStatus(AgentStatus.Blocked)</div>
    </div>
    @if (_decisionLog is not null)
    {
        var pending = _decisionLog.GetPendingDecisions().Count;
        var total = _decisionLog.GetAllDecisions().Count;
        <div class="stat-card @(pending > 0 ? "stat-card-alert" : "")">
            <div class="stat-label">⚖️ Decisions</div>
            <div class="stat-value @(pending > 0 ? "amber" : "")">
                @total
                @if (pending > 0)
                {
                    <span class="stat-sub-badge">@pending gated</span>
                }
            </div>
        </div>
    }
</div>

@if (_teamComposition is not null)
{
    <div class="team-composition-card" @onclick="() => _teamCompExpanded = !_teamCompExpanded">
        <div class="team-comp-header">
            <span class="team-comp-icon">🏗️</span>
            <span class="team-comp-title">Team Composition</span>
            <span class="team-comp-summary">@_teamCompSummary</span>
            <span class="team-comp-chevron @(_teamCompExpanded ? "expanded" : "")">▶</span>
        </div>
        @if (_teamCompExpanded)
        {
            <div class="team-comp-body" @onclick:stopPropagation="true">
                @((MarkupString)Markdig.Markdown.ToHtml(_teamComposition, _mdPipeline))
            </div>
        }
    </div>
}

@if (_agents.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">🤖</div>
        <div class="empty-text">No agents registered</div>
        <div class="empty-sub">Agents will appear here once they connect to the orchestrator</div>
    </div>
}
else
{
    <div class="agent-grid">
        @foreach (var agent in _visibleAgents)
        {
            var statusClass = $"status-{agent.Status.ToString().ToLowerInvariant()}";
            var roleClass = $"role-{agent.Role.ToString().ToLowerInvariant()}";
            var selectedClass = _selectedAgentId == agent.Id ? "selected" : "";
            var approvalClass = IsAwaitingApproval(agent) ? "awaiting-approval" : "";

            <div class="agent-card @statusClass @selectedClass @approvalClass" @onclick="() => NavigateToAgent(agent.Id)" data-testid="agent-card" data-agent-id="@agent.Id" data-agent-status="@agent.Status">
                <div class="agent-card-header">
                    <div class="agent-avatar @roleClass">
                        @GetRoleInitials(agent.Role, agent.Specialty)
                    </div>
                    <div class="agent-info">
                        <div class="agent-name" title="@agent.DisplayName">@agent.DisplayName</div>
                        <div class="agent-role" style="position:relative; cursor:pointer;" @onclick:stopPropagation="true" @onclick="() => ToggleRolePopover(agent.Id)">
                            @FormatRole(agent.Role, agent.Specialty)
                            @if (_rolePopoverId == agent.Id)
                            {
                                <div class="role-popover" @onclick:stopPropagation="true">
                                    <span class="role-popover-close" @onclick="() => _rolePopoverId = null">✕</span>
                                    @_rolePopoverDescription
                                </div>
                            }
                        </div>
                        @if (agent.Capabilities.Count > 0)
                        {
                            <div class="agent-capabilities">
                                @foreach (var cap in agent.Capabilities.Take(3))
                                {
                                    <span class="capability-tag">@cap</span>
                                }
                                @if (agent.Capabilities.Count > 3)
                                {
                                    <span class="capability-more">+@(agent.Capabilities.Count - 3)</span>
                                }
                            </div>
                        }
                    </div>
                    <span class="status-badge @statusClass">
                        <span class="status-dot"></span>
                        @agent.Status
                    </span>
                </div>
                <div class="agent-card-body">
                    @* Task = parent task name; Step = specific activity within that task *@
                    @{
                        // Only show live step data for Working agents — idle/error/blocked agents
                        // may have stale steps in the tracker that were never CompleteStep'd
                        var isWorking = agent.Status == AgentStatus.Working;
                        var activeStep = isWorking ? _taskTracker?.GetCurrentStep(agent.Id) : null;
                        var stepName = isWorking ? (agent.CurrentStepName ?? activeStep?.Name) : null;
                        var stepDescription = isWorking ? (agent.CurrentStepDescription ?? activeStep?.Description) : null;
                        // Resolve the parent task display name from the task tracker groups
                        // In standalone mode (5051), use the pre-resolved CurrentTaskName from the DTO
                        string? parentTaskName = isWorking ? agent.CurrentTaskName : null;
                        if (parentTaskName is null && activeStep is not null && _taskTracker is not null)
                        {
                            var groups = _taskTracker.GetGroupedSteps(agent.Id);
                            parentTaskName = groups.FirstOrDefault(g => g.TaskId == activeStep.TaskId)?.DisplayName;
                        }
                        var taskDisplay = parentTaskName ?? agent.StatusReason;
                        var timeInState = DateTime.UtcNow - agent.LastStatusChange;
                        var timeLabel = timeInState.TotalMinutes < 1 ? "just now"
                            : timeInState.TotalMinutes < 60 ? $"{(int)timeInState.TotalMinutes}m ago"
                            : $"{(int)timeInState.TotalHours}h {(int)(timeInState.TotalMinutes % 60)}m ago";
                    }
                    <div class="agent-detail">
                        <span class="detail-label">Task</span>
                        @if (!string.IsNullOrEmpty(taskDisplay))
                        {
                            <span class="detail-value task-active" title="@agent.StatusReason">@TruncateTask(taskDisplay)</span>
                        }
                        else if (agent.AssignedPullRequest is not null)
                        {
                            <span class="detail-value task-active">PR #@agent.AssignedPullRequest</span>
                        }
                        else
                        {
                            <span class="detail-value task-idle">Idle</span>
                        }
                    </div>
                    @{
                        var stepInfo = isWorking ? GetAgentStepInfo(agent.Id) : (completed: 0, total: 0, currentName: (string?)null, tooltip: (string?)null);
                    }
                    @if (!string.IsNullOrEmpty(stepName))
                    {
                        var isSinglePass = Config.Value.CopilotCli.SinglePassMode && stepInfo.total <= 1;
                        var stepText = (stepInfo.total > 0 && !isSinglePass) ? $"Step {stepInfo.completed}/{stepInfo.total}: {TruncateTask(stepName)}" : TruncateTask(stepName);
                        <div class="agent-detail">
                            <span class="detail-label">⚡ Step</span>
                            <span class="detail-value step-active" title="@stepDescription">@stepText</span>
                        </div>
                        @if (stepInfo.total > 0 && !isSinglePass)
                        {
                            var stepPct = (int)(100.0 * stepInfo.completed / stepInfo.total);
                            <div class="step-compact-bar">
                                <div class="step-compact-fill" style="width: @(stepPct)%"></div>
                            </div>
                        }
                    }

                    @* LLM call elapsed time *@
                    @if (agent.LlmCallElapsedTime.HasValue)
                    {
                        var llmElapsed = agent.LlmCallElapsedTime.Value;
                        var llmTimeStr = llmElapsed.TotalSeconds < 60
                            ? $"{(int)llmElapsed.TotalSeconds}s"
                            : $"{(int)llmElapsed.TotalMinutes}m {llmElapsed.Seconds}s";
                        var isSlowCall = llmElapsed.TotalSeconds > 30;
                        <div class="agent-detail llm-call-detail">
                            <span class="detail-label">🤖 AI</span>
                            <span class="detail-value @(isSlowCall ? "llm-call-slow" : "llm-call-active")">
                                @llmTimeStr @if (isSlowCall) { <span title="LLM call exceeding 30s">⚠</span> }
                            </span>
                        </div>
                    }

                    @* Work item link (PR or Issue) — prefers structured CurrentPrNumber (set by
                       engineers + doc-PR agents) over the StatusReason parse fallback. *@
                    @{ var prNum = agent.CurrentPrNumber?.ToString() ?? ExtractPrNumber(agent.StatusReason) ?? agent.AssignedPullRequest; }
                    @if (agent.Status == AgentStatus.Blocked && agent.BlockedReason is { } blockedReason)
                    {
                        @* Blocked-state badge: deep-link to /approvals?focus={GateId} so the operator
                           lands directly on the matching gate card (agent-blocked-show-approval-link). *@
                        var blockedSinceMin = (int)(DateTime.UtcNow - blockedReason.BlockedSince).TotalMinutes;
                        var tooltip = blockedReason.PullRequestNumber is { } bprn
                            ? $"{blockedReason.GateName} — waiting {blockedSinceMin}m on PR #{bprn}"
                            : $"{blockedReason.GateName} — waiting {blockedSinceMin}m";
                        <div class="agent-detail" @onclick:stopPropagation="true">
                            <span class="detail-label">🚦 Gate</span>
                            <a class="badge-blocked-gate"
                               href="@($"/approvals?focus={blockedReason.GateId}")"
                               title="@tooltip"
                               data-testid="agent-card-blocked-gate-link"
                               data-gate-id="@blockedReason.GateId">
                                Review needed →
                            </a>
                        </div>
                    }
                    else if (prNum is not null)
                    {
                        var prLinkUrl = int.TryParse(prNum, out var prId)
                            ? LinkService.BuildPullRequestUrl(prId, DataService.GetPullRequestUrl(prId))
                            : $"#pr-{prNum}";
                        var prLinkTarget = LinkService.TargetForUrl(prLinkUrl);
                        var prLinkRel = prLinkTarget == "_blank" ? "noopener" : null;
                        var prLinkTitle = LinkService.IsInternal(prLinkUrl)
                            ? $"View PR #{prNum} in dashboard"
                            : $"Open PR #{prNum} on {LinkService.PlatformDisplayName}";
                        var prLinkArrow = LinkService.IsInternal(prLinkUrl) ? "" : "↗";
                        <div class="agent-detail" @onclick:stopPropagation="true">
                            <span class="detail-label">🔗 PR</span>
                            <a class="badge-pr" href="@prLinkUrl" target="@prLinkTarget" rel="@prLinkRel" title="@prLinkTitle" data-testid="agent-card-pr-link" data-pr-number="@prNum">
                                #@prNum @prLinkArrow
                            </a>
                        </div>
                    }

                    @* Approval details when awaiting gate *@
                    @if (IsAwaitingApproval(agent))
                    {
                        var gate = GetActiveGateForAgent(agent);
                        <div class="agent-detail approval-detail">
                            <span class="detail-label">🚦 Gate</span>
                            <span class="detail-value approval-value">
                                @if (gate is not null)
                                {
                                    <span title="@gate.Context">@gate.GateName</span>
                                    @if (gate.GitHubUrl is not null)
                                    {
                                        var (gateHref, gateTarget, gateRel, gateTitle) = ResolveGateLink(gate);
                                        <a class="gate-link" href="@gateHref" target="@gateTarget" rel="@gateRel" title="@gateTitle" @onclick:stopPropagation="true">Review</a>
                                    }
                                }
                                else
                                {
                                    <span>@ExtractGateName(agent.StatusReason)</span>
                                }
                            </span>
                        </div>
                    }

                    @* Time in state + diagnostic compliance *@
                    @if (!agent.DiagnosticCompliant && !string.IsNullOrEmpty(agent.DiagnosticComplianceIssue))
                    {
                        <div class="agent-detail diagnostic-row" title="@agent.DiagnosticJustification">
                            <span class="detail-label">⚠️ Issue</span>
                            <span class="detail-value diagnostic-value non-compliant-text">
                                @TruncateDiagnostic(agent.DiagnosticComplianceIssue)
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="agent-detail diagnostic-row">
                            <span class="detail-label">🕐 Since</span>
                            <span class="detail-value diagnostic-value">@timeLabel</span>
                        </div>
                    }

                    @* AI Assessment badge — shows when latest assessment targets this agent *@
                    @if (_agentIssues.TryGetValue(agent.Id, out var aiIssues) && aiIssues.Count > 0)
                    {
                        var topIssue = aiIssues[0];
                        var issueSeverityClass = string.Equals(topIssue.Severity, "warning", StringComparison.OrdinalIgnoreCase)
                            ? "ai-badge-warning" : "ai-badge-info";
                        var badgeText = aiIssues.Count == 1
                            ? TruncateDiagnostic(topIssue.Description ?? "AI concern")
                            : $"{aiIssues.Count} AI findings";
                        <div class="agent-detail ai-assessment-row" title="@(topIssue.Description ?? "From latest pipeline assessment")">
                            <span class="detail-label">🤖 AI</span>
                            <span class="detail-value @issueSeverityClass">@badgeText</span>
                        </div>
                    }

                    <div class="agent-detail" @onclick:stopPropagation="true">
                        @if (_editingModelAgentId == agent.Id)
                        {
                            <select class="model-select" value="@agent.ActiveModel"
                                    @onchange="(e) => OnModelSelected(agent.Id, e)" data-testid="agent-card-model-select">
                                @foreach (var model in _availableModels)
                                {
                                    <option value="@model" selected="@(model == agent.ActiveModel)">@model</option>
                                }
                            </select>
                            <button class="model-edit-btn" @onclick="() => _editingModelAgentId = null" title="Cancel" data-testid="agent-card-model-cancel">✕</button>
                        }
                        else
                        {
                            <span class="detail-value">@agent.ActiveModel</span>
                            <button class="model-edit-btn" @onclick="() => _editingModelAgentId = agent.Id" title="Change model" data-testid="agent-card-model-edit">✏️</button>
                        }
                    </div>
                    @if (agent.Status == AgentStatus.Working)
                    {
                        <div class="agent-detail">
                            <span class="detail-label">Duration</span>
                            <span class="detail-value task-active">@FormatDuration(DateTime.UtcNow - agent.LastStatusChange)</span>
                        </div>
                    }
                    @if (agent.ErrorCount > 0)
                    {
                        <div class="agent-detail error-badge-row" @onclick:stopPropagation="true" @onclick="() => ShowErrors(agent.Id)" data-testid="agent-card-error-badge">
                            <span class="error-badge">⚠ @agent.ErrorCount error@(agent.ErrorCount != 1 ? "s" : "")</span>
                        </div>
                    }
                    <div class="agent-actions" @onclick:stopPropagation="true">
                        <button class="action-btn role-btn" @onclick="() => OpenRoleEditor(agent.Id)" title="View/edit role description" data-testid="agent-card-role-btn">📝 Role</button>
                        <button class="action-btn chat-btn" @onclick="() => OpenChat(agent.Id)" title="Chat with this agent" data-testid="agent-card-chat-btn">💬 Chat</button>
                        <button class="agent-btn-log @(agent.Status == AgentStatus.Working ? "has-activity" : "")" @onclick="() => OpenLog(agent.Id, agent.DisplayName)" title="View live CLI session output" data-testid="agent-card-log-btn">📋 Log</button>
                        @if (_restartConfirmAgentId == agent.Id)
                        {
                            <button class="action-btn restart-btn restart-confirm" @onclick="() => ConfirmRestart(agent.Id)" title="Click again to confirm — this will stop the agent, discard in-memory state, and restart it. Any in-progress LLM call will be lost. The agent will recover durable state (PRs, issues) on restart." data-testid="agent-card-restart-confirm">⚠ Confirm?</button>
                        }
                        else if (_restartingAgentId == agent.Id)
                        {
                            <button class="action-btn restart-btn" disabled title="Restarting...">🔄 ...</button>
                        }
                        else
                        {
                            <button class="action-btn restart-btn" @onclick="() => RequestRestart(agent.Id)" title="🔄 Restart: Stops and recreates this agent with the same identity. In-progress LLM calls are lost, but durable state (PRs, issues, task assignments) is recovered automatically. Use when an agent is stuck, looping, or in a bad state." data-testid="agent-card-restart-btn">🔄</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_showErrorModal && _errorModalAgentId is not null)
{
    <div class="modal-overlay" @onclick="CloseErrorModal" data-testid="modal-agent-errors">
        <div class="error-modal" @onclick:stopPropagation="true">
            <div class="error-modal-header">
                <h3>Errors — @_errorModalAgentName</h3>
                <button class="modal-close" @onclick="CloseErrorModal" data-testid="modal-error-close">✕</button>
            </div>
            <div class="error-modal-body" data-testid="modal-error-body">
                @if (_errorEntries.Count == 0)
                {
                    <div class="empty-errors">No errors recorded</div>
                }
                else
                {
                    @foreach (var err in _errorEntries)
                    {
                        <div class="error-entry @(err.Level == Microsoft.Extensions.Logging.LogLevel.Warning ? "warn" : "err")" data-testid="modal-error-entry">
                            <div class="error-entry-header">
                                <span class="error-level">@(err.Level == Microsoft.Extensions.Logging.LogLevel.Warning ? "⚠ WARN" : "❌ ERROR")</span>
                                <LocalTimeText Value="err.Timestamp" CssClass="error-time" IncludeSeconds="true" />
                            </div>
                            <div class="error-message">@err.Message</div>
                            @if (err.ExceptionDetails is not null)
                            {
                                <details class="error-details">
                                    <summary>Stack trace</summary>
                                    <pre>@err.ExceptionDetails</pre>
                                </details>
                            }
                        </div>
                    }
                }
            </div>
            <div class="error-modal-footer">
                <button class="btn-reset" @onclick="ResetErrors" data-testid="modal-error-reset">Clear All Errors</button>
            </div>
        </div>
    </div>
}

@* Chat Modal *@
@if (_showChatModal && _chatAgentId is not null)
{
    <div class="modal-overlay" @onclick="CloseChat">
        <div class="chat-modal" @onclick:stopPropagation="true">
            <div class="chat-modal-header">
                <div class="chat-header-left">
                    <h3>💬 @_chatAgentName</h3>
                    @if (_chatAgent is not null && !string.IsNullOrEmpty(_chatAgent.DiagnosticSummary))
                    {
                        <span class="chat-diag-badge @(_chatAgent.DiagnosticCompliant ? "compliant" : "non-compliant")"
                              title="@_chatAgent.DiagnosticJustification">
                            @(_chatAgent.DiagnosticCompliant ? "✅" : "⚠️") @_chatAgent.DiagnosticSummary
                        </span>
                    }
                </div>
                <button class="modal-close" @onclick="CloseChat">✕</button>
            </div>
            <div class="chat-modal-body">
                @if (_chatMessages.Count == 0 && !_chatSending)
                {
                    <div class="chat-empty">
                        <div class="chat-empty-icon">💬</div>
                        <div class="chat-empty-text">Ask @_chatAgentName anything</div>
                        <div class="chat-empty-examples">
                            <div class="chat-example" @onclick='() => SetChatInput("What are you currently working on and why?")'>
                                "What are you currently working on and why?"
                            </div>
                            <div class="chat-example" @onclick='() => SetChatInput("Explain your last decision in detail.")'>
                                "Explain your last decision in detail."
                            </div>
                            <div class="chat-example" @onclick='() => SetChatInput("What should you be doing right now according to the scenarios?")'>
                                "What should you be doing right now?"
                            </div>
                        </div>
                    </div>
                }
                @foreach (var msg in _chatMessages)
                {
                    <div class="chat-message @(msg.Role == "user" ? "chat-user" : "chat-assistant")">
                        <div class="chat-msg-header">
                            <span class="chat-role">@(msg.Role == "user" ? "👤 You" : $"🤖 {_chatAgentName}")</span>
                            <LocalTimeText Value="msg.Timestamp" CssClass="chat-time" IncludeSeconds="true" />
                        </div>
                        <div class="chat-msg-body">@((MarkupString)RenderMarkdown(msg.Content))</div>
                    </div>
                }
                @if (_chatSending)
                {
                    <div class="chat-message chat-assistant">
                        <div class="chat-msg-header">
                            <span class="chat-role">🤖 @_chatAgentName</span>
                        </div>
                        <div class="chat-msg-body chat-typing">Thinking…</div>
                    </div>
                }
            </div>
            <div class="chat-modal-footer">
                <input class="chat-input" type="text" placeholder="Ask a question or give an instruction…"
                       @bind="_chatInput" @bind:event="oninput"
                       @onkeydown="OnChatKeyDown"
                       disabled="@_chatSending" />
                <button class="chat-send-btn" @onclick="SendChat"
                        disabled="@(_chatSending || string.IsNullOrWhiteSpace(_chatInput))">
                    @(_chatSending ? "⏳" : "➤")
                </button>
            </div>
        </div>
    </div>
}

@* Role Editor Modal *@
@if (_showRoleModal && _roleAgentId is not null)
{
    <div class="modal-overlay" @onclick="CloseRoleEditor" data-testid="modal-role-editor">
        <div class="role-modal" @onclick:stopPropagation="true">
            <div class="role-modal-header">
                <h3>📝 @_roleAgentName — Role Description</h3>
                <button class="modal-close" @onclick="CloseRoleEditor" data-testid="modal-role-close">✕</button>
