@page "/flow-monitor/recommendations"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Markdig
@using VirtualDevTeam.Core.HealthMonitor
@inject IServiceProvider ServiceProvider
@implements IDisposable

<PageTitle>Virtual Dev Team — Flow Monitor Recommendations</PageTitle>

<div class="dashboard-header" data-testid="page-flow-monitor-recommendations">
    <h2>Flow Monitor Recommendations</h2>
    <div class="fmr-header-links">
        <a href="/flow-monitor" class="fmr-header-link">🔍 Flow Monitor</a>
        <a href="/approvals" class="fmr-header-link">🚦 Approvals</a>
    </div>
</div>

@{
    var filteredRecommendations = FilteredRecommendations();
}

<div class="fmr-toolbar">
    <input class="fmr-search"
           type="search"
           placeholder="Search detector, finding, files, or plan text"
           @bind="_searchText"
           @bind:event="oninput" />

    <select class="fmr-select" @bind="_stateFilter">
        <option value="all">All states</option>
        @foreach (var state in Enum.GetValues<FixRecommendationState>())
        {
            <option value="@state">@state</option>
        }
    </select>

    <select class="fmr-select" @bind="_severityFilter">
        <option value="all">All severities</option>
        @foreach (var severity in Enum.GetValues<FlowFindingSeverity>())
        {
            <option value="@severity">@severity</option>
        }
    </select>

    <div class="fmr-summary">@filteredRecommendations.Count of @_recommendations.Count recommendations shown</div>
</div>

@if (filteredRecommendations.Count == 0)
{
    <div class="fmr-empty" data-testid="flow-monitor-recommendations-empty">
        @(_recommendations.Count == 0 ? "No Flow Monitor recommendations yet." : "No recommendations match the current filters.")
    </div>
}
else
{
    <div class="fmr-list">
        @foreach (var rec in filteredRecommendations)
        {
            if (!_feedbackById.ContainsKey(rec.Id))
            {
                _feedbackById[rec.Id] = string.Empty;
            }

            var planExpanded = _expandedPlans.Contains(rec.Id);
            var preview = GetPlanPreview(rec.PlanMarkdown);
            var severityClass = $"fmr-severity-{rec.Severity.ToString().ToLowerInvariant()}";
            var confidenceClass = rec.Confidence >= 0.75 ? "fmr-confidence-high"
                : rec.Confidence >= 0.5 ? "fmr-confidence-med"
                : "fmr-confidence-low";
            var (tierEmoji, tierLabel, tierClass, tierTooltip) = GetTierPresentation(rec.FixTier);
            var stateHint = GetStateHint(rec.State);
            var pending = rec.State == FixRecommendationState.PendingReview;

            <div class="fmr-card" id="@($"rec-{rec.Id}")" data-testid="@($"fixrec-page-card-{rec.Id}")">
                <div class="fmr-card-header">
                    <div>
                        <div class="fmr-title-row">
                            <span class="fmr-title">@rec.DetectorId</span>
                            <span class="fmr-tier @tierClass" title="@tierTooltip">@tierEmoji @tierLabel</span>
                            <span class="fmr-badge @severityClass">@rec.Severity</span>
                            <span class="fmr-badge @confidenceClass">@rec.Confidence.ToString("0%") confidence</span>
                            <span class="fmr-badge fmr-state">@rec.State</span>
                        </div>
                        <div class="fmr-meta">
                            <span>Finding <a href="@($"/health#finding-{rec.FindingId}")">@ShortId(rec.FindingId)</a></span>
                            <span>Recommendation @ShortId(rec.Id)</span>
                            <span><LocalTimeText OffsetValue="rec.CreatedAt" CssClass="fmr-time" /></span>
                            @if (rec.EstimatedMinutes is int mins)
                            {
                                <span>~@mins min</span>
                            }
                            @if (rec.ReworkCount > 0)
                            {
                                <span>rework v@(rec.ReworkCount + 1)</span>
                            }
                        </div>
                    </div>
                    @if (rec.NeedsRestart)
                    {
                        <span class="fmr-restart-pill">⟳ restart-aware</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(rec.FilesToChange))
                {
                    <div class="fmr-files"><strong>Files:</strong> <code>@rec.FilesToChange</code></div>
                }

                <div class="fmr-state-hint">@stateHint</div>

                @if (!string.IsNullOrWhiteSpace(preview))
                {
                    <div class="fmr-preview">@preview</div>
                }

                <button class="fmr-plan-toggle" @onclick="() => TogglePlan(rec.Id)">
                    @(planExpanded ? "▾ Hide full plan" : "📋 View full plan")
                </button>

                @if (planExpanded)
                {
                    <div class="fmr-plan-body">
                        @((MarkupString)RenderSafeMarkdown(rec.PlanMarkdown))
                    </div>
                }

                @if (_actionStateById.TryGetValue(rec.Id, out var actionState))
                {
                    <div class="fmr-action-state">
                        <span class="rework-spinner"></span>
                        <span>@actionState</span>
                    </div>
                }

                @if (pending && !_actionStateById.ContainsKey(rec.Id))
                {
                    <div class="fmr-actions">
                        <textarea class="approval-feedback-input"
                                  rows="3"
                                  placeholder="Operator feedback for rework"
                                  @bind="_feedbackById[rec.Id]"
                                  @bind:event="oninput"></textarea>
                        <div class="approval-footer-buttons">
                            <button class="approval-action-btn approve-btn" @onclick="() => ApproveAsync(rec.Id)">
                                ✅ Approve
                            </button>
                            <button class="approval-action-btn review-btn" @onclick="() => ApproveAndRestartAsync(rec.Id)">
                                🔄 Approve with Restart
                            </button>
                            <button class="approval-action-btn review-btn" @onclick="() => ReworkAsync(rec.Id)">
                                📝 Rework
                            </button>
                            <button class="approval-action-btn reject-btn" @onclick="() => DismissAsync(rec.Id)">
                                🗑️ Dismiss
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .fmr-header-links { display:flex; gap:0.75rem; flex-wrap:wrap; }
    .fmr-header-link { color: var(--text-primary, #e5e7eb); text-decoration:none; font-size:0.95rem; }
    .fmr-header-link:hover { text-decoration:underline; }
    .fmr-toolbar { display:grid; grid-template-columns:minmax(240px, 1fr) 180px 180px auto; gap:0.75rem; align-items:center; margin-bottom:1rem; }
    .fmr-search, .fmr-select { background:rgba(15,23,42,0.65); color:#e5e7eb; border:1px solid rgba(148,163,184,0.28); border-radius:10px; padding:0.65rem 0.8rem; }
    .fmr-summary { justify-self:end; color:rgba(226,232,240,0.75); font-size:0.9rem; }
    .fmr-empty { padding:1.25rem; border:1px solid rgba(148,163,184,0.2); border-radius:12px; background:rgba(15,23,42,0.45); color:rgba(226,232,240,0.75); }
    .fmr-list { display:flex; flex-direction:column; gap:1rem; }
    .fmr-card { border:1px solid rgba(148,163,184,0.2); border-radius:16px; background:rgba(15,23,42,0.45); padding:1rem; box-shadow:0 10px 30px rgba(2,6,23,0.22); }
    .fmr-card-header { display:flex; justify-content:space-between; gap:1rem; align-items:flex-start; }
    .fmr-title-row { display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; }
    .fmr-title { font-size:1.05rem; font-weight:700; color:#f8fafc; }
    .fmr-meta { display:flex; flex-wrap:wrap; gap:0.85rem; margin-top:0.45rem; color:rgba(226,232,240,0.72); font-size:0.88rem; }
    .fmr-meta a { color:#7dd3fc; }
    .fmr-badge, .fmr-tier, .fmr-restart-pill { display:inline-flex; align-items:center; gap:0.3rem; padding:0.18rem 0.55rem; border-radius:999px; font-size:0.76rem; font-weight:700; }
    .fmr-tier { background:rgba(51,65,85,0.55); color:#e2e8f0; }
    .fmr-tier-live { background:rgba(16,185,129,0.16); color:#6ee7b7; }
    .fmr-tier-deferred { background:rgba(245,158,11,0.16); color:#fbbf24; }
    .fmr-tier-blocked { background:rgba(248,113,113,0.16); color:#fca5a5; }
    .fmr-tier-unknown { background:rgba(148,163,184,0.16); color:#cbd5e1; }
    .fmr-state { background:rgba(59,130,246,0.18); color:#bfdbfe; }
    .fmr-restart-pill { background:rgba(168,85,247,0.18); color:#d8b4fe; }
    .fmr-severity-info { background:rgba(59,130,246,0.16); color:#bfdbfe; }
    .fmr-severity-warning { background:rgba(245,158,11,0.16); color:#fbbf24; }
    .fmr-severity-critical { background:rgba(248,113,113,0.16); color:#fca5a5; }
    .fmr-confidence-high { background:rgba(16,185,129,0.16); color:#6ee7b7; }
    .fmr-confidence-med { background:rgba(245,158,11,0.16); color:#fbbf24; }
    .fmr-confidence-low { background:rgba(248,113,113,0.16); color:#fca5a5; }
    .fmr-files, .fmr-preview, .fmr-state-hint { margin-top:0.8rem; color:#e2e8f0; }
    .fmr-preview { color:rgba(226,232,240,0.82); }
    .fmr-state-hint { font-size:0.9rem; color:#93c5fd; }
    .fmr-plan-toggle { margin-top:0.75rem; background:transparent; border:none; color:#7dd3fc; cursor:pointer; padding:0; }
    .fmr-plan-body { margin-top:0.9rem; border-top:1px solid rgba(148,163,184,0.15); padding-top:0.9rem; color:#e2e8f0; }
    .fmr-action-state { display:flex; align-items:center; gap:0.6rem; margin-top:0.9rem; color:#bfdbfe; }
    .rework-spinner { width:0.9rem; height:0.9rem; border:2px solid rgba(191,219,254,0.25); border-top-color:#bfdbfe; border-radius:50%; animation:fmr-spin 0.85s linear infinite; }
    .fmr-actions { margin-top:1rem; display:flex; flex-direction:column; gap:0.75rem; }

    @@keyframes fmr-spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 900px) {
        .fmr-toolbar { grid-template-columns:1fr; }
        .fmr-summary { justify-self:start; }
        .fmr-card-header { flex-direction:column; }
    }
</style>

@code {
    private readonly Dictionary<string, string> _feedbackById = new();
    private readonly Dictionary<string, string> _actionStateById = new();
    private readonly HashSet<string> _expandedPlans = new();
    private readonly List<FixRecommendation> _recommendations = new();
    private HttpClient? _http;
    private System.Threading.Timer? _pollTimer;
    private int _refreshInProgress;
    private string _searchText = string.Empty;
    private string _stateFilter = "all";
    private string _severityFilter = "all";

    private static readonly MarkdownPipeline _markdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
    private static readonly Ganss.Xss.HtmlSanitizer _htmlSanitizer = new();

    protected override void OnInitialized()
    {
        var factory = ServiceProvider.GetService<IHttpClientFactory>();
        _http = factory?.CreateClient("RunnerApi") ?? new HttpClient { BaseAddress = new Uri("http://localhost:5050") };
        _pollTimer = new System.Threading.Timer(_ => _ = RefreshRecommendationsAsync(), null, 0, 5000);
    }

    private async Task RefreshRecommendationsAsync()
    {
        if (_http is null || System.Threading.Interlocked.Exchange(ref _refreshInProgress, 1) == 1) return;
        try
        {
            var recs = await _http.GetFromJsonAsync<List<FixRecommendation>>("/api/dashboard/health/flow-monitor/recommendations") ?? new();
            _recommendations.Clear();
            _recommendations.AddRange(recs);
            foreach (var rec in recs)
            {
                if (!_feedbackById.ContainsKey(rec.Id))
                {
                    _feedbackById[rec.Id] = string.Empty;
                }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // best-effort polling only
        }
        finally
        {
            System.Threading.Interlocked.Exchange(ref _refreshInProgress, 0);
        }
    }

    private List<FixRecommendation> FilteredRecommendations()
    {
        IEnumerable<FixRecommendation> query = _recommendations;

        if (!string.Equals(_stateFilter, "all", StringComparison.OrdinalIgnoreCase)
            && Enum.TryParse<FixRecommendationState>(_stateFilter, out var stateFilter))
        {
            query = query.Where(r => r.State == stateFilter);
        }

        if (!string.Equals(_severityFilter, "all", StringComparison.OrdinalIgnoreCase)
            && Enum.TryParse<FlowFindingSeverity>(_severityFilter, out var severityFilter))
        {
            query = query.Where(r => r.Severity == severityFilter);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(r =>
                ContainsIgnoreCase(r.DetectorId, _searchText)
                || ContainsIgnoreCase(r.FindingId, _searchText)
                || ContainsIgnoreCase(r.Id, _searchText)
                || ContainsIgnoreCase(r.FilesToChange, _searchText)
                || ContainsIgnoreCase(r.PlanMarkdown, _searchText));
        }

        return query
            .OrderByDescending(r => r.CreatedAt)
            .ToList();
    }

    private static bool ContainsIgnoreCase(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private void TogglePlan(string recommendationId)
    {
        if (!_expandedPlans.Add(recommendationId))
        {
            _expandedPlans.Remove(recommendationId);
        }
    }

    private async Task ApproveAsync(string recommendationId)
    {
        _actionStateById[recommendationId] = "Approving recommendation...";
        StateHasChanged();
        try
        {
            var approved = await PostActionAsync($"recommendations/{recommendationId}/approve", payload: null);
            if (!approved)
            {
                _actionStateById[recommendationId] = "⚠️ Approve failed.";
                StateHasChanged();
                await Task.Delay(2500);
            }
        }
        finally
        {
            _actionStateById.Remove(recommendationId);
            await RefreshRecommendationsAsync();
        }
    }

    private async Task ApproveAndRestartAsync(string recommendationId)
    {
        _actionStateById[recommendationId] = "Approving recommendation and restarting runner...";
        StateHasChanged();
        try
        {
            var approved = await PostActionAsync($"recommendations/{recommendationId}/approve", payload: null);
            if (!approved)
            {
                _actionStateById[recommendationId] = "⚠️ Approve failed — restart skipped.";
                StateHasChanged();
                await Task.Delay(2500);
                return;
            }

            _actionStateById[recommendationId] = "Restarting runner...";
            StateHasChanged();
            await PostRunnerRestartAsync();
        }
        finally
        {
            _actionStateById.Remove(recommendationId);
            await RefreshRecommendationsAsync();
        }
    }

    private async Task ReworkAsync(string recommendationId)
    {
        var feedback = _feedbackById.GetValueOrDefault(recommendationId, string.Empty);
        if (string.IsNullOrWhiteSpace(feedback))
        {
            _actionStateById[recommendationId] = "⚠️ Feedback required for rework.";
            StateHasChanged();
            await Task.Delay(2500);
            _actionStateById.Remove(recommendationId);
            StateHasChanged();
            return;
        }

        _actionStateById[recommendationId] = "Generating revised recommendation...";
        StateHasChanged();
        try
        {
            var reworked = await PostActionAsync($"recommendations/{recommendationId}/rework", new { feedback });
            if (!reworked)
            {
                _actionStateById[recommendationId] = "⚠️ Rework request failed.";
                StateHasChanged();
                await Task.Delay(2500);
                return;
            }

            _feedbackById[recommendationId] = string.Empty;
        }
        finally
        {
            _actionStateById.Remove(recommendationId);
            await RefreshRecommendationsAsync();
        }
    }

    private async Task DismissAsync(string recommendationId)
    {
        _actionStateById[recommendationId] = "Dismissing recommendation...";
        StateHasChanged();
        try
        {
            var dismissed = await PostActionAsync($"recommendations/{recommendationId}/reject", payload: null);
            if (!dismissed)
            {
                _actionStateById[recommendationId] = "⚠️ Dismiss failed.";
                StateHasChanged();
                await Task.Delay(2500);
            }
        }
        finally
        {
            _actionStateById.Remove(recommendationId);
            await RefreshRecommendationsAsync();
        }
    }

    private async Task<bool> PostActionAsync(string relativePath, object? payload)
    {
        if (_http is null) return false;
        try
        {
            using var response = payload is null
                ? await _http.PostAsync($"/api/dashboard/health/flow-monitor/{relativePath}", content: null)
                : await _http.PostAsJsonAsync($"/api/dashboard/health/flow-monitor/{relativePath}", payload);
            return response.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    private async Task PostRunnerRestartAsync()
    {
        if (_http is null) return;
        try
        {
            await _http.PostAsync("/api/dashboard/runtime/restart", content: null);
        }
        catch
        {
            // expected mid-flight while the runner restarts
        }
    }

    private static string GetPlanPreview(string planMarkdown)
    {
        if (string.IsNullOrWhiteSpace(planMarkdown)) return string.Empty;
        var lines = planMarkdown.Split('\n', StringSplitOptions.None)
            .Select(l => l.TrimEnd('\r'))
            .Where(l => !string.IsNullOrWhiteSpace(l)
                        && !l.StartsWith("---")
                        && !l.StartsWith("## Problem", StringComparison.OrdinalIgnoreCase)
                        && !l.StartsWith("# "))
            .Take(3)
            .ToList();
        return string.Join(" ", lines).Trim();
    }

    private static string RenderSafeMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        var html = Markdown.ToHtml(markdown, _markdownPipeline);
        return _htmlSanitizer.Sanitize(html);
    }

    private static string ShortId(string value) => value.Length <= 8 ? value : value[..8];

    private static (string Emoji, string Label, string CssClass, string Tooltip) GetTierPresentation(FixTier? tier) => tier switch
    {
        FixTier.Live => ("🟢", "Live", "fmr-tier-live", "Applies in-place with no restart."),
        FixTier.DeferredRestart => ("🟡", "Deferred", "fmr-tier-deferred", "Writes code now; restart runner to activate."),
        FixTier.Blocked => ("🔴", "Blocked", "fmr-tier-blocked", "Stages the fix for next runner boot."),
        _ => ("⚪", "Unknown", "fmr-tier-unknown", "Tier not classified yet."),
    };

    private static string GetStateHint(FixRecommendationState state) => state switch
    {
        FixRecommendationState.PendingReview => "Waiting for operator action.",
        FixRecommendationState.ApprovedForCoding => "Applying approved fix now.",
        FixRecommendationState.Applied => "Applied live — no restart needed.",
        FixRecommendationState.Coded => "Fix is coded — restart runner to activate.",
        FixRecommendationState.StagedForNextRestart or FixRecommendationState.RestartRequested => "Staged for the next runner restart.",
        FixRecommendationState.AppliedFailed => "Application failed — inspect the plan and runner logs.",
        FixRecommendationState.Complete => "Underlying issue is fully resolved.",
        FixRecommendationState.Pruned => "Recommendation was pruned because the finding cleared itself.",
        FixRecommendationState.Rejected => "Recommendation was dismissed by an operator.",
        _ => state.ToString(),
    };

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
