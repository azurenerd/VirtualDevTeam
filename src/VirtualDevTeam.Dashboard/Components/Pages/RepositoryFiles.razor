@page "/repository/files"
@page "/repository/files/{*FilePath}"
@using VirtualDevTeam.Core.DevPlatform.Models
@using VirtualDevTeam.Core.Configuration
@using VirtualDevTeam.Dashboard.Services
@using Markdig
@using Microsoft.Extensions.Options
@inject IDashboardDataService DataService
@inject NavigationManager Navigation
@inject IOptions<VirtualDevTeamConfig> Config
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Virtual Dev Team — Code</PageTitle>

<div class="page-header" data-testid="page-repository-files">
    <h1 class="page-title">💻 Code</h1>
    <div class="header-badges">
        <span class="badge badge-info">@_effectiveBranch</span>
        @if (_fileTree is not null)
        {
            <span class="badge badge-purple">@_fileTree.Files.Count files</span>
        }
    </div>
</div>

@* Tab bar — same order as Repository.razor: Code, Pull Requests, Issues *@
<div class="repo-tab-bar">
    <button class="repo-tab active">
        💻 Code
    </button>
    <button class="repo-tab" @onclick="NavigateToRepo">
        🔀 Pull Requests
    </button>
    <button class="repo-tab" @onclick='() => Navigation.NavigateTo("/repository/issues")'>
        📋 Issues
    </button>
</div>

@if (!_configured)
{
    <div class="files-no-config">
        <div class="files-no-config-icon">⚠️</div>
        <h3>No Repository Configured</h3>
        <p>Configure a repository connection to browse files.</p>
        <a href="/configuration" class="files-config-link">Go to Configuration →</a>
    </div>
}
else if (_loading)
{
    <div class="files-loading">
        <div class="files-spinner"></div>
        <span>Loading repository tree...</span>
    </div>
}
else if (_error is not null)
{
    <div class="files-error">
        <span>❌ @_error</span>
        <button class="files-retry-btn" @onclick="LoadTreeAsync">Retry</button>
    </div>
}
else if (_viewingFile)
{
    @* ── File Content View ── *@
    <div class="files-breadcrumb">
        <a class="files-breadcrumb-link" @onclick="NavigateToRoot" @onclick:preventDefault>@_repoName</a>
        @foreach (var segment in GetPathSegments())
        {
            <span class="files-breadcrumb-sep">/</span>
            @if (segment.IsLast)
            {
                <span class="files-breadcrumb-current">@segment.Name</span>
            }
            else
            {
                <a class="files-breadcrumb-link" @onclick="() => NavigateToPath(segment.FullPath)" @onclick:preventDefault>@segment.Name</a>
            }
        }
    </div>

    @if (_fileContent is null)
    {
        <div class="files-loading"><div class="files-spinner"></div><span>Loading file...</span></div>
    }
    else if (_fileContent.IsBinary)
    {
        <div class="files-binary-notice">
            <span>📦 Binary file — @_fileContent.FileName (@FormatSize(_fileContent.SizeBytes))</span>
        </div>
    }
    else
    {
        <div class="files-content-header">
            <span class="files-content-name">@_fileContent.FileName</span>
            <span class="files-content-size">@FormatSize(_fileContent.SizeBytes)</span>
            @if (_fileContent.WasTruncated)
            {
                <span class="files-content-truncated">⚠️ Truncated (showing first 100KB)</span>
            }
            @if (IsMarkdownFile(_fileContent.FileName) && !_fileContent.WasTruncated)
            {
                <div class="files-view-toggle">
                    <button class="files-toggle-btn @(!_previewMarkdown ? "active" : "")" @onclick="() => _previewMarkdown = false">
                        &lt;/&gt; Code
                    </button>
                    <button class="files-toggle-btn @(_previewMarkdown ? "active" : "")" @onclick="() => _previewMarkdown = true">
                        👁️ Preview
                    </button>
                </div>
            }
        </div>
        @if (_previewMarkdown && IsMarkdownFile(_fileContent.FileName))
        {
            <div class="files-markdown-preview">
                @((MarkupString)RenderMarkdownSafe(_fileContent.Content ?? ""))
            </div>
        }
        else
        {
            <div class="files-content-viewer">
                <table class="files-code-table">
                    @{ var lines = (_fileContent.Content ?? "").Split('\n'); }
                    @for (var i = 0; i < lines.Length; i++)
                    {
                        var lineNum = i + 1;
                        <tr class="files-code-line">
                            <td class="files-line-number">@lineNum</td>
                            <td class="files-line-content"><pre>@lines[i]</pre></td>
                        </tr>
                    }
                </table>
            </div>
        }
    }
}
else
{
    @* ── Directory Listing View ── *@
    <div class="files-breadcrumb">
        @if (string.IsNullOrEmpty(EffectiveFilePath))
        {
            <span class="files-breadcrumb-current">@_repoName</span>
        }
        else
        {
            <a class="files-breadcrumb-link" @onclick="NavigateToRoot" @onclick:preventDefault>@_repoName</a>
            @foreach (var segment in GetPathSegments())
            {
                <span class="files-breadcrumb-sep">/</span>
                @if (segment.IsLast)
                {
                    <span class="files-breadcrumb-current">@segment.Name</span>
                }
                else
                {
                    <a class="files-breadcrumb-link" @onclick="() => NavigateToPath(segment.FullPath)" @onclick:preventDefault>@segment.Name</a>
                }
            }
        }
    </div>

    <div class="files-table">
        <div class="files-table-header">
            <span>Name</span>
        </div>
        @foreach (var entry in GetCurrentDirectoryEntries())
        {
            <div class="files-table-row" @onclick="() => OnEntryClick(entry)">
                <span class="files-entry-icon">@(entry.IsDirectory ? "📁" : "📄")</span>
                <span class="files-entry-name">@entry.Name</span>
            </div>
        }
        @if (!GetCurrentDirectoryEntries().Any())
        {
            <div class="files-table-empty">No files in this directory</div>
        }
    </div>
}

@code {
    [Parameter] public string? FilePath { get; set; }

    private RepositoryFileTreeResult? _fileTree;
    private RepositoryFileContentResult? _fileContent;
    private string _effectiveBranch = "main";
    private string? _queryBranch; // From ?branch= query param (PR file links)
    private string? _queryPath;   // From ?path= query param (LocalDevPlatform body links)
    private string _repoName = "Repository";
    private bool _loading = true;
    private bool _configured = true;
    private bool _viewingFile;
    private bool _previewMarkdown;
    private string? _error;

    private static readonly MarkdownPipeline _markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    protected override async Task OnInitializedAsync()
    {
        _repoName = DataService.RepositoryDisplayName;
        if (string.IsNullOrEmpty(_repoName) || _repoName == "Unknown")
        {
            _configured = false;
            _loading = false;
            return;
        }
        if (_repoName.Contains('/'))
            _repoName = _repoName.Split('/').Last();

        // Read ?branch= and ?path= query params (used when navigating from PR/issue body links,
        // which use the query form: /repository/files?path=...&branch=...). The route-segment form
        // (/repository/files/{*FilePath}) is handled via the FilePath parameter.
        ReadQueryParams();

        // React to same-page query-string navigations (e.g. clicking a second ?path= link while
        // already on /repository/files). Route-param changes are handled by OnParametersSetAsync.
        Navigation.LocationChanged += OnLocationChanged;

        await LoadTreeAsync();
    }

    private void ReadQueryParams()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _queryBranch = query["branch"];
        _queryPath = query["path"];
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Only relevant while we're on the files page; the router replaces the component otherwise.
        if (!e.Location.Contains("/repository/files", StringComparison.OrdinalIgnoreCase)) return;

        try
        {
            var prevBranch = _queryBranch;
            ReadQueryParams();

            // If the branch changed, reload the tree; otherwise just re-resolve the view for the new path.
            if (!string.Equals(prevBranch, _queryBranch, StringComparison.OrdinalIgnoreCase))
                await InvokeAsync(LoadTreeAsync);
            else
                await InvokeAsync(DetermineViewMode);
        }
        catch (Exception ex)
        {
            _error = $"Navigation failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// The file/dir path being viewed. Prefers the route-segment form (<see cref="FilePath"/>),
    /// falling back to the <c>?path=</c> query param used by LocalDevPlatform body links.
    /// </summary>
    private string? EffectiveFilePath => !string.IsNullOrEmpty(FilePath) ? FilePath : _queryPath;

    protected override async Task OnParametersSetAsync()
    {
        if (_fileTree is null) return;
        await DetermineViewMode();
    }

    private async Task LoadTreeAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Use query param branch if provided (PR file links), otherwise default
            _fileTree = await DataService.GetRepositoryFileTreeAsync(branch: _queryBranch, ct: default);

            // Fallback: if branch returned empty tree (e.g., PR branch not in bare repo in LDP mode),
            // retry with default/working branch where the merged content lives
            if (_fileTree.Files.Count == 0 && !string.IsNullOrEmpty(_queryBranch))
            {
                _fileTree = await DataService.GetRepositoryFileTreeAsync(branch: null, ct: default);
            }

            _effectiveBranch = _fileTree.Branch;
            await DetermineViewMode();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load file tree: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task DetermineViewMode()
    {
        if (_fileTree is null) return;

        var normalizedPath = NormalizePath(EffectiveFilePath);

        // No path → root/directory listing.
        if (string.IsNullOrEmpty(normalizedPath))
        {
            SetDirectoryView();
            return;
        }

        // 1) File present in the already-loaded tree → view it on the current effective branch.
        if (TreeContainsFile(normalizedPath))
        {
            await ShowFileAsync(normalizedPath, _effectiveBranch);
            return;
        }

        // 2) The path LOOKS like a file but isn't on the currently-loaded branch. This is the
        //    common deep-link failure: a PR file link carries the PR's head branch (often deleted
        //    after merge in LocalDevPlatform), or the document lives only on the working branch
        //    (e.g. AgentDocs/{workingBranch}/PMSpec.md) while the loaded tree is the default branch.
        //    Probe candidate branches and display the file from wherever it actually exists — never
        //    silently fall back to the repository root for a real file.
        if (Path.HasExtension(normalizedPath))
        {
            foreach (var branch in CandidateBranches())
            {
                var content = await DataService.GetFileContentWithMetadataAsync(normalizedPath, branch);
                if (content is not null)
                {
                    _viewingFile = true;
                    _effectiveBranch = branch;
                    _previewMarkdown = IsMarkdownFile(normalizedPath);
                    _fileContent = content;
                    StateHasChanged();
                    return;
                }
            }
        }

        // 3) Genuinely a directory (or an unresolvable path) → directory listing.
        SetDirectoryView();
    }

    /// <summary>True when the loaded tree contains <paramref name="normalizedPath"/> (slash/case-insensitive).</summary>
    private bool TreeContainsFile(string normalizedPath) =>
        _fileTree is not null &&
        _fileTree.Files.Any(f =>
            string.Equals(f, normalizedPath, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(f.Replace('\\', '/'), normalizedPath.Replace('\\', '/'), StringComparison.OrdinalIgnoreCase));

    /// <summary>Renders a file view for <paramref name="normalizedPath"/> on <paramref name="branch"/>.</summary>
    private async Task ShowFileAsync(string normalizedPath, string branch)
    {
        _viewingFile = true;
        _fileContent = null;
        _previewMarkdown = IsMarkdownFile(normalizedPath); // Default to preview for .md files
        StateHasChanged();
        _fileContent = await DataService.GetFileContentWithMetadataAsync(normalizedPath, branch);
        StateHasChanged();
    }

    private void SetDirectoryView()
    {
        _viewingFile = false;
        _fileContent = null;
        _previewMarkdown = false;
    }

    /// <summary>
    /// Ordered, de-duplicated branches to probe when a file isn't found on the loaded tree's branch.
    /// Excludes the already-checked <see cref="_effectiveBranch"/>. Order: the requested query branch,
    /// then the working branch (where LocalDevPlatform merges land), then the configured default branch.
    /// </summary>
    private IEnumerable<string> CandidateBranches()
    {
        var cfg = Config.Value?.Project;
        return BuildBranchProbeOrder(_effectiveBranch, _queryBranch, cfg?.WorkingBranch, cfg?.DefaultBranch);
    }

    /// <summary>
    /// Pure branch-probe ordering used by <see cref="CandidateBranches"/>. Returns the distinct
    /// branches to try (in order) when a deep-linked file is not present on
    /// <paramref name="alreadyTried"/>: the query branch, then working branch, then default branch.
    /// Null/empty entries are skipped and <paramref name="alreadyTried"/> is excluded (it was checked).
    /// </summary>
    internal static IReadOnlyList<string> BuildBranchProbeOrder(
        string? alreadyTried, string? queryBranch, string? workingBranch, string? defaultBranch)
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(alreadyTried)) seen.Add(alreadyTried);

        var ordered = new List<string>();
        foreach (var b in new[] { queryBranch, workingBranch, defaultBranch })
        {
            if (string.IsNullOrWhiteSpace(b)) continue;
            if (seen.Add(b)) ordered.Add(b);
        }
        return ordered;
    }

    private IEnumerable<FileEntry> GetCurrentDirectoryEntries()
    {
        if (_fileTree is null) return Enumerable.Empty<FileEntry>();

        var currentDir = NormalizePath(EffectiveFilePath);
        var prefix = string.IsNullOrEmpty(currentDir) ? "" : currentDir + "/";

        var directories = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var files = new List<FileEntry>();

        foreach (var filePath in _fileTree.Files)
        {
            var normalized = filePath.Replace('\\', '/');
            if (!string.IsNullOrEmpty(prefix) && !normalized.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                continue;

            var relative = string.IsNullOrEmpty(prefix) ? normalized : normalized[prefix.Length..];
            var slashIndex = relative.IndexOf('/');

            if (slashIndex >= 0)
            {
                // This is a subdirectory
                var dirName = relative[..slashIndex];
                directories.Add(dirName);
            }
            else
            {
                // This is a file at this level
                files.Add(new FileEntry { Name = relative, FullPath = normalized, IsDirectory = false });
            }
        }

        // Directories first (sorted), then files (sorted)
        return directories
            .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)
            .Select(d => new FileEntry
            {
                Name = d,
                FullPath = string.IsNullOrEmpty(prefix) ? d : prefix + d,
                IsDirectory = true
            })
            .Concat(files.OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase));
    }

    private void OnEntryClick(FileEntry entry)
    {
        if (entry.IsDirectory)
        {
            NavigateToPath(entry.FullPath);
        }
        else
        {
            Navigation.NavigateTo($"/repository/files/{entry.FullPath}");
        }
    }

    private void NavigateToRoot() => Navigation.NavigateTo("/repository/files");
    private void NavigateToPath(string path) => Navigation.NavigateTo($"/repository/files/{path}");
    private void NavigateToRepo() => Navigation.NavigateTo("/repository");

    private IEnumerable<PathSegment> GetPathSegments()
    {
        var path = NormalizePath(EffectiveFilePath);
        if (string.IsNullOrEmpty(path)) yield break;

        var parts = path.Split('/');
        var accumulated = "";
        for (var i = 0; i < parts.Length; i++)
        {
            accumulated = i == 0 ? parts[i] : $"{accumulated}/{parts[i]}";
            yield return new PathSegment
            {
                Name = parts[i],
                FullPath = accumulated,
                IsLast = i == parts.Length - 1
            };
        }
    }

    private static string NormalizePath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        return path.Replace('\\', '/').TrimStart('/').TrimEnd('/');
    }

    private static string FormatSize(long bytes)
    {
        return bytes switch
        {
            var b when b < 1024 => $"{bytes} B",
            var b when b < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
            _ => $"{bytes / (1024.0 * 1024.0):F1} MB"
        };
    }

    private static bool IsMarkdownFile(string fileName)
    {
        return fileName.EndsWith(".md", StringComparison.OrdinalIgnoreCase) ||
               fileName.EndsWith(".markdown", StringComparison.OrdinalIgnoreCase) ||
               fileName.EndsWith(".mdx", StringComparison.OrdinalIgnoreCase);
    }

    private static string RenderMarkdownSafe(string markdown)
    {
        return Markdown.ToHtml(markdown, _markdownPipeline);
    }

    public void Dispose() { Navigation.LocationChanged -= OnLocationChanged; }

    private record FileEntry
    {
        public required string Name { get; init; }
        public required string FullPath { get; init; }
        public required bool IsDirectory { get; init; }
    }

    private record PathSegment
    {
        public required string Name { get; init; }
        public required string FullPath { get; init; }
        public required bool IsLast { get; init; }
    }
}
