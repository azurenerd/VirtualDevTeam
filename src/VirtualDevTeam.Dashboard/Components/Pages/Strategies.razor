    private static string FormatStepDuration(double? ms)
    {
        if (ms is null) return "—";
        var v = ms.Value;
        if (v < 1000) return $"{v:F0} ms";
        if (v < 60_000) return $"{v / 1000.0:F1} s";
        var totalSec = v / 1000.0;
        var min = (int)(totalSec / 60);
        var sec = totalSec - (min * 60);
        return $"{min}m {sec:F0}s";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private async Task CancelTaskAsync(string runId, string taskId)
    {
        try
        {
            await StrategiesData.CancelOrchestrationAsync(runId, taskId);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to cancel orchestration {RunId}/{TaskId}", runId, taskId);
        }
    }

    private async Task CancelCandidateAsync(string runId, string taskId, string strategyId)
    {
        try
        {
            await StrategiesData.CancelCandidateAsync(runId, taskId, strategyId);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to cancel candidate {RunId}/{TaskId}/{StrategyId}", runId, taskId, strategyId);
        }
    }

    private async Task ResetCandidateAsync(string runId, string taskId, string strategyId)
    {
        try
        {
            await StrategiesData.ResetCandidateAsync(runId, taskId, strategyId);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to reset candidate {RunId}/{TaskId}/{StrategyId}", runId, taskId, strategyId);
        }
    }

    private string? _resetConfirmKey;

    private void RequestResetCandidate(string taskId, string strategyId)
    {
        _resetConfirmKey = $"{taskId}_{strategyId}";
    }

    private async Task ConfirmResetCandidateAsync(string runId, string taskId, string strategyId)
    {
        _resetConfirmKey = null;
        await ResetCandidateAsync(runId, taskId, strategyId);
    }

    private void SetTab(string key, string tab)
    {
        _activeTabs[key] = tab;
    }

    private void ToggleScoreFeedback(string key)
    {
        if (!_expandedScoreFeedback.Remove(key))
            _expandedScoreFeedback.Add(key);
    }

    /// <summary>Toggle a specific dimension's feedback for a score block. Only one dimension active per prefix.</summary>
    private void ToggleDimensionFeedback(string prefix, string dimension)
    {
        var key = $"{prefix}_{dimension}";
        // If already active, collapse it (show overall); otherwise activate this dimension
        if (_expandedScoreFeedback.Contains(key))
        {
            _expandedScoreFeedback.Remove(key);
        }
        else
        {
            // Remove any other active dimension for this prefix first
            _expandedScoreFeedback.RemoveWhere(k => k.StartsWith(prefix + "_"));
            _expandedScoreFeedback.Add(key);
        }
    }

    /// <summary>Returns the active dimension key for a score block, or null if showing overall feedback.</summary>
    private string? GetActiveDimensionKey(string prefix)
    {
        return _expandedScoreFeedback.FirstOrDefault(k => k.StartsWith(prefix + "_"));
    }

    /// <summary>Get per-dimension feedback for the final scores of a candidate.</summary>
    private static string GetDimensionFeedback(string dimKey, CandidateSnapshot candidate)
    {
        var dim = dimKey[(dimKey.LastIndexOf('_') + 1)..];
        return dim switch
        {
            "ac" => candidate.AcFeedback ?? "No specific feedback available",
            "design" => candidate.DesignFeedback ?? "No specific feedback available",
            "readability" => candidate.ReadabilityFeedback ?? "No specific feedback available",
            "visuals" => candidate.VisualsFeedback ?? "No specific feedback available",
            _ => "Unknown dimension"
        };
    }

    /// <summary>Get per-dimension feedback for the initial scores of a candidate.</summary>
    private static string GetInitialDimensionFeedback(string dimKey, CandidateSnapshot candidate)
    {
        var dim = dimKey[(dimKey.LastIndexOf('_') + 1)..];
        return dim switch
        {
            "ac" => candidate.InitialAcFeedback ?? candidate.AcFeedback ?? "No specific feedback available",
            "design" => candidate.InitialDesignFeedback ?? candidate.DesignFeedback ?? "No specific feedback available",
            "readability" => candidate.InitialReadabilityFeedback ?? candidate.ReadabilityFeedback ?? "No specific feedback available",
            "visuals" => candidate.InitialVisualsFeedback ?? candidate.VisualsFeedback ?? "No specific feedback available",
            _ => "Unknown dimension"
        };
    }

    /// <summary>Extract a human-readable label from a dimension key (e.g., "final_t1_baseline_ac" → "Acceptance Criteria").</summary>
    private static string GetDimensionLabel(string dimKey)
    {
        var dim = dimKey[(dimKey.LastIndexOf('_') + 1)..];
        return dim switch
        {
            "ac" => "Acceptance Criteria",
            "design" => "Design",
            "readability" => "Readability",
            "visuals" => "Visuals",
            _ => dim
        };
    }

    private static string ScoreBarGradient(int score)
    {
        // Low scores: orange/yellow, high scores: blue/green
        return score switch
        {
            >= 9 => "background: linear-gradient(90deg, #10b981, #06d6a0)",
            >= 7 => "background: linear-gradient(90deg, #3b82f6, #10b981)",
            >= 5 => "background: linear-gradient(90deg, #f59e0b, #3b82f6)",
            >= 3 => "background: linear-gradient(90deg, #f97316, #f59e0b)",
            _ => "background: linear-gradient(90deg, #ef4444, #f97316)",
        };
    }

    private static int TotalScore(CandidateSnapshot c)
        => (c.AcScore ?? 0) + (c.DesignScore ?? 0) + (c.ReadabilityScore ?? 0) + (c.VisualsScore ?? 0);

    private static int MaxScore(CandidateSnapshot c)
        => c.VisualsScore.HasValue ? 40 : 30;

    private static int InitialTotalScore(CandidateSnapshot c)
        => (c.InitialAcScore ?? 0) + (c.InitialDesignScore ?? 0) + (c.InitialReadabilityScore ?? 0) + (c.InitialVisualsScore ?? 0);

    private static int InitialMaxScore(CandidateSnapshot c)
        => c.InitialVisualsScore.HasValue ? 40 : 30;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/agenthub"))
                .WithAutomaticReconnect()
                .Build();
            _hub.On<string, object>("StrategyEvent", async (eventName, _) =>
            {
                // CandidateStateStore snapshots are immutable record objects (TaskSnapshot/CandidateSnapshot).
                // That means StateHasChanged() alone will NOT pick up new activity/media updates because this
                // page renders from a cached _activeTasks list that is only replaced by RefreshAsync().
                //
                // In the in-process dashboard, RefreshAsync() is cheap (in-memory). In the standalone dashboard,
                // avoid hammering the Runner HTTP API on high-frequency activity events — the 3s poll will pick
                // up changes.
                if (eventName == StrategyEvents.CandidateActivity)
                {
                    if (StrategiesData is InProcessStrategiesDataService)
                    {
                        await InvokeAsync(RefreshAsync);
                    }
                    else
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
                else
                {
                    await InvokeAsync(RefreshAsync);
                }
            });
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "SignalR connection for /strategies failed; falling back to manual refresh");
        }

        // Polling fallback: ensures the page always refreshes even when SignalR events
        // don't reach this host (e.g. standalone dashboard at :5051 vs Runner at :5050).
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollLoopAsync();
    }

    private async Task PollLoopAsync()
    {
        try
        {
            while (_pollTimer is not null && await _pollTimer.WaitForNextTickAsync())
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync()
    {
        // Coalesce pattern: if a refresh is in-flight, mark pending so it re-runs
        // after completion. Prevents bursty SignalR events from being silently dropped
        // (which caused media tiles to not appear until a later event landed).
        if (_refreshing) { _refreshPending = true; return; }
        _refreshing = true;
        try
        {
            var active = StrategiesData.GetActiveTasksAsync();
            var recent = StrategiesData.GetRecentTasksAsync(50);
            var enabled = StrategiesData.GetEnabledAsync();
            await Task.WhenAll(active, recent, enabled);
            _activeTasks = active.Result;
            _recentTasks = recent.Result
                .GroupBy(t => $"{t.RunId}:{t.TaskId}")
                .Select(g => g.OrderByDescending(t => t.CompletedAt).First())
                .ToList();
            _enabled = enabled.Result;
            // Auto-expand any active candidate cards whose media (screenshot/GIF/video) just
            // became available, so the inline media renders without requiring a click on the
            // GIF/Video badges. Bugfix: the collapsed view only renders text-only badges for
            // GIF/Video — actual <img>/<video> elements live in the isActiveExpanded branch.
            AutoExpandCandidatesWithMedia();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Strategies page refresh failed");
        }
        finally
        {
            _refreshing = false;
            if (_refreshPending)
            {
                _refreshPending = false;
                _ = InvokeAsync(RefreshAsync);
            }
        }
    }

    private static string FormatTaskElapsed(TaskSnapshot task)
    {
        // For completed tasks, show actual execution duration (not wall-clock since start)
        if (task.CompletedAt is DateTimeOffset completed)
        {
            var d = completed - task.StartedAt;
            return FormatDuration(d.TotalSeconds);
        }
        // For running tasks, show live wall-clock
        return FormatElapsed(task.StartedAt);
    }

    private static string FormatElapsed(DateTimeOffset startedAt)
    {
        var d = DateTimeOffset.UtcNow - startedAt;
        if (d.TotalSeconds < 60) return $"{d.TotalSeconds:0}s";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m {d.Seconds}s";
        return $"{(int)d.TotalHours}h {d.Minutes}m";
    }

    private static string FormatDuration(double totalSeconds)
    {
        if (totalSeconds < 60) return $"{totalSeconds:0.0}s";
        var ts = TimeSpan.FromSeconds(totalSeconds);
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
    }

    private static string FileTypeIcon(string type) => type switch
    {
        "Added" => "+",
        "Modified" => "~",
        "Deleted" => "−",
