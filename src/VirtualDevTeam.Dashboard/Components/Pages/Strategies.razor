@page "/strategies"
@rendermode InteractiveServer
@using VirtualDevTeam.Core.Strategies
@using VirtualDevTeam.Core.Strategies.Contracts
@using VirtualDevTeam.Core.Strategies.MediaCapture
@using VirtualDevTeam.Dashboard.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IStrategiesDataService StrategiesData
@inject NavigationManager Navigation
@inject ILogger<Strategies> Logger
@inject IPlatformLinkService LinkService

<PageTitle>Virtual Dev Team — Frameworks</PageTitle>

<div class="dashboard-header" data-testid="page-strategies">
    <h1 title="Frameworks are pluggable AI coding agents (e.g., Baseline, GitHub Copilot CLI, Squad) that compete on each task. The best output wins.">Frameworks</h1>
    <div class="header-badges">
        <span class="header-badge @(_enabled?.MasterEnabled == true ? "" : "muted")" data-testid="strategies-enabled-badge"
              title="@(_enabled?.MasterEnabled == true ? "Multi-framework mode is ON — tasks are sent to multiple AI agents simultaneously" : "Multi-framework mode is OFF — only baseline code generation is active")">
            @(_enabled?.MasterEnabled == true ? "● Framework ON" : "○ Framework OFF")
        </span>
        <span class="header-badge" data-testid="strategies-active-count"
              title="Number of tasks and candidates currently being processed">
            Active: @_activeTasks.Count task@(_activeTasks.Count != 1 ? "s" : "") · @_activeTasks.Sum(t => t.Candidates.Count) candidates
        </span>
        <span class="header-badge" data-testid="strategies-recent-count"
              title="Number of recently completed tasks (persisted across restarts)">
            Recent: @_recentTasks.Count
        </span>
        @{
            long totalTokens = 0;
            int countedCandidates = 0;
            int unknownCandidates = 0;
            foreach (var t in _activeTasks.Concat(_recentTasks))
            {
                foreach (var c in t.Candidates.Values)
                {
                    if (c.TokensUsed is { } tu) { totalTokens += tu; countedCandidates++; }
                    else { unknownCandidates++; }
                }
            }
            var tokensLabel = totalTokens > 0 ? $"{totalTokens:N0}" : "—";
            var tokensTooltip = $"Total tokens across {countedCandidates} candidate(s) with reported usage" +
                (unknownCandidates > 0 ? $". {unknownCandidates} candidate(s) had no reported tokens (older runs or framework didn't expose them)." : "");
        }
        <span class="header-badge" data-testid="strategies-total-tokens" title="@tokensTooltip">
            🔤 @tokensLabel tokens
        </span>
        <button class="ntl-refresh-btn @(_refreshing ? "spinning" : "")" @onclick="RefreshAsync" disabled="@_refreshing" title="Refresh active and recent task data" data-testid="strategies-refresh">
            <svg class="ntl-refresh-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v2h-2"/>
            </svg>
        </button>
    </div>
</div>

<div class="frameworks-description">
    <p>
        When enabled, the Strategy Framework runs <strong>multiple AI coding approaches in parallel</strong> for each engineering task —
        including GitHub Copilot CLI (single-agent), Squad (multi-agent team), and baseline generation.
        Each approach produces a candidate implementation in an isolated worktree.
    </p>
    <p>
        A <strong>Judge</strong> then scores each candidate on acceptance criteria alignment, architectural design, code readability,
        and test coverage. The highest-scoring candidate's code is applied to the PR for peer review by the Architect, PM, and Test Engineer.
        This competitive evaluation ensures the best possible output is submitted — not just the first result.
    </p>
</div>

@if (_enabled?.MasterEnabled != true)
{
    <div class="alert-banner info" data-testid="strategies-disabled-banner">
        <strong>Frameworks are disabled.</strong> Baseline code generation is the
        only active path. Set <code>VirtualDevTeam:StrategyFramework:Enabled = true</code>
        to enable multi-framework candidate runs.
    </div>
}

<section class="strategies-section">
    <h2 title="Tasks currently being processed — each task runs multiple framework candidates in parallel">Active Tasks</h2>
    @if (_activeTasks.Count == 0)
    {
        <div class="empty-state">No active framework candidates. Waiting for the next task&hellip;</div>
    }
    else
    {
        @foreach (var task in _activeTasks)
        {
            <div class="task-card" data-testid="strategies-task-card" data-task-id="@task.TaskId">
                <div class="task-header">
                    <div>
                        <span class="task-id" title="Unique identifier for this engineering task">@task.TaskId</span>
                        <span class="task-run" title="Run identifier — groups all candidates executing for this task">run @task.RunId</span>
                        @if (task.PrNumber is int prNum)
                        {
                            var prHref = LinkService.BuildPullRequestUrl(prNum, task.PrUrl);
                            var prTarget = LinkService.TargetForUrl(prHref);
                            var prRel = prTarget == "_blank" ? "noopener" : null;
                            var prTitleAttr = !string.IsNullOrEmpty(task.PrTitle)
                                ? (LinkService.IsInternal(prHref)
                                    ? $"View PR #{prNum} in dashboard: {task.PrTitle}"
                                    : $"Open PR #{prNum} on {LinkService.PlatformDisplayName}: {task.PrTitle}")
                                : (LinkService.IsInternal(prHref)
                                    ? $"View PR #{prNum} in dashboard"
                                    : $"Open PR #{prNum} on {LinkService.PlatformDisplayName}");
                            <a class="task-pr-link" href="@prHref" target="@prTarget" rel="@prRel"
                               title="@prTitleAttr"
                               @onclick:stopPropagation="true">
                                🔗 PR #@prNum
                            </a>
                        }
                        @{
                            var activeTaskTitle = task.PrTitle ?? task.TaskTitle;
                        }
                        @if (!string.IsNullOrWhiteSpace(activeTaskTitle))
                        {
                            <span class="task-title-label" title="@activeTaskTitle" style="margin-left: 8px; color: #e2e8f0; font-weight: 500;">@TruncateText(activeTaskTitle, 80)</span>
                        }
                    </div>
                    <div class="task-actions">
                        <span class="task-elapsed" title="Time elapsed since task started">@FormatTaskElapsed(task)</span>
                        <button class="cancel-all-btn" @onclick="() => CancelTaskAsync(task.RunId, task.TaskId)"
                                @onclick:stopPropagation="true"
                                title="Cancel ALL candidates and abort this task entirely. The task will be marked failed and the agent will move on. Use only if the task itself is wrong or unnecessary.">
                            ✕ Cancel All
                        </button>
                    </div>
                </div>
                @if (task.ProgressDetail is not null)
                {
                    <div class="task-progress-detail" title="Current progress status">@task.ProgressDetail</div>
                }
                <div class="candidate-grid">
                    @foreach (var candidate in task.Candidates.Values.OrderBy(c => c.StrategyId.Equals("baseline", StringComparison.OrdinalIgnoreCase) ? 1 : 0).ThenBy(c => c.StrategyId))
                    {
                        var activeKey = $"{task.TaskId}_{candidate.StrategyId}";
                        var isActiveExpanded = _expandedActiveCandidates.Contains(activeKey);
                        <div class="candidate-card state-@(candidate.State.ToString().ToLowerInvariant()) @(isActiveExpanded ? "active-expanded" : "")"
                             data-testid="strategies-candidate-card" data-strategy-id="@candidate.StrategyId"
                             @onclick="() => ToggleActiveExpand(activeKey)">
                            <div class="candidate-head">
                                <span class="candidate-id" title="@StrategyTooltip(candidate.StrategyId)">
                                    @StrategyDisplayName(candidate.StrategyId)
                                </span>
                                <span class="candidate-state" title="@StateTooltip(candidate.State)">@candidate.State</span>
                                @if (candidate.State is CandidateState.Running or CandidateState.Completed or CandidateState.Pending)
                                {
                                    var nonCancelledCount = task.Candidates.Values.Count(
                                        cc => cc.State != CandidateState.Cancelled);
                                    var isLastActive = nonCancelledCount <= 1;
                                    @if (candidate.State == CandidateState.Running)
                                    {
                                        var resetKey = $"{task.TaskId}_{candidate.StrategyId}";
                                        @if (_resetConfirmKey == resetKey)
                                        {
                                            <button class="candidate-reset-btn reset-confirm"
                                                    @onclick="() => ConfirmResetCandidateAsync(task.RunId, task.TaskId, candidate.StrategyId)"
                                                    @onclick:stopPropagation="true"
                                                    title="Click again to confirm reset — this will kill the running process immediately">
                                                ⚠ Reset?
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="candidate-reset-btn"
                                                    @onclick="() => RequestResetCandidate(task.TaskId, candidate.StrategyId)"
                                                    @onclick:stopPropagation="true"
                                                    title="🔄 Reset: Kills this candidate's process and retries from scratch in a fresh worktree. Use when the candidate is stuck or frozen. The retry uses an escalation ladder (attempt 1: same config, attempt 2: no wrapper). Current resets: @candidate.ResetCount">
                                                🔄
                                            </button>
                                        }
                                    }
                                    <button class="candidate-cancel-btn"
                                            disabled="@isLastActive"
                                            @onclick="() => CancelCandidateAsync(task.RunId, task.TaskId, candidate.StrategyId)"
                                            @onclick:stopPropagation="true"
                                            title="@(isLastActive ? "Cannot cancel — at least one candidate must remain running to produce a result" : "✕ Cancel: Permanently stops this candidate. It will NOT be retried. The remaining candidate(s) continue. Use when this strategy is clearly not working and you want to rely on the other(s).")">
                                        ✕
                                    </button>
                                }
                            </div>
                            @if (candidate.ElapsedSec is double e)
                            {
                                <div class="candidate-timing" title="Execution duration and token usage for this candidate">
                                    ⏱ @FormatDuration(e)
                                    @if (candidate.TokensUsed.HasValue)
                                    {
                                        <span>· @(candidate.TokensUsed.Value.ToString("N0")) tok</span>
                                    }
                                    else if (candidate.State >= CandidateState.Completed)
                                    {
                                        <span class="muted" title="Token count not exposed by this framework — tool-call count shown in Activity tab">· tokens n/a</span>
                                    }
                                </div>
                            }
                            @if (candidate.ToolCallCount.HasValue && candidate.State == CandidateState.Running)
                            {
                                <div class="candidate-analyzer" title="Live AI session analyzer status — monitors build, test, and execution health">
                                    <span class="analyzer-badge analyzer-tools" title="Tool calls executed so far">🔧 @candidate.ToolCallCount</span>
                                    @if (candidate.BuildPassed == true)
                                    {
                                        <span class="analyzer-badge analyzer-pass" title="Build succeeded">✅ Build</span>
                                    }
                                    else if (candidate.BuildFailCount > 0)
                                    {
                                        <span class="analyzer-badge analyzer-fail" title="Build failed @candidate.BuildFailCount time(s)">❌ Build (@candidate.BuildFailCount)</span>
                                    }
                                    @if (candidate.TestsPassed == true)
                                    {
                                        <span class="analyzer-badge analyzer-pass" title="Tests passed">✅ Tests</span>
                                    }
                                    @if (candidate.NudgeSent == true)
                                    {
                                        <span class="analyzer-badge analyzer-nudge" title="Commit nudge sent — tests passed, told CLI to stop and commit">📤 Nudge</span>
                                    }
                                    @if (!string.IsNullOrEmpty(candidate.AnalyzerVerdict))
                                    {
                                        <span class="analyzer-badge analyzer-verdict" title="AI monitor verdict: @candidate.AnalyzerVerdict">
                                            @(candidate.AnalyzerVerdict.StartsWith("error-loop", StringComparison.OrdinalIgnoreCase) ? "🔴" : "🤖")
                                            @TruncateText(candidate.AnalyzerVerdict, 40)
                                        </span>
                                    }
                                </div>
                            }
                            @if (candidate.State == CandidateState.Completed && candidate.Succeeded == true)
                            {
                                <div class="candidate-awaiting" title="This candidate finished generating code — waiting for all candidates to complete before evaluation begins">
                                    ⏳ Awaiting evaluation…
                                </div>
                            }
                            @if (candidate.ActivityLog.Count > 0)
                            {
                                <div class="candidate-activity-live" title="Latest activity from this framework's execution — click to expand full log">
                                    @if (candidate.State == CandidateState.Running)
                                    {
                                        <span class="activity-pulse">●</span>
                                    }
                                    else
                                    {
                                        <span class="activity-done">✓</span>
                                    }
                                    <span class="activity-last">@candidate.ActivityLog[^1].Message</span>
                                    <span class="activity-count" title="Total activity log entries captured">(@candidate.ActivityLog.Count)</span>
                                </div>
                                @if (!isActiveExpanded && candidate.ActivityLog.Count > 1)
                                {
                                    @* Show last 3 grouped entries as mini-log preview *@
                                    <div class="candidate-minilog">
                                        @foreach (var group in GroupConsecutive(candidate.ActivityLog).TakeLast(3))
                                        {
                                            <div class="minilog-entry">
                                                <LocalTimeText OffsetValue="group.Entry.Timestamp" CssClass="minilog-time" IncludeSeconds="true" />
                                                <span class="minilog-cat cd-activity-cat-@group.Entry.Category">@group.Entry.Category</span>
                                                @{ var artifactUrl = TryBuildArtifactUrl(group.Entry); }
                                                @if (artifactUrl is not null && IsImageArtifact(group.Entry))
                                                {
                                                    <span class="minilog-msg minilog-msg-artifact"
                                                          @onclick="() => OpenArtifactPreview(artifactUrl)" @onclick:stopPropagation="true"
                                                          title="@group.Entry.Message — click to preview">
                                                        @group.Entry.Message
                                                        <img class="minilog-thumb-tooltip" src="@artifactUrl" loading="lazy" alt=""
                                                             onerror="this.style.display='none';" />
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="minilog-msg">@group.Entry.Message</span>
                                                }
                                                @if (group.Count > 1)
                                                {
                                                    <span class="activity-group-badge">(×@group.Count)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                var imageArtifacts = candidate.ActivityLog.Where(IsImageArtifact).ToList();
                                @if (imageArtifacts.Count > 0)
                                {
                                    <div class="artifact-strip" tabindex="0"
                                         @onkeydown="HandleArtifactStripKey"
                                         data-testid="strategies-artifact-strip"
                                         title="Live artifacts produced by this candidate. Use ← → to scroll, click to preview full-size.">
                                        <span class="artifact-strip-label">🎨 @imageArtifacts.Count</span>
                                        @foreach (var entry in imageArtifacts.TakeLast(20))
                                        {
                                            var url = TryBuildArtifactUrl(entry);
                                            if (url is null) { continue; }
                                            var rel = TryGetArtifactRelPath(entry) ?? "artifact";
                                            <div class="artifact-strip-thumb" title="@rel"
                                                 @onclick="() => OpenArtifactPreview(url)" @onclick:stopPropagation="true">
                                                <img src="@url" loading="lazy" alt="@rel"
                                                     onerror="this.style.display='none';this.parentElement.classList.add('artifact-strip-thumb--broken');" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            @if (candidate.MediaCaptureProgress is { Steps.Count: > 0 } mp)
                            {
                                var mediaKey = $"{task.RunId}:{task.TaskId}:{candidate.StrategyId}";
                                var mediaExpanded = _expandedMediaStrips.Contains(mediaKey);
                                <div class="media-progress @(mediaExpanded ? "media-progress-expanded" : "")"
                                     title="@(mediaExpanded ? "Click to collapse step details" : "Click to expand step details + per-step timing")"
                                     data-testid="strategies-media-progress" data-strategy-id="@candidate.StrategyId"
                                     @onclick="() => ToggleMediaStrip(mediaKey)" @onclick:stopPropagation="true"
                                     style="cursor:pointer;">
                                    <span class="media-progress-label">Media:</span>
                                    @foreach (var step in mp.Steps)
                                    {
                                        var pipClass = step.Status switch
                                        {
                                            MediaCaptureStepStatus.Running => "mp-pip-running",
                                            MediaCaptureStepStatus.Completed => "mp-pip-done",
                                            MediaCaptureStepStatus.Failed => "mp-pip-failed",
                                            MediaCaptureStepStatus.Skipped => "mp-pip-skipped",
                                            _ => "mp-pip-pending",
                                        };
                                        var elapsedSuffix = step.ElapsedMs is { } ms ? $" · {FormatStepDuration(ms)}" : "";
                                        var detailSuffix = !string.IsNullOrEmpty(step.Detail) ? $" · {step.Detail}" : "";
                                        var pipTitle = $"{step.Id}: {step.Status}{elapsedSuffix}{detailSuffix}";
                                        <span class="mp-pip @pipClass" title="@pipTitle" data-step="@step.Id"></span>
                                    }
                                    @if (mp.CurrentStepId is not null)
                                    {
                                        <span class="media-progress-current" title="Currently running step">@mp.CurrentStepId</span>
                                    }
                                    else if (mp.Steps.Any(s => s.Status == MediaCaptureStepStatus.Completed && s.Id == MediaCaptureStepId.Complete))
                                    {
                                        <span class="media-progress-current mp-current-done" title="Capture complete">✓ done</span>
                                    }
                                    else if (mp.Steps.Any(s => s.Status == MediaCaptureStepStatus.Failed && s.Id == MediaCaptureStepId.Complete))
                                    {
                                        <span class="media-progress-current mp-current-failed" title="Capture aborted — gate failed">✗ failed</span>
                                    }
                                    <span class="media-progress-toggle" aria-hidden="true">@(mediaExpanded ? "▾" : "▸")</span>
                                </div>
                                @if (mediaExpanded)
                                {
                                    <div class="media-progress-details" @onclick:stopPropagation="true">
                                        <div class="mpd-summary">
                                            <span><strong>Total elapsed:</strong> @FormatStepDuration(mp.TotalElapsedMs)</span>
                                            <span><strong>Started:</strong> <LocalTimeText OffsetValue="mp.StartedAt" /></span>
                                            @{
                                                var doneCount = mp.Steps.Count(s => s.Status == MediaCaptureStepStatus.Completed);
                                                var failCount = mp.Steps.Count(s => s.Status == MediaCaptureStepStatus.Failed);
                                                var skipCount = mp.Steps.Count(s => s.Status == MediaCaptureStepStatus.Skipped);
                                            }
                                            <span><strong>Done:</strong> @doneCount</span>
                                            @if (failCount > 0) { <span class="mpd-fail-count"><strong>Failed:</strong> @failCount</span> }
                                            @if (skipCount > 0) { <span class="mpd-skip-count"><strong>Skipped:</strong> @skipCount</span> }
                                        </div>
                                        <table class="mpd-table">
                                            <thead>
                                                <tr><th>#</th><th>Step</th><th>Status</th><th>Started</th><th>Elapsed</th><th>Detail</th></tr>
                                            </thead>
                                            <tbody>
                                                @{ int rowNo = 1; }
                                                @foreach (var step in mp.Steps)
                                                {
                                                    var rowClass = step.Status switch
                                                    {
                                                        MediaCaptureStepStatus.Running => "mpd-row-running",
                                                        MediaCaptureStepStatus.Completed => "mpd-row-done",
                                                        MediaCaptureStepStatus.Failed => "mpd-row-failed",
                                                        MediaCaptureStepStatus.Skipped => "mpd-row-skipped",
                                                        _ => "mpd-row-pending",
                                                    };
                                                    <tr class="@rowClass">
                                                        <td>@rowNo</td>
                                                        <td>@step.Id</td>
                                                        <td>@step.Status</td>
                                                        <td><LocalTimeText OffsetValue="step.StartedAt" /></td>
                                                        <td>@FormatStepDuration(step.ElapsedMs)</td>
                                                        <td class="mpd-detail">@(string.IsNullOrEmpty(step.Detail) ? "—" : step.Detail)</td>
                                                    </tr>
                                                    rowNo++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                            @if (candidate.State == CandidateState.Scored || candidate.State == CandidateState.Winner)
                            {
                                <div class="cd-scores cd-scores-compact" @onclick:stopPropagation="true" title="LLM judge scores — Acceptance Criteria, Design quality, Readability, and Visuals (each 0–10)">
                                    <div class="cd-score-row">
                                        <span class="cd-score-label">AC</span>
                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.AcScore ?? 0) * 10)%; @ScoreBarGradient(candidate.AcScore ?? 0)"></div></div>
                                        <span class="cd-score-val">@(candidate.AcScore ?? 0)/10</span>
                                    </div>
                                    <div class="cd-score-row">
                                        <span class="cd-score-label">Design</span>
                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.DesignScore ?? 0) * 10)%; @ScoreBarGradient(candidate.DesignScore ?? 0)"></div></div>
                                        <span class="cd-score-val">@(candidate.DesignScore ?? 0)/10</span>
                                    </div>
                                    <div class="cd-score-row">
                                        <span class="cd-score-label">Read</span>
                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.ReadabilityScore ?? 0) * 10)%; @ScoreBarGradient(candidate.ReadabilityScore ?? 0)"></div></div>
                                        <span class="cd-score-val">@(candidate.ReadabilityScore ?? 0)/10</span>
                                    </div>
                                    @if (candidate.VisualsScore.HasValue)
                                    {
                                        <div class="cd-score-row">
                                            <span class="cd-score-label">Visuals</span>
                                            <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @(candidate.VisualsScore.Value * 10)%; @ScoreBarGradient(candidate.VisualsScore.Value)"></div></div>
                                            <span class="cd-score-val">@(candidate.VisualsScore.Value)/10</span>
                                        </div>
                                    }
                                </div>
                            }
                            else if (candidate.InitialAcScore.HasValue || candidate.InitialDesignScore.HasValue || candidate.InitialReadabilityScore.HasValue)
                            {
                                <div class="cd-scores cd-scores-compact initial-scores" @onclick:stopPropagation="true" title="Initial judge scores — revision in progress to improve these">
                                    <div class="cd-score-row">
                                        <span class="cd-score-label">AC</span>
                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialAcScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialAcScore ?? 0)"></div></div>
                                        <span class="cd-score-val">@(candidate.InitialAcScore ?? 0)/10</span>
                                    </div>
                                    <div class="cd-score-row">
                                        <span class="cd-score-label">Design</span>
                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialDesignScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialDesignScore ?? 0)"></div></div>
                                        <span class="cd-score-val">@(candidate.InitialDesignScore ?? 0)/10</span>
                                    </div>
                                    <div class="cd-score-row">
                                        <span class="cd-score-label">Read</span>
                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialReadabilityScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialReadabilityScore ?? 0)"></div></div>
                                        <span class="cd-score-val">@(candidate.InitialReadabilityScore ?? 0)/10</span>
                                    </div>
                                    @if (candidate.InitialVisualsScore.HasValue)
                                    {
                                        <div class="cd-score-row">
                                            <span class="cd-score-label">Visuals</span>
                                            <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @(candidate.InitialVisualsScore.Value * 10)%; @ScoreBarGradient(candidate.InitialVisualsScore.Value)"></div></div>
                                            <span class="cd-score-val">@(candidate.InitialVisualsScore.Value)/10</span>
                                        </div>
                                    }
                                    @if (candidate.State == CandidateState.Revising)
                                    {
                                        <span class="scores-label-revision" title="Candidate is being revised based on judge feedback">⟳ revising</span>
                                    }
                                </div>
                            }
                            else if (candidate.State == CandidateState.Evaluated && candidate.Survived == true)
                            {
                                <div class="candidate-scores muted" title="This candidate passed gate checks but was not scored by the LLM judge">@(candidate.JudgeSkippedReason ?? "not scored")</div>
                            }
                            else if (candidate.State == CandidateState.Evaluated && candidate.Survived == false)
                            {
                                <div class="candidate-gate-fail" title="This candidate's generated code failed a build/evaluation gate">
                                    ❌ Gate failed
                                    @if (!string.IsNullOrEmpty(candidate.FailureReason))
                                    {
                                        <span class="gate-fail-detail">@TruncateText(candidate.FailureReason, 120)</span>
                                    }
                                </div>
                            }
                            @if (candidate.Succeeded == false)
                            {
                                <div class="candidate-fail" title="Reason this candidate failed during execution">@candidate.FailureReason</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(candidate.JudgeFeedback)
                                 && candidate.State != CandidateState.Scored
                                 && candidate.State != CandidateState.Winner)
                            {
                                <div class="candidate-judge-feedback" title="Judge's recommendations for improvement">
                                    <div class="judge-feedback-label">🧑‍⚖️ Judge Feedback:</div>
                                    <div class="judge-feedback-text">@candidate.JudgeFeedback</div>
                                </div>
                            }
                            @{
                                var thumbScreenshot = (candidate.State == CandidateState.InitialScored || candidate.State == CandidateState.Revising)
                                    ? (candidate.InitialScreenshotBase64 ?? candidate.ScreenshotBase64)
                                    : (candidate.ScreenshotBase64 ?? candidate.InitialScreenshotBase64);
                                var isNoVisual = IsNonVisualPreviewSource(candidate.PreviewSource);
                                var hasValidThumb = !string.IsNullOrEmpty(thumbScreenshot) && !IsOnePixelPlaceholder(thumbScreenshot);
                            }
                            @if (!isActiveExpanded && hasValidThumb && !isNoVisual)
                            {
                                <div class="candidate-screenshot-thumb">
                                    <img src="data:image/png;base64,@thumbScreenshot"
                                         alt="@candidate.StrategyId preview" class="cd-screenshot-thumb-img"
                                         @onclick="() => OpenLightbox(thumbScreenshot, candidate.StrategyId)"
                                         @onclick:stopPropagation="true" />
                                </div>
                            }
                            else if (!isActiveExpanded && isNoVisual)
                            {
                                <div class="candidate-screenshot-thumb no-visual-collapsed"
                                     title="@PreviewStateTooltip(candidate.PreviewSource)">
                                    <span class="no-visual-collapsed-icon">@PreviewStateIcon(candidate.PreviewSource)</span>
                                    <span class="no-visual-collapsed-text">@PreviewStateBadgeLabel(candidate.PreviewSource)</span>
                                </div>
                            }
                            @if (!isActiveExpanded)
                            {
                                var hasGif = !string.IsNullOrEmpty(candidate.AnimatedGifPath);
                                var hasVideo = !string.IsNullOrEmpty(candidate.VideoPath);
                                var hasShot = !string.IsNullOrEmpty(candidate.ScreenshotBase64);
                                var isImageAssets = candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.ImageAssets;
                                var isDiagrams = candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.Diagrams;
                                @if (hasShot || hasGif || hasVideo || isImageAssets || isDiagrams || candidate.CaptureMetrics is not null)
                                {
                                    <div class="cd-media-badges">
                                        @if (isImageAssets)
                                        {
                                            <span class="cd-media-badge candidate-badge-art"
                                                  title="Image assets from this PR's worktree — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">🎨 Art</span>
                                        }
                                        @if (isDiagrams)
                                        {
                                            <span class="cd-media-badge candidate-badge-diagrams"
                                                  title="Diagrams from this PR's worktree — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">📐 Diagrams</span>
                                        }
                                        @* Screenshot badge: only shown when a screenshot is available but no richer
                                           media badge (GIF/video/art/diagrams) is present. Covers the static-fallback
                                           capture path where CaptureMetrics is null and no GIF/video was produced. *@
                                        @if (hasShot && !hasGif && !isImageAssets && !isDiagrams)
                                        {
                                            <span class="cd-media-badge candidate-badge-screenshot"
                                                  title="Screenshot preview available — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">📷 Preview</span>
                                        }
                                        @if (hasGif)
                                        {
                                            <span class="cd-media-badge cd-media-badge-gif"
                                                  title="Animated GIF available — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">🎞️ GIF</span>
                                        }
                                        @if (hasVideo)
                                        {
                                            <span class="cd-media-badge cd-media-badge-video"
                                                  title="Interaction video available — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">🎬 Video</span>
                                        }
                                        @if (candidate.CaptureMetrics is { } activeCm)
                                        {
                                            <span class="cd-media-badge cd-capture-badge-mcp"
                                                  title="MCP: @(activeCm.Sources.FirstOrDefault(s => s.Source == ScreenshotCaptureSource.Mcp)?.ArtifactCount ?? 0) screenshots — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">🟣 MCP @(activeCm.Sources.FirstOrDefault(s => s.Source == ScreenshotCaptureSource.Mcp)?.ArtifactCount ?? 0)</span>
                                            <span class="cd-media-badge cd-capture-badge-direct"
                                                  title="Direct: @(activeCm.Sources.FirstOrDefault(s => s.Source == ScreenshotCaptureSource.DirectPlaywright)?.ArtifactCount ?? 0) screenshots — click to view"
                                                  @onclick="@(() => ExpandToOverview(activeKey))" @onclick:stopPropagation="true"
                                                  role="button" tabindex="0">🔵 Direct @(activeCm.Sources.FirstOrDefault(s => s.Source == ScreenshotCaptureSource.DirectPlaywright)?.ArtifactCount ?? 0)</span>
                                            @if (!string.IsNullOrEmpty(candidate.AppBaseUrl))
                                            {
                                                <span class="cd-media-badge cd-capture-badge-url"
                                                      title="App started at @candidate.AppBaseUrl">🌐 @(Uri.TryCreate(candidate.AppBaseUrl, UriKind.Absolute, out var parsedUrl) ? parsedUrl.Authority : candidate.AppBaseUrl)</span>
                                            }
                                            @if ((activeCm.Sources.FirstOrDefault(s => s.Source == ScreenshotCaptureSource.Mcp)?.TestedUrls.Count ?? 0) == 0
                                                 && (activeCm.Sources.FirstOrDefault(s => s.Source == ScreenshotCaptureSource.DirectPlaywright)?.TestedUrls.Count ?? 0) > 0)
                                            {
                                                <span class="cd-media-badge cd-capture-badge-warn" title="MCP exploration found 0 pages">⚠️ MCP: 0 pages</span>
                                            }
                                            @if (activeCm.ExpectedPageCount > 0)
                                            {
                                                <span class="cd-media-badge" title="Pages captured vs expected from Visual Verification">📊 @activeCm.TotalUniquePages/@activeCm.ExpectedPageCount pages</span>
                                            }
                                        }
                                    </div>
                                }
                            }

                            @* Expandable detail panel — same tabbed UI as Recent Completed *@
                            @if (isActiveExpanded)
                            {
                                <div class="candidate-detail-expanded" @onclick:stopPropagation="true">
                                    @{
                                        var tabKey = $"active_{task.TaskId}_{candidate.StrategyId}";
                                        var activeTab = _activeTabs.GetValueOrDefault(tabKey, "activity");
                                    }
                                    <div class="cd-tabs">
                                        <button class="cd-tab @(activeTab == "overview" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "overview"))" @onclick:stopPropagation="true" title="Scores, metrics, and screenshot preview">Overview</button>
                                        @if (candidate.InitialAcScore.HasValue || candidate.InitialDesignScore.HasValue || candidate.InitialReadabilityScore.HasValue)
                                        {
                                        <button class="cd-tab @(activeTab == "prelim" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "prelim"))" @onclick:stopPropagation="true" title="Preliminary judge scoring before revision round">Prelim</button>
                                        }
                                        <button class="cd-tab @(activeTab == "activity" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "activity"))" @onclick:stopPropagation="true" title="Real-time activity log showing what the framework did step by step">
                                            Activity @if (candidate.ActivityLog.Count > 0) { <span class="cd-tab-badge">@candidate.ActivityLog.Count</span> }
                                        </button>
                                        <button class="cd-tab @(activeTab == "files" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "files"))" @onclick:stopPropagation="true" title="Files created, modified, or deleted by this framework">
                                            Files @if (candidate.ExecutionSummary?.FilesChanged.Count > 0) { <span class="cd-tab-badge">@candidate.ExecutionSummary.FilesChanged.Count</span> }
                                        </button>
                                        <button class="cd-tab @(activeTab == "metrics" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "metrics"))" @onclick:stopPropagation="true" title="Performance metrics">Metrics</button>
                                        <button class="cd-tab @(activeTab == "logs" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "logs"))" @onclick:stopPropagation="true" title="Raw diagnostic logs">
                                            Logs @if (candidate.ExecutionSummary?.DiagnosticLog.Count > 0) { <span class="cd-tab-badge">@candidate.ExecutionSummary.DiagnosticLog.Count</span> }
                                        </button>
                                    </div>
                                    <div class="cd-tab-content">
                                        @if (activeTab == "overview")
                                        {
                                            @if (candidate.AcScore.HasValue || candidate.DesignScore.HasValue || candidate.ReadabilityScore.HasValue)
                                            {
                                                var fbPrefix = $"final_{task.TaskId}_{candidate.StrategyId}";
                                                var activeDimKey = GetActiveDimensionKey(fbPrefix);
                                                <div class="cd-scores" @onclick:stopPropagation="true">
                                                    <div class="cd-score-row cd-score-row-clickable @(activeDimKey == $"{fbPrefix}_ac" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(fbPrefix, "ac"))">
                                                        <span class="cd-score-label">Acceptance</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.AcScore ?? 0) * 10)%; @ScoreBarGradient(candidate.AcScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.AcScore ?? 0)/10</span>
                                                    </div>
                                                    <div class="cd-score-row cd-score-row-clickable @(activeDimKey == $"{fbPrefix}_design" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(fbPrefix, "design"))">
                                                        <span class="cd-score-label">Design</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.DesignScore ?? 0) * 10)%; @ScoreBarGradient(candidate.DesignScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.DesignScore ?? 0)/10</span>
                                                    </div>
                                                    <div class="cd-score-row cd-score-row-clickable @(activeDimKey == $"{fbPrefix}_readability" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(fbPrefix, "readability"))">
                                                        <span class="cd-score-label">Readability</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.ReadabilityScore ?? 0) * 10)%; @ScoreBarGradient(candidate.ReadabilityScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.ReadabilityScore ?? 0)/10</span>
                                                    </div>
                                                    @if (candidate.VisualsScore.HasValue)
                                                    {
                                                        <div class="cd-score-row cd-score-row-clickable @(activeDimKey == $"{fbPrefix}_visuals" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(fbPrefix, "visuals"))">
                                                            <span class="cd-score-label">Visuals</span>
                                                            <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @(candidate.VisualsScore.Value * 10)%; @ScoreBarGradient(candidate.VisualsScore.Value)"></div></div>
                                                            <span class="cd-score-val">@(candidate.VisualsScore.Value)/10</span>
                                                        </div>
                                                    }
                                                    <div class="cd-score-total" title="Combined score (max @MaxScore(candidate))">Total: <strong>@TotalScore(candidate)</strong>/@MaxScore(candidate)</div>
                                                </div>
                                                <div class="cd-score-feedback-expand">
                                                    @if (activeDimKey is not null)
                                                    {
                                                        var dimFeedback = GetDimensionFeedback(activeDimKey, candidate);
                                                        <div class="judge-feedback-text judge-feedback-dim">
                                                            <span class="dim-feedback-label">@GetDimensionLabel(activeDimKey):</span> @dimFeedback
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(candidate.JudgeFeedback))
                                                    {
                                                        <div class="judge-feedback-text">@candidate.JudgeFeedback</div>
                                                    }
                                                    else if (TotalScore(candidate) >= MaxScore(candidate))
                                                    {
                                                        <div class="judge-feedback-text judge-feedback-perfect">No feedback — perfect score</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="judge-feedback-text judge-feedback-missing">⚠️ Judge did not provide detailed feedback (score: @TotalScore(candidate)/@MaxScore(candidate)).</div>
                                                    }
                                                </div>
                                            }
                                            else if (candidate.InitialAcScore.HasValue || candidate.InitialDesignScore.HasValue || candidate.InitialReadabilityScore.HasValue)
                                            {
                                                var initPrefix = $"init_{task.TaskId}_{candidate.StrategyId}";
                                                var initActiveDim = GetActiveDimensionKey(initPrefix);
                                                <div class="cd-scores initial-scores" @onclick:stopPropagation="true">
                                                    <div class="cd-score-label-note">Initial Scores (revision in progress)</div>
                                                    <div class="cd-score-row cd-score-row-clickable @(initActiveDim == $"{initPrefix}_ac" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(initPrefix, "ac"))">
                                                        <span class="cd-score-label">Acceptance</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialAcScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialAcScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.InitialAcScore ?? 0)/10</span>
                                                    </div>
                                                    <div class="cd-score-row cd-score-row-clickable @(initActiveDim == $"{initPrefix}_design" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(initPrefix, "design"))">
                                                        <span class="cd-score-label">Design</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialDesignScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialDesignScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.InitialDesignScore ?? 0)/10</span>
                                                    </div>
                                                    <div class="cd-score-row cd-score-row-clickable @(initActiveDim == $"{initPrefix}_readability" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(initPrefix, "readability"))">
                                                        <span class="cd-score-label">Readability</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialReadabilityScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialReadabilityScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.InitialReadabilityScore ?? 0)/10</span>
                                                    </div>
                                                    @if (candidate.InitialVisualsScore.HasValue)
                                                    {
                                                        <div class="cd-score-row cd-score-row-clickable @(initActiveDim == $"{initPrefix}_visuals" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(initPrefix, "visuals"))">
                                                            <span class="cd-score-label">Visuals</span>
                                                            <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @(candidate.InitialVisualsScore.Value * 10)%; @ScoreBarGradient(candidate.InitialVisualsScore.Value)"></div></div>
                                                            <span class="cd-score-val">@(candidate.InitialVisualsScore.Value)/10</span>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="cd-score-feedback-expand">
                                                    @if (initActiveDim is not null)
                                                    {
                                                        var dimFb = GetInitialDimensionFeedback(initActiveDim, candidate);
                                                        <div class="judge-feedback-text judge-feedback-dim">
                                                            <span class="dim-feedback-label">@GetDimensionLabel(initActiveDim):</span> @dimFb
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(candidate.JudgeFeedback))
                                                    {
                                                        <div class="judge-feedback-text">@candidate.JudgeFeedback</div>
                                                    }
                                                    else if (InitialTotalScore(candidate) >= InitialMaxScore(candidate))
                                                    {
                                                        <div class="judge-feedback-text judge-feedback-perfect">No feedback — perfect score</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="judge-feedback-text judge-feedback-missing">⚠️ Judge did not provide detailed feedback (score: @InitialTotalScore(candidate)/@InitialMaxScore(candidate)).</div>
                                                    }
                                                </div>
                                            }
                                            else if (candidate.Succeeded == false)
                                            {
                                                <div class="cd-no-scores">Not scored — strategy execution failed</div>
                                            }
                                            else if (candidate.State < CandidateState.Evaluated)
                                            {
                                                <div class="cd-no-scores">Scores available after evaluation completes</div>
                                            }

                                            <div class="cd-metrics">
                                                @if (candidate.ElapsedSec.HasValue) { <span class="cd-metric" title="Execution time">⏱ @FormatDuration(candidate.ElapsedSec.Value)</span> }
                                                @if (candidate.TokensUsed.HasValue) { <span class="cd-metric" title="Tokens used">🔤 @(candidate.TokensUsed.Value.ToString("N0")) tokens</span> }
                                                @if (candidate.ExecutionSummary is { } s)
                                                {
                                                    <span class="cd-metric">📁 @s.FilesChanged.Count files</span>
                                                    <span class="cd-metric">+@s.TotalLinesAdded / -@s.TotalLinesRemoved lines</span>
                                                }
                                            </div>

                                            @if (candidate.Succeeded == false && !string.IsNullOrEmpty(candidate.FailureReason))
                                            {
                                                <div class="cd-failure"><span class="cd-failure-label">Failure:</span> @candidate.FailureReason</div>
                                            }

                                            var activeExpScreenshot = candidate.ScreenshotBase64 ?? candidate.InitialScreenshotBase64;
                                            var activeHasShot = !string.IsNullOrEmpty(activeExpScreenshot) && !IsOnePixelPlaceholder(activeExpScreenshot);
                                            var activeHasGif = !string.IsNullOrEmpty(candidate.AnimatedGifPath);
                                            var activeHasVideo = !string.IsNullOrEmpty(candidate.VideoPath);
                                            var activeShotLabel = string.IsNullOrEmpty(candidate.ScreenshotBase64) ? "Initial Screenshot (pre-revision)" : "Preview Screenshot";
                                            var activeShotPagesNote = (candidate.ScreenshotPaths is { Count: > 1 } sp) ? $" ({sp.Count} pages)" : "";
                                            var activeShotTitle = $"{candidate.StrategyId} — {activeShotLabel}";
                                            var activeGifTitle = $"{candidate.StrategyId} — Animated GIF";
                                            var activeVideoTitle = $"{candidate.StrategyId} — Interaction Video";
                                            var activeShotTooltip = $"{activeShotLabel}{activeShotPagesNote} — click to enlarge";
                                            var activeGifUrl = activeHasGif ? GetArtifactUrl(candidate.AnimatedGifPath) : "";
                                            var activeVideoUrl = activeHasVideo ? GetArtifactUrl(candidate.VideoPath) : "";

                                            @if (activeHasShot || activeHasGif || activeHasVideo)
                                            {
                                                <div class="cd-media-row" title="Click any tile to enlarge in lightbox. Order: screenshot → animated GIF → video.">
                                                    @if (activeHasShot)
                                                    {
                                                        <div class="cd-media-tile" role="button" tabindex="0"
                                                             title="@activeShotTooltip"
                                                             @onclick="() => OpenLightbox(activeExpScreenshot, activeShotTitle)"
                                                             @onclick:stopPropagation="true">
                                                            <img src="data:image/png;base64,@activeExpScreenshot" alt="@candidate.StrategyId screenshot" class="cd-media-tile-thumb" />
                                                            <span class="cd-media-tile-label">@PreviewTileLabel(candidate.PreviewSource)</span>
                                                        </div>
                                                    }
                                                    @if (activeHasGif)
                                                    {
                                                        <div class="cd-media-tile" role="button" tabindex="0"
                                                             title="Animated GIF — click to enlarge"
                                                             @onclick="() => OpenLightboxGif(activeGifUrl, activeGifTitle)"
                                                             @onclick:stopPropagation="true">
                                                            <img src="@activeGifUrl" alt="@candidate.StrategyId animated GIF" class="cd-media-tile-thumb" />
                                                            <span class="cd-media-tile-label">🎞️ GIF</span>
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(candidate.AnimatedGifPath))
                                                    {
                                                        <div class="cd-media-tile cd-media-tile-missing" title="GIF was generated but file is no longer available">
                                                            <span class="cd-media-tile-icon">🎞️</span>
                                                            <span class="cd-media-tile-label">GIF (unavailable)</span>
                                                        </div>
                                                    }
                                                    @if (activeHasVideo)
                                                    {
                                                        <div class="cd-media-tile cd-media-tile-video" role="button" tabindex="0"
                                                             title="Interaction video — click to enlarge and play"
                                                             @onclick="() => OpenLightboxVideo(activeVideoUrl, activeVideoTitle)"
                                                             @onclick:stopPropagation="true">
                                                            <video preload="metadata" muted class="cd-media-tile-thumb cd-media-tile-video-thumb">
                                                                <source src="@activeVideoUrl" type="video/webm" />
                                                            </video>
                                                            <span class="cd-media-tile-play" aria-hidden="true">▶</span>
                                                            <span class="cd-media-tile-label">🎬 Video</span>
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(candidate.VideoPath))
                                                    {
                                                        <div class="cd-media-tile cd-media-tile-missing" title="Video was recorded but file is no longer available">
                                                            <span class="cd-media-tile-icon">🎬</span>
                                                            <span class="cd-media-tile-label">Video (unavailable)</span>
                                                        </div>
                                                    }
                                                </div>
                                                @* Asset Gallery — image-asset / diagram producers expose a per-asset list *@
                                                @if (candidate.IncludedAssetPaths is { Count: > 0 } activeAssets
                                                     && (candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.ImageAssets
                                                      || candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.Diagrams))
                                                {
                                                    var activeGallerySectionKey = $"gallery_active_{task.TaskId}_{candidate.StrategyId}";
                                                    var activeGalleryOpen = _expandedGalleries.Contains(activeGallerySectionKey);
                                                    var activeGalleryLabel = candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.Diagrams
                                                        ? "Diagrams" : "Asset Gallery";
                                                    <div class="asset-gallery">
                                                        <button class="asset-gallery-toggle" type="button"
                                                                @onclick="() => ToggleGallery(activeGallerySectionKey)"
                                                                @onclick:stopPropagation="true"
                                                                title="@(activeGalleryOpen ? "Hide" : "Show") @(activeAssets.Count) included @(candidate.PreviewSource.ToString())">
                                                            <span class="asset-gallery-caret">@(activeGalleryOpen ? "▾" : "▸")</span>
                                                            <span class="asset-gallery-label">@activeGalleryLabel</span>
                                                            <span class="asset-gallery-count">(@activeAssets.Count)</span>
                                                        </button>
                                                        @if (activeGalleryOpen)
                                                        {
                                                            <ul class="asset-gallery-list">
                                                                @foreach (var assetPath in activeAssets)
                                                                {
                                                                    <li class="asset-gallery-item" title="@assetPath">
                                                                        <img src="data:image/png;base64,@activeExpScreenshot"
                                                                             alt="@System.IO.Path.GetFileName(assetPath)"
                                                                             class="asset-gallery-thumb" />
                                                                        <span class="asset-gallery-name">@System.IO.Path.GetFileName(assetPath)</span>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                }
                                                @* Secondary preview strip — mixed-content PRs (Playwright primary + ImageAssets secondary) *@
                                                @if (!string.IsNullOrEmpty(candidate.SecondaryPreviewBase64))
                                                {
                                                    var activeSecondaryAssets = candidate.SecondaryAssetPaths ?? Array.Empty<string>();
                                                    var activeSecondaryTitle = $"{candidate.StrategyId} — Assets used";
                                                    <div class="cd-asset-strip" title="Committed art assets in this candidate. Click any tile to view the full contact sheet.">
                                                        <div class="cd-asset-strip-header">
                                                            <span class="cd-asset-strip-icon">📦</span>
                                                            <span class="cd-asset-strip-label">Assets used in this candidate</span>
                                                            <span class="cd-asset-strip-count">(@activeSecondaryAssets.Count)</span>
                                                        </div>
                                                        <div class="cd-asset-strip-thumbs">
                                                            @if (activeSecondaryAssets.Count == 0)
                                                            {
                                                                @* No per-asset list — fall back to the composite contact-sheet itself as a single tile. *@
                                                                <div class="cd-asset-strip-thumb" role="button" tabindex="0"
                                                                     title="Contact sheet — click to enlarge"
                                                                     @onclick="() => OpenLightbox(candidate.SecondaryPreviewBase64, activeSecondaryTitle)"
                                                                     @onclick:stopPropagation="true">
                                                                    <img src="data:image/png;base64,@candidate.SecondaryPreviewBase64"
                                                                         alt="Asset contact sheet" class="cd-asset-strip-img" />
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var assetPath in activeSecondaryAssets)
                                                                {
                                                                    <div class="cd-asset-strip-thumb" role="button" tabindex="0"
                                                                         title="@assetPath — click to view full contact sheet"
                                                                         @onclick="() => OpenLightbox(candidate.SecondaryPreviewBase64, activeSecondaryTitle)"
                                                                         @onclick:stopPropagation="true">
                                                                        <img src="data:image/png;base64,@candidate.SecondaryPreviewBase64"
                                                                             alt="@System.IO.Path.GetFileName(assetPath)" class="cd-asset-strip-img" />
                                                                        <span class="cd-asset-strip-name">@System.IO.Path.GetFileName(assetPath)</span>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else if (IsNonVisualPreviewSource(candidate.PreviewSource))
                                            {
                                                <div class="no-visual-content-placeholder" title="@PreviewStateTooltip(candidate.PreviewSource)">
                                                    <span class="no-visual-content-icon">@PreviewStateIcon(candidate.PreviewSource)</span>
                                                    <span class="no-visual-content-text">@PreviewStateDescription(candidate.PreviewSource)</span>
                                                </div>
                                            }
                                            else if (candidate.State >= CandidateState.Evaluated)
                                            {
                                                <div class="cd-no-screenshot">📷 No preview generated — the candidate produced no app screenshots, image assets, or diagrams</div>
                                            }
                                        }
                                        @if (activeTab == "prelim")
                                        {
                                            @if (candidate.InitialAcScore.HasValue || candidate.InitialDesignScore.HasValue || candidate.InitialReadabilityScore.HasValue)
                                            {
                                                <div class="cd-scores">
                                                    <div class="cd-score-label-note">Preliminary Scores (before revision)</div>
                                                    <div class="cd-score-row">
                                                        <span class="cd-score-label">Acceptance</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialAcScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialAcScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.InitialAcScore ?? 0)/10</span>
                                                    </div>
                                                    <div class="cd-score-row">
                                                        <span class="cd-score-label">Design</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialDesignScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialDesignScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.InitialDesignScore ?? 0)/10</span>
                                                    </div>
                                                    <div class="cd-score-row">
                                                        <span class="cd-score-label">Readability</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.InitialReadabilityScore ?? 0) * 10)%; @ScoreBarGradient(candidate.InitialReadabilityScore ?? 0)"></div></div>
                                                        <span class="cd-score-val">@(candidate.InitialReadabilityScore ?? 0)/10</span>
                                                    </div>
                                                    @if (candidate.InitialVisualsScore.HasValue)
                                                    {
                                                    <div class="cd-score-row">
                                                        <span class="cd-score-label">Visuals</span>
                                                        <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @(candidate.InitialVisualsScore.Value * 10)%; @ScoreBarGradient(candidate.InitialVisualsScore.Value)"></div></div>
                                                        <span class="cd-score-val">@candidate.InitialVisualsScore.Value/10</span>
                                                    </div>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(candidate.JudgeFeedback))
                                                {
                                                    <div class="cd-score-feedback-expand" style="margin-top: .5rem;">
                                                        <div class="judge-feedback-label" style="font-size: .75em; font-weight: 600; opacity: .7; margin-bottom: .25rem;">🧑‍⚖️ Revision Feedback:</div>
                                                        <div class="judge-feedback-text">@candidate.JudgeFeedback</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="cd-score-feedback-expand" style="margin-top: .5rem;">
                                                        <div class="judge-feedback-text judge-feedback-perfect">No revision feedback — all scores met threshold</div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="cd-no-scores">No preliminary scores available</div>
                                            }
                                        }
                                        @if (activeTab == "activity")
                                        {
                                            @if (candidate.ActivityLog.Count > 0)
                                            {
                                                <div class="cd-activity-timeline">
                                                    @foreach (var group in GroupConsecutive(candidate.ActivityLog.Reverse()))
                                                    {
                                                        <div class="cd-activity-entry" @onclick="() => _selectedActivity = group.Entry" @onclick:stopPropagation="true" title="Click for full detail">
                                                            <LocalTimeText OffsetValue="group.Entry.Timestamp" CssClass="cd-activity-time" IncludeSeconds="true" />
                                                            <span class="cd-activity-cat cd-activity-cat-@group.Entry.Category">@group.Entry.Category</span>
                                                            <span class="cd-activity-msg">@group.Entry.Message</span>
                                                            @if (group.Count > 1)
                                                            {
                                                                <span class="activity-group-badge" title="@group.Count consecutive identical entries">(×@group.Count)</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="cd-empty-tab">No activity recorded yet</div>
                                            }
                                        }
                                        @if (activeTab == "files")
                                        {
                                            @if (candidate.ExecutionSummary?.FilesChanged is { Count: > 0 } files)
                                            {
                                                <div class="cd-file-tree">
                                                    @foreach (var file in files.OrderBy(f => f.Path))
                                                    {
                                                        <div class="cd-file-row">
                                                            <span class="cd-file-type cd-file-type-@(file.Type.ToLowerInvariant())">@FileTypeIcon(file.Type)</span>
                                                            <span class="cd-file-path" title="@file.Path">@file.Path</span>
                                                            @if (!file.IsBinary) { <span class="cd-file-stats">@if (file.LinesAdded > 0) { <span class="cd-file-add">+@file.LinesAdded</span> } @if (file.LinesRemoved > 0) { <span class="cd-file-del">-@file.LinesRemoved</span> }</span> }
                                                            else { <span class="cd-file-stats muted">binary</span> }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else { <div class="cd-empty-tab">No file changes recorded.</div> }
                                        }
                                        @if (activeTab == "metrics")
                                        {
                                            <div class="cd-metrics-detail">
                                                <div class="cd-metric-row"><span class="cd-metric-label">Elapsed Time</span><span class="cd-metric-value">@(candidate.ElapsedSec?.ToString("0.1") ?? "—")s</span></div>
                                                <div class="cd-metric-row"><span class="cd-metric-label">Tokens Used</span><span class="cd-metric-value">@(candidate.TokensUsed?.ToString("N0") ?? "unknown")</span></div>
                                                @{
                                                    var toolEvents = candidate.ActivityLog.Count(e => e.Category == "tool" || e.Category == "intent");
                                                    var totalEvents = candidate.ActivityLog.Count;
                                                }
                                                @if (totalEvents > 0)
                                                {
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Tool Calls</span><span class="cd-metric-value">@toolEvents</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Total Events</span><span class="cd-metric-value">@totalEvents</span></div>
                                                }
                                                @if (candidate.Survived.HasValue)
                                                {
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Build Gate</span><span class="cd-metric-value">@(candidate.Survived == true ? "✅ Passed" : "❌ Failed")</span></div>
                                                }
                                                @if (candidate.ExecutionSummary is { } sm)
                                                {
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Files Changed</span><span class="cd-metric-value">@sm.FilesChanged.Count</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Lines Added</span><span class="cd-metric-value cd-file-add">+@sm.TotalLinesAdded</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Lines Removed</span><span class="cd-metric-value cd-file-del">-@sm.TotalLinesRemoved</span></div>
                                                }
                                                @if (candidate.CaptureMetrics is { } cm)
                                                {
                                                    <div class="cd-metric-section-header">📸 Capture Metrics</div>
                                                    @if (!string.IsNullOrEmpty(candidate.AppBaseUrl))
                                                    {
                                                        <div class="cd-metric-row"><span class="cd-metric-label">App URL</span><span class="cd-metric-value cd-url-value">🌐 @candidate.AppBaseUrl</span></div>
                                                    }
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Primary Source</span><span class="cd-metric-value">@(cm.PrimarySource == ScreenshotCaptureSource.Mcp ? "🟣 MCP" : "🔵 Direct")</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Total Artifacts</span><span class="cd-metric-value">@cm.TotalArtifacts</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Unique Pages</span><span class="cd-metric-value">@cm.TotalUniquePages</span></div>
                                                    @if (cm.ExpectedPageCount > 0)
                                                    {
                                                        var coveragePct = cm.TotalUniquePages * 100 / cm.ExpectedPageCount;
                                                        var coverageClass = coveragePct >= 75 ? "cd-coverage-good" : coveragePct >= 50 ? "cd-coverage-partial" : "cd-coverage-low";
                                                        <div class="cd-metric-row"><span class="cd-metric-label">Page Coverage</span><span class="cd-metric-value @coverageClass">📊 @cm.TotalUniquePages/@cm.ExpectedPageCount (@coveragePct%)</span></div>
                                                    }
                                                    @foreach (var src in cm.Sources)
                                                    {
                                                        var srcIcon = src.Source == ScreenshotCaptureSource.Mcp ? "🟣" : "🔵";
                                                        var srcName = src.Source == ScreenshotCaptureSource.Mcp ? "MCP" : "Direct";
                                                        <div class="cd-metric-subsection">
                                                            <span class="cd-metric-label">@srcIcon @srcName</span>
                                                            <span class="cd-metric-value">@src.ArtifactCount screenshots, @src.PagesDiscovered pages@(src.ToolCallsUsed.HasValue ? $", {src.ToolCallsUsed} tool calls" : "")@(src.DurationMs.HasValue ? $", {src.DurationMs / 1000.0:F1}s" : "")@(src.Error is not null ? $" ⚠️ {src.Error}" : "")</span>
                                                        </div>
                                                        @if (src.TestedUrls.Count > 0)
                                                        {
                                                            <div class="cd-tested-urls-visible">
                                                                <div class="cd-tested-urls-header">@srcIcon @srcName Tested URLs (@src.TestedUrls.Count)</div>
                                                                <ul>
                                                                    @foreach (var url in src.TestedUrls)
                                                                    {
                                                                        <li>@url</li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="cd-tested-urls-warn">⚠️ @srcName captured 0 pages</div>
                                                        }
                                                    }
                                                }
                                                @if (candidate.PageAnalysis is { } pa)
                                                {
                                                    <div class="cd-metric-section-header">🔍 Page Analysis (CDP)</div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Page Type</span><span class="cd-metric-value">@pa.PageType</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Network Requests</span><span class="cd-metric-value">@pa.NetworkRequestCount</span></div>
                                                    <div class="cd-metric-row"><span class="cd-metric-label">Response Size</span><span class="cd-metric-value">@FormatBytes(pa.NetworkResponseBytes)</span></div>
                                                    @if (pa.ConsoleErrors.Count > 0)
                                                    {
                                                        <div class="cd-metric-row"><span class="cd-metric-label">Console Errors</span><span class="cd-metric-value cd-file-del">@pa.ConsoleErrors.Count</span></div>
                                                    }
                                                    @if (pa.FailedRequests.Count > 0)
                                                    {
                                                        <div class="cd-metric-row"><span class="cd-metric-label">Failed Requests</span><span class="cd-metric-value cd-file-del">@pa.FailedRequests.Count</span></div>
                                                    }
                                                }
                                            </div>
                                        }
                                        @if (activeTab == "logs")
                                        {
                                            @if (candidate.ExecutionSummary?.DiagnosticLog is { Count: > 0 } log)
                                            {
                                                <div class="cd-log-viewer">
                                                    @foreach (var logLine in log) { <div class="cd-log-line">@logLine</div> }
                                                </div>
                                            }
                                            else { <div class="cd-empty-tab">No diagnostic logs captured.</div> }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                @{
                    var allEvaluated = task.Candidates.Values.All(c => c.State >= CandidateState.Evaluated);
                    var noWinner = string.IsNullOrEmpty(task.WinnerStrategyId);
                    var allGateFailed = task.Candidates.Values.All(c => c.Survived == false);
                }
                @if (allEvaluated && noWinner && allGateFailed)
                {
                    <div class="task-no-winner" title="All candidate patches failed build gate checks — no winner could be selected. The runner will fall back to legacy code path.">
                        ⚠️ No winner — all @task.Candidates.Count candidates failed build gates. Falling back to legacy path.
                    </div>
                }
                else if (allEvaluated && noWinner && task.Candidates.Values.Any(c => c.Survived == true))
                {
                    <div class="task-evaluating" title="Evaluation completed but winner not yet determined">
                        🔄 Evaluation complete — selecting winner…
                    </div>
                }
            </div>
        }
    }
</section>

<section class="strategies-section">
    <h2 title="Completed tasks with evaluation results — click a row to expand and see detailed candidate data">Recent Completed (last @_recentTasks.Count)</h2>
    @if (_recentTasks.Count == 0)
    {
        <div class="empty-state">No completed tasks yet.</div>
    }
    else
    {
        <table class="recent-table" data-testid="strategies-recent-table">
            <thead>
                <tr>
                    <th title="Click a row to expand/collapse details"></th>
                    <th class="sortable-col @(SortHeaderClass("wave"))" @onclick='() => ToggleSort("wave")' title="Wave assignment — Scaffold first, Final Integration last, all other tasks in between (click to sort)">
                        Wave @SortIndicator("wave")
                    </th>
                    <th class="sortable-col @(SortHeaderClass("title"))" @onclick='() => ToggleSort("title")' title="PR title (or task ID if no PR yet) — click to sort">
                        Task @SortIndicator("title")
                    </th>
                    <th title="Pull Request created from this task — click to open in a new tab">PR</th>
                    <th title="The framework that produced the best code for this task">Winner</th>
                    <th title="All frameworks that competed on this task">Candidates</th>
                    <th title="How the winner was selected (e.g., highest score, only survivor, tie-break rule)">Tie-break</th>
                    <th class="sortable-col @(SortHeaderClass("runtime"))" @onclick='() => ToggleSort("runtime")' title="Total wall-clock time from task start to completion (click to sort)">
                        Runtime @SortIndicator("runtime")
                    </th>
                    <th class="sortable-col @(SortHeaderClass("eval"))" @onclick='() => ToggleSort("eval")' title="Time spent evaluating all candidates (gate checks + LLM judge scoring) (click to sort)">
                        Eval @SortIndicator("eval")
                    </th>
                    <th class="sortable-col @(SortHeaderClass("completed"))" @onclick='() => ToggleSort("completed")' title="When the task evaluation finished (click to sort)">
                        Completed @SortIndicator("completed")
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in SortRecentTasks(_recentTasks))
                {
                    var expandKey = $"{task.RunId}:{task.TaskId}";
                    var isExpanded = _expandedTasks.Contains(expandKey);
                    var taskDisplayName = !string.IsNullOrWhiteSpace(task.PrTitle) ? task.PrTitle! 
                        : !string.IsNullOrWhiteSpace(task.TaskTitle) ? task.TaskTitle! 
                        : task.TaskId;
                    var waveLabel = ComputeWaveLabel(task);
                    var totalRuntime = ComputeTotalRuntimeSec(task);
                    <tr @key="@($"row-{task.RunId}-{task.TaskId}")" class="recent-row @(isExpanded ? "expanded" : "")" @onclick="() => ToggleExpand(expandKey)">
                        <td class="expand-toggle" title="@(isExpanded ? "Collapse details" : "Expand to see candidate details")">@(isExpanded ? "▾" : "▸")</td>
                        <td><span class="wave-badge wave-@(waveLabel.Replace(" ", "-").ToLowerInvariant())" title="Execution order assignment">@waveLabel</span></td>
                        <td><span class="task-id" title="@(string.IsNullOrEmpty(task.PrTitle) ? "Task ID (no PR linked yet)" : $"PR title — internal task ID: {task.TaskId}")">@taskDisplayName</span></td>
                        <td>
                            @if (task.PrNumber is int recentPrNum)
                            {
                                var recentPrHref = LinkService.BuildPullRequestUrl(recentPrNum, task.PrUrl);
                                var recentPrTarget = LinkService.TargetForUrl(recentPrHref);
                                var recentPrRel = recentPrTarget == "_blank" ? "noopener" : null;
                                var recentPrTitleAttr = !string.IsNullOrEmpty(task.PrTitle)
                                    ? (LinkService.IsInternal(recentPrHref)
                                        ? $"View PR #{recentPrNum} in dashboard: {task.PrTitle}"
                                        : $"Open PR #{recentPrNum} on {LinkService.PlatformDisplayName}: {task.PrTitle}")
                                    : (LinkService.IsInternal(recentPrHref)
                                        ? $"View PR #{recentPrNum} in dashboard"
                                        : $"Open PR #{recentPrNum} on {LinkService.PlatformDisplayName}");
                                <a class="task-pr-link" href="@recentPrHref" target="@recentPrTarget" rel="@recentPrRel"
                                   title="@recentPrTitleAttr"
                                   @onclick:stopPropagation="true">
                                    🔗 #@recentPrNum
                                </a>
                            }
                            else
                            {
                                <span class="muted" title="No PR linked to this task">—</span>
                            }
                        </td>
                        <td>
                            @if (task.WinnerStrategyId is string w)
                            {
                                <span class="winner-badge" title="@StrategyTooltip(w) — won this task">@w</span>
                            }
                            else
                            {
                                <span class="muted" title="No candidate produced acceptable code for this task">— none —</span>
                            }
                        </td>
                        <td title="Frameworks that ran: @string.Join(", ", task.Candidates.Keys.Select(k => StrategyDisplayName(k)))">@string.Join(", ", task.Candidates.Keys)</td>
                        <td class="muted" title="Selection reason for the winning candidate">@task.TieBreakReason</td>
                        <td title="Total wall-clock time from task start to completion (StartedAt → CompletedAt)">@(totalRuntime.HasValue ? FormatDuration(totalRuntime.Value) : "-")</td>
                        <td title="Total evaluation time including gate checks and LLM judge scoring">@(task.EvaluationElapsedSec.HasValue ? FormatDuration(task.EvaluationElapsedSec.Value) : "-")</td>
                        <td title="@(task.CompletedAt?.ToString("u") ?? "Not yet completed")"><LocalTimeText OffsetValue="task.CompletedAt" Placeholder="-" /></td>
                    </tr>
                    @if (isExpanded)
                    {
                        <tr @key="@($"detail-{task.RunId}-{task.TaskId}")" class="detail-row">
                            <td colspan="10">
                                <div class="candidate-detail-grid">
                                    @foreach (var candidate in task.Candidates.Values.OrderByDescending(c => TotalScore(c)).ThenBy(c => c.StrategyId.Equals("baseline", StringComparison.OrdinalIgnoreCase) ? 1 : 0).ThenBy(c => c.StrategyId))
                                    {
                                        var isWinner = string.Equals(task.WinnerStrategyId, candidate.StrategyId, StringComparison.OrdinalIgnoreCase);
                                        <div class="candidate-detail-card @(isWinner ? "is-winner" : "") @(candidate.Succeeded == false ? "is-failed" : "")">
                                            @* Header *@
                                            <div class="cd-header">
                                                <span class="cd-name" title="@StrategyTooltip(candidate.StrategyId)">
                                                    @if (isWinner) { <span class="cd-trophy" title="This framework won the task">🏆</span> }
                                                    @candidate.StrategyId
                                                </span>
                                                <span class="cd-state cd-state-@(candidate.State.ToString().ToLowerInvariant())" title="@StateTooltip(candidate.State)">@candidate.State</span>
                                            </div>

                                            @* Progress pipeline *@
                                            <div class="cd-pipeline" title="Execution pipeline: Start → Gate checks (build, tests, screenshots) → LLM Judge scoring → Winner selection">
                                                <span class="cd-pip @(candidate.State >= CandidateState.Running ? "pip-done" : "")" title="Framework started code generation">Started</span>
                                                <span class="cd-pip-arrow">→</span>
                                                <span class="cd-pip @(candidate.Survived == true || candidate.State >= CandidateState.Evaluated ? "pip-done" : candidate.Survived == false && candidate.State >= CandidateState.Evaluated ? "pip-fail" : candidate.Succeeded == false ? "pip-fail" : "")"
                                                      title="Gate checks: build success, test pass, and optional screenshot verification">
                                                    @(candidate.Survived == true ? "Gates ✓" : candidate.Survived == false && candidate.State >= CandidateState.Evaluated ? "Gate Failed ✗" : candidate.Succeeded == false ? "Failed ✗" : "Evaluating…")
                                                </span>
                                                <span class="cd-pip-arrow">→</span>
                                                <span class="cd-pip @(candidate.State >= CandidateState.Scored ? "pip-done" : candidate.State >= CandidateState.Evaluated && !string.IsNullOrEmpty(candidate.JudgeSkippedReason) ? "pip-skip" : "")"
                                                      title="LLM Judge: scores code on Acceptance Criteria, Design, and Readability (each 0–10)">
                                                    @if (candidate.State >= CandidateState.Scored)
                                                    {
                                                        @:Scored ✓
                                                    }
                                                    else if (candidate.State >= CandidateState.Evaluated && !string.IsNullOrEmpty(candidate.JudgeSkippedReason))
                                                    {
                                                        @:Judge skipped
                                                    }
                                                    else if (candidate.Survived == false && candidate.State >= CandidateState.Evaluated)
                                                    {
                                                        @:—
                                                    }
                                                    else
                                                    {
                                                        @:Scoring…
                                                    }
                                                </span>
                                                @if (isWinner)
                                                {
                                                    <span class="cd-pip-arrow">→</span>
                                                    <span class="cd-pip pip-winner" title="This framework produced the best code and was selected as the winner">Winner 🏆</span>
                                                }
                                            </div>

                                            @* Tabbed detail view *@
                                            @{
                                                var tabKey = $"{task.TaskId}_{candidate.StrategyId}";
                                                var activeTab = _activeTabs.GetValueOrDefault(tabKey, "overview");
                                            }
                                            <div class="cd-tabs">
                                                <button class="cd-tab @(activeTab == "overview" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "overview"))" @onclick:stopPropagation="true" title="Scores, judge reasoning, key metrics, and screenshot preview">Overview</button>
                                                <button class="cd-tab @(activeTab == "activity" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "activity"))" @onclick:stopPropagation="true" title="Real-time activity log showing what the framework did step by step">
                                                    Activity @if (candidate.ActivityLog.Count > 0) { <span class="cd-tab-badge">@candidate.ActivityLog.Count</span> }
                                                </button>
                                                <button class="cd-tab @(activeTab == "files" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "files"))" @onclick:stopPropagation="true" title="Files created, modified, or deleted by this framework">
                                                    Files @if (candidate.ExecutionSummary?.FilesChanged.Count > 0) { <span class="cd-tab-badge">@candidate.ExecutionSummary.FilesChanged.Count</span> }
                                                </button>
                                                <button class="cd-tab @(activeTab == "metrics" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "metrics"))" @onclick:stopPropagation="true" title="Detailed performance metrics: time, tokens, lines changed, patch size, and judge scores">Metrics</button>
                                                <button class="cd-tab @(activeTab == "logs" ? "active" : "")" @onclick="@(() => SetTab(tabKey, "logs"))" @onclick:stopPropagation="true" title="Raw diagnostic logs from the framework execution (stdout/stderr)">
                                                    Logs @if (candidate.ExecutionSummary?.DiagnosticLog.Count > 0) { <span class="cd-tab-badge">@candidate.ExecutionSummary.DiagnosticLog.Count</span> }
                                                </button>
                                            </div>

                                            <div class="cd-tab-content">
                                                @if (activeTab == "overview")
                                                {
                                                    @* Scores *@
                                                    @if (candidate.AcScore.HasValue || candidate.DesignScore.HasValue || candidate.ReadabilityScore.HasValue)
                                                    {
                                                        var recentPrefix = $"recent_{task.TaskId}_{candidate.StrategyId}";
                                                        var recentActiveDim = GetActiveDimensionKey(recentPrefix);
                                                        <div class="cd-scores" @onclick:stopPropagation="true">
                                                            <div class="cd-score-row cd-score-row-clickable @(recentActiveDim == $"{recentPrefix}_ac" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(recentPrefix, "ac"))">
                                                                <span class="cd-score-label">Acceptance</span>
                                                                <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.AcScore ?? 0) * 10)%; @ScoreBarGradient(candidate.AcScore ?? 0)"></div></div>
                                                                <span class="cd-score-val">@(candidate.AcScore ?? 0)/10</span>
                                                            </div>
                                                            <div class="cd-score-row cd-score-row-clickable @(recentActiveDim == $"{recentPrefix}_design" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(recentPrefix, "design"))">
                                                                <span class="cd-score-label">Design</span>
                                                                <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.DesignScore ?? 0) * 10)%; @ScoreBarGradient(candidate.DesignScore ?? 0)"></div></div>
                                                                <span class="cd-score-val">@(candidate.DesignScore ?? 0)/10</span>
                                                            </div>
                                                            <div class="cd-score-row cd-score-row-clickable @(recentActiveDim == $"{recentPrefix}_readability" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(recentPrefix, "readability"))">
                                                                <span class="cd-score-label">Readability</span>
                                                                <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @((candidate.ReadabilityScore ?? 0) * 10)%; @ScoreBarGradient(candidate.ReadabilityScore ?? 0)"></div></div>
                                                                <span class="cd-score-val">@(candidate.ReadabilityScore ?? 0)/10</span>
                                                            </div>
                                                            @if (candidate.VisualsScore.HasValue)
                                                            {
                                                                <div class="cd-score-row cd-score-row-clickable @(recentActiveDim == $"{recentPrefix}_visuals" ? "cd-score-row-active" : "")" @onclick="@(() => ToggleDimensionFeedback(recentPrefix, "visuals"))">
                                                                    <span class="cd-score-label">Visuals</span>
                                                                    <div class="cd-score-bar-bg"><div class="cd-score-bar" style="width: @(candidate.VisualsScore.Value * 10)%; @ScoreBarGradient(candidate.VisualsScore.Value)"></div></div>
                                                                    <span class="cd-score-val">@(candidate.VisualsScore.Value)/10</span>
                                                                </div>
                                                            }
                                                            <div class="cd-score-total" title="Combined score across all categories (max @MaxScore(candidate))">
                                                                Total: <strong>@TotalScore(candidate)</strong>/@MaxScore(candidate)
                                                            </div>
                                                        </div>
                                                        <div class="cd-score-feedback-expand">
                                                            @if (recentActiveDim is not null)
                                                            {
                                                                var dimFb = GetDimensionFeedback(recentActiveDim, candidate);
                                                                <div class="judge-feedback-text judge-feedback-dim">
                                                                    <span class="dim-feedback-label">@GetDimensionLabel(recentActiveDim):</span> @dimFb
                                                                </div>
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(candidate.JudgeFeedback))
                                                            {
                                                                <div class="judge-feedback-text">@candidate.JudgeFeedback</div>
                                                            }
                                                            else if (TotalScore(candidate) >= MaxScore(candidate))
                                                            {
                                                                <div class="judge-feedback-text judge-feedback-perfect">No feedback — perfect score</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="judge-feedback-text judge-feedback-missing">⚠️ Judge did not provide detailed feedback (score: @TotalScore(candidate)/@MaxScore(candidate)).</div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (candidate.Survived == false && candidate.State >= CandidateState.Evaluated)
                                                    {
                                                        <div class="cd-no-scores">Not scored — failed gate: @(candidate.FailureReason ?? "unknown")</div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(candidate.JudgeSkippedReason))
                                                    {
                                                        <div class="cd-no-scores cd-judge-skipped">
                                                            No LLM judge scoring — <strong>@candidate.JudgeSkippedReason</strong>
                                                        </div>
                                                    }
                                                    else if (candidate.Succeeded == false)
                                                    {
                                                        <div class="cd-no-scores">Not scored — strategy execution failed</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="cd-no-scores">Scores not available</div>
                                                    }

                                                    @* Judge Reasoning *@
                                                    @if (!string.IsNullOrEmpty(candidate.ExecutionSummary?.JudgeReasoning))
                                                    {
                                                        <div class="cd-reasoning">
                                                            <div class="cd-reasoning-label" title="The LLM judge's explanation for why it assigned these scores">Judge Reasoning</div>
                                                            <div class="cd-reasoning-text">@candidate.ExecutionSummary.JudgeReasoning</div>
                                                        </div>
                                                    }

                                                    @* Key metrics row *@
                                                    <div class="cd-metrics">
                                                        @if (candidate.ElapsedSec.HasValue)
                                                        {
                                                            <span class="cd-metric" title="Actual execution time for this framework's code generation">⏱ @FormatDuration(candidate.ElapsedSec.Value)</span>
                                                        }
                                                        @if (candidate.TokensUsed.HasValue)
                                                        {
                                                            <span class="cd-metric" title="Total LLM tokens consumed during code generation">🔤 @(candidate.TokensUsed.Value.ToString("N0")) tokens</span>
                                                        }
                                                        @if (candidate.ExecutionSummary is { } s)
                                                        {
                                                            <span class="cd-metric" title="Number of files created, modified, or deleted">📁 @s.FilesChanged.Count files</span>
                                                            <span class="cd-metric" title="Lines of code added vs removed">+@s.TotalLinesAdded / -@s.TotalLinesRemoved lines</span>
                                                        }
                                                    </div>

                                                    @* Failure reason *@
                                                    @if (candidate.Succeeded == false && !string.IsNullOrEmpty(candidate.FailureReason))
                                                    {
                                                        <div class="cd-failure">
                                                            <span class="cd-failure-label">Failure:</span> @candidate.FailureReason
                                                        </div>
                                                    }

                                                    @* Media row — screenshot, animated GIF, video. Click any tile to enlarge in lightbox. *@
                                                    var rcExpScreenshot = candidate.ScreenshotBase64 ?? candidate.InitialScreenshotBase64;
                                                    var rcIsNoVisual = IsNonVisualPreviewSource(candidate.PreviewSource);
                                                    var rcHasShot = !string.IsNullOrEmpty(rcExpScreenshot) && !rcIsNoVisual && !IsOnePixelPlaceholder(rcExpScreenshot);
                                                    var rcHasGif = !string.IsNullOrEmpty(candidate.AnimatedGifPath) && File.Exists(candidate.AnimatedGifPath);
                                                    var rcHasVideo = !string.IsNullOrEmpty(candidate.VideoPath) && File.Exists(candidate.VideoPath);
                                                    var rcShotLabel = string.IsNullOrEmpty(candidate.ScreenshotBase64) ? "Initial Screenshot (pre-revision)" : "Preview Screenshot";
                                                    var rcShotTitle = $"{candidate.StrategyId} — {rcShotLabel}";
                                                    var rcGifTitle = $"{candidate.StrategyId} — Animated GIF";
                                                    var rcVideoTitle = $"{candidate.StrategyId} — Interaction Video";
                                                    var rcGifUrl = rcHasGif ? GetArtifactUrl(candidate.AnimatedGifPath) : "";
                                                    var rcVideoUrl = rcHasVideo ? GetArtifactUrl(candidate.VideoPath) : "";

                                                    @if (rcIsNoVisual && !rcHasGif && !rcHasVideo)
                                                    {
                                                        <div class="cd-media-row" title="@PreviewStateTooltip(candidate.PreviewSource)">
                                                            <div class="cd-media-tile cd-media-tile-no-visual" title="@PreviewStateTooltip(candidate.PreviewSource)">
                                                                <span class="cd-media-tile-icon">@PreviewStateIcon(candidate.PreviewSource)</span>
                                                                <span class="cd-media-tile-label">@PreviewStateBadgeText(candidate.PreviewSource)</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (rcHasShot || rcHasGif || rcHasVideo)
                                                    {
                                                        <div class="cd-media-row" title="Click any tile to enlarge in lightbox. Order: screenshot → animated GIF → video.">
                                                            @if (rcHasShot)
                                                            {
                                                                <div class="cd-media-tile" role="button" tabindex="0"
                                                                     title="@rcShotLabel — click to enlarge"
                                                                     @onclick="() => OpenLightbox(rcExpScreenshot, rcShotTitle)"
                                                                     @onclick:stopPropagation="true">
                                                                    <img src="data:image/png;base64,@rcExpScreenshot" alt="@candidate.StrategyId screenshot" class="cd-media-tile-thumb" />
                                                                    <span class="cd-media-tile-label">@PreviewTileLabel(candidate.PreviewSource)</span>
                                                                </div>
                                                            }
                                                            @if (rcHasGif)
                                                            {
                                                                <div class="cd-media-tile" role="button" tabindex="0"
                                                                     title="Animated GIF — click to enlarge"
                                                                     @onclick="() => OpenLightboxGif(rcGifUrl, rcGifTitle)"
                                                                     @onclick:stopPropagation="true">
                                                                    <img src="@rcGifUrl" alt="@candidate.StrategyId animated GIF" class="cd-media-tile-thumb" />
                                                                    <span class="cd-media-tile-label">🎞️ GIF</span>
                                                                </div>
                                                            }
                                                            else if (!string.IsNullOrEmpty(candidate.AnimatedGifPath))
                                                            {
                                                                <div class="cd-media-tile cd-media-tile-missing" title="GIF was generated but file is no longer available">
                                                                    <span class="cd-media-tile-icon">🎞️</span>
                                                                    <span class="cd-media-tile-label">GIF (unavailable)</span>
                                                                </div>
                                                            }
                                                            @if (rcHasVideo)
                                                            {
                                                                <div class="cd-media-tile cd-media-tile-video" role="button" tabindex="0"
                                                                     title="Interaction video — click to enlarge and play"
                                                                     @onclick="() => OpenLightboxVideo(rcVideoUrl, rcVideoTitle)"
                                                                     @onclick:stopPropagation="true">
                                                                    <video preload="metadata" muted class="cd-media-tile-thumb cd-media-tile-video-thumb">
                                                                        <source src="@rcVideoUrl" type="video/webm" />
                                                                    </video>
                                                                    <span class="cd-media-tile-play" aria-hidden="true">▶</span>
                                                                    <span class="cd-media-tile-label">🎬 Video</span>
                                                                </div>
                                                            }
                                                            else if (!string.IsNullOrEmpty(candidate.VideoPath))
                                                            {
                                                                <div class="cd-media-tile cd-media-tile-missing" title="Video was recorded but file is no longer available">
                                                                    <span class="cd-media-tile-icon">🎬</span>
                                                                    <span class="cd-media-tile-label">Video (unavailable)</span>
                                                                </div>
                                                            }
                                                        </div>
                                                        @* Asset Gallery — image-asset / diagram producers expose a per-asset list *@
                                                        @if (candidate.IncludedAssetPaths is { Count: > 0 } rcAssets
                                                             && (candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.ImageAssets
                                                              || candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.Diagrams))
                                                        {
                                                            var rcGallerySectionKey = $"gallery_recent_{task.TaskId}_{candidate.StrategyId}";
                                                            var rcGalleryOpen = _expandedGalleries.Contains(rcGallerySectionKey);
                                                            var rcGalleryLabel = candidate.PreviewSource == VirtualDevTeam.Core.Strategies.Preview.CandidatePreviewSource.Diagrams
                                                                ? "Diagrams" : "Asset Gallery";
                                                            <div class="asset-gallery">
                                                                <button class="asset-gallery-toggle" type="button"
                                                                        @onclick="() => ToggleGallery(rcGallerySectionKey)"
                                                                        @onclick:stopPropagation="true"
                                                                        title="@(rcGalleryOpen ? "Hide" : "Show") @(rcAssets.Count) included @(candidate.PreviewSource.ToString())">
                                                                    <span class="asset-gallery-caret">@(rcGalleryOpen ? "▾" : "▸")</span>
                                                                    <span class="asset-gallery-label">@rcGalleryLabel</span>
                                                                    <span class="asset-gallery-count">(@rcAssets.Count)</span>
                                                                </button>
                                                                @if (rcGalleryOpen)
                                                                {
                                                                    <ul class="asset-gallery-list">
                                                                        @foreach (var assetPath in rcAssets)
                                                                        {
                                                                            <li class="asset-gallery-item" title="@assetPath">
                                                                                <img src="data:image/png;base64,@rcExpScreenshot"
                                                                                     alt="@System.IO.Path.GetFileName(assetPath)"
                                                                                     class="asset-gallery-thumb" />
                                                                                <span class="asset-gallery-name">@System.IO.Path.GetFileName(assetPath)</span>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                }
                                                            </div>
                                                        }
                                                        @* Secondary preview strip — mixed-content PRs (Playwright primary + ImageAssets secondary) *@
                                                        @if (!string.IsNullOrEmpty(candidate.SecondaryPreviewBase64))
                                                        {
                                                            var rcSecondaryAssets = candidate.SecondaryAssetPaths ?? Array.Empty<string>();
                                                            var rcSecondaryTitle = $"{candidate.StrategyId} — Assets used";
                                                            <div class="cd-asset-strip" title="Committed art assets in this candidate. Click any tile to view the full contact sheet.">
                                                                <div class="cd-asset-strip-header">
                                                                    <span class="cd-asset-strip-icon">📦</span>
                                                                    <span class="cd-asset-strip-label">Assets used in this candidate</span>
                                                                    <span class="cd-asset-strip-count">(@rcSecondaryAssets.Count)</span>
                                                                </div>
                                                                <div class="cd-asset-strip-thumbs">
                                                                    @if (rcSecondaryAssets.Count == 0)
                                                                    {
                                                                        <div class="cd-asset-strip-thumb" role="button" tabindex="0"
                                                                             title="Contact sheet — click to enlarge"
                                                                             @onclick="() => OpenLightbox(candidate.SecondaryPreviewBase64, rcSecondaryTitle)"
                                                                             @onclick:stopPropagation="true">
                                                                            <img src="data:image/png;base64,@candidate.SecondaryPreviewBase64"
                                                                                 alt="Asset contact sheet" class="cd-asset-strip-img" />
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var assetPath in rcSecondaryAssets)
                                                                        {
                                                                            <div class="cd-asset-strip-thumb" role="button" tabindex="0"
                                                                                 title="@assetPath — click to view full contact sheet"
                                                                                 @onclick="() => OpenLightbox(candidate.SecondaryPreviewBase64, rcSecondaryTitle)"
                                                                                 @onclick:stopPropagation="true">
                                                                                <img src="data:image/png;base64,@candidate.SecondaryPreviewBase64"
                                                                                     alt="@System.IO.Path.GetFileName(assetPath)" class="cd-asset-strip-img" />
                                                                                <span class="cd-asset-strip-name">@System.IO.Path.GetFileName(assetPath)</span>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    else if (IsNonVisualPreviewSource(candidate.PreviewSource))
                                                    {
                                                        <div class="no-visual-content-placeholder" title="@PreviewStateTooltip(candidate.PreviewSource)">
                                                            <span class="no-visual-content-icon">@PreviewStateIcon(candidate.PreviewSource)</span>
                                                            <span class="no-visual-content-text">@PreviewStateDescription(candidate.PreviewSource)</span>
                                                        </div>
                                                    }
                                                    else if (candidate.State >= CandidateState.Evaluated)
                                                    {
                                                        <div class="cd-no-screenshot">📷 No preview generated — the candidate produced no app screenshots, image assets, or diagrams</div>
                                                    }

                                                    @* Media capture timeline — shows step-by-step media pipeline progress for finished candidates *@
                                                    @if (candidate.MediaCaptureProgress is { Steps.Count: > 0 } fmp)
                                                    {
                                                        var fMediaKey = $"finished:{task.TaskId}:{candidate.StrategyId}";
                                                        var fMediaExpanded = _expandedMediaStrips.Contains(fMediaKey);
                                                        <div class="media-progress @(fMediaExpanded ? "media-progress-expanded" : "")"
                                                             title="@(fMediaExpanded ? "Click to collapse step details" : "Click to expand step details + per-step timing")"
                                                             data-testid="strategies-media-progress-finished"
                                                             @onclick="() => ToggleMediaStrip(fMediaKey)" @onclick:stopPropagation="true"
                                                             style="cursor:pointer;">
                                                            <span class="media-progress-label">Media:</span>
                                                            @foreach (var step in fmp.Steps)
                                                            {
                                                                var fPipClass = step.Status switch
                                                                {
                                                                    MediaCaptureStepStatus.Running => "mp-pip-running",
                                                                    MediaCaptureStepStatus.Completed => "mp-pip-done",
                                                                    MediaCaptureStepStatus.Failed => "mp-pip-failed",
                                                                    MediaCaptureStepStatus.Skipped => "mp-pip-skipped",
                                                                    _ => "mp-pip-pending",
                                                                };
                                                                var fElapsed = step.ElapsedMs is { } ms2 ? $" · {FormatStepDuration(ms2)}" : "";
                                                                var fDetail = !string.IsNullOrEmpty(step.Detail) ? $" · {step.Detail}" : "";
                                                                <span class="mp-pip @fPipClass" title="@($"{step.Id}: {step.Status}{fElapsed}{fDetail}")" data-step="@step.Id"></span>
                                                            }
                                                            @if (fmp.Steps.Any(s => s.Status == MediaCaptureStepStatus.Completed && s.Id == MediaCaptureStepId.Complete))
                                                            {
                                                                <span class="media-progress-current mp-current-done" title="Capture complete">✓ done</span>
                                                            }
                                                            else if (fmp.Steps.Any(s => s.Status == MediaCaptureStepStatus.Failed && s.Id == MediaCaptureStepId.Complete))
                                                            {
                                                                <span class="media-progress-current mp-current-failed" title="Capture aborted — gate failed">✗ failed</span>
                                                            }
                                                            <span class="media-progress-toggle" aria-hidden="true">@(fMediaExpanded ? "▾" : "▸")</span>
                                                        </div>
                                                        @if (fMediaExpanded)
                                                        {
                                                            <div class="media-progress-details" @onclick:stopPropagation="true">
                                                                <div class="mpd-summary">
                                                                    <span><strong>Total elapsed:</strong> @FormatStepDuration(fmp.TotalElapsedMs)</span>
                                                                    <span><strong>Started:</strong> <LocalTimeText OffsetValue="fmp.StartedAt" /></span>
                                                                    @{
                                                                        var fDone = fmp.Steps.Count(s => s.Status == MediaCaptureStepStatus.Completed);
                                                                        var fFail = fmp.Steps.Count(s => s.Status == MediaCaptureStepStatus.Failed);
                                                                        var fSkip = fmp.Steps.Count(s => s.Status == MediaCaptureStepStatus.Skipped);
                                                                    }
                                                                    <span><strong>Done:</strong> @fDone</span>
                                                                    @if (fFail > 0) { <span class="mpd-fail-count"><strong>Failed:</strong> @fFail</span> }
                                                                    @if (fSkip > 0) { <span class="mpd-skip-count"><strong>Skipped:</strong> @fSkip</span> }
                                                                </div>
                                                                <table class="mpd-table">
                                                                    <thead>
                                                                        <tr><th>#</th><th>Step</th><th>Status</th><th>Started</th><th>Elapsed</th><th>Detail</th></tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ int fRowNo = 1; }
                                                                        @foreach (var step in fmp.Steps)
                                                                        {
                                                                            var fRowClass = step.Status switch
                                                                            {
                                                                                MediaCaptureStepStatus.Running => "mpd-row-running",
                                                                                MediaCaptureStepStatus.Completed => "mpd-row-done",
                                                                                MediaCaptureStepStatus.Failed => "mpd-row-failed",
                                                                                MediaCaptureStepStatus.Skipped => "mpd-row-skipped",
                                                                                _ => "mpd-row-pending",
                                                                            };
                                                                            <tr class="@fRowClass">
                                                                                <td>@fRowNo</td>
                                                                                <td>@step.Id</td>
                                                                                <td>@step.Status</td>
                                                                                <td><LocalTimeText OffsetValue="step.StartedAt" /></td>
                                                                                <td>@FormatStepDuration(step.ElapsedMs)</td>
                                                                                <td class="mpd-detail">@(string.IsNullOrEmpty(step.Detail) ? "—" : step.Detail)</td>
                                                                            </tr>
                                                                            fRowNo++;
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                    }
                                                }
                                                @if (activeTab == "activity")
                                                {
                                                    @if (candidate.ActivityLog.Count > 0)
                                                    {
                                                        <div class="cd-activity-timeline">
                                                            @foreach (var group in GroupConsecutive(candidate.ActivityLog.Reverse()))
                                                            {
                                                                <div class="cd-activity-entry" @onclick="() => _selectedActivity = group.Entry" @onclick:stopPropagation="true" title="Click for full detail">
                                                                    <LocalTimeText OffsetValue="group.Entry.Timestamp" CssClass="cd-activity-time" IncludeSeconds="true" />
                                                                    <span class="cd-activity-cat cd-activity-cat-@group.Entry.Category">@group.Entry.Category</span>
                                                                    <span class="cd-activity-msg">@group.Entry.Message</span>
                                                                    @if (group.Count > 1)
                                                                    {
                                                                        <span class="activity-group-badge" title="@group.Count consecutive identical entries">(×@group.Count)</span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="cd-empty-tab">No activity recorded yet</div>
                                                    }
                                                }
                                                @if (activeTab == "files")
                                                {
                                                    @if (candidate.ExecutionSummary?.FilesChanged is { Count: > 0 } files)
                                                    {
                                                        <div class="cd-file-tree">
                                                            @foreach (var file in files.OrderBy(f => f.Path))
                                                            {
                                                                <div class="cd-file-row">
                                                                    <span class="cd-file-type cd-file-type-@(file.Type.ToLowerInvariant())">@FileTypeIcon(file.Type)</span>
                                                                    <span class="cd-file-path" title="@file.Path">@file.Path</span>
                                                                    @if (!file.IsBinary)
                                                                    {
                                                                        <span class="cd-file-stats">
                                                                            @if (file.LinesAdded > 0) { <span class="cd-file-add">+@file.LinesAdded</span> }
                                                                            @if (file.LinesRemoved > 0) { <span class="cd-file-del">-@file.LinesRemoved</span> }
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="cd-file-stats muted">binary</span>
                                                                    }
                                                                </div>
                                                            }
                                                            <div class="cd-file-summary">
                                                                @files.Count file(s) · <span class="cd-file-add">+@files.Sum(f => f.LinesAdded)</span> <span class="cd-file-del">-@files.Sum(f => f.LinesRemoved)</span> · @FormatBytes(candidate.ExecutionSummary.PatchSizeBytes) patch
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="cd-empty-tab">No file changes recorded.</div>
                                                    }
                                                }
                                                @if (activeTab == "metrics")
                                                {
                                                    <div class="cd-metrics-detail">
                                                        <div class="cd-metric-row" title="Wall-clock time the framework spent generating code">
                                                            <span class="cd-metric-label">Elapsed Time</span>
                                                            <span class="cd-metric-value">@(candidate.ElapsedSec.HasValue ? FormatDuration(candidate.ElapsedSec.Value) : "—")</span>
                                                        </div>
                                                        <div class="cd-metric-row" title="Total LLM tokens consumed (prompt + completion)">
                                                            <span class="cd-metric-label">Tokens Used</span>
                                                            <span class="cd-metric-value">@(candidate.TokensUsed?.ToString("N0") ?? "unknown")</span>
                                                        </div>
                                                        @{
                                                            var rcToolEvents = candidate.ActivityLog.Count(e => e.Category == "tool" || e.Category == "intent");
                                                            var rcTotalEvents = candidate.ActivityLog.Count;
                                                        }
                                                        @if (rcTotalEvents > 0)
                                                        {
                                                            <div class="cd-metric-row" title="Number of tool calls executed by the AI agent">
                                                                <span class="cd-metric-label">Tool Calls</span>
                                                                <span class="cd-metric-value">@rcToolEvents</span>
                                                            </div>
                                                            <div class="cd-metric-row" title="Total JSONL events from the agent session">
                                                                <span class="cd-metric-label">Total Events</span>
                                                                <span class="cd-metric-value">@rcTotalEvents</span>
                                                            </div>
                                                        }
                                                        @if (candidate.Survived.HasValue)
                                                        {
                                                            <div class="cd-metric-row" title="Whether the candidate passed the build gate">
                                                                <span class="cd-metric-label">Build Gate</span>
                                                                <span class="cd-metric-value">@(candidate.Survived == true ? "✅ Passed" : "❌ Failed")</span>
                                                            </div>
                                                        }
                                                        @if (candidate.ExecutionSummary is { } sm)
                                                        {
                                                            <div class="cd-metric-row" title="Total number of files created, modified, or deleted">
                                                                <span class="cd-metric-label">Files Changed</span>
                                                                <span class="cd-metric-value">@sm.FilesChanged.Count</span>
                                                            </div>
                                                            <div class="cd-metric-row" title="Total new lines of code added across all files">
                                                                <span class="cd-metric-label">Lines Added</span>
                                                                <span class="cd-metric-value cd-file-add">+@sm.TotalLinesAdded</span>
                                                            </div>
                                                            <div class="cd-metric-row" title="Total lines of code removed across all files">
                                                                <span class="cd-metric-label">Lines Removed</span>
                                                                <span class="cd-metric-value cd-file-del">-@sm.TotalLinesRemoved</span>
                                                            </div>
                                                            <div class="cd-metric-row" title="Total size of the git diff/patch produced">
                                                                <span class="cd-metric-label">Patch Size</span>
                                                                <span class="cd-metric-value">@FormatBytes(sm.PatchSizeBytes)</span>
                                                            </div>
                                                        }
                                                        @if (candidate.ExecutionSummary?.Scores is { } sc)
                                                        {
                                                            <div class="cd-metric-divider"></div>
                                                            <div class="cd-metric-row" title="LLM judge's combined score across all evaluated dimensions (each 0–10).">
                                                                <span class="cd-metric-label">Judge Score</span>
                                                                <span class="cd-metric-value">
                                                                    @sc.Total / @sc.MaxScore
                                                                    (AC=@sc.AcceptanceCriteria, Design=@sc.Design, Read=@sc.Readability@(sc.Visuals.HasValue ? $", Visuals={sc.Visuals.Value}" : ""))
                                                                </span>
                                                            </div>
                                                        }
                                                        @if (candidate.CaptureMetrics is { } rcCm)
                                                        {
                                                            <div class="cd-metric-section-header">📸 Capture Metrics</div>
                                                            @if (!string.IsNullOrEmpty(candidate.AppBaseUrl))
                                                            {
                                                                <div class="cd-metric-row"><span class="cd-metric-label">App URL</span><span class="cd-metric-value cd-url-value">🌐 @candidate.AppBaseUrl</span></div>
                                                            }
                                                            <div class="cd-metric-row"><span class="cd-metric-label">Primary Source</span><span class="cd-metric-value">@(rcCm.PrimarySource == ScreenshotCaptureSource.Mcp ? "🟣 MCP" : "🔵 Direct")</span></div>
                                                            <div class="cd-metric-row"><span class="cd-metric-label">Total Artifacts</span><span class="cd-metric-value">@rcCm.TotalArtifacts</span></div>
                                                            <div class="cd-metric-row"><span class="cd-metric-label">Unique Pages</span><span class="cd-metric-value">@rcCm.TotalUniquePages</span></div>
                                                            @if (rcCm.ExpectedPageCount > 0)
                                                            {
                                                                var rcCovPct = rcCm.TotalUniquePages * 100 / rcCm.ExpectedPageCount;
                                                                var rcCovClass = rcCovPct >= 75 ? "cd-coverage-good" : rcCovPct >= 50 ? "cd-coverage-partial" : "cd-coverage-low";
                                                                <div class="cd-metric-row"><span class="cd-metric-label">Page Coverage</span><span class="cd-metric-value @rcCovClass">📊 @rcCm.TotalUniquePages/@rcCm.ExpectedPageCount (@rcCovPct%)</span></div>
                                                            }
                                                            @foreach (var src in rcCm.Sources)
                                                            {
                                                                var srcIcon = src.Source == ScreenshotCaptureSource.Mcp ? "🟣" : "🔵";
                                                                var srcName = src.Source == ScreenshotCaptureSource.Mcp ? "MCP" : "Direct";
                                                                <div class="cd-metric-subsection">
                                                                    <span class="cd-metric-label">@srcIcon @srcName</span>
                                                                    <span class="cd-metric-value">@src.ArtifactCount screenshots, @src.PagesDiscovered pages@(src.ToolCallsUsed.HasValue ? $", {src.ToolCallsUsed} tool calls" : "")@(src.DurationMs.HasValue ? $", {src.DurationMs / 1000.0:F1}s" : "")@(src.Error is not null ? $" ⚠️ {src.Error}" : "")</span>
                                                                </div>
                                                                @if (src.TestedUrls.Count > 0)
                                                                {
                                                                    <div class="cd-tested-urls-visible">
                                                                        <div class="cd-tested-urls-header">@srcIcon @srcName Tested URLs (@src.TestedUrls.Count)</div>
                                                                        <ul>
                                                                            @foreach (var url in src.TestedUrls)
                                                                            {
                                                                                <li>@url</li>
                                                                            }
                                                                        </ul>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="cd-tested-urls-warn">⚠️ @srcName captured 0 pages</div>
                                                                }
                                                            }
                                                        }
                                                        @if (candidate.PageAnalysis is { } rcPa)
                                                        {
                                                            <div class="cd-metric-section-header">🔍 Page Analysis (CDP)</div>
                                                            <div class="cd-metric-row"><span class="cd-metric-label">Page Type</span><span class="cd-metric-value">@rcPa.PageType</span></div>
                                                            <div class="cd-metric-row"><span class="cd-metric-label">Network Requests</span><span class="cd-metric-value">@rcPa.NetworkRequestCount</span></div>
                                                            <div class="cd-metric-row"><span class="cd-metric-label">Response Size</span><span class="cd-metric-value">@FormatBytes(rcPa.NetworkResponseBytes)</span></div>
                                                            @if (rcPa.ConsoleErrors.Count > 0)
                                                            {
                                                                <div class="cd-metric-row"><span class="cd-metric-label">Console Errors</span><span class="cd-metric-value cd-file-del">@rcPa.ConsoleErrors.Count</span></div>
                                                            }
                                                            @if (rcPa.FailedRequests.Count > 0)
                                                            {
                                                                <div class="cd-metric-row"><span class="cd-metric-label">Failed Requests</span><span class="cd-metric-value cd-file-del">@rcPa.FailedRequests.Count</span></div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                                @if (activeTab == "logs")
                                                {
                                                    @if (candidate.ExecutionSummary?.DiagnosticLog is { Count: > 0 } log)
                                                    {
                                                        <div class="cd-log-viewer">
                                                            @foreach (var logLine in log)
                                                            {
                                                                <div class="cd-log-line">@logLine</div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="cd-empty-tab">No diagnostic logs captured.</div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@* Screenshot lightbox modal *@
@if (_lightboxImage is not null || _lightboxGifUrl is not null || _lightboxVideoUrl is not null)
{
    <div class="lightbox-overlay" @onclick="CloseLightbox">
        <div class="lightbox-content" @onclick:stopPropagation="true">
            <div class="lightbox-header">
                <span class="lightbox-title">@_lightboxTitle</span>
                <button class="lightbox-close" @onclick="CloseLightbox">✕</button>
            </div>
            @if (_lightboxImage is not null)
            {
                <img src="data:image/png;base64,@_lightboxImage" alt="@_lightboxTitle" class="lightbox-img" />
            }
            else if (_lightboxGifUrl is not null)
            {
                <img src="@_lightboxGifUrl" alt="@_lightboxTitle" class="lightbox-img" />
            }
            else if (_lightboxVideoUrl is not null)
            {
                <video src="@_lightboxVideoUrl" controls autoplay class="lightbox-video">
                    Your browser does not support the video tag.
                </video>
            }
        </div>
    </div>
}

@if (_selectedActivity is not null)
{
    <div class="activity-modal-overlay" @onclick="() => _selectedActivity = null">
        <div class="activity-modal" @onclick:stopPropagation="true">
            <div class="activity-modal-header">
                <span class="activity-modal-cat cd-activity-cat-@_selectedActivity.Category">@_selectedActivity.Category</span>
                <LocalTimeText OffsetValue="_selectedActivity.Timestamp" CssClass="activity-modal-time" IncludeDate="true" IncludeSeconds="true" />
                <button class="activity-modal-close" @onclick="() => _selectedActivity = null">✕</button>
            </div>
            <div class="activity-modal-body">@_selectedActivity.Message</div>
        </div>
    </div>
}

<style>
    .frameworks-description {
        background: var(--bg-card, #1a1e26);
        border: 1px solid var(--border-card, #2d3240);
        border-left: 3px solid var(--accent-cyan, #00d4ff);
        border-radius: var(--radius-md, 6px);
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: var(--text-secondary, #9ca3af);
        line-height: 1.6;
    }
    .frameworks-description p { margin: 0 0 0.5rem 0; }
    .frameworks-description p:last-child { margin-bottom: 0; }
    .frameworks-description strong { color: var(--text-primary, #e5e7eb); }

    .strategies-section { margin: 1.5rem 0; }
    .strategies-section h2 { font-size: 1.1rem; margin: 0 0 .75rem; }
    .task-card { background: var(--card-bg, #1a1e26); border: 1px solid var(--border, #2d3240); border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
    .task-header { display: flex; justify-content: space-between; margin-bottom: .75rem; align-items: baseline; }
    .task-id { font-weight: 600; }

    /* Sortable column headers + sort indicator arrows for the Recent Completed table. */
    .sortable-col { cursor: pointer; user-select: none; transition: background-color 0.15s; }
    .sortable-col:hover { background: rgba(255,255,255,0.05); }
    .sortable-col.sort-asc, .sortable-col.sort-desc { background: rgba(56,189,248,0.08); }

    /* Wave badges to visually distinguish Scaffold / Wave 1 / Final Integration. */
    .wave-badge { display: inline-block; padding: 2px 7px; border-radius: 4px; font-size: .75em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
    .wave-scaffold        { background: rgba(56,189,248,0.18); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.35); }
    .wave-wave-1, .wave-wave-2, .wave-wave-3, .wave-wave-4, .wave-wave-5,
    .wave-wave-6, .wave-wave-7, .wave-wave-8, .wave-wave-9 { background: rgba(34,197,94,0.18); color: #86efac; border: 1px solid rgba(34,197,94,0.35); }
    .wave-final-integration { background: rgba(217,70,239,0.18); color: #f0abfc; border: 1px solid rgba(217,70,239,0.35); }
    .task-run { opacity: .55; font-size: .85em; margin-left: .5rem; font-family: monospace; }
    .task-elapsed { font-family: monospace; opacity: .7; }
    .candidate-grid { display: flex; flex-direction: column; gap: .75rem; }
    .candidate-card { border: 1px solid var(--border, #2d3240); border-radius: 5px; padding: .75rem; }
    .candidate-card.state-running { border-left: 3px solid #4dabf7; }
    .candidate-card.state-completed { border-left: 3px solid #51cf66; }
    .candidate-card.state-evaluated { border-left: 3px solid #ab9ae6; }
    .candidate-card.state-scored { border-left: 3px solid #ffd43b; }
    .candidate-card.state-winner { border-left: 3px solid gold; background: rgba(255, 215, 0, .08); }
    .candidate-head { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin-bottom: .25rem; font-weight: 500; }
    .candidate-state { font-size: .75em; opacity: .7; text-transform: uppercase; letter-spacing: .05em; }
    .candidate-timing { font-family: monospace; font-size: .85em; opacity: .8; }
    .candidate-analyzer { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .3rem; font-size: .8em; }
    .analyzer-badge { display: inline-flex; align-items: center; gap: .2rem; padding: .15rem .4rem; border-radius: 3px; background: rgba(255,255,255,.05); }
    .analyzer-badge.analyzer-tools { color: #a8b5c8; }
    .analyzer-badge.analyzer-pass { color: #51cf66; background: rgba(81,207,102,.1); }
    .analyzer-badge.analyzer-fail { color: #ff6b6b; background: rgba(255,107,107,.1); }
    .analyzer-badge.analyzer-nudge { color: #fcc419; background: rgba(252,196,25,.1); }
    .analyzer-badge.analyzer-verdict { color: #ff922b; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .candidate-scores { display: flex; gap: .5rem; font-size: .85em; margin-top: .35rem; }
    .candidate-scores div { flex: 1; background: rgba(255,255,255,.04); padding: .2rem .4rem; border-radius: 3px; }
    .candidate-scores span { font-weight: 600; margin-left: .15rem; }
    .candidate-scores .visuals-score span { color: #fab005; }
    .candidate-fail { color: #ff6b6b; font-size: .85em; margin-top: .35rem; }
    .candidate-gate-fail { color: #ff8787; font-size: .82em; margin-top: .35rem; background: rgba(255,107,107,.08); padding: .3rem .5rem; border-radius: 4px; border-left: 2px solid #ff6b6b; }
    .gate-fail-detail { display: block; font-size: .9em; opacity: .75; margin-top: .15rem; word-break: break-word; }
    .task-no-winner { background: rgba(255,107,107,.1); border-left: 3px solid #ff6b6b; padding: .5rem .75rem; margin-top: .5rem; border-radius: 4px; font-size: .85em; color: #ff8787; }
    .task-evaluating { background: rgba(77,171,247,.08); border-left: 3px solid #4dabf7; padding: .5rem .75rem; margin-top: .5rem; border-radius: 4px; font-size: .85em; color: #4dabf7; }
    .recent-table { width: 100%; border-collapse: collapse; }
    .recent-table th, .recent-table td { padding: .5rem; border-bottom: 1px solid var(--border, #2d3240); text-align: left; }
    .recent-table th { opacity: .7; font-weight: 500; font-size: .85em; text-transform: uppercase; letter-spacing: .05em; }
    .winner-badge { background: gold; color: #111; padding: .1rem .4rem; border-radius: 3px; font-weight: 600; font-size: .85em; }
    .empty-state { opacity: .6; padding: 1rem 0; font-style: italic; }
    .muted { opacity: .55; }
    .alert-banner { background: rgba(77, 171, 247, .08); border-left: 3px solid #4dabf7; padding: .75rem 1rem; border-radius: 4px; margin: 1rem 0; }

    /* Expandable recent rows */
    .recent-row { cursor: pointer; transition: background .15s; }
    .recent-row:hover { background: rgba(255,255,255,.03); }
    .recent-row.expanded { background: rgba(255,255,255,.02); }
    .expand-toggle { width: 1.5rem; text-align: center; opacity: .5; font-size: .85em; }
    .detail-row td { padding: 0 !important; border-bottom: 1px solid var(--border, #2d3240); }

    /* Candidate detail grid — vertical rows like active candidates */
    .candidate-detail-grid { display: flex; flex-direction: column; gap: .75rem; padding: .75rem 1rem 1rem; }
    .candidate-detail-card { background: var(--card-bg, #1a1e26); border: 1px solid var(--border, #2d3240); border-radius: 6px; padding: .85rem; transition: border-color .15s; }
    .candidate-detail-card.is-winner { border: 1px solid gold; background: rgba(255, 215, 0, .04); }
    .candidate-detail-card.is-failed { opacity: .7; }

    .cd-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
    .cd-name { font-weight: 600; font-size: .95em; }
    .cd-trophy { margin-right: .25rem; }
    .cd-state { font-size: .7em; text-transform: uppercase; letter-spacing: .05em; padding: .15rem .4rem; border-radius: 3px; }
    .cd-state-running { background: rgba(77, 171, 247, .15); color: #4dabf7; }
    .cd-state-completed { background: rgba(81, 207, 102, .15); color: #51cf66; }
    .cd-state-evaluated { background: rgba(171, 154, 230, .15); color: #ab9ae6; }
    .cd-state-scored { background: rgba(255, 212, 59, .15); color: #ffd43b; }
    .cd-state-winner { background: rgba(255, 215, 0, .2); color: gold; }

    /* Progress pipeline */
    .cd-pipeline { display: flex; align-items: center; gap: .25rem; font-size: .75em; margin-bottom: .65rem; flex-wrap: wrap; }
    .cd-pip { padding: .15rem .35rem; border-radius: 3px; background: rgba(255,255,255,.05); opacity: .45; }
    .cd-pip.pip-done { opacity: 1; background: rgba(81, 207, 102, .12); color: #51cf66; }
    .cd-pip.pip-fail { opacity: 1; background: rgba(255, 107, 107, .12); color: #ff6b6b; }
    .cd-pip.pip-skip { opacity: .75; background: rgba(255, 212, 59, .1); color: #ffd43b; font-style: italic; }
    .cd-pip.pip-winner { opacity: 1; background: rgba(255, 215, 0, .15); color: gold; }
    .cd-pip-arrow { opacity: .3; }

    /* Score bars */
    .cd-scores { margin-bottom: .5rem; }
    .cd-scores-compact { margin-top: .35rem; }
    .cd-scores-compact .cd-score-row { margin-bottom: .15rem; }
    .cd-scores-compact .cd-score-label { width: 3.5rem; font-size: .7em; }
    .cd-scores-compact .cd-score-bar-bg { height: 5px; }
    .cd-scores-compact .cd-score-val { font-size: .7em; width: 2.2rem; min-width: 2.2rem; }
    .cd-scores-clickable { cursor: pointer; padding: .35rem; border-radius: 6px; transition: background .15s; }
    .cd-scores-clickable:hover { background: rgba(255,255,255,.04); }
    .cd-score-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .3rem; }
    .cd-score-row-clickable { cursor: pointer; padding: 2px 4px; border-radius: 4px; transition: background .15s; }
    .cd-score-row-clickable:hover { background: rgba(255,255,255,.06); }
    .cd-score-row-active { background: rgba(79,172,254,.12); border-left: 2px solid rgba(79,172,254,.6); padding-left: 2px; }
    .cd-score-label { width: 5.5rem; font-size: .75em; opacity: .65; text-align: right; }
    .cd-score-bar-bg { flex: 1; height: 6px; background: rgba(255,255,255,.06); border-radius: 3px; overflow: hidden; }
    .cd-score-bar { height: 100%; border-radius: 3px; transition: width .3s; }
    .cd-score-val { font-size: .75em; font-family: monospace; width: 2.5rem; min-width: 2.5rem; flex-shrink: 0; opacity: .85; color: rgba(255,255,255,.85); text-align: right; }
    .cd-score-total { text-align: right; font-size: .8em; margin-top: .25rem; opacity: .8; }
    .cd-no-scores { font-size: .8em; opacity: .4; font-style: italic; margin-bottom: .5rem; }
    .cd-judge-skipped { opacity: .6; color: #ffd43b; font-style: normal; }
    .cd-score-feedback-expand { margin-top: .35rem; padding: .5rem .65rem; background: rgba(255,255,255,.03); border-radius: 6px; border-left: 3px solid rgba(79,172,254,.4); animation: fadeIn .2s; }
    .cd-score-feedback-expand .judge-feedback-text { font-size: .8em; line-height: 1.5; white-space: pre-wrap; opacity: .85; }
    .cd-score-feedback-expand .judge-feedback-perfect { opacity: .5; font-style: italic; }
    .cd-score-feedback-expand .judge-feedback-dim .dim-feedback-label { font-weight: 600; color: #4facfe; margin-right: .35rem; }
    .cd-score-label-note { font-size: .7em; opacity: .5; margin-bottom: .25rem; font-style: italic; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

    /* Metrics */
    .cd-metrics { display: flex; gap: .75rem; font-size: .8em; opacity: .7; margin-bottom: .35rem; }
    .cd-metric { font-family: monospace; }

    /* Failure */
    .cd-failure { font-size: .8em; color: #ff6b6b; background: rgba(255,107,107,.06); padding: .35rem .5rem; border-radius: 4px; margin-top: .35rem; }
    .cd-failure-label { font-weight: 600; }

    /* Screenshot */
    .cd-screenshot { margin-top: .5rem; }
    .cd-screenshot-label { font-size: .7em; text-transform: uppercase; letter-spacing: .05em; opacity: .5; margin-bottom: .3rem; }
    .cd-screenshot-img { width: 100%; border-radius: 4px; border: 1px solid var(--border, #2d3240); cursor: pointer; transition: transform .15s; }
    .cd-screenshot-img:hover { transform: scale(1.02); box-shadow: 0 4px 12px rgba(0,0,0,.4); }

    /* Tabs */
    .cd-tabs { display: flex; gap: .25rem; border-bottom: 1px solid var(--border, #2d3240); margin-bottom: .65rem; }
    .cd-tab { background: none; border: none; color: inherit; padding: .35rem .6rem; font-size: .75em; cursor: pointer; opacity: .5; border-bottom: 2px solid transparent; transition: opacity .15s, border-color .15s; font-family: inherit; }
    .cd-tab:hover { opacity: .8; }
    .cd-tab.active { opacity: 1; border-bottom-color: #4dabf7; }
    .cd-tab-badge { background: rgba(77, 171, 247, .2); color: #4dabf7; padding: .05rem .3rem; border-radius: 8px; font-size: .85em; margin-left: .25rem; }
    .cd-tab-content { min-height: 3rem; }

    /* Judge Reasoning */
    .cd-reasoning { margin-bottom: .5rem; }
    .cd-reasoning-label { font-size: .7em; text-transform: uppercase; letter-spacing: .05em; opacity: .5; margin-bottom: .25rem; }
    .cd-reasoning-text { font-size: .8em; line-height: 1.45; background: rgba(255,255,255,.03); padding: .5rem; border-radius: 4px; border-left: 2px solid rgba(77,171,247,.3); white-space: pre-wrap; }

    /* File tree */
    .cd-file-tree { font-family: 'Cascadia Code', 'Fira Code', monospace; font-size: .78em; }
    .cd-file-row { display: flex; align-items: center; gap: .5rem; padding: .2rem 0; border-bottom: 1px solid rgba(255,255,255,.03); }
    .cd-file-type { width: 1.2rem; text-align: center; font-size: .85em; }
    .cd-file-type-added { color: #51cf66; }
    .cd-file-type-modified { color: #ffd43b; }
    .cd-file-type-deleted { color: #ff6b6b; }
    .cd-file-type-renamed { color: #4dabf7; }
    .cd-file-path { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cd-file-stats { text-align: right; white-space: nowrap; }
    .cd-file-add { color: #51cf66; }
    .cd-file-del { color: #ff6b6b; }
    .cd-file-summary { margin-top: .5rem; padding-top: .4rem; border-top: 1px solid var(--border, #2d3240); font-size: .85em; opacity: .7; }

    /* Metrics detail */
    .cd-metrics-detail { display: grid; gap: .35rem; }
    .cd-metric-row { display: flex; justify-content: space-between; align-items: center; padding: .25rem 0; border-bottom: 1px solid rgba(255,255,255,.03); font-size: .85em; }
    .cd-metric-label { opacity: .6; }
    .cd-metric-value { font-family: monospace; font-weight: 500; }
    .cd-metric-divider { height: 1px; background: var(--border, #2d3240); margin: .35rem 0; }

    /* Log viewer */
    .cd-log-viewer { font-family: 'Cascadia Code', 'Fira Code', monospace; font-size: .72em; max-height: 300px; overflow-y: auto; background: rgba(0,0,0,.2); border-radius: 4px; padding: .5rem; }
    .cd-log-line { padding: .1rem 0; line-height: 1.4; white-space: pre-wrap; word-break: break-all; border-bottom: 1px solid rgba(255,255,255,.02); }

    /* Live activity indicator on running candidates */
    .candidate-activity-live { display: flex; align-items: center; gap: .35rem; font-size: .75em; margin-top: .3rem; padding: .25rem .4rem; background: rgba(64, 192, 87, .08); border-radius: 4px; overflow: hidden; }
    .activity-pulse { color: #40c057; animation: pulse-blink 1.2s infinite; font-size: .6em; }
    .activity-done { color: #51cf66; font-size: .7em; }
    .activity-last { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: .85; }
    .activity-count { opacity: .5; font-size: .9em; }
    @@keyframes pulse-blink { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

    /* Mini activity log preview on active cards */
    .candidate-minilog { margin-top: .3rem; font-size: .7em; border-top: 1px solid rgba(255,255,255,.05); padding-top: .25rem; }
    .minilog-entry { display: flex; gap: .35rem; align-items: baseline; padding: .1rem 0; opacity: .65; }
    .minilog-time { font-family: monospace; opacity: .5; white-space: nowrap; }
    .minilog-cat { font-weight: 600; text-transform: uppercase; font-size: .85em; white-space: nowrap; }
    .minilog-msg { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Awaiting evaluation badge */
    .candidate-awaiting { font-size: .75em; color: #ffd43b; margin-top: .3rem; opacity: .8; }

    /* Media capture progress tracker — 12-pip pipeline strip */
    .media-progress { display: flex; align-items: center; gap: .25rem; font-size: .7em; margin-top: .3rem; padding: .25rem .4rem; background: rgba(77, 171, 247, .06); border-radius: 4px; transition: background .15s; }
    .media-progress:hover { background: rgba(77, 171, 247, .12); }
    .media-progress-expanded { background: rgba(77, 171, 247, .15); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .media-progress-label { opacity: .7; font-weight: 600; text-transform: uppercase; font-size: .85em; }
    .mp-pip { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--border, #2d3240); transition: background .2s; flex-shrink: 0; }
    .mp-pip-pending { background: rgba(255, 255, 255, .12); }
    .mp-pip-running { background: #4dabf7; box-shadow: 0 0 6px rgba(77, 171, 247, .8); animation: mp-pulse 1s infinite; }
    .mp-pip-done { background: #51cf66; }
    .mp-pip-failed { background: #ff6b6b; }
    .mp-pip-skipped { background: rgba(255, 255, 255, .25); }
    @@keyframes mp-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
    .media-progress-current { margin-left: auto; opacity: .75; font-family: monospace; font-size: .9em; }
    .mp-current-done { color: #51cf66; opacity: 1; }
    .mp-current-failed { color: #ff6b6b; opacity: 1; }
    .media-progress-toggle { opacity: .55; font-size: 1em; padding-left: .35rem; user-select: none; }

    /* Expanded media-step details panel */
    .media-progress-details { background: rgba(77, 171, 247, .06); padding: .5rem .6rem .55rem; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; font-size: .72em; margin-top: -1px; }
    .mpd-summary { display: flex; flex-wrap: wrap; gap: .9rem; margin-bottom: .45rem; opacity: .82; font-size: .95em; }
    .mpd-summary .mpd-fail-count { color: #ff8787; }
    .mpd-summary .mpd-skip-count { opacity: .55; }
    .mpd-table { width: 100%; border-collapse: collapse; }
    .mpd-table th { text-align: left; padding: .25rem .4rem; opacity: .55; font-weight: 600; text-transform: uppercase; font-size: .8em; border-bottom: 1px solid rgba(255,255,255,.06); }
    .mpd-table td { padding: .22rem .4rem; border-bottom: 1px solid rgba(255,255,255,.04); vertical-align: top; font-family: monospace; font-size: .92em; }
    .mpd-table .mpd-detail { font-family: inherit; opacity: .75; max-width: 280px; word-break: break-word; }
    .mpd-row-pending td { opacity: .45; }
    .mpd-row-running td { color: #74c0fc; }
    .mpd-row-done td { color: rgba(255,255,255,.85); }
    .mpd-row-failed td { color: #ff8787; }
    .mpd-row-skipped td { opacity: .55; font-style: italic; }

    /* Expandable active candidate cards */
    .candidate-card { cursor: pointer; transition: border-color .15s, background .15s; }
    .candidate-card:hover { background: rgba(255,255,255,.02); }
    .candidate-card.active-expanded { background: rgba(255,255,255,.03); }
    .candidate-detail-expanded { margin-top: .65rem; padding-top: .65rem; border-top: 1px solid var(--border, #2d3240); }

    /* Activity timeline in detail tab */
    .cd-activity-timeline { max-height: 500px; overflow-y: auto; }
    .cd-activity-entry { display: flex; align-items: baseline; gap: .5rem; padding: .3rem .4rem; border-bottom: 1px solid rgba(255,255,255,.03); font-size: .8em; cursor: pointer; border-radius: 3px; transition: background .1s; }
    .cd-activity-entry:hover { background: rgba(255,255,255,.06); }
    .cd-activity-time { font-family: monospace; opacity: .5; white-space: nowrap; font-size: .85em; }
    .cd-activity-cat { padding: .1rem .35rem; border-radius: 3px; font-size: .75em; font-weight: 600; text-transform: uppercase; white-space: nowrap; background: rgba(255,255,255,.06); }
    .cd-activity-cat-init { color: #4dabf7; }
    .cd-activity-cat-spawn { color: #da77f2; }
    .cd-activity-cat-stdout { color: #69db7c; }
    .cd-activity-cat-config { color: #ffd43b; }
    .cd-activity-cat-complete { color: #ff922b; }
    .cd-activity-cat-error { color: #ff6b6b; }
    .cd-activity-cat-warning { color: #ffa94d; }
    .cd-activity-cat-retry { color: #fcc419; }
    .cd-activity-cat-sandbox { color: #20c997; }
    .cd-activity-cat-tool-call { color: #da77f2; }
    .cd-activity-cat-tool-result { color: #b197fc; }
    .cd-activity-cat-prompt { color: #74c0fc; }
    .cd-activity-cat-llm { color: #b197fc; }
    .cd-activity-cat-parse { color: #63e6be; }
    .cd-activity-cat-write { color: #69db7c; }
    .cd-activity-cat-security { color: #ffa94d; }
    .cd-activity-cat-assistant { color: #da77f2; }
    .cd-activity-cat-intent { color: #69db7c; }
    .cd-activity-cat-reasoning { color: #868e96; }
    .cd-activity-cat-thinking { color: #da77f2; }
    .cd-activity-msg { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .activity-group-badge { background: rgba(77,171,247,.2); color: #4dabf7; font-size: .75em; font-weight: 600; padding: .05rem .35rem; border-radius: 8px; white-space: nowrap; flex-shrink: 0; }

    /* Empty tab */
    .cd-empty-tab { opacity: .4; font-style: italic; font-size: .85em; padding: .5rem 0; }

    /* No screenshot placeholder */
    .cd-no-screenshot { font-size: .8em; opacity: .5; font-style: italic; padding: .5rem; background: rgba(255,255,255,.03); border-radius: 4px; border: 1px dashed var(--border, #2d3240); }

    /* Lightbox modal */
    .lightbox-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.85); z-index: 10000; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .lightbox-content { max-width: 90vw; max-height: 90vh; display: flex; flex-direction: column; cursor: default; }
    .lightbox-header { display: flex; justify-content: space-between; align-items: center; padding: .5rem .75rem; background: rgba(30,34,42,.95); border-radius: 6px 6px 0 0; }
    .lightbox-title { font-size: .85em; font-weight: 600; opacity: .8; }
    .lightbox-close { background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; opacity: .7; padding: .2rem .5rem; }
    .lightbox-close:hover { opacity: 1; }
    .lightbox-img { max-width: 90vw; max-height: calc(90vh - 3rem); object-fit: contain; border-radius: 0 0 6px 6px; border: 1px solid var(--border, #2d3240); }
    .lightbox-video { max-width: 90vw; max-height: calc(90vh - 3rem); object-fit: contain; border-radius: 0 0 6px 6px; border: 1px solid var(--border, #2d3240); background: #000; }

    /* Compact 3-tile media row (screenshot · gif · video) on candidate-detail expanded views */
    .cd-media-row { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
    .cd-media-tile { position: relative; width: 220px; height: 130px; border: 1px solid var(--border, #2d3240); border-radius: 4px; overflow: hidden; background: #0d1117; transition: transform .12s, border-color .12s, box-shadow .12s; flex-shrink: 0; }
    .cd-media-tile[role="button"] { cursor: pointer; }
    .cd-media-tile[role="button"]:hover { transform: translateY(-1px) scale(1.02); border-color: rgba(77,171,247,.55); box-shadow: 0 4px 14px rgba(0,0,0,.35); }
    .cd-media-tile-thumb { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cd-media-tile-video-thumb { background: #000; }
    .cd-media-tile-label { position: absolute; left: 4px; bottom: 4px; background: rgba(0,0,0,.75); color: #fff; font-size: .65em; font-weight: 600; padding: 2px 6px; border-radius: 3px; letter-spacing: .02em; backdrop-filter: blur(4px); }
    .cd-media-tile-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 38px; height: 38px; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 1.1em; display: flex; align-items: center; justify-content: center; pointer-events: none; transition: background .12s; }
    .cd-media-tile[role="button"]:hover .cd-media-tile-play { background: rgba(77,171,247,.85); }
    .cd-media-tile-missing { display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: .5; cursor: not-allowed; gap: .35rem; padding: .5rem; }
    .cd-media-tile-missing .cd-media-tile-icon { font-size: 1.6em; opacity: .7; }
    .cd-media-tile-missing .cd-media-tile-label { position: static; background: none; padding: 0; font-size: .7em; opacity: .8; }
    /* No-visual-content placeholder — replaces the blank-white 1×1 PNG fallback when
       the preview producer chain returned NoVisualContent (e.g., backend-only PR). */
    .cd-media-tile-no-visual { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .4rem; padding: 1rem .75rem; min-height: 120px; background: rgba(255,255,255,.02); border: 1px dashed var(--border, #2d3240); border-radius: 6px; cursor: default; }
    .cd-media-tile-no-visual .cd-media-tile-icon { font-size: 2em; opacity: .45; }
    .cd-media-tile-no-visual .cd-media-tile-label { position: static; background: none; padding: 0; font-size: .8em; opacity: .65; font-weight: 500; font-style: italic; }
    .candidate-screenshot-thumb.no-visual-collapsed { display: flex; align-items: center; justify-content: center; gap: .35rem; background: rgba(255,255,255,.02); border: 1px dashed var(--border, #2d3240); color: var(--text-muted, #8a93a3); padding: .5rem .65rem; font-size: .75em; font-style: italic; cursor: default; }
    .candidate-screenshot-thumb.no-visual-collapsed .no-visual-collapsed-icon { font-size: 1.1em; opacity: .6; }
    .cd-no-screenshot { padding: .6rem; opacity: .55; font-size: .8em; font-style: italic; border: 1px dashed var(--border, #2d3240); border-radius: 4px; margin-top: .4rem; }

    /* Activity detail popup modal */
    .activity-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.8); z-index: 10000; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .activity-modal { background: var(--card-bg, #1a1e26); border: 1px solid var(--border, #2d3240); border-radius: 8px; max-width: 700px; width: 90vw; max-height: 80vh; overflow-y: auto; cursor: default; box-shadow: 0 8px 32px rgba(0,0,0,.5); }
    .activity-modal-header { display: flex; justify-content: space-between; align-items: center; padding: .75rem 1rem; border-bottom: 1px solid var(--border, #2d3240); }
    .activity-modal-cat { font-size: .75em; font-weight: 600; text-transform: uppercase; padding: .15rem .4rem; border-radius: 3px; background: rgba(255,255,255,.06); }
    .activity-modal-time { font-family: monospace; font-size: .8em; opacity: .6; }
    .activity-modal-close { background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; opacity: .7; padding: .2rem .5rem; }
    .activity-modal-close:hover { opacity: 1; }
    .activity-modal-body { padding: 1rem; font-size: .9em; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }

    /* Cancel button and progress */
    .task-actions { display: flex; align-items: center; gap: .75rem; }
    .cancel-btn { background: rgba(255,107,107,.12); border: 1px solid rgba(255,107,107,.3); color: #ff6b6b; padding: .25rem .6rem; border-radius: 4px; font-size: .78em; cursor: pointer; font-weight: 500; transition: all .15s; }
    .cancel-btn:hover { background: rgba(255,107,107,.25); border-color: #ff6b6b; }
    .cancel-all-btn { background: rgba(255,107,107,.08); border: 1px solid rgba(255,107,107,.2); color: #ff6b6b; padding: .2rem .5rem; border-radius: 4px; font-size: .72em; cursor: pointer; font-weight: 400; transition: all .15s; opacity: .7; }
    .cancel-all-btn:hover { background: rgba(255,107,107,.2); border-color: #ff6b6b; opacity: 1; }
    .candidate-cancel-btn { background: rgba(255,107,107,.1); border: 1px solid rgba(255,107,107,.25); color: #ff6b6b; padding: .1rem .35rem; border-radius: 3px; font-size: .75em; cursor: pointer; font-weight: 500; transition: all .15s; margin-left: auto; line-height: 1; }
    .candidate-cancel-btn:hover:not(:disabled) { background: rgba(255,107,107,.3); border-color: #ff6b6b; }
    .candidate-cancel-btn:disabled { opacity: .3; cursor: not-allowed; }
    .candidate-reset-btn { background: rgba(77,171,247,.1); border: 1px solid rgba(77,171,247,.25); color: #4dabf7; padding: .1rem .35rem; border-radius: 3px; font-size: .75em; cursor: pointer; font-weight: 500; transition: all .15s; line-height: 1; }
    .candidate-reset-btn:hover { background: rgba(77,171,247,.3); border-color: #4dabf7; }
    .candidate-reset-btn.reset-confirm { background: rgba(255,193,7,.15); border-color: rgba(255,193,7,.5); color: #ffc107; animation: pulse-warn .8s ease-in-out infinite alternate; font-size: .7em; padding: .15rem .4rem; }
    @@keyframes pulse-warn { from { opacity: .8; } to { opacity: 1; } }
    .candidate-card.state-cancelled { opacity: .5; border-color: rgba(255,107,107,.3); }
    .candidate-card.state-cancelled .candidate-state { color: #ff6b6b; }
    .task-phase { font-size: .75em; padding: .15rem .45rem; background: rgba(77,171,247,.12); color: #4dabf7; border-radius: 3px; margin-left: .5rem; font-weight: 500; }
    .task-progress-detail { font-size: .82em; opacity: .7; margin-bottom: .5rem; padding: .25rem .5rem; background: rgba(255,255,255,.03); border-radius: 3px; }
    .task-pr-link {
        display: inline-block;
        font-size: .78em;
        padding: .15rem .5rem;
        margin-left: .5rem;
        background: rgba(81, 207, 102, .15);
        color: #51cf66;
        border: 1px solid rgba(81, 207, 102, .35);
        border-radius: 3px;
        font-weight: 600;
        text-decoration: none;
        transition: background .15s, border-color .15s;
    }
    .task-pr-link:hover {
        background: rgba(81, 207, 102, .28);
        border-color: rgba(81, 207, 102, .6);
        text-decoration: none;
    }

    /* Initial scores (during revision) */
    .initial-scores { opacity: 0.75; }
    .scores-label-revision { font-size: 0.75em; color: var(--color-warning, #f0ad4e); margin-left: 8px; }
    .cd-score-label-note { font-size: .78em; opacity: .65; margin-bottom: 4px; font-style: italic; }

    /* Judge feedback */
    .candidate-judge-feedback { margin-top: 6px; padding: 6px 8px; background: rgba(255, 255, 255, 0.03); border-left: 2px solid var(--color-warning, #f0ad4e); border-radius: 4px; font-size: 0.82em; }
    .judge-feedback-label { font-weight: 600; margin-bottom: 3px; }
    .judge-feedback-text { white-space: pre-wrap; max-height: 120px; overflow-y: auto; color: rgba(255, 255, 255, 0.8); }

    /* Screenshot thumbnail (collapsed card) */
    .candidate-screenshot-thumb { margin-top: 6px; }
    .cd-screenshot-thumb-img { max-height: 80px; aspect-ratio: 16/9; object-fit: cover; border-radius: 4px; opacity: 0.9; cursor: pointer; transition: opacity 0.2s; }
    .cd-screenshot-thumb-img:hover { opacity: 1; }

    /* Multi-screenshot and video indicators */
    .cd-screenshot-count { font-weight: 400; opacity: 0.7; margin-left: .3rem; }
    .cd-screenshot-hint { font-weight: 400; opacity: 0.5; margin-left: .3rem; }
    .cd-video-indicator { margin-top: .4rem; }
    .cd-video-badge { font-size: .75em; padding: 2px 8px; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.3); border-radius: 4px; color: #93c5fd; }
    .cd-video-player { width: 100%; max-height: 500px; border-radius: 4px; border: 1px solid var(--border, #2d3240); background: #000; }
    .cd-gif-preview { cursor: default; }
    .cd-media-section { margin-top: .5rem; }

    /* Media badges (collapsed card) */
    .cd-media-badges { display: flex; gap: .4rem; margin-top: .4rem; flex-wrap: wrap; }
    .cd-media-badge { font-size: .72em; padding: 2px 6px; border-radius: 3px; font-weight: 500; cursor: pointer; transition: filter .12s, transform .12s; user-select: none; }
    .cd-media-badge[role="button"]:hover { filter: brightness(1.25); }
    .cd-media-badge[role="button"]:active { transform: scale(.96); }
    .cd-media-badge-disabled { cursor: not-allowed !important; opacity: .45; filter: grayscale(.6); pointer-events: none; }
    .cd-media-badge-gif { background: rgba(168,85,247,.12); border: 1px solid rgba(168,85,247,.3); color: #c4b5fd; }
    .cd-media-badge-video { background: rgba(59,130,246,.12); border: 1px solid rgba(59,130,246,.3); color: #93c5fd; }

    /* Producer-source badges (PreviewSource) — match the cd-media-badge visual language. */
    .candidate-badge-art { background: rgba(244,114,182,.12); border: 1px solid rgba(244,114,182,.35); color: #f9a8d4; }
    .candidate-badge-diagrams { background: rgba(45,212,191,.12); border: 1px solid rgba(45,212,191,.35); color: #5eead4; }
    /* Screenshot-only fallback badge — shown when capture ran but produced no GIF/Video/Metrics */
    .candidate-badge-screenshot { background: rgba(16,185,129,.10); border: 1px solid rgba(16,185,129,.30); color: #6ee7b7; }

    /* Dual-capture source badges — 🟣 MCP purple, 🔵 Direct blue */
    .cd-capture-badge-mcp { background: rgba(168,85,247,.12); border: 1px solid rgba(168,85,247,.4); color: #c4b5fd; }
    .cd-capture-badge-direct { background: rgba(59,130,246,.12); border: 1px solid rgba(59,130,246,.4); color: #93c5fd; }

    /* Capture metrics section in the Metrics tab */
    .cd-metric-section-header { font-weight: 600; font-size: .85em; margin-top: .75rem; margin-bottom: .35rem; padding-bottom: .2rem; border-bottom: 1px solid var(--border, #2d3240); color: var(--text, #e2e8f0); }
    .cd-metric-subsection { display: flex; justify-content: space-between; gap: .5rem; padding: .15rem 0; font-size: .82em; }
    .cd-tested-urls { margin: .25rem 0 .5rem .5rem; font-size: .8em; }
    .cd-tested-urls summary { cursor: pointer; color: var(--text-muted, #a8adba); }
    .cd-tested-urls summary:hover { color: var(--text, #e2e8f0); }
    .cd-tested-urls ul { list-style: none; padding: .25rem 0 0 .75rem; margin: 0; }
    .cd-tested-urls li { padding: .1rem 0; font-family: var(--font-mono, ui-monospace, monospace); color: var(--text-muted, #a8adba); word-break: break-all; }

    /* Always-visible tested URLs (replacing collapsed details element) */
    .cd-tested-urls-visible { margin: .25rem 0 .5rem .5rem; font-size: .8em; }
    .cd-tested-urls-header { color: var(--text-muted, #a8adba); font-weight: 600; margin-bottom: .2rem; }
    .cd-tested-urls-visible ul { list-style: none; padding: .15rem 0 0 .75rem; margin: 0; }
    .cd-tested-urls-visible li { padding: .1rem 0; font-family: var(--font-mono, ui-monospace, monospace); color: #93c5fd; word-break: break-all; }
    .cd-tested-urls-warn { margin: .25rem 0 .5rem .5rem; font-size: .8em; color: #fbbf24; }

    /* App URL badge in collapsed card */
    .cd-capture-badge-url { background: rgba(59,130,246,.12); border: 1px solid rgba(59,130,246,.4); color: #93c5fd; }
    .cd-capture-badge-warn { background: rgba(251,191,36,.12); border: 1px solid rgba(251,191,36,.4); color: #fbbf24; }

    /* Coverage indicators */
    .cd-coverage-good { color: #4ade80; }
    .cd-coverage-partial { color: #fbbf24; }
    .cd-coverage-low { color: #f87171; }

    /* URL value in metrics */
    .cd-url-value { font-family: var(--font-mono, ui-monospace, monospace); color: #93c5fd; }

    /* Asset Gallery — collapsible per-asset list under the main preview tile. */
    .asset-gallery { margin-top: .55rem; padding: .35rem .5rem; background: rgba(255,255,255,.025); border: 1px solid var(--border, #2d3240); border-radius: 4px; }
    .asset-gallery-toggle { display: inline-flex; align-items: center; gap: .35rem; background: transparent; border: 0; color: inherit; padding: 2px 4px; font-size: .8em; font-weight: 600; cursor: pointer; opacity: .85; }
    .asset-gallery-toggle:hover { opacity: 1; }
    .asset-gallery-caret { font-size: .8em; opacity: .7; width: .8em; text-align: center; }
    .asset-gallery-label { letter-spacing: .02em; }
    .asset-gallery-count { font-weight: 400; opacity: .6; font-size: .9em; }
    .asset-gallery-list { list-style: none; margin: .4rem 0 .1rem; padding: 0; display: flex; flex-direction: column; gap: .3rem; max-height: 220px; overflow-y: auto; }
    .asset-gallery-item { display: flex; align-items: center; gap: .55rem; padding: .25rem .35rem; background: rgba(255,255,255,.02); border-radius: 3px; }
    .asset-gallery-thumb { width: 32px; height: 32px; object-fit: cover; border-radius: 3px; border: 1px solid var(--border, #2d3240); flex: 0 0 auto; }
    .asset-gallery-name { font-family: var(--font-mono, ui-monospace, monospace); font-size: .78em; color: var(--text-muted, #a8adba); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Secondary preview strip — mixed-content PRs (Playwright primary + ImageAssets secondary).
       Compact horizontal "Assets used" strip rendered below the primary preview. Click any
       thumbnail to view the full asset contact-sheet in the lightbox. */
    .cd-asset-strip { margin-top: .55rem; padding: .4rem .55rem; background: rgba(255,255,255,.025); border: 1px solid var(--border, #2d3240); border-radius: 4px; }
    .cd-asset-strip-header { display: flex; align-items: center; gap: .35rem; font-size: .8em; font-weight: 600; opacity: .85; margin-bottom: .35rem; }
    .cd-asset-strip-icon { font-size: 1em; }
    .cd-asset-strip-label { letter-spacing: .02em; }
    .cd-asset-strip-count { font-weight: 400; opacity: .6; font-size: .9em; }
    .cd-asset-strip-thumbs { display: flex; gap: .4rem; overflow-x: auto; padding: .15rem 0 .25rem; scrollbar-width: thin; }
    .cd-asset-strip-thumb { display: flex; flex-direction: column; align-items: center; gap: .2rem; flex: 0 0 auto; max-width: 90px; cursor: pointer; padding: .15rem; border-radius: 3px; transition: background .12s, transform .12s; }
    .cd-asset-strip-thumb:hover { background: rgba(77,171,247,.10); transform: translateY(-1px); }
    .cd-asset-strip-img { width: 64px; height: 64px; object-fit: cover; border-radius: 3px; border: 1px solid var(--border, #2d3240); display: block; }
    .cd-asset-strip-name { font-family: var(--font-mono, ui-monospace, monospace); font-size: .68em; color: var(--text-muted, #a8adba); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 84px; text-align: center; }

    /* No-visual-content placeholder — replaces the screenshot block when the producer
       chain returned NoVisualContent. */
    .no-visual-content-placeholder { display: flex; align-items: center; gap: .65rem; padding: .9rem 1rem; margin-top: .4rem; border: 1px dashed var(--border, #2d3240); border-radius: 6px; background: rgba(255,255,255,.02); color: var(--text-muted, #a8adba); font-size: .85em; font-style: italic; }
    .no-visual-content-icon { font-size: 1.4em; opacity: .55; flex: 0 0 auto; line-height: 1; }
    .no-visual-content-text { line-height: 1.35; }

    /* 2026-05-12 (eval-horizontal-artifact-viewer + frameworks-artifact-clickable-preview) */
    .artifact-strip { display: flex; gap: 4px; align-items: center; padding: 6px 8px; margin-top: 6px;
        background: rgba(96, 144, 255, .06); border: 1px solid rgba(96, 144, 255, .15); border-radius: 6px;
        overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; outline: none; }
    .artifact-strip:focus-within { border-color: rgba(96, 144, 255, .45); }
    .artifact-strip-label { color: var(--text-muted, #a8adba); font-size: .75em; flex: 0 0 auto;
        padding: 0 6px 0 2px; user-select: none; }
    .artifact-strip-thumb { flex: 0 0 auto; width: 72px; height: 72px; border-radius: 4px;
        border: 1px solid var(--border, #2d3240); overflow: hidden; cursor: pointer;
        scroll-snap-align: start; transition: transform .15s, border-color .15s; background: #0a0d14; }
    .artifact-strip-thumb:hover { transform: scale(1.05); border-color: var(--accent, #58a6ff); z-index: 2; }
    .artifact-strip-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .artifact-strip-thumb--broken { display: flex; align-items: center; justify-content: center;
        border-style: dashed; opacity: 0.5; }
    .artifact-strip-thumb--broken::after { content: '🖼️'; font-size: 1.4em; }

    /* Inline-clickable artifact in mini-log: shows a hover-thumbnail tooltip */
    .minilog-msg-artifact { color: var(--accent, #58a6ff); cursor: pointer; position: relative;
        text-decoration: underline; text-decoration-style: dotted; }
    .minilog-msg-artifact:hover { text-decoration-style: solid; }
    .minilog-thumb-tooltip { position: absolute; left: 0; top: 1.4em; width: 200px; height: 200px;
        object-fit: contain; background: #0a0d14; border: 1px solid var(--accent, #58a6ff);
        border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.6); padding: 4px;
        display: none; z-index: 100; pointer-events: none; }
    .minilog-msg-artifact:hover .minilog-thumb-tooltip { display: block; }

    /* Click-to-popup full preview overlay (matches PullRequestDetail pr-image-preview-overlay) */
    .artifact-preview-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, .85);
        display: flex; align-items: center; justify-content: center; z-index: 10000; cursor: pointer; }
    .artifact-preview-modal { max-width: 95vw; max-height: 95vh; display: flex; flex-direction: column;
        background: #0a0d14; border: 1px solid var(--accent, #58a6ff); border-radius: 8px;
        padding: 12px; box-shadow: 0 16px 48px rgba(0,0,0,.85); cursor: default; position: relative; }
    .artifact-preview-modal img { max-width: 90vw; max-height: 85vh; object-fit: contain; display: block; }
    .artifact-preview-close { position: absolute; top: 6px; right: 8px; background: rgba(0, 0, 0, .7);
        color: white; border: none; padding: 4px 12px; border-radius: 4px; cursor: pointer;
        font-size: 1.2em; line-height: 1; }
    .artifact-preview-close:hover { background: rgba(255, 80, 80, .8); }
</style>

