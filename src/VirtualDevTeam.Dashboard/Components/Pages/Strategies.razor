            <button class="artifact-preview-close" @onclick="CloseArtifactPreview" title="Close (Esc)">×</button>
            <img src="@_artifactPreviewUrl" alt="Artifact preview" />
        </div>
    </div>
}

@code {
    private IReadOnlyList<TaskSnapshot> _activeTasks = [];
    private IReadOnlyList<TaskSnapshot> _recentTasks = [];
    private EnabledStrategiesInfo? _enabled;
    private HubConnection? _hub;
    private PeriodicTimer? _pollTimer;
    private bool _refreshing;
    private bool _refreshPending;
    private readonly HashSet<string> _expandedTasks = new();
    private readonly HashSet<string> _expandedActiveCandidates = new();
    // Tracks candidates the user explicitly collapsed so the auto-expand-on-media
    // logic in RefreshAsync doesn't re-open them on every poll/SignalR tick.
    private readonly HashSet<string> _userCollapsedCandidates = new();
    private readonly HashSet<string> _expandedScoreFeedback = new();
    private readonly HashSet<string> _expandedMediaStrips = new();
    private readonly HashSet<string> _expandedGalleries = new();
    private readonly Dictionary<string, string> _activeTabs = new();
    private string? _lightboxImage;
    private string? _lightboxTitle;
    private string? _lightboxGifUrl;
    private string? _lightboxVideoUrl;
    private ActivityEntry? _selectedActivity;

    // Recent-table sorting state. Default: execution order (Wave) ascending so Scaffold
    // tops the table and Final Integration tails it, with all other tasks chronologically.
    private string _sortColumn = "wave";
    private bool _sortAscending = true;

    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortHeaderClass(string column) =>
        _sortColumn == column ? (_sortAscending ? "sort-asc" : "sort-desc") : "";

    private string SortIndicator(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    /// <summary>
    /// Wave label for display. Prefers the real wave value plumbed from the engineering plan
    /// (TaskSnapshot.Wave, populated when present in CandidateStartedEvent). Falls back to a
    /// TaskId/PR-title heuristic for legacy snapshots and tasks without wave metadata.
    /// </summary>
    private static string ComputeWaveLabel(TaskSnapshot task)
    {
        // Real-wave path: if the engineering plan plumbed it through, prefer that.
        if (!string.IsNullOrWhiteSpace(task.Wave))
        {
            var w = task.Wave!.Trim();
            if (w.Equals("W-FINAL", StringComparison.OrdinalIgnoreCase)) return "Final Integration";
            if (w.Equals("W0", StringComparison.OrdinalIgnoreCase)) return "Scaffold";
            // Any other "W<n>" — render as "Wave N" for human-friendly display
            if (w.Length >= 2 && (w[0] == 'W' || w[0] == 'w') && int.TryParse(w[1..], out var n))
                return $"Wave {n}";
            return w; // already a friendly label
        }

        // Heuristic fallback for legacy snapshots without Wave metadata.
        var taskId = task.TaskId ?? "";
        var prTitle = task.PrTitle ?? "";
        if (taskId.Equals("T-FINAL", StringComparison.OrdinalIgnoreCase)
            || prTitle.Contains("Final Integration", StringComparison.OrdinalIgnoreCase)
            || prTitle.Contains("T-FINAL", StringComparison.OrdinalIgnoreCase))
        {
            return "Final Integration";
        }
        if (taskId.Equals("T1", StringComparison.OrdinalIgnoreCase)
            || prTitle.Contains("Scaffold", StringComparison.OrdinalIgnoreCase)
            || prTitle.Contains("Foundation", StringComparison.OrdinalIgnoreCase)
            || prTitle.Contains("Project Setup", StringComparison.OrdinalIgnoreCase))
        {
            return "Scaffold";
        }
        return "Wave 1";
    }

    private static int WaveSortOrder(TaskSnapshot task)
    {
        var label = ComputeWaveLabel(task);
        if (label == "Scaffold") return 0;
        if (label == "Final Integration") return 99;
        // Wave N → sort by N
        if (label.StartsWith("Wave ", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(label[5..].Trim(), out var n))
        {
            return n;
        }
        return 1;
    }

    private static double? ComputeTotalRuntimeSec(TaskSnapshot task)
    {
        if (task.CompletedAt is { } end)
        {
            return (end - task.StartedAt).TotalSeconds;
        }
        return null;
    }

    private IEnumerable<TaskSnapshot> SortRecentTasks(IReadOnlyList<TaskSnapshot> tasks)
    {
        IEnumerable<TaskSnapshot> sorted = _sortColumn switch
        {
            "title" => _sortAscending
                ? tasks.OrderBy(t => !string.IsNullOrWhiteSpace(t.PrTitle) ? t.PrTitle : !string.IsNullOrWhiteSpace(t.TaskTitle) ? t.TaskTitle : t.TaskId, StringComparer.OrdinalIgnoreCase)
                : tasks.OrderByDescending(t => !string.IsNullOrWhiteSpace(t.PrTitle) ? t.PrTitle : !string.IsNullOrWhiteSpace(t.TaskTitle) ? t.TaskTitle : t.TaskId, StringComparer.OrdinalIgnoreCase),
            "runtime" => _sortAscending
                ? tasks.OrderBy(t => ComputeTotalRuntimeSec(t) ?? double.MaxValue)
                : tasks.OrderByDescending(t => ComputeTotalRuntimeSec(t) ?? double.MinValue),
            "eval" => _sortAscending
                ? tasks.OrderBy(t => t.EvaluationElapsedSec ?? double.MaxValue)
                : tasks.OrderByDescending(t => t.EvaluationElapsedSec ?? double.MinValue),
            "completed" => _sortAscending
                ? tasks.OrderBy(t => t.CompletedAt ?? DateTimeOffset.MaxValue)
                : tasks.OrderByDescending(t => t.CompletedAt ?? DateTimeOffset.MinValue),
            _ => _sortAscending
                // Default "wave": Scaffold first, Final Integration last, everything else by StartedAt asc
                ? tasks.OrderBy(WaveSortOrder).ThenBy(t => t.StartedAt)
                : tasks.OrderByDescending(WaveSortOrder).ThenByDescending(t => t.StartedAt),
        };
        return sorted;
    }

    private void OpenLightbox(string? base64, string? title)
    {
        if (string.IsNullOrEmpty(base64)) return;
        _lightboxImage = base64;
        _lightboxGifUrl = null;
        _lightboxVideoUrl = null;
        _lightboxTitle = title ?? "Screenshot";
    }

    private void OpenLightboxGif(string? gifUrl, string? title)
    {
        if (string.IsNullOrEmpty(gifUrl)) return;
        _lightboxImage = null;
        _lightboxGifUrl = gifUrl;
        _lightboxVideoUrl = null;
        _lightboxTitle = title ?? "Animated GIF";
    }

    private void OpenLightboxVideo(string? videoUrl, string? title)
    {
        if (string.IsNullOrEmpty(videoUrl)) return;
        _lightboxImage = null;
        _lightboxGifUrl = null;
        _lightboxVideoUrl = videoUrl;
        _lightboxTitle = title ?? "Interaction Video";
    }

    private void CloseLightbox()
    {
        _lightboxImage = null;
        _lightboxGifUrl = null;
        _lightboxVideoUrl = null;
        _lightboxTitle = null;
    }

    /// <summary>
    /// Builds a candidate-artifact preview URL from an ActivityEntry whose Metadata includes
    /// "abspath" (absolute file path on disk). The endpoint at /api/dashboard/candidate-artifact
    /// validates the path is inside an allowed workspace root before serving.
    /// Returns null if the entry has no abspath metadata.
    /// </summary>
    private static string? TryBuildArtifactUrl(ActivityEntry entry)
    {
        if (entry.Metadata is null) return null;
        if (!entry.Metadata.TryGetValue("abspath", out var absObj) || absObj is null) return null;
        var abs = absObj.ToString();
        if (string.IsNullOrEmpty(abs)) return null;
        var bytes = System.Text.Encoding.UTF8.GetBytes(abs);
        var token = Convert.ToBase64String(bytes).Replace('+', '-').Replace('/', '_').TrimEnd('=');
        return $"/api/dashboard/candidate-artifact?token={token}";
    }

    private static string? TryGetArtifactRelPath(ActivityEntry entry)
    {
        if (entry.Metadata is null) return null;
        if (!entry.Metadata.TryGetValue("relpath", out var relObj) || relObj is null) return null;
        return relObj.ToString();
    }

    private static bool IsImageArtifact(ActivityEntry entry)
    {
        if (entry.Category != "artifact") return false;
        if (entry.Metadata is not null
            && entry.Metadata.TryGetValue("kind", out var k)
            && k?.ToString() == "image")
            return true;
        var msg = entry.Message ?? "";
        return msg.Contains(".png", StringComparison.OrdinalIgnoreCase)
            || msg.Contains(".jpg", StringComparison.OrdinalIgnoreCase)
            || msg.Contains(".jpeg", StringComparison.OrdinalIgnoreCase)
            || msg.Contains(".gif", StringComparison.OrdinalIgnoreCase)
            || msg.Contains(".webp", StringComparison.OrdinalIgnoreCase);
    }

    private string? _artifactPreviewUrl;
    private void OpenArtifactPreview(string url) { _artifactPreviewUrl = url; }
    private void CloseArtifactPreview() { _artifactPreviewUrl = null; }
    private void HandleArtifactStripKey(KeyboardEventArgs e) { /* Future: JS-side scrollBy on ArrowLeft/Right */ }

    /// <summary>
    /// Converts a local file path to a /api/preview/artifacts URL by computing its artifact ID.
    /// Falls back to empty string if the path is null.
    /// </summary>
    private static string GetArtifactUrl(string? filePath)
    {
        if (string.IsNullOrEmpty(filePath)) return "";
        // Canonicalize path before hashing to match TestArtifactIndexService
        var canonicalPath = Path.GetFullPath(filePath);
        var hash = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(canonicalPath));
        var id = Convert.ToHexString(hash)[..16].ToLowerInvariant();
        return $"/api/preview/artifacts/{id}";
    }

    private void ToggleExpand(string taskId)
    {
        if (!_expandedTasks.Remove(taskId))
            _expandedTasks.Add(taskId);
    }

    private void ToggleActiveExpand(string key)
    {
        if (_expandedActiveCandidates.Remove(key))
        {
            // User explicitly collapsed — remember so auto-expand-on-media won't re-open.
            _userCollapsedCandidates.Add(key);
        }
        else
        {
            _expandedActiveCandidates.Add(key);
            _userCollapsedCandidates.Remove(key);
        }
    }

    /// <summary>Expand candidate card directly to Overview tab (used by media badges).</summary>
    private void ExpandToOverview(string key)
    {
        _expandedActiveCandidates.Add(key);
        _userCollapsedCandidates.Remove(key);
        // key format: "{taskId}_{strategyId}" — derive the tab key
        var tabKey = $"active_{key}";
        _activeTabs[tabKey] = "overview";
    }

    /// <summary>
    /// Auto-expand active candidate cards that have media (screenshot/GIF/video) available
    /// so the inline &lt;img&gt; and &lt;video&gt; elements render without requiring a click on the
    /// GIF/Video badges. Respects explicit user-collapses recorded in _userCollapsedCandidates.
    /// </summary>
    private void AutoExpandCandidatesWithMedia()
    {
        foreach (var task in _activeTasks)
        {
            foreach (var candidate in task.Candidates.Values)
            {
                var key = $"{task.TaskId}_{candidate.StrategyId}";
                if (_userCollapsedCandidates.Contains(key)) continue;
                if (_expandedActiveCandidates.Contains(key)) continue;

                var hasGif = !string.IsNullOrEmpty(candidate.AnimatedGifPath);
                var hasVideo = !string.IsNullOrEmpty(candidate.VideoPath);
                var hasShot = !string.IsNullOrEmpty(candidate.ScreenshotBase64)
                              || !string.IsNullOrEmpty(candidate.InitialScreenshotBase64);

                if (hasGif || hasVideo || hasShot)
                {
                    _expandedActiveCandidates.Add(key);
                    var tabKey = $"active_{key}";
                    if (!_activeTabs.ContainsKey(tabKey))
                        _activeTabs[tabKey] = "overview";
                }
            }
        }
    }

    private void ToggleMediaStrip(string key)
    {
        if (!_expandedMediaStrips.Remove(key))
            _expandedMediaStrips.Add(key);
    }

    private void ToggleGallery(string key)
    {
        if (!_expandedGalleries.Remove(key))
            _expandedGalleries.Add(key);
    }

