@code {
    private ExecutionHealthAssessment _assessment = new()
    {
        OverallStatus = "Loading",
        Phase = "—",
        Uptime = TimeSpan.Zero,
        TotalAgents = 0,
        WorkingAgents = 0,
        CompliantAgents = 0,
        NonCompliantAgents = 0,
        ErrorAgents = 0,
        HasDeadlock = false,
        Observations = [],
        NextPhaseGates = [],
        PhaseTimeline = []
    };

    private IReadOnlyList<AgentSnapshot> _agents = [];
    private string _filterAgent = "";
    private string _filterCompliance = "";

    private HttpClient? _http;
    private List<DiagnosticHistoryEntry>? _standaloneDiagnostics;
    private System.Threading.Timer? _pollTimer;

    // FlowMonitor state — populated via API endpoint /api/dashboard/health/flow-monitor
    // (works in both bundled and standalone dashboard modes since the runner exposes it).
    private bool _flowEnabled;
    private int _flowPollSeconds = 30;
    private int _flowMaxActionsPerHour = 12;
    private DateTimeOffset? _flowLastTick;
    private List<FlowFinding> _flowFindings = new();
    private List<FlowAction> _flowActions = new();
    // T1.5: FixRecommendation state — newest-first list, indexed by finding for quick lookup
    // when expanding a Critical finding card. Populated alongside findings/actions via the
    // same poll cycle to keep things in sync.
    private List<FixRecommendation> _flowRecommendations = new();
    private System.Threading.Timer? _flowPollTimer;
    // Filter + drill-down state — client-side only, no API calls per toggle
    private string _flowFilterSeverity = "all";
    private string _flowFilterDetector = "";
    private string? _expandedFindingId;
    // Per-detector / per-action enable overrides — applied via /api/dashboard/health/flow-monitor/toggle endpoint
    private Dictionary<string, bool> _flowDetectorOverrides = new();
    private Dictionary<string, bool> _flowActionOverrides = new();
    // Hardcoded list of known IDs so the UI shows toggles even before any findings have arrived.
    // Add new detectors / actions here when they're registered in DI.
    private static readonly string[] _knownDetectorIds = new[]
    {
        "agent-stuck", "phase-completion-mismatch", "deadlock", "pr-merge-conflict", "unmerged-approved-pr",
        "idle-agent-phase-stuck", "te-false-completion", "label-transition-timeout", "rework-saturation",
        "handoff-gap", "phase-advancement-watchdog", "status-reason-stagnant", "orphan-pr", "idle-idle-cycle",
        "empty-queue", "ai-anomaly"
    };
    private static readonly string[] _knownActionIds = new[] { "kick-agent-poll", "post-explicit-ask", "escalate-to-human", "merge-approved-pr" };

    // T1.7: Warm restart state. Two-click confirm pattern; auto-reverts after 4s if not confirmed.
    private bool _restartPending;
    private bool _restartInProgress;
    private System.Threading.Timer? _restartConfirmTimer;

    private string FlowPulseClass
    {
        get
        {
            if (_flowLastTick is null) return "flow-pulse-dead";
            var age = DateTimeOffset.UtcNow - _flowLastTick.Value;
            if (age < TimeSpan.FromMinutes(2)) return "flow-pulse-fresh";
            if (age < TimeSpan.FromMinutes(5)) return "flow-pulse-stale";
            return "flow-pulse-dead";
        }
    }

    private string FlowPulseText
    {
        get
        {
            if (_flowLastTick is null) return "● no ticks yet";
            var age = DateTimeOffset.UtcNow - _flowLastTick.Value;
            if (age.TotalSeconds < 60) return $"● {age.TotalSeconds:0}s ago";
            if (age.TotalMinutes < 60) return $"● {age.TotalMinutes:0}m ago";
            return $"● {age.TotalHours:0.0}h ago";
        }
    }

    /// <summary>
    /// Resolve a raw agent ID (like "softwareengineer-736c807fad8e48a198844686724d035d") to a
    /// human-readable display name (like "SoftwareEngineer 1") by looking it up against the
    /// live agent snapshot list. Falls back to the trimmed ID if no match is found.
    /// </summary>
    private string ResolveAgentName(string? target)
    {
        if (string.IsNullOrEmpty(target)) return "(no target)";
        if (_agents is not null && _agents.Count > 0)
        {
            var match = _agents.FirstOrDefault(a => string.Equals(a.Id, target, StringComparison.OrdinalIgnoreCase));
            if (match is not null) return match.DisplayName;
        }
        return AgentSnapshotService.FormatAgentId(target);
    }

    /// <summary>
    /// Strips the agent name prefix from detail text to avoid redundancy with the badge.
    /// Handles both raw IDs ("softwareengineer-83e4d82f: details") and display names ("Program Manager: details").
    /// </summary>
    private static string StripAgentPrefix(string detail, string? agentName)
    {
        if (string.IsNullOrEmpty(detail) || string.IsNullOrEmpty(agentName)) return detail;

        // Try stripping "agentName: " or "agentName " prefix
        if (detail.StartsWith(agentName + ": ", StringComparison.OrdinalIgnoreCase))
            return detail[(agentName.Length + 2)..];
        if (detail.StartsWith(agentName + " ", StringComparison.OrdinalIgnoreCase))
            return detail[(agentName.Length + 1)..];

        return detail;
    }

    /// <summary>
    /// Walks a piece of text (like a finding's Summary or Rationale) looking for embedded
    /// agent IDs and replaces them with their display names where found. Keeps the raw ID
    /// available as a tooltip for traceability. Operates on plaintext rendering — Blazor
    /// auto-escapes via the @ binding so this is XSS-safe.
    /// </summary>
    private string RenderAgentMentions(string? text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        if (_agents is null || _agents.Count == 0) return text;
        var output = text;
        foreach (var a in _agents)
        {
            if (string.IsNullOrEmpty(a.Id) || string.IsNullOrEmpty(a.DisplayName)) continue;
            // Only replace if the ID actually appears AND DisplayName isn't already present
            if (output.Contains(a.Id, StringComparison.OrdinalIgnoreCase) &&
                !output.Contains($"{a.DisplayName} (")) // avoid double-decoration
            {
                output = output.Replace(a.Id, a.DisplayName, StringComparison.OrdinalIgnoreCase);
            }
        }
        return output;
    }

    private List<FlowFinding> FilteredFindings()
    {
        IEnumerable<FlowFinding> q = _flowFindings;
        if (!string.IsNullOrEmpty(_flowFilterDetector))
            q = q.Where(f => string.Equals(f.DetectorId, _flowFilterDetector, StringComparison.OrdinalIgnoreCase));
        if (_flowFilterSeverity != "all")
        {
            q = q.Where(f => string.Equals(f.Severity.ToString(), _flowFilterSeverity,
                StringComparison.OrdinalIgnoreCase));
        }
        return q.ToList();
    }

    private void ToggleExpandFinding(string id)
    {
        // Click same finding again → collapse. Click different → switch expansion target.
        _expandedFindingId = (_expandedFindingId == id) ? null : id;
    }

    private async void ToggleDetector(string detectorId)
    {
        var current = !_flowDetectorOverrides.TryGetValue(detectorId, out var v) || v;
        _flowDetectorOverrides[detectorId] = !current;
        await PostFlowMonitorToggleAsync("detector", detectorId, !current);
    }

    private async void ToggleAction(string actionId)
    {
        var current = !_flowActionOverrides.TryGetValue(actionId, out var v) || v;
        _flowActionOverrides[actionId] = !current;
        await PostFlowMonitorToggleAsync("action", actionId, !current);
    }

    private async Task PostFlowMonitorToggleAsync(string kind, string id, bool enabled)
    {
        if (_http is null) return;
        try
        {
            var body = new { kind, id, enabled };
            var response = await _http.PostAsJsonAsync("/api/dashboard/health/flow-monitor/toggle", body);
            if (!response.IsSuccessStatusCode)
            {
                // Revert local state if the server rejected — keeps the UI honest about real config state
                if (kind == "detector") _flowDetectorOverrides[id] = !enabled;
                else _flowActionOverrides[id] = !enabled;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Network failure — revert
            if (kind == "detector") _flowDetectorOverrides[id] = !enabled;
            else _flowActionOverrides[id] = !enabled;
        }
    }

    protected override void OnInitialized()
    {
        if (Mode.IsStandalone)
        {
            var factory = Services.GetService<IHttpClientFactory>();
            _http = factory?.CreateClient("RunnerApi");
            _pollTimer = new System.Threading.Timer(async _ => await PollDiagnosticsAsync(), null, 0, 5000);
        }
        else
        {
            // Bundled mode: still need an HTTP client for the FlowMonitor API endpoint
            // (we could DI FlowMonitorPersistence directly, but going through the API keeps
            // both modes on the same code path and lets us reuse the polling timer).
            var factory = Services.GetService<IHttpClientFactory>();
            _http = factory?.CreateClient("RunnerApi") ?? new HttpClient { BaseAddress = new Uri("http://localhost:5050") };
        }
        // FlowMonitor data refreshes every 5s — frequent enough to watch live activity
        // without thrashing the SQLite DB or burning CPU on JSON serialization.
        _flowPollTimer = new System.Threading.Timer(async _ => await PollFlowMonitorAsync(), null, 1000, 5000);
        RefreshData();
        DataService.OnChange += OnDataChanged;
    }

    private async Task PollFlowMonitorAsync()
    {
        if (_http is null) return;
        try
        {
            var result = await _http.GetFromJsonAsync<FlowMonitorApiResponse>("/api/dashboard/health/flow-monitor");
            if (result is null) return;
            _flowEnabled = result.Enabled;
            _flowPollSeconds = result.PollIntervalSeconds;
            _flowMaxActionsPerHour = result.MaxActionsPerHour;
            // Bug fix: result.LastTickUtc comes off the wire as a DateTime with Kind=Unspecified
            // (System.Text.Json default behaviour). When used with DateTimeOffset constructor or
            // .ToLocalTime() it was being interpreted as LOCAL time, not UTC, producing a 7-hour
            // offset that rendered as "-25173s ago" in the pulse badge.
            // Force-mark Kind=Utc so subsequent comparisons against UtcNow produce real elapsed time.
            _flowLastTick = result.LastTickUtc.HasValue
                ? new DateTimeOffset(DateTime.SpecifyKind(result.LastTickUtc.Value, DateTimeKind.Utc), TimeSpan.Zero)
                : null;
            _flowFindings = result.Findings ?? new();
            _flowActions = result.Actions ?? new();

            // T1.5: Pull fix recommendations alongside the findings / actions snapshot so the
            // expanded-finding panel can deep-link to the Approvals page for any plan that's
            // already been generated. Failure here is silent — the rest of the dashboard
            // keeps working without recommendations.
            try
            {
                var recs = await _http.GetFromJsonAsync<List<FixRecommendation>>(
                    "/api/dashboard/health/flow-monitor/recommendations");
                _flowRecommendations = recs ?? new();
            }
            catch { /* endpoint not yet wired or transient — keep last snapshot */ }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Runner isn't reachable or endpoint not yet available — silent fail.
        }
    }

    /// <summary>
    /// T1.5: All FixRecommendations attached to a particular finding, newest first.
    /// Used by the expanded-finding panel to surface the latest recommendation + its
    /// rework history in a compact pill.
    /// </summary>
    private List<FixRecommendation> GetRecommendationsForFinding(string findingId)
    {
        if (_flowRecommendations.Count == 0 || string.IsNullOrEmpty(findingId)) return new();
        return _flowRecommendations
            .Where(r => string.Equals(r.FindingId, findingId, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.CreatedAt)
            .ToList();
    }

    /// <summary>DTO matching the /api/dashboard/health/flow-monitor JSON shape.</summary>
    private sealed class FlowMonitorApiResponse
    {
        public bool Enabled { get; set; }
        public int PollIntervalSeconds { get; set; }
        public int MaxActionsPerHour { get; set; }
        public DateTime? LastTickUtc { get; set; }
        public List<FlowFinding>? Findings { get; set; }
        public List<FlowAction>? Actions { get; set; }
    }

    private async Task PollDiagnosticsAsync()
    {
        if (_http is null) return;
        try
        {
            _assessment = await _http.GetFromJsonAsync<ExecutionHealthAssessment>("/api/dashboard/health/assessment") ?? _assessment;
            _standaloneDiagnostics = await _http.GetFromJsonAsync<List<DiagnosticHistoryEntry>>("/api/dashboard/health/diagnostics?limit=100");
            var agents = await _http.GetFromJsonAsync<List<AgentSnapshot>>("/api/dashboard/agents");
            if (agents is not null) _agents = agents;
            await InvokeAsync(StateHasChanged);
        }
        catch { /* runner not reachable */ }
    }

    private void RefreshData()
    {
        _assessment = DataService.GetExecutionHealthAssessment();
        _agents = DataService.GetAllAgentSnapshots();
    }

    private async void OnDataChanged()
    {
        RefreshData();
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<DiagnosticHistoryEntry> GetFilteredFeed()
    {
        bool? compliantFilter = _filterCompliance switch
        {
            "compliant" => true,
            "non-compliant" => false,
            _ => null
        };

        var agentFilter = string.IsNullOrEmpty(_filterAgent) ? null : _filterAgent;

        if (_standaloneDiagnostics is not null)
        {
            IEnumerable<DiagnosticHistoryEntry> query = _standaloneDiagnostics;
            if (agentFilter is not null) query = query.Where(d => d.AgentId == agentFilter);
            if (compliantFilter is not null) query = query.Where(d => d.IsCompliant == compliantFilter);
            return query.OrderByDescending(d => d.Timestamp).Take(100).ToList();
        }

        return DataService.GetDiagnosticHistory(agentFilter, compliantFilter, 100);
    }

    private string OverallStatusClass => _assessment.OverallStatus switch
    {
        "Healthy" => "badge-healthy",
        "Caution" => "badge-caution",
        "Warning" => "badge-warning",
        "Critical" => "badge-critical",
        _ => ""
    };

    private static string FormatObservation(string obs) =>
        obs.Replace("**", "<strong>").Replace("**", "</strong>");

    private static string FormatDuration(TimeSpan ts) => ts.TotalHours >= 1
        ? $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s"
        : ts.TotalMinutes >= 1
            ? $"{ts.Minutes}m {ts.Seconds}s"
            : $"{ts.Seconds}s";

    // T1.7 — Warm restart click handlers. Two-click confirm to avoid accidental restarts.
    private void OnRestartClicked()
    {
        _restartPending = true;
        // Auto-cancel after 4s so the button doesn't sit in confirm state forever
        _restartConfirmTimer?.Dispose();
        _restartConfirmTimer = new System.Threading.Timer(_ =>
        {
            _restartPending = false;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    private void OnRestartCancelled()
    {
        _restartPending = false;
        _restartConfirmTimer?.Dispose();
        _restartConfirmTimer = null;
    }

    private async Task OnRestartConfirmed()
    {
        _restartPending = false;
        _restartInProgress = true;
        _restartConfirmTimer?.Dispose();
        _restartConfirmTimer = null;

        if (_http is null)
        {
            _restartInProgress = false;
            return;
        }
        try
        {
            // Fire-and-forget — the runner will stop ~2s after responding, so we don't await long.
            // The auto-reload-on-disconnect logic in App.razor (commit 35b0829) will reload the
            // page when the new runner is up and SignalR reconnects.
            await _http.PostAsync("/api/dashboard/runtime/restart", content: null);
        }
        catch
        {
            // Ignore — common to throw "connection forcibly closed" mid-flight as the runner shuts down.
        }
    }

    public void Dispose()
    {
        DataService.OnChange -= OnDataChanged;
        _pollTimer?.Dispose();
        _flowPollTimer?.Dispose();
        _restartConfirmTimer?.Dispose();
    }
}
