@page "/health"
@rendermode InteractiveServer
@using VirtualDevTeam.Core.Agents
@using VirtualDevTeam.Core.Diagnostics
@using VirtualDevTeam.Core.HealthMonitor
@using VirtualDevTeam.Dashboard.Services
@using VirtualDevTeam.Orchestrator
@using System.Net.Http.Json
@implements IDisposable
@inject IDashboardDataService DataService
@inject DashboardMode Mode
@inject IServiceProvider Services

<PageTitle>Virtual Dev Team — Health Monitor</PageTitle>

<div class="dashboard-header" data-testid="page-health">
    <h1>Health Monitor</h1>
    <span class="header-badge @OverallStatusClass">● @_assessment.OverallStatus</span>
</div>

@* ── Top Row: Phase Timeline (left) + Status & Assessment (right) ── *@
<div class="health-top-row">
    <div class="health-card phase-card">
        <h2>Phase Progression</h2>
        <div class="phase-timeline">
            @foreach (var phase in _assessment.PhaseTimeline)
            {
                <div class="phase-step @(phase.IsCurrent ? "current" : phase.IsCompleted ? "completed" : "pending")">
                    <div class="phase-dot"></div>
                    <div class="phase-info">
                        <span class="phase-name">@phase.Phase</span>
                        @if (phase.CompletedAt.HasValue)
                        {
                            <LocalTimeText Value="phase.CompletedAt.Value" CssClass="phase-time" IncludeSeconds="true" />
                        }
                        else if (phase.IsCurrent)
                        {
                            <span class="phase-time active">Active</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_assessment.NextPhaseGates.Count > 0)
        {
            <div class="gates-section">
                <h3>Next Phase Gates</h3>
                @foreach (var gate in _assessment.NextPhaseGates)
                {
                    <div class="gate-row @(gate.IsMet ? "met" : "unmet")">
                        <span class="gate-icon">@(gate.IsMet ? "✅" : "⬜")</span>
                        <span class="gate-name">@gate.Name</span>
                        <span class="gate-desc">@gate.Description</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="health-right-column">
        <div class="health-card status-card">
            <h2>Execution Status</h2>
            <div class="status-grid">
                <div class="status-item">
                    <span class="status-label">Phase</span>
                    <span class="status-value phase-value">@_assessment.Phase</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Uptime</span>
                    <span class="status-value">@FormatDuration(_assessment.Uptime)</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Working</span>
                    <span class="status-value cyan">@_assessment.WorkingAgents / @_assessment.TotalAgents</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Compliant</span>
                    <span class="status-value @(_assessment.NonCompliantAgents > 0 ? "yellow" : "green")">
                        @_assessment.CompliantAgents / @_assessment.TotalAgents
                    </span>
                </div>
                <div class="status-item">
                    <span class="status-label">Errors</span>
                    <span class="status-value @(_assessment.ErrorAgents > 0 ? "red" : "green")">
                        @_assessment.ErrorAgents
                    </span>
                </div>
                <div class="status-item">
                    <span class="status-label">Deadlock</span>
                    <span class="status-value @(_assessment.HasDeadlock ? "red" : "green")">
                        @(_assessment.HasDeadlock ? "Yes" : "None")
                    </span>
                </div>
            </div>
        </div>

        <div class="health-card observations-card">
            <h2>System Assessment</h2>
            <div class="observations-list">
                @foreach (var obs in _assessment.Observations)
                {
                    <div class="observation-item">
                        <span class="obs-bullet">›</span>
                        <span class="obs-text">@((MarkupString)FormatObservation(obs))</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ── Execution Flowchart ── *@
<div class="health-card flowchart-card">
    <h2>Execution Timeline</h2>
    <div class="flowchart">
        @{ var milestones = DataService.GetExecutionTimeline(); }
        @if (milestones.Count == 0)
        {
            <div class="flowchart-empty">Pipeline has not started yet.</div>
        }
        else
        {
            @foreach (var (milestone, index) in milestones.Select((m, i) => (m, i)))
            {
                var isLast = index == milestones.Count - 1;
                <div class="flow-node @milestone.Category @(isLast ? "flow-node-active" : "")">
                    <div class="flow-connector">
                        <div class="flow-dot">@milestone.Icon</div>
                        @if (!isLast)
                        {
                            <div class="flow-line"></div>
                        }
                    </div>
                    <div class="flow-content">
                        <div class="flow-title-row">
                            <span class="flow-title">@milestone.Title</span>
                            @if (!string.IsNullOrEmpty(milestone.AgentName))
                            {
                                <span class="flow-agent" title="@milestone.AgentName">@AgentSnapshotService.FormatAgentId(milestone.AgentName)</span>
                            }
                        </div>
                        <div class="flow-detail-row">
                            @if (!string.IsNullOrEmpty(milestone.Detail))
                            {
                                <span class="flow-detail">@StripAgentPrefix(milestone.Detail, milestone.AgentName)</span>
                            }
                            <LocalTimeText Value="milestone.Timestamp" CssClass="flow-time" IncludeSeconds="true" />
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* ── Agent Compliance Grid ── *@
<div class="health-card compliance-card">
    <h2>Agent Compliance</h2>
    <div class="compliance-grid">
        <div class="compliance-header">
            <span class="col-agent">Agent</span>
            <span class="col-role">Role</span>
            <span class="col-status">Status</span>
            <span class="col-compliant">Compliant</span>
            <span class="col-task">Current Activity</span>
            <span class="col-scenario">Scenario</span>
        </div>
        @foreach (var agent in _agents.OrderBy(a => a.Role))
        {
            <div class="compliance-row @(!agent.DiagnosticCompliant ? "non-compliant-row" : "")">
                <span class="col-agent">@agent.DisplayName</span>
                <span class="col-role">@agent.Role</span>
                <span class="col-status">
                    <span class="mini-badge status-@(agent.Status.ToString().ToLowerInvariant())">
                        @agent.Status
                    </span>
                </span>
                <span class="col-compliant">
                    @(agent.DiagnosticCompliant ? "✅" : "⚠️")
                </span>
                <span class="col-task" title="@agent.DiagnosticJustification">
                    @(agent.DiagnosticSummary ?? agent.StatusReason ?? "—")
                </span>
                <span class="col-scenario">@(agent.DiagnosticScenarioRef ?? "—")</span>
            </div>
        }
    </div>
</div>

@* ── Diagnostic Feed ── *@
<div class="health-card feed-card">
    <div class="feed-header">
        <h2>Diagnostic Feed</h2>
        <div class="feed-controls">
            <select class="feed-pill" @bind="_filterAgent">
                <option value="">🤖 All Agents</option>
                @foreach (var agent in _agents.OrderBy(a => a.DisplayName))
                {
                    <option value="@agent.Id">@agent.DisplayName</option>
                }
            </select>
            <select class="feed-pill" @bind="_filterCompliance">
                <option value="">📋 All Status</option>
                <option value="compliant">✅ Compliant</option>
                <option value="non-compliant">⚠️ Non-Compliant</option>
            </select>
            <span class="feed-count">@GetFilteredFeed().Count entries</span>
        </div>
    </div>

    <div class="feed-list">
        @{ var feedItems = GetFilteredFeed(); }
        @if (feedItems.Count == 0)
        {
            <div class="feed-empty">No diagnostic entries yet. Agents will report justifications as they work.</div>
        }
        else
        {
            @foreach (var entry in feedItems)
            {
                <div class="feed-entry @(!entry.IsCompliant ? "feed-entry-warn" : "")">
                    <div class="feed-entry-row">
                        <LocalTimeText Value="entry.Timestamp" CssClass="feed-timestamp" IncludeSeconds="true" />
                        <span class="feed-compliance">@(entry.IsCompliant ? "✅" : "⚠️")</span>
                        <span class="feed-agent-name">@entry.AgentDisplayName</span>
                        @if (!string.IsNullOrEmpty(entry.ScenarioRef))
                        {
                            <span class="feed-scenario-ref">@entry.ScenarioRef</span>
                        }
                        <span class="feed-summary-inline">@entry.Summary</span>
                    </div>
                    @if (!entry.IsCompliant && !string.IsNullOrEmpty(entry.ComplianceIssue))
                    {
                        <div class="feed-compliance-issue">⚠️ @entry.ComplianceIssue</div>
                    }
                    <details class="feed-details">
                        <summary>Justification</summary>
                        <div class="feed-justification">@entry.Justification</div>
                    </details>
                </div>
            }
        }
    </div>
</div>

@* ── Flow Monitor — autonomous flow watchdog ── *@
<div class="health-card flow-monitor-card" data-testid="flow-monitor-card">
    <div class="flow-monitor-header">
        <h2>🔧 Flow Monitor</h2>
        <span class="flow-monitor-pulse @FlowPulseClass" title="Last tick: @(_flowLastTick?.ToLocalTime().ToString("h:mm:ss tt") ?? "never")">
            @FlowPulseText
        </span>
        <span class="flow-monitor-meta">
            @(_flowEnabled ? "ON" : "OFF") · poll @_flowPollSeconds.ToString()s · cap @_flowMaxActionsPerHour/hr
        </span>
        @* T1.7: Warm restart — stops the runner gracefully and re-launches via restart-runner.ps1.
           Workflow state, agent identities, and signals are checkpointed to SQLite, so the new
           runner resumes from where the old one stopped. Two-click confirm to avoid mis-clicks. *@
        @if (!_restartPending && !_restartInProgress)
        {
            <button class="warm-restart-btn" @onclick="OnRestartClicked" title="Stop runner gracefully and re-launch (workflow state preserved)">
                🔄 Restart Runner
            </button>
        }
        else if (_restartPending && !_restartInProgress)
        {
            <button class="warm-restart-btn confirm" @onclick="OnRestartConfirmed" title="Click again to confirm — runner will stop and auto-restart">
                ⚠️ Click to confirm restart
            </button>
            <button class="warm-restart-btn cancel" @onclick="OnRestartCancelled">Cancel</button>
        }
        else
        {
            <span class="warm-restart-pending">⏳ Runner restarting — page will reload when it's back up...</span>
        }
        @* Stats strip: severity counts + success rate + most-frequent detector — gives an at-a-glance health pulse *@
        <span class="flow-monitor-stats">
            @{
                var critCount = _flowFindings.Count(f => f.Severity == VirtualDevTeam.Core.HealthMonitor.FlowFindingSeverity.Critical);
                var warnCount = _flowFindings.Count(f => f.Severity == VirtualDevTeam.Core.HealthMonitor.FlowFindingSeverity.Warning);
                var infoCount = _flowFindings.Count(f => f.Severity == VirtualDevTeam.Core.HealthMonitor.FlowFindingSeverity.Info);
                var actionTotal = _flowActions.Count;
                var actionSuccess = _flowActions.Count(a => a.Result == VirtualDevTeam.Core.HealthMonitor.FlowActionResult.Success);
                var successRate = actionTotal == 0 ? "—" : $"{(actionSuccess * 100.0 / actionTotal):0}%";
                var topDetector = _flowFindings.GroupBy(f => f.DetectorId).OrderByDescending(g => g.Count()).FirstOrDefault();
            }
            <span class="stat-pill stat-crit" title="Critical findings">🚨 @critCount</span>
            <span class="stat-pill stat-warn" title="Warning findings">⚠️ @warnCount</span>
            <span class="stat-pill stat-info" title="Info findings">ℹ️ @infoCount</span>
            <span class="stat-pill stat-success" title="Action success rate">✓ @successRate</span>
            @if (topDetector is not null)
            {
                <span class="stat-pill" title="Most-frequent detector">📊 @topDetector.Key (@topDetector.Count())</span>
            }
        </span>
    </div>
    @* Filter chips — quickly narrow recent findings by severity / detector / state. Operates on the
       client-side state only (no API calls) so toggling is instant. *@
    <div class="flow-monitor-filters">
        <span class="filter-label">Filter:</span>
        <button class="filter-chip @(_flowFilterSeverity == "all" ? "active" : "")" @onclick='() => _flowFilterSeverity = "all"'>All severities</button>
        <button class="filter-chip @(_flowFilterSeverity == "critical" ? "active critical" : "")" @onclick='() => _flowFilterSeverity = "critical"'>🚨 Critical</button>
        <button class="filter-chip @(_flowFilterSeverity == "warning" ? "active warning" : "")" @onclick='() => _flowFilterSeverity = "warning"'>⚠️ Warning</button>
        <button class="filter-chip @(_flowFilterSeverity == "info" ? "active info" : "")" @onclick='() => _flowFilterSeverity = "info"'>ℹ️ Info</button>
        <span class="filter-divider">|</span>
        <button class="filter-chip @(_flowFilterDetector == "" ? "active" : "")" @onclick='() => _flowFilterDetector = ""'>All detectors</button>
        @foreach (var d in _flowFindings.Select(f => f.DetectorId).Distinct().OrderBy(x => x))
        {
            var detectorId = d;
            <button class="filter-chip @(_flowFilterDetector == detectorId ? "active" : "")" @onclick="() => _flowFilterDetector = detectorId">@detectorId</button>
        }
    </div>
    @* Per-detector enable/disable controls — operator can silence a misfiring detector without
       editing config or restarting. Toggles take effect on the next tick (~30s). *@
    <details class="flow-monitor-controls">
        <summary>⚙️ Detector / Action toggles</summary>
        <div class="flow-controls-body">
            <div class="flow-controls-section">
                <h4>Detectors</h4>
                @foreach (var detectorId in _knownDetectorIds)
                {
                    var id = detectorId;
                    var enabled = !_flowDetectorOverrides.TryGetValue(id, out var v) || v;
                    <label class="flow-toggle">
                        <input type="checkbox" checked="@enabled" @onchange="() => ToggleDetector(id)" />
                        <span>@id</span>
                    </label>
                }
            </div>
            <div class="flow-controls-section">
                <h4>Actions</h4>
                @foreach (var actionId in _knownActionIds)
                {
                    var id = actionId;
                    var enabled = !_flowActionOverrides.TryGetValue(id, out var v) || v;
                    <label class="flow-toggle">
                        <input type="checkbox" checked="@enabled" @onchange="() => ToggleAction(id)" />
                        <span>@id</span>
                    </label>
                }
            </div>
        </div>
    </details>
    @if (_flowFindings.Count == 0 && _flowActions.Count == 0)
    {
        <div class="flow-monitor-empty">No flow anomalies detected. The pipeline is moving forward as expected.</div>
    }
    else
    {
        <div class="flow-monitor-body">
            <div class="flow-monitor-col">
                <h3>Recent Findings <span class="col-count">(@FilteredFindings().Count)</span></h3>
                @foreach (var f in FilteredFindings().Take(15))
                {
                    var matchedAction = _flowActions.FirstOrDefault(a => a.FindingId == f.Id);
                    var isExpanded = _expandedFindingId == f.Id;
                    <div class="flow-finding @($"flow-severity-{f.Severity.ToString().ToLowerInvariant()}") @(isExpanded ? "expanded" : "")"
                         id="@($"finding-{f.Id}")"
                         @onclick="() => ToggleExpandFinding(f.Id)" role="button" tabindex="0">
                        <div class="flow-row-head">
                            <span class="flow-detector" title="Detector ID">@f.DetectorId</span>
                            <LocalTimeText OffsetValue="f.DetectedAt" CssClass="flow-time" />
                            <span class="flow-state flow-state-@(f.State.ToString().ToLowerInvariant())">@f.State</span>
                            <span class="flow-expand-hint">@(isExpanded ? "▾" : "▸")</span>
                        </div>
                        <div class="flow-summary">@RenderAgentMentions(f.Summary)</div>
                        @if (matchedAction is not null)
                        {
                            <div class="flow-finding-action @($"flow-result-{matchedAction.Result.ToString().ToLowerInvariant()}")"
                                 title="Action taken in response: @matchedAction.ActionType → @matchedAction.Result">
                                <span class="flow-action-tag">↳ @matchedAction.ActionType</span>
                                <span class="flow-result">@matchedAction.Result</span>
                            </div>
                        }
                        else if (f.State == VirtualDevTeam.Core.HealthMonitor.FlowFindingState.Open)
                        {
                            <div class="flow-finding-action flow-no-action" title="No action handler for this finding — logged for human review">
                                <span class="flow-action-tag">↳ no action — logged for review</span>
                            </div>
                        }
                        @if (isExpanded)
                        {
                            <div class="flow-finding-detail">
                                <div class="flow-detail-section">
                                    <strong>Rationale:</strong>
                                    <div>@RenderAgentMentions(f.Rationale)</div>
                                </div>
                                @if (!string.IsNullOrEmpty(f.TargetAgentId))
                                {
                                    <div class="flow-detail-section">
                                        <strong>Target agent:</strong>
                                        <span>@ResolveAgentName(f.TargetAgentId)</span>
                                        <span class="flow-detail-muted">(@f.TargetAgentId)</span>
                                    </div>
                                }
                                @{
                                    var related = _flowFindings
                                        .Where(x => x.Id != f.Id
                                                    && x.DetectorId == f.DetectorId
                                                    && x.TargetAgentId == f.TargetAgentId)
                                        .Take(5)
                                        .ToList();
                                }
                                @if (related.Count > 0)
                                {
                                    <div class="flow-detail-section">
                                        <strong>Related findings (same detector + target):</strong>
                                        <ul class="flow-related-list">
                                            @foreach (var r in related)
                                            {
                                                <li><LocalTimeText OffsetValue="r.DetectedAt" /> — @r.State</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (matchedAction is not null && !string.IsNullOrEmpty(matchedAction.Detail))
                                {
                                    <div class="flow-detail-section">
                                        <strong>Action detail:</strong>
                                        <div class="flow-detail-muted">@matchedAction.Detail</div>
                                    </div>
                                }
                                @{
                                    // T1.5: When a Critical finding has produced one or more
                                    // FixRecommendations (newest first), surface the latest one
                                    // here as a deep link to the Approvals page.
                                    var recsForFinding = GetRecommendationsForFinding(f.Id);
                                    var latestRec = recsForFinding.FirstOrDefault();
                                }
                                @if (latestRec is not null)
                                {
                                    var confClass = latestRec.Confidence >= 0.75 ? "fixrec-conf-high"
                                        : latestRec.Confidence >= 0.5 ? "fixrec-conf-med"
                                        : "fixrec-conf-low";
                                    // T1.6: tier badge — duplicates the Approvals page treatment so operators
                                    // can see at a glance whether this finding's recommendation will reload
                                    // live, need a restart, or be staged for next boot.
                                    var (tierEmoji, tierLabel, tierClass) = latestRec.FixTier switch
                                    {
                                        FixTier.Live            => ("🟢", "Live",     "fixrec-tier-live"),
                                        FixTier.DeferredRestart => ("🟡", "Deferred", "fixrec-tier-deferred"),
                                        FixTier.Blocked         => ("🔴", "Blocked",  "fixrec-tier-blocked"),
                                        _                       => ("⚪", "Unknown",  "fixrec-tier-unknown"),
                                    };
                                    var tierTooltip = latestRec.FixTier switch
                                    {
                                        FixTier.Live            => "Applies in-place via config/prompt watcher — no restart needed.",
                                        FixTier.DeferredRestart => "Code change written; click Restart Runner to activate.",
                                        FixTier.Blocked         => "Cannot apply while runner is up — staged for next boot.",
                                        _                       => "Tier not classified yet.",
                                    };
                                    <div class="flow-detail-section flow-fixrec-link">
                                        <strong>🔧 Fix Recommendation:</strong>
                                        <span class="fixrec-tier-badge @tierClass" title="@tierTooltip">@tierEmoji @tierLabel</span>
                                        <span class="flow-fixrec-conf @confClass">@($"{latestRec.Confidence:0%}")</span>
                                        <span class="flow-fixrec-state">state: @latestRec.State</span>
                                        @if (recsForFinding.Count > 1)
                                        {
                                            <span class="flow-fixrec-rework-pill">@(recsForFinding.Count) revisions</span>
                                        }
                                        <a class="flow-fixrec-link-btn" href="@($"/flow-monitor/recommendations#rec-{latestRec.Id}")" @onclick:stopPropagation="true">
                                            View Recommendation →
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="flow-monitor-col">
                <h3>Recent Actions <span class="col-count">(@_flowActions.Count)</span></h3>
                @foreach (var a in _flowActions.Take(10))
                {
                    <div class="flow-action @($"flow-result-{a.Result.ToString().ToLowerInvariant()}")">
                        <div class="flow-row-head">
                            <span class="flow-action-type" title="Action type">@a.ActionType</span>
                            <LocalTimeText OffsetValue="a.InitiatedAt" CssClass="flow-time" />
                            <span class="flow-result">@a.Result</span>
                        </div>
                        <div class="flow-summary">→ @ResolveAgentName(a.Target)</div>
                        @if (!string.IsNullOrEmpty(a.Detail))
                        {
                            <div class="flow-detail">@a.Detail</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .flow-monitor-card { margin-top: 1rem; padding: 1rem; }
    .flow-monitor-header { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .flow-monitor-header h2 { margin: 0; font-size: 1.1rem; }
    .flow-monitor-pulse { padding: 2px 8px; border-radius: 4px; font-size: 0.8em; font-weight: 600; }
    .flow-pulse-fresh { background: rgba(34,197,94,0.18); color: #86efac; border: 1px solid rgba(34,197,94,0.35); }
    .flow-pulse-stale { background: rgba(245,158,11,0.18); color: #fcd34d; border: 1px solid rgba(245,158,11,0.35); }
    .flow-pulse-dead { background: rgba(239,68,68,0.18); color: #fca5a5; border: 1px solid rgba(239,68,68,0.35); }
    .flow-monitor-meta { font-size: 0.85em; opacity: 0.7; font-family: monospace; }
    /* T1.7 — Warm restart button. Pushes itself to the right of the header so it's always visible. */
    .warm-restart-btn { margin-left: auto; padding: 4px 10px; border: 1px solid rgba(245,158,11,0.4); background: rgba(245,158,11,0.08); color: #fcd34d; border-radius: 4px; font-size: 0.85em; cursor: pointer; transition: all 0.15s; }
    .warm-restart-btn:hover { background: rgba(245,158,11,0.18); border-color: rgba(245,158,11,0.6); }
    .warm-restart-btn.confirm { background: rgba(239,68,68,0.18); border-color: rgba(239,68,68,0.6); color: #fca5a5; animation: pulse-warn 1s ease-in-out infinite; }
    .warm-restart-btn.cancel { margin-left: 0.25rem; background: transparent; border-color: rgba(148,163,184,0.4); color: #94a3b8; }
    .warm-restart-btn.cancel:hover { background: rgba(148,163,184,0.1); }
    .warm-restart-pending { margin-left: auto; padding: 4px 10px; background: rgba(245,158,11,0.18); color: #fcd34d; border: 1px solid rgba(245,158,11,0.4); border-radius: 4px; font-size: 0.85em; font-style: italic; }
    @@keyframes pulse-warn { 0%, 100% { opacity: 1; } 50% { opacity: 0.65; } }
    .flow-monitor-empty { padding: 0.75rem; opacity: 0.6; font-style: italic; }
    .flow-monitor-body { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.75rem; }
    .flow-monitor-col h3 { font-size: 0.95rem; margin: 0 0 0.5rem; opacity: 0.85; }
    .flow-finding, .flow-action { border-left: 3px solid var(--border, #2d3240); padding: 0.5rem 0.75rem; margin-bottom: 0.5rem; background: rgba(255,255,255,0.02); border-radius: 4px; }
    .flow-severity-critical { border-left-color: #ef4444; }
    .flow-severity-warning { border-left-color: #f59e0b; }
    .flow-severity-info { border-left-color: #38bdf8; }
    .flow-result-success { border-left-color: #22c55e; }
    .flow-result-failed { border-left-color: #ef4444; }
    .flow-result-skipped { border-left-color: #94a3b8; }
