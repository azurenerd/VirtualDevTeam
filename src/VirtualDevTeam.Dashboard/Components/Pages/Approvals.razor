@code {
    /// <summary>
    /// Resolve the gate-card "Review" link.  PR / Issue gates route through internal
    /// <c>/repository/...</c> pages; other gate types fall back to the platform URL.
    /// Returns the href, target, rel, title, and arrow glyph for the rendered anchor.
    /// </summary>
    private (string href, string? target, string? rel, string title, string arrow) ResolveGateReviewLink(GateNotification gate)
    {
        // For document gates (PMSpec, Architecture), link directly to the document file
        // in the internal code browser with the PR's source branch — works for all platforms.
        string? docPath = null;
        string? prBranch = _prBranchCache.GetValueOrDefault(gate.ResourceNumber ?? -1);
        try
        {
            var config = ServiceProvider.GetService<IOptions<VirtualDevTeam.Core.Configuration.VirtualDevTeamConfig>>();
            var docsFolder = config?.Value?.Project?.DocsFolderPath ?? "AgentDocs";
            var workBranch = config?.Value?.Project?.WorkingBranch ?? "main";
            docPath = gate.GateId switch
            {
                "PMSpecification" => $"{docsFolder}/{workBranch}/PMSpec.md",
                "ArchitectureDesign" => $"{docsFolder}/{workBranch}/Architecture.md",
                _ => null
            };
        }
        catch { /* fall through to PR link */ }

        if (docPath is not null)
        {
            if (gate.Artifacts?.Count > 0)
            {
                var docArtifact = gate.Artifacts.FirstOrDefault(a => a.Kind == ArtifactKind.Document);
                if (docArtifact is not null && !string.IsNullOrEmpty(docArtifact.FilePath))
                    docPath = docArtifact.FilePath;
            }
            var fileHref = LinkService.BuildFileUrl(docPath, prBranch);
            return (fileHref, null, null, "Review document", "");
        }

        string href = gate.GitHubUrl ?? "#";
        if (gate.ResourceNumber is int n)
        {
            if (string.Equals(gate.ResourceType, "PR", StringComparison.OrdinalIgnoreCase))
                href = LinkService.BuildPullRequestUrl(n, gate.GitHubUrl);
            else if (string.Equals(gate.ResourceType, "Issue", StringComparison.OrdinalIgnoreCase))
                href = LinkService.BuildIssueUrl(n, gate.GitHubUrl);
        }
        var target = LinkService.TargetForUrl(href);
        var rel = target == "_blank" ? "noopener" : null;
        var isInternal = LinkService.IsInternal(href);
        var title = isInternal ? "Review in dashboard" : $"Review on {LinkService.PlatformDisplayName}";
        var arrow = isInternal ? "" : "↗";
        return (href, target, rel, title, arrow);
    }

    private string? BuildArtifactUrl(GateNotification gate, GateArtifact artifact)
    {
        if (string.IsNullOrEmpty(gate.GitHubUrl) || string.IsNullOrEmpty(artifact.FilePath))
            return null;
        var m = System.Text.RegularExpressions.Regex.Match(gate.GitHubUrl,
            @"github\.com/([^/]+)/([^/]+)");
        if (!m.Success) return null;
        var owner = m.Groups[1].Value;
        var repo = m.Groups[2].Value;
        var ref_ = artifact.CommitSha ?? "main";
        return $"https://github.com/{owner}/{repo}/blob/{ref_}/{artifact.FilePath}";
    }

    private NotificationFilter _filter = NotificationFilter.Open;
    private IReadOnlyList<GateNotification> _notifications = Array.Empty<GateNotification>();
    /// <summary>
    /// Groups identical FlowMonitor info-only notifications so the operator sees one
    /// card with a count badge instead of N duplicate cards. Key = display notification's
    /// <see cref="GateNotification.Id"/>; value = all notification IDs in the group
    /// (including the display one). Other notification IDs are added to
    /// <see cref="_collapsedFlowMonitorIds"/> so the render loop skips them.
    /// </summary>
    private Dictionary<string, List<string>> _flowMonitorGroups = new();
    private HashSet<string> _collapsedFlowMonitorIds = new();
    /// <summary>True when any open FlowMonitor info-only entry exists. Drives the header "Dismiss all" button.</summary>
    private bool _hasOpenFlowMonitorInfo;
    private IReadOnlyList<AgentDecision> _pendingDecisions = Array.Empty<AgentDecision>();
    private IReadOnlyList<PrePRClarificationSet> _pendingClarifications = Array.Empty<PrePRClarificationSet>();
    private Dictionary<string, List<string>> _clarificationAnswers = new();
    private Dictionary<string, string> _feedbackInputs = new();
    private Dictionary<string, string> _gateFeedbackInputs = new();
    private Dictionary<string, (string Feedback, DateTime RequestedAt)> _reworkedGates = new();
    private int _openCount;
    private int _resolvedCount;
    private int _pendingDecisionCount;

    /// <summary>
    /// Deep-link target gate id from <c>?focus=&lt;GateId&gt;</c> URL parameter.
    /// Used to render the <c>highlight-pulse</c> class on the matching card and to
    /// trigger a one-time scrollIntoView after first render. Set in OnInitialized;
    /// cleared after the post-render scroll runs so a second navigation re-triggers it.
    /// </summary>
    private string? _focusedGateId;
    private bool _hasScrolledToFocus;

    private GateNotificationService? _inProcessService;
    private HttpGateNotificationService? _httpService;
    private IDecisionLog? _decisionLog;
    private DecisionGateService? _decisionGateService;
    private IGateCheckService? _gateCheckService;
    private IReviewService? _reviewService;
    private PrePRClarificationStore? _clarificationStore;

    // T1.5: FixRecommendation state — populated from /api/dashboard/health/flow-monitor/recommendations
    // and refreshed every time gate notifications change. Keyed by recommendation id.
    private FlowMonitorPersistence? _flowPersistence; // when running bundled; null in standalone mode
    private HttpClient? _http;                        // for standalone-mode API access
    private Dictionary<string, FixRecommendation> _fixRecsById = new();
    private HashSet<string> _expandedPlans = new();
    private Dictionary<string, string> _fixRecActionInProgress = new();
    private System.Threading.Timer? _fixRecPollTimer;

    // Proposals: MissingWork proposed issues + FlowAction proposed actions.
    // In bundled mode, resolved directly from DI (avoids self-HTTP deadlock).
    // In standalone mode, polled via HTTP client.
    private MissingWorkPersistence? _missingWorkStore;
    private IFlowActionProposalStore? _flowActionProposalStore;
    private List<ProposedIssue>? _missingWorkProposals;
    private List<ProposedFlowAction>? _flowActionProposals;
    private System.Threading.Timer? _proposalPollTimer;
    private bool _disposed;
    private Dictionary<int, string> _prBranchCache = new();

    // Markdown rendering: HtmlSanitizer + Markdig keep operator-supplied feedback safe even
    // though the planner is local. Defense-in-depth — the same pipeline can render PR
    // descriptions later without auditing every callsite.
    private static readonly MarkdownPipeline _fixRecMarkdownPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
    private static readonly Ganss.Xss.HtmlSanitizer _htmlSanitizer = new();

    protected override void OnInitialized()
    {
        _httpService = ServiceProvider.GetService<HttpGateNotificationService>();
        _inProcessService = ServiceProvider.GetService<GateNotificationService>();
        _decisionLog = ServiceProvider.GetService<IDecisionLog>();
        _decisionGateService = ServiceProvider.GetService<DecisionGateService>();
        _gateCheckService = ServiceProvider.GetService<IGateCheckService>();
        _reviewService = ServiceProvider.GetService<IReviewService>();
        _clarificationStore = ServiceProvider.GetService<PrePRClarificationStore>();

        System.Console.Error.WriteLine($"[APPROVALS-DIAG] Services resolved {DateTime.UtcNow:O}");

        // Parse ?focus={GateId} so deep links from the agent overview / detail
        // page can scroll to + highlight the matching card.
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("focus", out var focusVal) && !string.IsNullOrWhiteSpace(focusVal))
        {
            _focusedGateId = focusVal.ToString();
        }

        if (_httpService is not null)
            _httpService.OnChange += OnChange;
        else if (_inProcessService is not null)
            _inProcessService.OnChange += OnChange;

        if (_decisionLog is not null)
            _decisionLog.OnDecisionChanged += OnDecisionChange;

        if (_clarificationStore is not null)
            _clarificationStore.OnChange += OnChange;

        // T1.5: hook FixRecommendation data source.
        // Bundled mode: pull directly from FlowMonitorPersistence singleton.
        // Standalone mode: poll the API endpoint via HttpClient.
        _flowPersistence = ServiceProvider.GetService<FlowMonitorPersistence>();
        if (_flowPersistence is null)
        {
            var factory = ServiceProvider.GetService<IHttpClientFactory>();
            _http = factory?.CreateClient("RunnerApi") ?? new HttpClient { BaseAddress = new Uri("http://localhost:5050") };
        }

        // Proposal poll: resolve in-process stores in bundled mode to avoid self-HTTP deadlock.
        _missingWorkStore = ServiceProvider.GetService<MissingWorkPersistence>();
        _flowActionProposalStore = ServiceProvider.GetService<IFlowActionProposalStore>();

        // IMPORTANT: Timers are created in OnAfterRenderAsync (not here) to avoid
        // pre-rendering deadlocks. During SSR pre-render, no Blazor circuit exists,
        // so timer callbacks that call InvokeAsync(StateHasChanged) hang forever.

        RefreshData();
    }

    /// <summary>
    /// Pre-fetch PR head branches for document gate review links.
    /// Done async here to avoid blocking the Blazor render thread with
    /// sync-over-async (.GetAwaiter().GetResult()) which causes deadlocks.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var prService = ServiceProvider.GetService<IPullRequestService>();
        if (prService is null) return;

        var docGatePrNumbers = _notifications
            .Where(n => !n.IsResolved && n.ResourceNumber.HasValue
                && (n.GateId == "PMSpecification" || n.GateId == "ArchitectureDesign"))
            .Select(n => n.ResourceNumber!.Value)
            .Distinct()
            .ToList();

        foreach (var prNum in docGatePrNumbers)
        {
            try
            {
                var pr = await prService.GetAsync(prNum);
                if (pr?.HeadBranch is not null)
                    _prBranchCache[prNum] = pr.HeadBranch;
            }
            catch { /* best-effort — link will work without branch, just won't show pre-merge content */ }
        }
    }

    /// <summary>
    /// Creates polling timers and handles deep-link scrolling after the first render.
    /// Timers MUST be created here (not OnInitialized) because during SSR pre-rendering
    /// there is no Blazor circuit — timer callbacks calling InvokeAsync would deadlock.
    /// OnAfterRenderAsync is NOT called during pre-rendering, so it's safe.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Start polling timers only after the circuit is connected and the page has rendered.
            _fixRecPollTimer = new System.Threading.Timer(async _ =>
            {
                if (_disposed) return;
                await RefreshFixRecommendationsAsync();
            }, null, 500, 5000);

            _proposalPollTimer = new System.Threading.Timer(async _ =>
            {
                if (_disposed) return;
                await RefreshProposalsAsync();
            }, null, 500, 10_000);
        }

        if (firstRender && !_hasScrolledToFocus && !string.IsNullOrEmpty(_focusedGateId))
        {
            _hasScrolledToFocus = true;
            try
            {
                await JS.InvokeVoidAsync("vdtScrollAndHighlightGate", _focusedGateId);
            }
            catch
            {
                // JS may not be ready on the first render in some hosting modes;
                // the .highlight-pulse class on the card is the visual fallback.
            }
        }
    }

    private void OnChange()
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            if (_disposed) return;
            RefreshData();
            StateHasChanged();
        });
    }

    private void OnDecisionChange(AgentDecision _)
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            if (_disposed) return;
            RefreshData();
            StateHasChanged();
        });
    }

    private void SetFilter(NotificationFilter filter)
    {
        _filter = filter;
        RefreshData();
    }

    private void RefreshData()
    {
        if (_httpService is not null)
        {
            _notifications = _httpService.GetByStatus(_filter);
            _openCount = _httpService.OpenCount;
            _resolvedCount = _httpService.ResolvedCount;
        }
        else if (_inProcessService is not null)
        {
            _notifications = _inProcessService.GetByStatus(_filter);
            _openCount = _inProcessService.OpenCount;
            _resolvedCount = _inProcessService.ResolvedCount;
        }

        RecomputeFlowMonitorGroups();

        // Get pending decisions
        if (_decisionLog is not null)
        {
            _pendingDecisions = _decisionLog.GetPendingDecisions();
            _pendingDecisionCount = _pendingDecisions.Count;

            // Ensure feedback inputs exist for each pending decision
            foreach (var d in _pendingDecisions)
            {
                _feedbackInputs.TryAdd(d.Id, "");
            }
        }

        // Ensure gate feedback inputs exist for each open standard notification
        foreach (var n in _notifications.Where(n => !n.IsResolved))
        {
            _gateFeedbackInputs.TryAdd(n.Id, "");
        }

        // Clear rework state for gates that got resolved (agent re-submitted)
        // The new re-submitted notification will have IsReworked=true
        var resolvedIds = _notifications.Where(n => n.IsResolved).Select(n => n.Id).ToHashSet();
        foreach (var id in _reworkedGates.Keys.ToList())
        {
            if (resolvedIds.Contains(id))
                _reworkedGates.Remove(id);
        }

        // Also clear rework state if a re-submitted notification exists for the same gate
        var reworkedNotifications = _notifications
            .Where(n => n.IsReworked && !n.IsResolved)
            .Select(n => n.GateId)
            .ToHashSet();
        foreach (var id in _reworkedGates.Keys.ToList())
        {
            var gateId = _notifications.FirstOrDefault(n => n.Id == id)?.GateId;
            if (gateId is not null && reworkedNotifications.Contains(gateId))
                _reworkedGates.Remove(id);
        }

        // Get pending clarification question sets
        if (_clarificationStore is not null)
        {
            _pendingClarifications = _clarificationStore.GetPending();
            foreach (var set in _pendingClarifications)
            {
                if (!_clarificationAnswers.ContainsKey(set.Id))
                {
                    _clarificationAnswers[set.Id] = set.Questions
                        .Select(q => q.ProposedAnswer)
                        .ToList();
                }
            }
        }
    }

    private void ApproveClarifications(string setId)
    {
        if (_clarificationStore is null) return;
        var answers = _clarificationAnswers.GetValueOrDefault(setId);
        _clarificationStore.Finalize(setId, answers);

        // Signal the gate so the waiting agent wakes up
        var set = _clarificationStore.Get(setId);
        if (set is not null)
        {
            _gateCheckService?.ApproveGate(GateIds.PrePRClarification, set.IssueNumber);
            _inProcessService?.Resolve(GateIds.PrePRClarification, resourceNumber: set.IssueNumber);
        }

        _clarificationAnswers.Remove(setId);
        RefreshData();
    }

    private void ApproveGate(string gateId, int? resourceNumber = null)
    {
        _gateCheckService?.ApproveGate(gateId, resourceNumber);
        _inProcessService?.Resolve(gateId, resourceNumber: resourceNumber);
        RefreshData();
    }

    private void RejectGate(string gateId, string notificationId, int? resourceNumber)
    {
        var feedback = _gateFeedbackInputs.GetValueOrDefault(notificationId, "");
        _gateCheckService?.RejectGate(gateId, string.IsNullOrWhiteSpace(feedback) ? null : feedback, resourceNumber);
        _reworkedGates[notificationId] = (feedback, DateTime.UtcNow);
        _gateFeedbackInputs.Remove(notificationId);
        RefreshData();
    }

    /// <summary>
    /// RECOMMEND_MANUAL_REVIEW: approves the gate (so the agent unblocks) but posts a
    /// follow-up comment on the platform PR flagging it for human review before merge.
    /// Renders the card as Approved in the UI — the platform comment is the durable record.
    /// </summary>
    private async Task RecommendManualReviewGateAsync(string gateId, string notificationId, int? resourceNumber)
    {
        // Approve the gate so the agent continues — this is non-blocking.
        _gateCheckService?.ApproveGate(gateId, resourceNumber);
        _inProcessService?.Resolve(gateId, resourceNumber: resourceNumber);

        // Best-effort: post a prominent follow-up comment to the PR so the human reviewer
        // knows to look at it before merging.
        if (resourceNumber is > 0 && _reviewService is not null)
        {
            try
            {
                await _reviewService.AddCommentAsync(
                    resourceNumber.Value,
                    "🔍 **Flagged for Follow-up**: This approval has been granted by the operator, " +
                    "but the operator has requested a manual review of scenario confidence before merging. " +
                    "Please have a human reviewer verify the T-FINAL results and scenario verdicts " +
                    "before this PR is merged.",
                    CancellationToken.None);
            }
            catch { /* best-effort — gate was already approved above */ }
        }

        _gateFeedbackInputs.Remove(notificationId);
        RefreshData();
    }

    /// <summary>
    /// Dismiss a single FlowMonitor info card. If the card represents a coalesced group of
    /// identical notifications, every member of the group is dismissed in one click.
    /// </summary>
    private void DismissFlowMonitorCard(string displayNotificationId)
    {
        if (!_flowMonitorGroups.TryGetValue(displayNotificationId, out var groupIds))
            groupIds = new List<string> { displayNotificationId };

        foreach (var id in groupIds)
        {
            if (_httpService is not null) _httpService.Dismiss(id);
            else _inProcessService?.Dismiss(id);
        }
        RefreshData();
    }

    /// <summary>Bulk-dismiss every open FlowMonitor info-only notification.</summary>
    private void DismissAllFlowMonitorInfo()
    {
        if (_httpService is not null) _httpService.DismissAllFlowMonitorInfo();
        else _inProcessService?.DismissAllFlowMonitorInfo();
        RefreshData();
    }

    /// <summary>
    /// Groups identical FlowMonitor info-only notifications by (GateName + first ~200 chars
    /// of Context). The most recent member of each group becomes the "display" card; the
    /// rest are added to <see cref="_collapsedFlowMonitorIds"/> so the render loop skips them.
    /// FlowMonitor "fix" gates are NEVER grouped — each is a distinct decision.
    /// </summary>
    private void RecomputeFlowMonitorGroups()
    {
        _flowMonitorGroups.Clear();
        _collapsedFlowMonitorIds.Clear();
        _hasOpenFlowMonitorInfo = false;

        var byKey = new Dictionary<string, List<GateNotification>>(StringComparer.OrdinalIgnoreCase);
        foreach (var n in _notifications)
        {
            if (n.IsResolved) continue;
            if (!n.GateId.StartsWith("flow-monitor:", StringComparison.OrdinalIgnoreCase)) continue;
            if (n.GateId.StartsWith("flow-monitor:fix:", StringComparison.OrdinalIgnoreCase)) continue;

            _hasOpenFlowMonitorInfo = true;
            var contextKey = (n.Context ?? string.Empty);
            if (contextKey.Length > 200) contextKey = contextKey[..200];
            var key = $"{n.GateName}|{contextKey}";
            if (!byKey.TryGetValue(key, out var list))
                byKey[key] = list = new List<GateNotification>();
            list.Add(n);
        }

        foreach (var (_, list) in byKey)
        {
            // Most recent notification becomes the display card.
            var ordered = list.OrderByDescending(x => x.CreatedAt).ToList();
            var display = ordered[0];
            _flowMonitorGroups[display.Id] = ordered.Select(x => x.Id).ToList();
            for (var i = 1; i < ordered.Count; i++)
                _collapsedFlowMonitorIds.Add(ordered[i].Id);
        }
    }

    private void ApproveDecision(string decisionId)
    {
        var feedback = _feedbackInputs.GetValueOrDefault(decisionId, "");
        _decisionGateService?.ApproveDecision(decisionId, string.IsNullOrWhiteSpace(feedback) ? null : feedback);
        _feedbackInputs.Remove(decisionId);
        RefreshData();
    }

    private async Task RejectDecisionAsync(string decisionId)
    {
        var feedback = _feedbackInputs.GetValueOrDefault(decisionId, "");
        var feedbackText = string.IsNullOrWhiteSpace(feedback) ? null : feedback;
        _decisionGateService?.RejectDecision(decisionId, feedbackText);

        // If the decision has an associated PR, post a rework comment to trigger agent rework
        var decision = _decisionLog?.GetDecision(decisionId);
        if (decision?.AssociatedPrNumber is > 0 && _reviewService is not null && feedbackText is not null)
        {
            try
            {
                await _reviewService.AddCommentAsync(decision.AssociatedPrNumber.Value,
                    $"🔄 **Decision Rejected**: {decision.Title}\n\n" +
                    $"**Original decision:** {decision.Rationale}\n\n" +
                    $"**Human guidance:** {feedbackText}\n\n" +
                    "Please rework this PR using the corrected decision above as a constraint.",
                    CancellationToken.None);
            }
            catch { /* best-effort — agent will detect rejection via status check too */ }
        }

        _feedbackInputs.Remove(decisionId);
        RefreshData();
    }

    /// <summary>
    /// Extract a short one-line summary from verbose FlowMonitor context markdown.
    /// Looks for key lines, falls back to the first non-empty line.
    /// </summary>
    private static string ExtractFlowMonitorSummary(string? context)
    {
        if (string.IsNullOrWhiteSpace(context)) return "FlowMonitor alert";

        // Look for key informational lines in priority order
        string[] prefixes = [
            "**What happened:**", "What happened:",
            "**Finding:**", "Finding:",
            "Automatically handled:",
        ];

        foreach (var line in context.Split('\n'))
        {
            var trimmed = line.Trim();
            foreach (var prefix in prefixes)
            {
                if (trimmed.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    var summary = trimmed[prefix.Length..].Trim();
                    return summary.Length > 120 ? summary[..117] + "..." : summary;
                }
            }
        }

        // Fallback: first non-empty line (strip markdown bold markers for readability)
        var firstLine = context.Split('\n')
            .Select(l => l.Trim().Replace("**", ""))
            .FirstOrDefault(l => l.Length > 5);
        if (firstLine is not null)
            return firstLine.Length > 120 ? firstLine[..117] + "..." : firstLine;

        return "FlowMonitor alert";
    }

