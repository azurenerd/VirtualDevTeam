    /// <summary>
    /// Returns the HttpClient for proposal API calls.  In standalone mode <c>_http</c> is already
    /// set; in bundled mode we create one pointing at the same process (localhost:5050).
    /// </summary>
    private HttpClient GetProposalHttpClient() => _http ?? GetSelfHttpClient();

    /// <summary>
    /// Returns an HttpClient that can call the Runner API from within the same process.
    /// The named "RunnerApi" client has a BaseAddress only in standalone Dashboard.Host; in
    /// bundled mode the factory returns a blank client. We always ensure BaseAddress is set.
    /// </summary>
    private HttpClient GetSelfHttpClient()
    {
        var factory = ServiceProvider.GetService<IHttpClientFactory>();
        var http = factory?.CreateClient("RunnerApi");
        if (http is not null && http.BaseAddress is null)
            http.BaseAddress = new Uri(Navigation.BaseUri);
        return http ?? new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
    }

    public void Dispose()
    {
        _disposed = true;
        _fixRecPollTimer?.Dispose();
        _proposalPollTimer?.Dispose();
        if (_httpService is not null)
            _httpService.OnChange -= OnChange;
        else if (_inProcessService is not null)
            _inProcessService.OnChange -= OnChange;

        if (_decisionLog is not null)
            _decisionLog.OnDecisionChanged -= OnDecisionChange;

        if (_clarificationStore is not null)
            _clarificationStore.OnChange -= OnChange;
    }
