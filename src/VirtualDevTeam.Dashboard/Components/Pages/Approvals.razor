@page "/approvals"
@rendermode InteractiveServer
@using VirtualDevTeam.Core.Notifications
@using VirtualDevTeam.Core.Scenarios
@using VirtualDevTeam.Core.Agents.Decisions
@using VirtualDevTeam.Core.Configuration
@using VirtualDevTeam.Core.DevPlatform.Capabilities
@using VirtualDevTeam.Core.HealthMonitor
@using VirtualDevTeam.Core.HealthMonitor.Actions
@using VirtualDevTeam.Core.MissingWork
@using VirtualDevTeam.Dashboard.Services
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using Markdig
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IPlatformLinkService LinkService

<PageTitle>Virtual Dev Team — Approvals / Alerts</PageTitle>

<div class="dashboard-header" data-testid="page-approvals">
    <h1>🚦 Approvals / Alerts</h1>
    <div class="header-badges">
        <span class="header-badge @(_openCount > 0 ? "warning" : "healthy")">
            @_openCount Open
        </span>
        @if (_pendingDecisionCount > 0)
        {
            <span class="header-badge warning">⚖️ @_pendingDecisionCount Decision Gates</span>
        }
        <span class="header-badge">@_resolvedCount Resolved</span>
    </div>
</div>

<div class="approval-filters">
    <button class="filter-btn @(_filter == NotificationFilter.Open ? "active" : "")"
            @onclick="() => SetFilter(NotificationFilter.Open)">
        Open @if (_openCount > 0) { <span class="filter-count">@_openCount</span> }
    </button>
    <button class="filter-btn @(_filter == NotificationFilter.Resolved ? "active" : "")"
            @onclick="() => SetFilter(NotificationFilter.Resolved)">
        Resolved
    </button>
    <button class="filter-btn @(_filter == NotificationFilter.All ? "active" : "")"
            @onclick="() => SetFilter(NotificationFilter.All)">
        All
    </button>
    @if (_hasOpenFlowMonitorInfo && _filter != NotificationFilter.Resolved)
    {
        <button class="filter-btn dismiss-flow-monitor-btn"
                @onclick="DismissAllFlowMonitorInfo"
                title="Dismiss all FlowMonitor info-only entries. They are audit-trail entries that need no human decision.">
            ✕ Dismiss all FlowMonitor entries
        </button>
    }
</div>

@* ── Pre-PR Clarification Questions ── *@
@if (_pendingClarifications.Count > 0 && _filter != NotificationFilter.Resolved)
{
    <div class="decision-gates-section">
        <h3>🤔 Pre-PR Clarification Questions</h3>
        @foreach (var set in _pendingClarifications)
        {
            <div class="approval-card clarification-card open">
                <div class="approval-card-left">
                    <div class="approval-icon"><span>🤔</span></div>
                </div>
                <div class="approval-card-body">
                    <div class="approval-card-header">
                        <span class="approval-gate-name">@set.AgentDisplayName</span>
                        <span class="approval-resource-badge">Issue #@set.IssueNumber</span>
                        <LocalTimeText Value="set.CreatedAt" CssClass="approval-time" />
                    </div>
                    <div class="approval-context">
                        <strong>Task:</strong> @set.IssueTitle
                    </div>
                    <div class="clarification-questions">
                        @for (var i = 0; i < set.Questions.Count; i++)
                        {
                            var q = set.Questions[i];
                            var idx = i;
                            <div class="clarification-question-item">
                                <div class="clarification-question-header">
                                    <span class="clarification-q-number">Q@(i + 1)</span>
                                    <span class="impact-badge impact-@q.ImpactLevel.ToString().ToLower()">@q.ImpactLevel</span>
                                    <span class="clarification-category">@q.Category</span>
                                </div>
                                <div class="clarification-question-text">@((MarkupString)RenderSafeMarkdown(q.Question))</div>
                                <textarea class="clarification-answer-input"
                                          rows="2"
                                          @bind="_clarificationAnswers[set.Id][idx]"
                                          @bind:event="oninput"></textarea>
                            </div>
                        }
                    </div>
                    <div class="approval-card-footer">
                        <div class="approval-footer-buttons">
                            <button class="approval-action-btn approve-btn" @onclick="() => ApproveClarifications(set.Id)">
                                ✅ Approve Answers
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Pending Decision Gates ── *@
@if (_pendingDecisions.Count > 0 && _filter != NotificationFilter.Resolved)
{
    <div class="decision-gates-section">
        <h3>⚖️ Decision Gates Awaiting Review</h3>
        @foreach (var decision in _pendingDecisions)
        {
            <div class="approval-card decision-gate open">
                <div class="approval-card-left">
                    <div class="approval-icon">
                        <span class="impact-badge impact-@decision.ImpactLevel.ToString().ToLower()">@decision.ImpactLevel</span>
                    </div>
                </div>
                <div class="approval-card-body">
                    <div class="approval-card-header">
                        <span class="approval-gate-name">⚖️ @decision.Title</span>
                        <span class="approval-resource-badge">@decision.AgentDisplayName</span>
                        @if (!string.IsNullOrEmpty(decision.SourceQuestion))
                        {
                            <span class="decision-source-badge">📋 Wizard Q</span>
                        }
                        @if (decision.AssociatedPrNumber is > 0)
                        {
                            <span class="decision-pr-badge">PR #@decision.AssociatedPrNumber</span>
                        }
                        <LocalTimeText Value="decision.CreatedAt" CssClass="approval-time" />
                    </div>
                    @if (!string.IsNullOrEmpty(decision.SourceQuestion))
                    {
                        <div class="decision-source-question">
                            <strong>Original Question:</strong> @((MarkupString)RenderSafeMarkdown(decision.SourceQuestion))
                        </div>
                    }
                    <div class="approval-context">
                        <strong>Rationale:</strong> @decision.Rationale
                    </div>
                    @if (!string.IsNullOrEmpty(decision.Alternatives))
                    {
                        <div class="decision-detail-field">
                            <strong>Alternatives Considered:</strong> @decision.Alternatives
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(decision.AffectedFiles))
                    {
                        <div class="decision-detail-field">
                            <strong>Affected Files:</strong> @decision.AffectedFiles
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(decision.RiskAssessment))
                    {
                        <div class="decision-detail-field">
                            <strong>Risk Assessment:</strong> @decision.RiskAssessment
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(decision.Plan))
                    {
                        <details class="decision-plan-detail">
                            <summary>📋 View Implementation Plan</summary>
                            <pre class="decision-plan-content">@decision.Plan</pre>
                        </details>
                    }

                    @* Feedback + Approve/Reject *@
                    <div class="decision-actions">
                        <input type="text" class="decision-feedback-input"
                               placeholder="Optional feedback..."
                               @bind="_feedbackInputs[decision.Id]" />
                        <button class="decision-approve-btn" @onclick="() => ApproveDecision(decision.Id)"
                            title="Approve this decision and let the agent proceed with the proposed approach. The agent will implement the plan as described in the rationale and alternatives.">
                            ✅ Approve
                        </button>
                        <button class="decision-reject-btn" @onclick="() => RejectDecisionAsync(decision.Id)"
                            title="Reject this decision. The agent will abandon this approach. Provide feedback to guide the agent toward a better alternative.">
                            ❌ Reject
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Standard Gate Notifications ── *@
@if (_notifications.Count == 0 && _pendingDecisions.Count == 0 && _pendingClarifications.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">✅</div>
        <div class="empty-text">
            @if (_filter == NotificationFilter.Open)
            {
                <span>No gates awaiting approval</span>
            }
            else if (_filter == NotificationFilter.Resolved)
            {
                <span>No resolved approvals yet</span>
            }
            else
            {
                <span>No gate notifications</span>
            }
        </div>
        <div class="empty-sub">Gate approval requests from agents will appear here</div>
    </div>
}
else if (_notifications.Count > 0)
{
    <div class="approvals-list">
        @foreach (var gate in _notifications)
        {
            // Coalesced FlowMonitor duplicates (every member except the "display" one) are
            // hidden — the display card surfaces the count.
            if (_collapsedFlowMonitorIds.Contains(gate.Id)) { continue; }
            var isProjectComplete = gate.GateName.Contains("Project Complete", StringComparison.OrdinalIgnoreCase);
            var isDecisionGate = gate.GateId.StartsWith(DecisionGateService.DecisionGatePrefix);
            var isClarificationGate = gate.GateId == GateIds.PrePRClarification;
            // FlowMonitor entries split into two flavours:
            //   • `flow-monitor:fix:<rec-id>` = real human gate (T1.5) — operator approves/reworks/rejects
            //     a /plan + rubber-duck FixRecommendation. Has its own card layout below.
            //   • `flow-monitor:<action>` = audit-trail entries for actions FlowMonitor already took.
            //     No human decision needed; rendered as a passive info card.
            var isFlowMonitorFix = gate.GateId.StartsWith("flow-monitor:fix:", StringComparison.OrdinalIgnoreCase);
            var isFlowMonitor = !isFlowMonitorFix
                && gate.GateId.StartsWith("flow-monitor:", StringComparison.OrdinalIgnoreCase);
            var fixRec = isFlowMonitorFix ? GetFixRecommendationForGate(gate.GateId) : null;

            @if (isFlowMonitorFix)
            {
                @* T1.5: FixRecommendation card — surfaces a /plan + rubber-duck plan with
                   approve/rework/reject buttons. Distinct visual treatment (badge + confidence
                   meter + collapsible plan body) so it doesn't look like a routine gate. *@
                var confidenceClass = fixRec is null ? "fixrec-conf-unknown"
                    : fixRec.Confidence >= 0.75 ? "fixrec-conf-high"
                    : fixRec.Confidence >= 0.5  ? "fixrec-conf-med"
                    : "fixrec-conf-low";
                var severityClass = fixRec is null ? "fixrec-sev-unknown"
                    : fixRec.Severity.ToString().ToLowerInvariant();
                var planExpanded = _expandedPlans.Contains(gate.Id);
                var preview = fixRec is null ? string.Empty : GetPlanPreview(fixRec.PlanMarkdown);
                // T1.6: tier badge — Live (🟢) / Deferred (🟡) / Blocked (🔴). Tells the operator
                // up-front what happens when they click Approve.
                var tier = fixRec?.FixTier;
                var (tierEmoji, tierLabel, tierClass) = tier switch
                {
                    FixTier.Live            => ("🟢", "Live",     "fixrec-tier-live"),
                    FixTier.DeferredRestart => ("🟡", "Deferred", "fixrec-tier-deferred"),
                    FixTier.Blocked         => ("🔴", "Blocked",  "fixrec-tier-blocked"),
                    _                       => ("⚪", "Unknown",  "fixrec-tier-unknown"),
                };
                var tierTooltip = tier switch
                {
                    FixTier.Live            => "Live: applies in-place via config/prompt watcher — no restart needed.",
                    FixTier.DeferredRestart => "Deferred: code change written; click Restart Runner to activate.",
                    FixTier.Blocked         => "Blocked: cannot apply while runner is up — staged for next boot.",
                    _                       => "Tier not classified yet.",
                };

                <div class="approval-card fixrec-card @(gate.IsResolved ? "resolved" : "open")"
                     data-testid="fixrec-card-@(fixRec?.Id ?? "unknown")">
                    <div class="approval-card-top">
                        <div class="approval-card-left">
                            <div class="approval-icon"><span>🔧</span></div>
                        </div>
                        <div class="approval-card-body">
                            <div class="approval-card-header">
                                <span class="approval-gate-name">Fix Recommendation</span>
                                <span class="fixrec-tier-badge @tierClass" title="@tierTooltip">
                                    @tierEmoji @tierLabel
                                </span>
                                <span class="fixrec-severity-badge fixrec-sev-@severityClass">
                                    @(fixRec?.Severity.ToString() ?? "Unknown")
                                </span>
                                <span class="fixrec-confidence-badge @confidenceClass" title="Rubber-duck confidence in this plan">
                                    @(fixRec is null ? "?" : $"{fixRec.Confidence:0%}") confidence
                                </span>
                                @if (fixRec?.NeedsRestart == true)
                                {
                                    <span class="fixrec-restart-badge" title="This fix touches code or NuGet — runner restart will be needed to activate">
                                        ⟳ restart
                                    </span>
                                }
                                @if (fixRec?.EstimatedMinutes is int mins)
                                {
                                    <span class="fixrec-meta-badge" title="Planner's effort estimate">~@mins min</span>
                                }
                                @if (fixRec?.ReworkCount > 0)
                                {
                                    <span class="fixrec-rework-badge" title="Rework round number">rework v@(fixRec.ReworkCount + 1)</span>
                                }
                                <LocalTimeText Value="gate.CreatedAt" CssClass="approval-time" />
                                @if (gate.IsResolved)
                                {
                                    <span class="approval-status-pill approved">@(fixRec?.State.ToString() ?? "Resolved")</span>
                                }
                            </div>
                            @* FlowMonitor fix-rec context — markdown rendered for **bold** / _italic_. *@
                            <div class="approval-context">
                                <VirtualDevTeam.Dashboard.Components.Shared.MarkdownBody Markdown="@gate.Context" />
                            </div>
                            @if (fixRec is not null && !string.IsNullOrEmpty(fixRec.FilesToChange))
                            {
                                <div class="fixrec-files">
                                    <strong>Files to change:</strong> <code>@fixRec.FilesToChange</code>
                                </div>
                            }
                            @if (fixRec is not null && !string.IsNullOrEmpty(preview))
                            {
                                <div class="fixrec-preview">@preview</div>
                            }
                            @if (fixRec is not null)
                            {
                                <button class="fixrec-expand-btn" @onclick="() => ToggleFixRecPlan(gate.Id)">
                                    @(planExpanded ? "▾ Hide full plan" : "📋 View Full Plan")
                                </button>
                            }
                            @if (planExpanded && fixRec is not null)
                            {
                                <div class="fixrec-plan-body">
                                    @((MarkupString)RenderSafeMarkdown(fixRec.PlanMarkdown))
                                </div>
                            }
                            @if (_fixRecActionInProgress.TryGetValue(gate.Id, out var actionState))
                            {
                                <div class="fixrec-action-status">
                                    <span class="rework-spinner"></span>
                                    <span>@actionState</span>
                                </div>
                            }
                        </div>
                    </div>
                    @if (!gate.IsResolved && fixRec is not null && !_fixRecActionInProgress.ContainsKey(gate.Id))
                    {
                        <div class="approval-card-footer">
                            <div class="approval-footer-buttons">
                                <button class="approval-action-btn approve-btn"
                                        @onclick="() => ApproveFixRecommendationAsync(fixRec.Id, gate.Id)">
                                    ✅ Approve
                                </button>
                                <button class="approval-action-btn review-btn"
                                        @onclick="() => ApproveFixRecommendationAndRestartAsync(fixRec.Id, gate.Id)">
                                    🔄 Approve with Restart
                                </button>
                                <button class="approval-action-btn reject-btn"
                                        @onclick="() => DismissFixRecommendationAsync(fixRec.Id, gate.Id)">
                                    🗑️ Dismiss
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (isClarificationGate && !gate.IsResolved)
            {
                @* Clarification gate with no matching question set (generation failed).
                   Render a simple "proceed without questions" card so it's not invisible. *@
                var hasMatchingSet = _pendingClarifications.Any(s => s.IssueNumber == gate.ResourceNumber);
                if (!hasMatchingSet)
                {
                    <div class="approval-card open @(_focusedGateId == gate.GateId ? "highlight-pulse" : "")"
                         id="@($"gate-{gate.GateId}")">
                        <div class="approval-card-top">
                            <div class="approval-card-left">
                                <div class="approval-icon"><span>⚠️</span></div>
                            </div>
                            <div class="approval-card-body">
                                <div class="approval-card-header">
                                    <span class="approval-gate-name">@gate.GateName</span>
                                    @if (gate.ResourceNumber is not null)
                                    {
                                        <span class="approval-resource-badge">Issue #@gate.ResourceNumber</span>
                                    }
                                    <LocalTimeText Value="gate.CreatedAt" CssClass="approval-time" />
                                </div>
                                <div class="approval-context">
                                    @gate.Context
                                </div>
                            </div>
                        </div>
                        <div class="approval-card-footer">
                            <div class="approval-footer-buttons">
                                <button class="approval-action-btn approve-btn" @onclick="() => ApproveGate(gate.GateId, gate.ResourceNumber)">
                                    ✅ Proceed Without Questions
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (!isDecisionGate && !isClarificationGate)
            {
                @* id="gate-{GateId}" enables deep-linking from agent cards/detail page
                   via /approvals?focus={GateId} (see agent-blocked-show-approval-link). *@
                <div class="approval-card @(gate.IsResolved ? "resolved" : gate.ReworkState is not null ? "reworking" : gate.IsReworked ? "reworked" : "open") @(isProjectComplete ? "project-complete" : "") @(isFlowMonitor ? "flow-monitor-info" : "") @(_focusedGateId == gate.GateId ? "highlight-pulse" : "")"
                     id="@($"gate-{gate.GateId}")">
                    <div class="approval-card-top">
                        <div class="approval-card-left">
                            <div class="approval-icon">
                                @if (isFlowMonitor) { <span>🔧</span> }
                                else if (isProjectComplete) { <span>🎉</span> }
                                else if (gate.IsResolved) { <span>✅</span> }
                                else if (gate.ReworkState is not null) { <span>🔄</span> }
                                else if (gate.IsReworked) { <span>🔄</span> }
                                else { <span>🚦</span> }
                            </div>
                        </div>
                        <div class="approval-card-body">
                            <div class="approval-card-header">
                                <span class="approval-gate-name">@gate.GateName</span>
                                @if (isFlowMonitor && _flowMonitorGroups.TryGetValue(gate.Id, out var groupIds) && groupIds.Count > 1)
                                {
                                    <span class="flow-monitor-group-badge"
                                          title="@(groupIds.Count) identical FlowMonitor escalations were coalesced into this card.">
                                        ×@groupIds.Count
                                    </span>
                                }
                                @if (gate.ResourceType is not null && gate.ResourceNumber is not null)
                                {
                                    <span class="approval-resource-badge">@gate.ResourceType #@gate.ResourceNumber</span>
                                }
                                <LocalTimeText Value="gate.CreatedAt" CssClass="approval-time" />
                                @if (gate.GitHubUrl is not null)
                                {
                                    var (revHref, revTarget, revRel, revTitle, revArrow) = ResolveGateReviewLink(gate);
                                    <a class="approval-action-btn review-btn" href="@revHref" target="@revTarget" rel="@revRel" title="@revTitle">
                                        Review @revArrow
                                    </a>
                                }
                                @if (gate.IsResolved)
                                {
                                    <span class="approval-status-pill approved">@(isProjectComplete ? "Complete" : "Approved")</span>
                                }
                                else if (gate.ReworkState is not null)
                                {
                                    <span class="approval-status-pill reworking" title="Rework iteration @gate.ReworkState.IterationCount">
                                        Rework iteration @gate.ReworkState.IterationCount
                                    </span>
                                }
                                else if (gate.IsReworked)
                                {
                                    <span class="approval-status-pill reworked">Revised — ready for re-review</span>
                                }
                            </div>
                            @* FlowMonitor and strategy notifications contain markdown (**bold**/_italic_);
                               render via MarkdownBody so operators see formatted text. *@
                            <div class="approval-context">
                                @if (isFlowMonitor || gate.GateId.StartsWith("strategy-", StringComparison.OrdinalIgnoreCase))
                                {
                                    @* Show a short summary line, collapse verbose details *@
                                    var summaryLine = ExtractFlowMonitorSummary(gate.Context);
                                    <div class="flow-monitor-summary">@((MarkupString)RenderSafeMarkdown(summaryLine))</div>
                                    <details class="flow-monitor-details">
                                        <summary>Show details</summary>
                                        <VirtualDevTeam.Dashboard.Components.Shared.MarkdownBody Markdown="@gate.Context" />
                                    </details>
                                }
                                else
                                {
                                    @gate.Context
                                }
                            </div>
                            @if (gate.Artifacts is { Count: > 0 })
                            {
                                <div class="approval-artifacts">
                                    @foreach (var artifact in gate.Artifacts)
                                    {
                                        var displayName = artifact.DisplayName ?? System.IO.Path.GetFileName(artifact.FilePath);
                                        var fileUrl = BuildArtifactUrl(gate, artifact);
                                        <div class="approval-artifact-item">
                                            <span class="artifact-icon">@(artifact.Kind switch {
                                                ArtifactKind.Document => "📄",
                                                ArtifactKind.Image => "🖼️",
                                                ArtifactKind.Diagram => "📊",
                                                _ => "📎"
                                            })</span>
                                            <span class="artifact-name">@displayName</span>
                                            @if (!string.IsNullOrEmpty(fileUrl))
                                            {
                                                <a href="@fileUrl" target="_blank" rel="noopener" class="artifact-link" title="View on platform">↗</a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (gate.IsResolved && gate.ResolvedAt.HasValue)
                            {
                                <div class="approval-resolved-info">
                                    ✅ @(isProjectComplete ? "Completed" : "Approved") <LocalTimeText Value="gate.ResolvedAt.Value" />
                                </div>
                            }
                            @if (gate.ReworkState is not null)
                            {
                                <div class="approval-rework-info">
                                    <div class="rework-status-bar">
                                        <span class="rework-spinner"></span>
                                        <span>Agent is revising based on your feedback (iteration @gate.ReworkState.IterationCount)</span>
                                        <span class="approval-time">requested <LocalTimeText Value="gate.ReworkState.RequestedAt" /></span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(gate.ReworkState.Feedback))
                                    {
                                        <div class="rework-feedback-quote">@gate.ReworkState.Feedback</div>
                                    }
                                    @{
                                        var commitsUrl = gate.ReworkState.ChangesUrl
                                            ?? (gate.GitHubUrl is not null ? $"{gate.GitHubUrl}/commits" : null);
                                        var filesUrl = gate.GitHubUrl is not null ? $"{gate.GitHubUrl}/files" : null;
                                    }
                                    @if (commitsUrl is not null || filesUrl is not null)
                                    {
                                        <div class="rework-links">
                                            @if (commitsUrl is not null)
                                            {
                                                <a class="approval-action-btn review-btn" href="@commitsUrl" target="_blank" rel="noopener">
                                                    View Commits ↗
                                                </a>
                                            }
                                            @if (filesUrl is not null)
                                            {
                                                <a class="approval-action-btn review-btn" href="@filesUrl" target="_blank" rel="noopener">
                                                    View Changes ↗
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @* ── D7: Scenario Confidence Panel ── *@
                            @if (gate.ScenarioVerdicts is { Count: > 0 })
                            {
                                var lowCritCount = gate.ScenarioVerdicts.Count(v =>
                                    v.Priority == ScenarioPriority.Critical && v.Confidence < 0.5);
                                var overallConf = gate.ScenarioVerdicts.Average(v => v.Confidence);
                                var showLowConfWarning = lowCritCount > 0 || overallConf < 0.7;
                                var overallConfClass = overallConf >= 0.7 ? "fixrec-conf-high"
                                    : overallConf >= 0.5 ? "fixrec-conf-med" : "fixrec-conf-low";

                                @if (showLowConfWarning)
                                {
                                    var warnMsg = lowCritCount > 0
                                        ? $"{lowCritCount} critical scenario{(lowCritCount > 1 ? "s" : "")} have low confidence."
                                        : $"Overall confidence {overallConf:0%} is below threshold.";
                                    <div class="low-confidence-warning-banner">
                                        ⚠️ Manual review recommended — @warnMsg
                                    </div>
                                }

                                <details class="scenario-verdict-section">
                                    <summary class="scenario-verdict-summary">
                                        🧪 Scenario Verification
                                        <span class="scenario-conf-badge @overallConfClass">
                                            overall @overallConf.ToString("0%")
                                        </span>
                                        <span class="scenario-count-badge">@gate.ScenarioVerdicts.Count scenarios</span>
                                    </summary>
                                    <div class="scenario-verdict-list">
                                        @foreach (var sv in gate.ScenarioVerdicts)
                                        {
                                            var (verdictIcon, verdictCls) = sv.Status switch
                                            {
                                                VerificationStatus.Verified     => ("✓", "verdict-verified"),
                                                VerificationStatus.Broken       => ("✗", "verdict-broken"),
                                                VerificationStatus.Inconclusive => ("?", "verdict-inconclusive"),
                                                _                               => ("–", "verdict-unknown"),
                                            };
                                            var svConfClass = sv.Confidence >= 0.7 ? "conf-high"
                                                : sv.Confidence >= 0.5 ? "conf-med" : "conf-low";
                                            <div class="scenario-verdict-row @verdictCls">
                                                <span class="verdict-icon @verdictCls" title="@sv.Status">@verdictIcon</span>
                                                <span class="verdict-scenario-id">@sv.ScenarioId</span>
                                                <span class="verdict-title" title="@sv.Title">@sv.Title</span>
                                                <span class="verdict-priority priority-@sv.Priority.ToString().ToLower()">@sv.Priority</span>
                                                <div class="confidence-bar" title="Confidence: @sv.Confidence.ToString("0%")">
                                                    <div class="confidence-bar-fill @svConfClass" style="width: @((sv.Confidence * 100).ToString("F0"))%"></div>
                                                </div>
                                                <span class="confidence-value @svConfClass">@sv.Confidence.ToString("0%")</span>
                                                @if (sv.EvidenceUrl is not null)
                                                {
                                                    <a class="verdict-evidence-link" href="@sv.EvidenceUrl" target="_blank" rel="noopener" title="View evidence">🔗</a>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                    @if (!gate.IsResolved && !isProjectComplete && !isFlowMonitor && gate.ReworkState is null)
                    {
                        <div class="approval-card-footer">
                            <textarea class="approval-feedback-input"
                                   rows="2"
                                   placeholder="Rework feedback (optional) — describe what needs to change"
                                   @bind="_gateFeedbackInputs[gate.Id]"
                                   @bind:event="oninput"></textarea>
                            <div class="approval-footer-buttons">
                                <button class="approval-action-btn reject-btn" @onclick="() => RejectGate(gate.GateId, gate.Id, gate.ResourceNumber)"
                                    title="Send the artifact back for rework. The agent will revise based on your feedback (if provided) and re-submit for approval. Use when the work needs changes but the approach is sound.">
                                    🔄 Request Rework
                                </button>
                                <button class="approval-action-btn recommend-manual-review-btn" @onclick="() => RecommendManualReviewGateAsync(gate.GateId, gate.Id, gate.ResourceNumber)"
                                    title="Approve but flag for manual follow-up. The pipeline continues, but a 'needs-manual-review' label is added so you remember to revisit this PR/artifact later. Use when it's good enough to proceed but deserves a closer look.">
                                    🔍 Flag for Follow-up
                                </button>
                                <button class="approval-action-btn approve-btn" @onclick="() => ApproveGate(gate.GateId, gate.ResourceNumber)"
                                    title="Approve this gate and allow the pipeline to proceed. The agent moves to the next phase immediately. Use when you're satisfied with the quality and completeness of the work.">
                                    ✅ Approve
                                </button>
                            </div>
                        </div>
                    }
                    else if (isFlowMonitor && !gate.IsResolved)
                    {
                        var isAutoApproval = gate.GateId.StartsWith("flow-monitor:auto-approve:", StringComparison.OrdinalIgnoreCase);
                        <div class="approval-card-footer">
                            <div class="flow-monitor-info-note">
                                @{
                                    var groupCount = _flowMonitorGroups.TryGetValue(gate.Id, out var gIds) ? gIds.Count : 1;
                                    var isPersistent = groupCount > 1;
                                }
                                @if (isAutoApproval)
                                {
                                    <span>🤖 FlowMonitor auto-approved this gate/decision after it exceeded the configured timeout. No human action needed — dismiss to acknowledge.</span>
                                }
                                else if (isPersistent)
                                {
                                    <span>⚠️ FlowMonitor escalated @groupCount times — automated actions (nudge → comment) did not resolve the condition. Manual investigation may be needed.</span>
                                }
                                else
                                {
                                    <span>ℹ️ Automatic FlowMonitor action — escalation in progress.</span>
                                }
                            </div>
                            <div class="approval-footer-buttons">
                                <button class="approval-action-btn dismiss-btn"
                                        @onclick="() => DismissFlowMonitorCard(gate.Id)"
                                        title="@(_flowMonitorGroups.TryGetValue(gate.Id, out var ids) && ids.Count > 1 ? $"Dismiss this card and the {ids.Count - 1} identical entries it coalesces." : "Dismiss this entry — it's audit-trail only and needs no decision.")">
                                    ✕ Dismiss
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@* ── MissingWork Proposed Issues ── *@
@if (_missingWorkProposals?.Count > 0)
