    /// <summary>
    /// Pull the latest 50 recommendations and index them by id for fast lookup
    /// in the gate-card render loop. Bundled mode reads from <see cref="FlowMonitorPersistence"/>;
    /// standalone mode goes through the API endpoint.
    /// </summary>
    private async Task RefreshFixRecommendationsAsync()
    {
        try
        {
            IReadOnlyList<FixRecommendation> recs;
            if (_flowPersistence is not null)
            {
                recs = _flowPersistence.GetRecentRecommendations(50);
            }
            else if (_http is not null)
            {
                recs = await _http.GetFromJsonAsync<List<FixRecommendation>>(
                    "/api/dashboard/health/flow-monitor/recommendations") ?? new();
            }
            else
            {
                return;
            }

            var byId = recs.ToDictionary(r => r.Id, r => r);
            // Only mutate + re-render when the set actually changed — otherwise we'd thrash the UI.
            if (byId.Count != _fixRecsById.Count
                || !byId.Keys.All(k => _fixRecsById.ContainsKey(k)))
            {
                _fixRecsById = byId;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                _fixRecsById = byId;
            }
        }
        catch
        {
            // Runner unreachable, DB locked, etc. — silent fail, will retry on next tick.
        }
    }

    /// <summary>
    /// Look up the FixRecommendation associated with a "flow-monitor:fix:{id}" gate.
    /// Returns null until the first poll cycle has populated the cache.
    /// </summary>
    private FixRecommendation? GetFixRecommendationForGate(string gateId)
    {
        const string prefix = "flow-monitor:fix:";
        if (!gateId.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) return null;
        var id = gateId[prefix.Length..];
        return _fixRecsById.TryGetValue(id, out var rec) ? rec : null;
    }

    private void ToggleFixRecPlan(string gateUiId)
    {
        if (!_expandedPlans.Add(gateUiId))
            _expandedPlans.Remove(gateUiId);
    }

    /// <summary>
    /// Render the first three non-empty lines of the plan as a teaser shown without expanding.
    /// Strips the YAML front-matter delimiter (---) and the leading "## Problem" header so the
    /// preview shows actual content, not boilerplate.
    /// </summary>
    private static string GetPlanPreview(string planMarkdown)
    {
        if (string.IsNullOrWhiteSpace(planMarkdown)) return string.Empty;
        var lines = planMarkdown.Split('\n', StringSplitOptions.None)
            .Select(l => l.TrimEnd('\r'))
            .Where(l => !string.IsNullOrWhiteSpace(l)
                        && !l.StartsWith("---")
                        && !l.StartsWith("## Problem", StringComparison.OrdinalIgnoreCase)
                        && !l.StartsWith("# "))
            .Take(3)
            .ToList();
        return string.Join(" ", lines).Trim();
    }

    /// <summary>
    /// Render plan Markdown to sanitized HTML. Markdig produces the HTML, then HtmlSanitizer
    /// strips any tags/attributes outside a tight allow-list — even the planner's own LLM
    /// output is treated as untrusted because operator feedback is mixed in during reworks.
    /// </summary>
    private static string RenderSafeMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        var html = Markdown.ToHtml(markdown, _fixRecMarkdownPipeline);
        return _htmlSanitizer.Sanitize(html);
    }

    private async Task ApproveFixRecommendationAsync(string recId, string notificationUiId)
    {
        _fixRecActionInProgress[notificationUiId] = "Approving plan...";
        StateHasChanged();
        try
        {
            await PostFixRecActionAsync($"recommendations/{recId}/approve", payload: null);
        }
        finally
        {
            _fixRecActionInProgress.Remove(notificationUiId);
            await RefreshFixRecommendationsAsync();
            RefreshData();
        }
    }

    private async Task ApproveFixRecommendationAndRestartAsync(string recId, string notificationUiId)
    {
        _fixRecActionInProgress[notificationUiId] = "Approving plan and restarting runner...";
        StateHasChanged();
        try
        {
            var approved = await PostFixRecActionAsync($"recommendations/{recId}/approve", payload: null);
            if (!approved)
            {
                _fixRecActionInProgress[notificationUiId] = "⚠️ Approve failed — restart skipped.";
                StateHasChanged();
                await Task.Delay(2500);
                return;
            }

            _fixRecActionInProgress[notificationUiId] = "Restarting runner...";
            StateHasChanged();
            await PostRunnerRestartAsync();
        }
        finally
        {
            _fixRecActionInProgress.Remove(notificationUiId);
            await RefreshFixRecommendationsAsync();
            RefreshData();
        }
    }

    private async Task DismissFixRecommendationAsync(string recId, string notificationUiId)
    {
        _fixRecActionInProgress[notificationUiId] = "Dismissing recommendation...";
        StateHasChanged();
        try
        {
            await PostFixRecActionAsync($"recommendations/{recId}/reject", payload: null);
        }
        finally
        {
            _fixRecActionInProgress.Remove(notificationUiId);
            await RefreshFixRecommendationsAsync();
            RefreshData();
        }
    }

    private async Task<bool> PostFixRecActionAsync(string relativePath, object? payload)
    {
        var url = $"/api/dashboard/health/flow-monitor/{relativePath}";
        var http = _http ?? GetSelfHttpClient();
        try
        {
            using var resp = payload is null
                ? await http.PostAsync(url, content: null)
                : await http.PostAsJsonAsync(url, payload);
            return resp.IsSuccessStatusCode;
        }
        catch
        {
            return false;
        }
    }

    private async Task PostRunnerRestartAsync()
    {
        var http = _http ?? GetSelfHttpClient();

        try
        {
            await http.PostAsync("/api/dashboard/runtime/restart", content: null);
        }
        catch
        {
            // Common to disconnect mid-flight while the runner shuts down and relaunches.
        }
    }

    // ── Proposal helpers (MissingWork + FlowAction) ─────────────────────────────────

    /// <summary>
    /// Fetch pending proposals from both subsystems and trigger a re-render.
    /// Uses an HTTP call to the Runner API so it works in both bundled and standalone modes.
    /// </summary>
    private async Task RefreshProposalsAsync()
    {
        try
        {
            if (_missingWorkStore is not null || _flowActionProposalStore is not null)
            {
                // Bundled mode: read directly from in-process stores (no self-HTTP).
                _missingWorkProposals = _missingWorkStore?.ListPendingProposals(50)?.ToList();
                _flowActionProposals = _flowActionProposalStore is not null
                    ? (await _flowActionProposalStore.ListPendingAsync(CancellationToken.None))?.ToList()
                    : null;
            }
            else
            {
                // Standalone mode: HTTP to Runner API.
                var http = GetProposalHttpClient();
                _missingWorkProposals = await http.GetFromJsonAsync<List<ProposedIssue>>(
                    "/api/dashboard/missing-work-proposals");
                _flowActionProposals = await http.GetFromJsonAsync<List<ProposedFlowAction>>(
                    "/api/dashboard/flow-action-proposals");
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { /* best-effort — section simply stays hidden until next poll */ }
    }

    private async Task ApproveMissingWorkAsync(string id)
    {
        await GetProposalHttpClient().PostAsJsonAsync(
            $"/api/dashboard/missing-work-proposals/{id}/approve", new { });
