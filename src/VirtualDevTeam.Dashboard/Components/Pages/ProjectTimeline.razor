    }

    private void ComputeTotalProjectTime()
    {
        // Use earliest CURRENT-RUN PR as the project start.
        // Exclude synthetic anchor PRs (grafted from prior runs in Step 2a) —
        // they have old CreatedAt timestamps that inflate the total.
        var currentRunScope = BranchProvider?.RunScope;
        var scopedPrs = currentRunScope is not null
            ? _pullRequests.Where(p =>
                !string.IsNullOrEmpty(p.HeadBranch) &&
                PullRequestWorkflow.IsCurrentRunScopePr(p.HeadBranch, p.Body, currentRunScope)).ToList()
            : _pullRequests;

        if (scopedPrs.Count > 0)
        {
            var earliest = scopedPrs.Min(p => p.CreatedAt);
            _totalProjectTime = DateTime.UtcNow - earliest;
        }
        else if (_pullRequests.Count > 0)
        {
            // Fallback: use issues from the current run as anchor
            var currentIssues = _issues.Where(i =>
                i.Labels.Any(l => l.Equals("engineering-task", StringComparison.OrdinalIgnoreCase))).ToList();
            if (currentIssues.Count > 0)
            {
                var earliest = currentIssues.Min(i => i.CreatedAt);
                _totalProjectTime = DateTime.UtcNow - earliest;
            }
            else
            {
                // Last resort: FlowTimelineTracker
                var timeline = FlowTracker.GetTimeline();
                if (timeline.Count > 0)
                    _totalProjectTime = DateTimeOffset.UtcNow - timeline.Min(s => s.StartedAtUtc);
            }
        }
    }

    private TimeSpan GetPhaseDuration(NeonPhase phase)
    {
        // Sum PR durations for phases with linked PRs
        var allPRs = phase.Items.SelectMany(g => g.LinkedPRs).Distinct().ToList();
        if (allPRs.Count > 0)
            return TimeSpan.FromTicks(allPRs.Sum(p => GetPrDuration(p).Ticks));

        // For doc phases (synthetic PRs), use item duration
        if (phase.Items.Any(g => g.IsPullRequest))
            return TimeSpan.FromTicks(phase.Items.Where(g => g.IsPullRequest).Sum(g => GetItemDuration(g.Issue).Ticks));

        // For dev phases with no PRs yet, use issue creation to now
        if (phase.Items.Count > 0)
        {
            var earliest = phase.Items.Min(g => g.Issue.CreatedAt);
            return DateTime.UtcNow - earliest;
        }

        // Fallback: use FlowTimelineTracker spans
        var spans = GetSpansForPhase(phase.Name);
        if (spans.Count > 0)
            return TimeSpan.FromTicks(spans.Sum(s => (s.Duration ?? (DateTimeOffset.UtcNow - s.StartedAtUtc)).Ticks));

        return TimeSpan.Zero;
    }

    private TimeSpan GetPrDuration(PlatformPullRequest pr)
    {
        var end = pr.MergedAt ?? (pr.State == "closed" ? pr.UpdatedAt ?? DateTime.UtcNow : DateTime.UtcNow);
        return end - pr.CreatedAt;
    }

    private TimeSpan GetItemDuration(PlatformWorkItem item)
    {
        var end = item.State == "closed" ? (item.UpdatedAt ?? DateTime.UtcNow) : DateTime.UtcNow;
        return end - item.CreatedAt;
    }

    private IReadOnlyList<FlowSpanView> GetSpansForPhase(string phaseName)
    {
        var phaseMap = FlowTracker.GetTimelineByPhase();
        var trackerPhase = phaseName switch
        {
            "Research" => "Research",
            "PM Spec" => "PMSpec",
            "Architecture" => "Architecture",
            "Finalization" => "Completion",
            _ when phaseName.StartsWith("Development") => "Engineering",
            _ => phaseName
        };
        if (phaseMap.TryGetValue(trackerPhase, out var spans))
            return spans;
        return Array.Empty<FlowSpanView>();
    }

    private IReadOnlyList<FlowSpanView> GetSpansForPr(int prNumber)
    {
        var timeline = FlowTracker.GetTimeline();
        return timeline.Where(s => s.EntityType == "PR" && s.EntityId == prNumber.ToString()).ToList();
    }

    private List<TimeActivity> GetPrTimeActivities(PlatformPullRequest pr)
    {
        var activities = new List<TimeActivity>();
        var labels = pr.Labels.Select(l => l.ToLowerInvariant()).ToList();
        var now = DateTime.UtcNow;
        var totalDuration = GetPrDuration(pr);

        // Try to build activities from real step data (IAgentTaskTracker)
        var stepActivities = GetStepBasedActivities(pr);

        if (pr.IsMerged && pr.MergedAt.HasValue)
        {
            // Merged PR: use step data for implementation sub-stages, then review stages
            if (stepActivities.Count > 0)
            {
                activities.AddRange(stepActivities);
            }
            else
            {
                // Fallback: single implementation block
                var implDuration = TimeSpan.FromTicks((long)(totalDuration.Ticks * 0.70));
                activities.Add(new TimeActivity("⚙️", "Implementation", implDuration, false));
            }

            // Review stages from labels — compute duration from total minus implementation
            var implTotal = activities.Where(a => a.Label != "Merged").Aggregate(TimeSpan.Zero, (sum, a) => sum + a.Duration);
            var remaining = totalDuration - implTotal;
            if (remaining < TimeSpan.Zero) remaining = TimeSpan.FromSeconds(5);

            var reviewLabels = new List<(string icon, string label)>();
            if (labels.Contains("architect-approved"))
                reviewLabels.Add(("🏗️", "Architect Review"));
            if (labels.Contains("tests-added"))
                reviewLabels.Add(("🧪", "Test Engineer"));
            if (labels.Contains("pm-approved"))
                reviewLabels.Add(("📋", "PM Review"));

            var mergeDuration = TimeSpan.FromTicks(Math.Max(remaining.Ticks / 10, TimeSpan.FromSeconds(1).Ticks));
            var reviewDuration = remaining - mergeDuration;
            if (reviewDuration < TimeSpan.Zero) reviewDuration = TimeSpan.FromSeconds(1);

            if (reviewLabels.Count > 0)
            {
                var perReview = TimeSpan.FromTicks(reviewDuration.Ticks / reviewLabels.Count);
                foreach (var (icon, label) in reviewLabels)
                    activities.Add(new TimeActivity(icon, label, perReview, false));
            }
            else
            {
                activities.Add(new TimeActivity("🔍", "Review", reviewDuration, false));
            }

            activities.Add(new TimeActivity("✅", "Merged", mergeDuration, false));
        }
        else if (!pr.IsMerged && pr.State != "closed")
        {
            // Open PR: show step-level sub-activities if available
            if (stepActivities.Count > 0)
            {
                activities.AddRange(stepActivities);

                // Show gap between tracked step time and total elapsed as "Waiting / Setup"
                var trackedTotal = stepActivities.Aggregate(TimeSpan.Zero, (sum, a) => sum + a.Duration);
                var gap = totalDuration - trackedTotal;
                if (gap.TotalMinutes >= 2)
                {
                    // Determine if we're currently in review or still implementing
                    bool isInReview = labels.Contains("ready-for-review") || labels.Contains("awaiting-human-review");
                    activities.Add(new TimeActivity(
                        isInReview ? "⏳" : "🔧",
                        isInReview ? "Awaiting Review" : "Setup / Build / Eval",
                        gap,
                        !isInReview));
                }
            }
            else
            {
                // Estimate implementation time — subtract review time from total
                var implEnd = pr.CreatedAt;
                var hasReviewLabels = false;

                // Check for completed review stages via labels
                var reviewEntries = new List<(string icon, string label, DateTime? completedAt)>();
                if (labels.Contains("architect-approved"))
                    reviewEntries.Add(("🏗️", "Architect Review", null));
                if (labels.Contains("tests-added"))
                    reviewEntries.Add(("🧪", "Test Engineer", null));
                if (labels.Contains("pm-approved"))
                    reviewEntries.Add(("📋", "PM Review", null));

                if (reviewEntries.Count > 0)
                {
                    hasReviewLabels = true;
                    // Implementation was ~70% of elapsed, reviews share remaining 30%
                    var implDuration = TimeSpan.FromTicks((long)(totalDuration.Ticks * 0.70));
                    var reviewDuration = totalDuration - implDuration;
                    activities.Add(new TimeActivity("⚙️", "Implementation", implDuration, false));

                    var perReview = TimeSpan.FromTicks(reviewDuration.Ticks / reviewEntries.Count);
                    foreach (var (icon, label, _) in reviewEntries)
                        activities.Add(new TimeActivity(icon, label, perReview, false));

                    // If labels show ready-for-merge but not yet merged, show merge in progress
                    if (labels.Contains("pm-approved") || labels.Contains("ready-for-review"))
                        activities.Add(new TimeActivity("🔄", "Merging", TimeSpan.FromSeconds(1), true));
                }

                if (!hasReviewLabels)
                {
                    // No review labels yet — show as in-progress implementation
                    bool isInReview = labels.Contains("ready-for-review") || labels.Contains("awaiting-human-review");
                    activities.Add(new TimeActivity(
                        isInReview ? "🔍" : "⚙️",
                        isInReview ? "In Review" : "Implementation",
                        now - pr.CreatedAt,
                        true));
                }
            }
        }

        return activities;
    }

    /// <summary>
    /// Extracts implementation sub-activities from IAgentTaskTracker step data for a PR.
    /// Groups steps into: Strategy Evaluation, Code Generation, Build/Test, Self-Assessment, Rework.
    /// </summary>
    private List<TimeActivity> GetStepBasedActivities(PlatformPullRequest pr)
    {
        var activities = new List<TimeActivity>();
        var prNum = pr.Number;

        try
        {
            // Collect steps from all agents that reference this PR
            var allAgentSteps = new List<VirtualDevTeam.Core.Agents.Steps.AgentTaskStep>();

            // Get all known agent IDs from snapshots
            var agentIds = DataService.GetAllAgentSnapshots().Select(s => s.Id).Distinct().ToHashSet();

            foreach (var agentId in agentIds)
            {
                var steps = TaskTracker.GetSteps(agentId);
                allAgentSteps.AddRange(steps);
            }

            // Match steps by PR-related task IDs (case-insensitive)
            var prTaskIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                $"pr-{prNum}",
                $"PR-{prNum}"
            };

            // Also try to find linked issue number from PR body ("Closes #N") for strategy steps
            if (!string.IsNullOrEmpty(pr.Body))
            {
                var closeMatch = System.Text.RegularExpressions.Regex.Match(
                    pr.Body, @"(?:Closes|Fixes|Resolves)\s+#(\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (closeMatch.Success)
                {
                    var issueNum = closeMatch.Groups[1].Value;
                    prTaskIds.Add($"T{issueNum}");
                    prTaskIds.Add(issueNum);
                    // Specialist agents use "specialist-{issueNumber}" as their strategy taskId
                    prTaskIds.Add($"specialist-{issueNum}");
                }
            }

            // Also extract issue number from PR title pattern "{AgentName}: [T-{N}] ..."
            if (!string.IsNullOrEmpty(pr.Title))
            {
                var titleMatch = System.Text.RegularExpressions.Regex.Match(
                    pr.Title, @"\[T-?(\d+)\]", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                if (titleMatch.Success)
                {
                    var taskNum = titleMatch.Groups[1].Value;
                    prTaskIds.Add($"T{taskNum}");
                    prTaskIds.Add($"T-{taskNum}");
                    prTaskIds.Add(taskNum);
                    prTaskIds.Add($"specialist-{taskNum}");
                }
            }

            var prSteps = allAgentSteps
                .Where(s => prTaskIds.Contains(s.TaskId) && !s.IsContainer && s.StartedAt.HasValue)
                .OrderBy(s => s.StartedAt)
                .ToList();

            if (prSteps.Count == 0) return activities;

            // Categorize steps into meaningful timeline activities
            var strategySteps = prSteps.Where(s =>
                s.Name.Contains("strategy", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Multi-strategy", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("copilot-cli", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Copilot CLI", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("squad", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Evaluating gates", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("🧪", StringComparison.Ordinal) ||
                s.Name.Contains("⚖️", StringComparison.Ordinal)).ToList();

            var selfAssessSteps = prSteps.Where(s =>
                s.Name.Contains("Self-assess", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("self assess", StringComparison.OrdinalIgnoreCase)).ToList();

            var reworkSteps = prSteps.Where(s =>
                s.Name.Contains("review feedback", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("rework", StringComparison.OrdinalIgnoreCase)).ToList();

            var implSteps = prSteps.Where(s =>
                s.Name.Contains("Execute step", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Generate implementation", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Create PR", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Claim issue", StringComparison.OrdinalIgnoreCase) ||
                s.Name.Contains("Mark ready", StringComparison.OrdinalIgnoreCase)).ToList();

            // Build activities in chronological order, merging steps of same category
            var categories = new List<(string icon, string label, List<VirtualDevTeam.Core.Agents.Steps.AgentTaskStep> steps)>
            {
                ("🎯", "Strategy Evaluation", strategySteps),
                ("⚙️", "Code Generation", implSteps),
                ("🔍", "Self-Assessment", selfAssessSteps),
                ("🔄", "Rework", reworkSteps),
            };

            foreach (var (icon, label, steps) in categories)
            {
                if (steps.Count == 0) continue;
                // Sum individual step durations (not span from earliest-to-latest which inflates
                // when there are gaps between steps of the same category)
                var duration = TimeSpan.Zero;
                bool isActive = false;
                foreach (var step in steps)
                {
                    var stepDuration = step.Elapsed ?? (step.CompletedAt.HasValue
                        ? step.CompletedAt.Value - step.StartedAt!.Value
                        : DateTime.UtcNow - step.StartedAt!.Value);
                    duration += stepDuration;
                    if (step.Status == VirtualDevTeam.Core.Agents.Steps.AgentTaskStepStatus.InProgress)
                        isActive = true;
                }
                if (duration.TotalSeconds >= 5) // Only show activities > 5s
                    activities.Add(new TimeActivity(icon, label, duration, isActive));
            }

            // If there are uncategorized steps with >2min duration, show them
            var categorizedIds = strategySteps.Concat(selfAssessSteps).Concat(reworkSteps).Concat(implSteps)
                .Select(s => s.Id).ToHashSet();
            var uncategorized = prSteps.Where(s => !categorizedIds.Contains(s.Id) && (s.Elapsed?.TotalMinutes ?? 0) > 2).ToList();
            foreach (var step in uncategorized)
            {
                activities.Add(new TimeActivity("📋", step.Name, step.Elapsed ?? TimeSpan.Zero,
                    step.Status == VirtualDevTeam.Core.Agents.Steps.AgentTaskStepStatus.InProgress));
            }
        }
        catch
        {
            // Graceful degradation — return empty list, caller falls back to proportional split
        }

        return activities;
    }

    private static string FormatTimeDuration(TimeSpan ts)
    {
        if (ts.TotalSeconds < 1) return "<1s";
        if (ts.TotalSeconds < 60) return $"{(int)ts.TotalSeconds}s";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalHours}h {ts.Minutes}m";
    }

    private static string GetTimeDurationClass(TimeSpan ts)
    {
        if (ts.TotalMinutes < 1) return "dur-fast";
        if (ts.TotalMinutes < 10) return "dur-normal";
        return "dur-slow";
    }

