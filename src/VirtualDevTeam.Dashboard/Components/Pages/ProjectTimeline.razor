    private IReadOnlyList<VirtualDevTeam.Core.Lifecycle.PrLifecycleStage>? _selectedPrLifecycle;

    private async Task SelectPr(int? prNumber)
    {
        if (!prNumber.HasValue || _selectedPr == prNumber)
        {
            _selectedPr = null;
            _selectedPrObj = null;
            _selectedPrLifecycle = null;
            StateHasChanged();
            return;
        }
        var pr = _rawPullRequests.FirstOrDefault(p => p.Number == prNumber.Value)
                 ?? _pullRequests.FirstOrDefault(p => p.Number == prNumber.Value);
        if (pr is null)
        {
            _selectedPr = null;
            _selectedPrObj = null;
            _selectedPrLifecycle = null;
        }
        else
        {
            _selectedIssue = null;
            _selectedGroup = null;
            _selectedPr = prNumber;
            _selectedPrObj = pr;
            _selectedPrLifecycle = null; // Clear stale lifecycle while loading
            StateHasChanged();

            // Compute lifecycle stages from labels + comments + config
            var requestedPr = prNumber.Value;
            try
            {
                var config = AppConfig?.CurrentValue ?? new VirtualDevTeam.Core.Configuration.VirtualDevTeamConfig();

                // Lazy-load comments for peer review detection and timestamp extraction
                IReadOnlyList<VirtualDevTeam.Core.DevPlatform.Models.PlatformComment>? comments = null;
                try { comments = await ReviewService.GetCommentsAsync(pr.Number); }
                catch { /* degrade gracefully — lifecycle still works from labels alone */ }

                // Guard: user may have clicked another PR while comments were loading
                if (_selectedPr != requestedPr) return;

                var lifecycle = VirtualDevTeam.Core.Lifecycle.PrLifecycleCalculator.Compute(
                    pr, config, comments, hasPeerReviewAgents: true);
                _selectedPrLifecycle = lifecycle.Stages;
            }
            catch
            {
                if (_selectedPr == requestedPr)
                    _selectedPrLifecycle = null;
            }
        }
        StateHasChanged();

        // Init detail panel scroll arrows (shows ▲/▼ when panel has more content above/below)
        _ = Task.Run(async () =>
        {
            await Task.Delay(100);
            await InvokeAsync(() => JS.InvokeVoidAsync("eval",
                "(function() {" +
                "var p = document.getElementById('ntl-detail-panel');" +
                "var btnDown = document.getElementById('ntl-detail-scroll-down');" +
                "var btnUp = document.getElementById('ntl-detail-scroll-up');" +
                "if (!p) return;" +
                "function setVisible(el, visible) {" +
                "  if (!el) return;" +
                "  var isVisible = el.classList.contains('ntl-arrow-visible');" +
                "  if (visible) {" +
                "    if (isVisible) return;" +
                "    el.classList.remove('ntl-arrow-hidden');" +
                "    void el.offsetWidth;" +
                "    el.classList.add('ntl-arrow-visible');" +
                "    return;" +
                "  }" +
                "  if (!isVisible && el.classList.contains('ntl-arrow-hidden')) return;" +
                "  el.classList.remove('ntl-arrow-visible');" +
                "  el.classList.add('ntl-arrow-hidden');" +
                "}" +
                "function update() {" +
                "  setVisible(btnDown, p.scrollTop + p.clientHeight < p.scrollHeight - 20);" +
                "  setVisible(btnUp, p.scrollTop > 20);" +
                "}" +
                "p.addEventListener('scroll', update, { passive: true });" +
                "new ResizeObserver(update).observe(p);" +
                "if (btnDown) btnDown.onclick = function() { p.scrollBy({ top: p.clientHeight * 0.6, behavior: 'smooth' }); };" +
                "if (btnUp) btnUp.onclick = function() { p.scrollBy({ top: -(p.clientHeight * 0.6), behavior: 'smooth' }); };" +
                "requestAnimationFrame(update);" +
                "setTimeout(update, 100);" +
                "})();"));
        });
    }

    // Builds a stable URL for the canonical ready-for-review screenshot captured at the PR's head SHA.
    // GitHub: raw.githubusercontent.com, ADO: not supported (relies on in-memory CandidateStore).
    private static string? BuildReadyForReviewScreenshotUrl(PlatformPullRequest pr)
    {
        if (string.IsNullOrEmpty(pr.Url) || string.IsNullOrEmpty(pr.HeadSha)) return null;
        // GitHub: pr.Url = https://github.com/{owner}/{repo}/pull/{N}
        var match = System.Text.RegularExpressions.Regex.Match(
            pr.Url,
            @"github\.com/([^/]+)/([^/]+)/pull/\d+",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!match.Success) return null; // ADO URLs won't match — return null (CandidateStore is primary)
        var owner = match.Groups[1].Value;
        var repo = match.Groups[2].Value;
        return $"https://raw.githubusercontent.com/{owner}/{repo}/{pr.HeadSha}/.screenshots/pr-{pr.Number}-ready-for-review.png";
    }

    /// <summary>
    /// Precomputes the winning screenshot URL for each PR (used by card thumbnails).
    /// Scans CandidateStateStore once and maps by linked issue → PR, avoiding per-card lookups.
    /// </summary>
    private void PrecomputeWinnerScreenshots()
    {
        _prWinnerScreenshots.Clear();
        foreach (var pr in _rawPullRequests)
        {
            if (string.IsNullOrEmpty(pr.Url) || string.IsNullOrEmpty(pr.HeadSha)) continue;

            // Resolve winner key from PR body
            var bodyMatch = System.Text.RegularExpressions.Regex.Match(
                pr.Body ?? string.Empty,
                @"<!--\s*winner-(?:strategy|method):\s*([a-z0-9\-]+)\s*-->",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            var winnerKey = bodyMatch.Success ? bodyMatch.Groups[1].Value.ToLowerInvariant() : "baseline";

            // Check in-memory CandidateStateStore first
            if (CandidateStore is not null && bodyMatch.Success)
            {
                var linkedIssue = PullRequestWorkflow.ParseLinkedIssueNumber(pr.Body ?? "");
                var linkedIssueStr = linkedIssue?.ToString();
                string? found = null;

                foreach (var task in CandidateStore.GetRecentTasks(20))
                {
                    if (task?.Candidates is null) continue;
                    if (linkedIssueStr is not null && task.TaskId != linkedIssueStr) continue;
                    if (task.Candidates.TryGetValue(winnerKey, out var snap) &&
                        !string.IsNullOrEmpty(snap?.ScreenshotBase64))
                    {
                        found = $"data:image/png;base64,{snap.ScreenshotBase64}";
                        break;
                    }
                }
                if (found is null)
                {
                    foreach (var task in CandidateStore.GetActiveTasks())
                    {
                        if (task?.Candidates is null) continue;
                        if (linkedIssueStr is not null && task.TaskId != linkedIssueStr) continue;
                        if (task.Candidates.TryGetValue(winnerKey, out var snap) &&
                            !string.IsNullOrEmpty(snap?.ScreenshotBase64))
                        {
                            found = $"data:image/png;base64,{snap.ScreenshotBase64}";
                            break;
                        }
                    }
                }
                if (found is not null)
                {
                    _prWinnerScreenshots[pr.Number] = found;
                    continue;
                }
            }

            // Fallback: GitHub raw URL for ready-for-review screenshot
            var url = BuildReadyForReviewScreenshotUrl(pr);
            if (url is not null)
                _prWinnerScreenshots[pr.Number] = url;
        }
    }

    private record ScreenshotCandidate(string MethodKey, string MethodLabel, string ImageUrl, bool IsWinner);

    // Returns one tile per code-generation strategy. Checks CandidateStateStore for in-memory
    // screenshot data first (base64 from evaluation), then falls back to platform raw file URLs.
    // ADO doesn't support unauthenticated raw file URLs, so only in-memory screenshots work for ADO.
    private List<ScreenshotCandidate> GetScreenshotCandidates(PlatformPullRequest pr)
    {
        var results = new List<ScreenshotCandidate>();
        if (string.IsNullOrEmpty(pr.Url) || string.IsNullOrEmpty(pr.HeadSha))
            return results;

        // Only show screenshots for PRs that used the strategy framework
        // (indicated by a <!-- winner-strategy: {key} --> comment in the body).
        // Non-code PRs (Research, PMSpec, Architecture) never have this marker
        // and should NOT show the previews section at all.
        var bodyMatch = System.Text.RegularExpressions.Regex.Match(
            pr.Body ?? string.Empty,
            @"<!--\s*winner-(?:strategy|method):\s*([a-z0-9\-]+)\s*-->",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!bodyMatch.Success)
            return results; // No framework marker → no previews section

        var winnerKey = bodyMatch.Groups[1].Value.ToLowerInvariant();

        // GitHub raw file URL fallback (ADO uses CandidateStore only — no public raw file URLs)
        string? owner = null, repo = null;
        var m = System.Text.RegularExpressions.Regex.Match(
            pr.Url,
            @"github\.com/([^/]+)/([^/]+)/pull/\d+",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (m.Success)
        {
            owner = m.Groups[1].Value;
            repo = m.Groups[2].Value;
        }

        // Try to find in-memory screenshot data from the CandidateStateStore.
        // Search ALL tasks (not just by linked issue) — TaskId is "T1"/"T-FINAL"
        // which doesn't match the linked issue number. We match by PR number
        // in the branch name or just use the most recent task with screenshots.
        var storeScreenshots = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (CandidateStore is not null)
        {
            foreach (var task in CandidateStore.GetRecentTasks(20))
            {
                if (task?.Candidates is null) continue;
                foreach (var (stratId, snap) in task.Candidates)
                {
                    if (!string.IsNullOrEmpty(snap?.ScreenshotBase64) && !storeScreenshots.ContainsKey(stratId))
                    {
                        storeScreenshots[stratId] = $"data:image/png;base64,{snap.ScreenshotBase64}";
                    }
                }
            }
            foreach (var task in CandidateStore.GetActiveTasks())
            {
                if (task?.Candidates is null) continue;
                foreach (var (stratId, snap) in task.Candidates)
                {
                    if (!string.IsNullOrEmpty(snap?.ScreenshotBase64) && !storeScreenshots.ContainsKey(stratId))
                    {
                        storeScreenshots[stratId] = $"data:image/png;base64,{snap.ScreenshotBase64}";
                    }
                }
            }
        }

        (string Key, string Label)[] strategies =
        {
            ("baseline", "Baseline"),
            ("mcp-enhanced", "MCP-Enhanced"),
            ("copilot-cli", "GitHub Copilot CLI"),
            ("squad", "Squad"),
        };

        // Filter to only enabled strategies (normalize IDs for comparison)
        var enabled = _enabledInfo?.EnabledStrategies;
        var normalizedEnabled = enabled is { Count: > 0 }
            ? enabled.Select(StrategyIdNormalizer.Normalize).ToHashSet(StringComparer.OrdinalIgnoreCase)
            : null;
        var filtered = normalizedEnabled is not null
            ? strategies.Where(s => normalizedEnabled.Contains(s.Key)).ToArray()
            : strategies;

        foreach (var (key, label) in filtered)
        {
            // Prefer in-memory screenshot from evaluation; fall back to raw URL (GitHub only).
            if (storeScreenshots.TryGetValue(key, out var dataUrl))
            {
                results.Add(new ScreenshotCandidate(key, label, dataUrl, IsWinner: key == winnerKey));
            }
            else if (owner is not null && repo is not null)
            {
                var path = $".screenshots/pr-{pr.Number}-{key}.png";
                var url = $"https://raw.githubusercontent.com/{owner}/{repo}/{pr.HeadSha}/{path}";
                results.Add(new ScreenshotCandidate(key, label, url, IsWinner: key == winnerKey));
            }
        }
        return results;
    }

    private string GetPhaseClass(string name) => name switch
    {
        "Research" => "phase-research",
        "PM Spec" => "phase-pmspec",
        "Architecture" => "phase-architecture",
        "Development" => "phase-development",
        "Eng Planning" => "phase-development",
        "Testing" => "phase-finalization",
        "Finalization" => "phase-finalization",
        _ when name.StartsWith("Development W") => "phase-development",
        _ => "phase-development"
    };

    private string TruncateTitle(string title, int max)
    {
        if (title.Length <= max) return title;
        return title[..(max - 1)] + "…";
    }

    private void OpenGitHub(string url)
    {
        if (!string.IsNullOrEmpty(url))
            Navigation.NavigateTo(url, forceLoad: true);
    }

    private async void OnDataChanged()
    {
        // After initial load, the 30s poll handles updates. OnDataChanged only
        // fires for the initial race where data arrives before the first poll tick.
        if (_initialLoadComplete) return;
        await LoadDataAsync();
    }

    public async ValueTask DisposeAsync()
    {
        DataService.OnChange -= OnDataChanged;
        await _refreshCts.CancelAsync();
        _refreshCts.Dispose();
    }

    private record IssueGroup
    {
        public required PlatformWorkItem Issue { get; init; }
        public required List<PlatformPullRequest> LinkedPRs { get; init; }
        public required List<PlatformWorkItem> ChildIssues { get; init; }
        /// <summary>True when the top-level item is actually a PR rendered as a synthetic issue.</summary>
        public bool IsPullRequest { get; init; }
        /// <summary>Wave assignment for engineering tasks (e.g., "W0", "W1"). Empty for non-engineering items.</summary>
        public string Wave { get; init; } = "";
        /// <summary>Issue numbers this task depends on (blocked by).</summary>
        public List<int> DependsOn { get; init; } = [];
    }

    private record NeonPhase
    {
        public required string Name { get; init; }
        public required string Icon { get; init; }
        public required string CssClass { get; init; }
        public required List<IssueGroup> Items { get; init; }
        /// <summary>True when this phase is a development wave sub-phase.</summary>
        public bool IsWavePhase { get; init; }
    }

    private static readonly System.Text.RegularExpressions.Regex WaveRegex = new(
        @"\*\*Wave:\*\*\s*(W\d+)", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static readonly System.Text.RegularExpressions.Regex DependsOnRegex = new(
        @"\*\*Depends On:\*\*\s*((?:#\d+(?:,\s*)?)+)", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string ParseWaveFromBody(string? body)
    {
        if (string.IsNullOrWhiteSpace(body)) return "";
        var match = WaveRegex.Match(body);
        return match.Success ? match.Groups[1].Value : "";
    }

    private static List<int> ParseDependsOnFromBody(string? body)
    {
        if (string.IsNullOrWhiteSpace(body)) return [];
        var match = DependsOnRegex.Match(body);
        if (!match.Success) return [];
        return System.Text.RegularExpressions.Regex.Matches(match.Groups[1].Value, @"#(\d+)")
            .Select(m => int.Parse(m.Groups[1].Value))
            .ToList();
    }

