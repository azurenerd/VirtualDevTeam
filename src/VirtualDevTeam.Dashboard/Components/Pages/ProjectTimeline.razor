    {
        MilestoneCategory.LLM => "🤖",
        MilestoneCategory.HumanGate => "👤",
        MilestoneCategory.Handoff => "🔄",
        MilestoneCategory.FastForward => "⏩",
        MilestoneCategory.Platform => "📋",
        MilestoneCategory.Wait => "⏳",
        _ => "⚙️",
