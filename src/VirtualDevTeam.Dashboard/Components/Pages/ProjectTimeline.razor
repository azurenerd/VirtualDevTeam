    private static bool TryGetWaveIdForPhase(string phaseName, out string wave)
    {
        var match = System.Text.RegularExpressions.Regex.Match(phaseName, @"(W\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (match.Success)
        {
            wave = match.Groups[1].Value.ToUpperInvariant();
            return true;
        }

        wave = string.Empty;
        return false;
    }

    private static string NormalizeWave(string? wave)
    {
        if (string.IsNullOrWhiteSpace(wave))
            return string.Empty;

        var trimmed = wave.Trim();
        if (TryGetWaveIdForPhase(trimmed, out var parsedWave))
            return parsedWave;

        var normalized = trimmed.ToUpperInvariant();
        return normalized.StartsWith('W') ? normalized : $"W{normalized}";
    }

