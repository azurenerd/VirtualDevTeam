@code {
    private List<PlatformWorkItem> _issues = [];
    private List<PlatformPullRequest> _pullRequests = [];
    private List<PlatformWorkItem> _rawIssues = [];
    private List<PlatformPullRequest> _rawPullRequests = [];
    private List<NeonPhase> _phases = [];
    private HashSet<int> _syntheticPrNumbers = new(); // tracks which issue numbers are actually PRs
    private string _dataFingerprint = ""; // hash to detect actual data changes
    private bool _loading = true;
    private bool _initialLoadComplete;
    private bool _refreshing;
    private bool _isRateLimited;
    private bool _showNewStoryWizard;
    private int _closedCount;
    /// <summary>
    /// Issues that are truly complete: closed AND no open/unmerged PRs pending.
    /// Used for progress bar to avoid showing 100% when a re-created PR is still in review.
    /// </summary>
    private int _completedCount;
    private int _openCount;
    private EnabledStrategiesInfo? _enabledInfo;
    private string? _previewImageUrl;
    private string? _previewTitle;
    private string? _newStoryWave;
    private string? _storySuccessMessage;

    private string _statusFilter = "all";
    private string _devViewMode = "engineering"; // "engineering" = engineering-task issues with PR children, "time" = timing breakdown
    private TimeSpan _totalProjectTime;
    private string _designTheme = "default"; // "default", "blueprint", "metro", "cards"
    private int _zoomPercent = 100;
    private int? _selectedIssue;
    private IssueGroup? _selectedGroup;
    private int? _selectedPr;
    private PlatformPullRequest? _selectedPrObj;
    private SelectedTimeActivityInfo? _selectedTimeActivity;

    private Dictionary<int, IssueGroup> _groupLookup = new();
    /// <summary>Precomputed winning screenshot URL per PR number — avoids per-card CandidateStore scans.</summary>
    private Dictionary<int, string> _prWinnerScreenshots = new();

    private CancellationTokenSource _refreshCts = new();

    protected override async Task OnInitializedAsync()
    {
        // OnChange fires when DashboardDataService cache refreshes — but the poll
        // already picks up changes every 30s, so we only use OnChange for the
        // initial load race. Subsequent updates come from the poll loop only,
        // avoiding redundant BuildTimeline + StateHasChanged calls that cause
        // jarring visual resets every few seconds.
        DataService.OnChange += OnDataChanged;
        try { _enabledInfo = await StrategiesService.GetEnabledAsync(); } catch { /* standalone fallback */ }

        // First load: show overlay only if we have no prior data. On subsequent
        // navigations back to this page, _initialLoadComplete is false (new component
        // instance) but DashboardDataService cache returns instantly so the await
        // completes in <1ms — no visible loading state.
        await LoadDataAsync(showOverlay: true);
        _ = PollForUpdatesAsync(_refreshCts.Token);
        _ = Task.Run(async () => { await Task.Delay(1500); await InvokeAsync(InitScrollArrowsAsync); });
    }

    /// <summary>
    /// Background poll — refreshes timeline every 30s. Uses cached data from
    /// DashboardDataService so it only hits the platform API when the cache expires.
    /// Fingerprint check prevents unnecessary re-renders when data hasn't changed.
    /// </summary>
    private async Task PollForUpdatesAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadDataAsync();
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadDataAsync(bool showOverlay = false)
    {
        // Delay overlay by 200ms — if cache hits, data arrives instantly and no flash.
        // Only show loading state if the fetch actually takes time (cache miss / API call).
        CancellationTokenSource? overlayCts = null;
        if (showOverlay)
        {
            overlayCts = new CancellationTokenSource();
            var token = overlayCts.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(200, token);
                    await InvokeAsync(() => { _loading = true; StateHasChanged(); });
                }
                catch (OperationCanceledException) { }
            });
        }
        _isRateLimited = DataService.IsRateLimited;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var issuesTask = DataService.GetWorkItemsAsync();
            var prsTask = DataService.GetPullRequestsAsync();
            try { await Task.WhenAll(issuesTask, prsTask).WaitAsync(cts.Token); }
            catch (OperationCanceledException) { }

            var newIssues = issuesTask.IsCompletedSuccessfully && issuesTask.Result != null ? issuesTask.Result.ToList() : null;
            var newPRs = prsTask.IsCompletedSuccessfully && prsTask.Result != null ? prsTask.Result.ToList() : null;
            _isRateLimited = DataService.IsRateLimited;

            // Guard: never replace existing data with empty/partial results from a timeout.
            // If we already have data and the new fetch returned nothing (timeout/error),
            // keep the existing data to prevent timeline flickering.
            var effectiveIssues = newIssues ?? _rawIssues;
            var effectivePRs = newPRs ?? _rawPullRequests;

            // Compute fingerprint: issue/PR numbers + states + labels count + PR merged status
            var fp = ComputeFingerprint(effectiveIssues, effectivePRs);
            if (fp == _dataFingerprint && !showOverlay)
                return; // nothing changed — skip rebuild and re-render

            // Mutate state + trigger render atomically on the UI thread
            // to prevent race conditions with the Blazor render tree diff builder
            await InvokeAsync(() =>
            {
                overlayCts?.Cancel();
                _rawIssues = effectiveIssues;
                _rawPullRequests = effectivePRs;
                _dataFingerprint = fp;
                BuildTimeline();

                if (_phases.Count == 0)
                    _ = RetryAfterDelay(TimeSpan.FromSeconds(_isRateLimited ? 30 : 15));

                _loading = false;
                _initialLoadComplete = true;
                StateHasChanged();
            });
        }
        catch
        {
            // Transient error — keep existing data if we have any, only show
            // empty state on the very first load (no prior data).
            if (_initialLoadComplete) return;

            await InvokeAsync(() =>
            {
                overlayCts?.Cancel();
                BuildTimeline();
                _ = RetryAfterDelay(TimeSpan.FromSeconds(15));
                _loading = false;
                _initialLoadComplete = true;
                StateHasChanged();
            });
        }
    }

    /// <summary>
    /// Cheap fingerprint of issue/PR data to detect real changes without rebuilding the whole timeline.
    /// </summary>
    private static string ComputeFingerprint(List<PlatformWorkItem> issues, List<PlatformPullRequest> prs)
    {
        var hash = new System.HashCode();
        hash.Add(issues.Count);
        hash.Add(prs.Count);
        foreach (var i in issues)
        {
            hash.Add(i.Number);
            hash.Add(i.State);
            hash.Add(i.Labels.Count);
            hash.Add(i.UpdatedAt?.Ticks ?? 0);
        }
        foreach (var p in prs)
        {
            hash.Add(p.Number);
            hash.Add(p.State);
            hash.Add(p.IsMerged);
            hash.Add(p.UpdatedAt?.Ticks ?? 0);
        }
        return hash.ToHashCode().ToString();
    }

    private async Task RetryAfterDelay(TimeSpan delay)
    {
        await Task.Delay(delay);
        if (_phases.Count == 0)
        {
            await LoadDataAsync(showOverlay: !_initialLoadComplete);
        }
    }

    private void BuildTimeline()
    {
        try
        {
            BuildTimelineCore();
            ComputeTotalProjectTime();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"BuildTimeline error: {ex}");
            _phases = [];
            _groupLookup = new();
        }
    }

    private void BuildTimelineCore()
    {
        // Work from raw copies so this method can be re-called (e.g., on view toggle)
        _issues = _rawIssues.ToList();
        _pullRequests = _rawPullRequests.ToList();
        _syntheticPrNumbers.Clear();

        // --- Step 1: Detect the latest run's start from the newest Research PR ---
        // Each run creates Research → PM Spec → Architecture PRs. The newest Research PR
        // marks the start of the latest run cycle.
        var latestResearchPr = _pullRequests
            .Where(p => p.Title.StartsWith("Researcher:", StringComparison.OrdinalIgnoreCase)
                     && p.Labels.Contains("AI-Generated", StringComparer.OrdinalIgnoreCase))
            .OrderByDescending(p => p.CreatedAt)
            .FirstOrDefault();
        var runCutoff = latestResearchPr?.CreatedAt.AddMinutes(-1) ?? DateTime.MinValue;

        // Filter issues and PRs to only the latest run
        _issues = _issues.Where(i => i.CreatedAt >= runCutoff).ToList();
        _pullRequests = _pullRequests.Where(p => p.CreatedAt >= runCutoff).ToList();

        // Run scope filter: exclude PRs from previous runs (they survive minimal reset
        // because GitHub keeps merged/closed PR history). Only show PRs whose branch
        // contains the current run scope prefix, OR PRs without an agent/ branch prefix
        // (doc PRs, external PRs). Also filter by AI-Generated label to exclude unrelated
        // PRs in shared repos with active development.
        var currentRunScope = BranchProvider?.RunScope;

        // Run scope filter for ISSUES: engineering-task issues from the current run are
        // always created AFTER the Research PR (runCutoff). Using engineer PR timestamps
        // as the anchor is wrong — engineer PRs open 5-30+ min after eng-task issues
        // are created, so a PR-based anchor filters out the very issues Development
        // wave columns need. Use runCutoff instead (anchored on newest Research PR).
        _issues = _issues.Where(i =>
        {
            if (!i.Labels.Any(l => l.Equals("engineering-task", StringComparison.OrdinalIgnoreCase)))
                return true;
            return i.CreatedAt >= runCutoff;
        }).ToList();
        // Build a set of current-run issue numbers for cross-run PR adoption check
        var currentRunIssueNumbers = new HashSet<int>(_issues.Select(i => i.Number));

        if (currentRunScope is not null)
        {
            _pullRequests = _pullRequests.Where(p =>
            {
                // No branch info → keep (synthetic/doc PRs)
                if (string.IsNullOrEmpty(p.HeadBranch)) return true;
                // Agent branches: must match current run scope
                if (p.HeadBranch.StartsWith("agent/", StringComparison.OrdinalIgnoreCase))
                {
                    if (p.HeadBranch.Contains($"/{currentRunScope}/", StringComparison.OrdinalIgnoreCase))
                        return true;
                    // Cross-run PRs adopted by the current run: the SE reuses a PR from a
                    // prior run scope instead of creating a new one. Include it if its body
                    // links to a current-run issue (Closes #N).
                    var linked = PullRequestWorkflow.ParseLinkedIssueNumber(p.Body);
                    return linked.HasValue && currentRunIssueNumbers.Contains(linked.Value);
                }
                // Non-agent branches: only keep known VDT doc PRs by title prefix
                // to prevent external developer PRs from leaking into the timeline
                var t = p.Title;
                return t.StartsWith("Researcher:", StringComparison.OrdinalIgnoreCase)
                    || t.StartsWith("ProgramManager:", StringComparison.OrdinalIgnoreCase)
                    || t.StartsWith("Architect:", StringComparison.OrdinalIgnoreCase)
                    || p.Labels.Any(l => string.Equals(l, "AI-Generated", StringComparison.OrdinalIgnoreCase));
            }).ToList();
        }

        // Label filter: only show issues with VDT labels (AI-Generated, engineering-task,
        // or enhancement — needed for ADO which doesn't auto-apply AI-Generated)
        _issues = _issues.Where(i =>
            i.Labels.Any(l => string.Equals(l, "AI-Generated", StringComparison.OrdinalIgnoreCase)
                           || string.Equals(l, "engineering-task", StringComparison.OrdinalIgnoreCase)
                           || string.Equals(l, "enhancement", StringComparison.OrdinalIgnoreCase))
        ).ToList();

        // Deduplicate by title (safety net — keep newest)
        _issues = _issues
            .GroupBy(i => i.Title.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => g.OrderByDescending(i => i.Number).First())
            .ToList();
        _pullRequests = _pullRequests
            .GroupBy(p => p.Title.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => g.OrderByDescending(p => p.Number).First())
            .ToList();

        // --- Step 2: Add doc PRs as synthetic timeline items ---
        // Research, PM Spec, and Architecture phases are PRs, not issues.
        // Create synthetic work item entries so they appear as timeline nodes.
        // But skip if a real issue from the same agent already exists (avoids duplicates).
        var existingNumbers = _issues.Select(i => i.Number).ToHashSet();
        foreach (var pr in _pullRequests)
        {
            if (existingNumbers.Contains(pr.Number)) continue;
            var t = pr.Title;
            // Require AI-Generated label to prevent non-VDT PRs with matching titles
            // (e.g., "Researcher: Initial Study" from a human) from becoming timeline nodes
            var hasVdtLabel = pr.Labels.Contains("AI-Generated", StringComparer.OrdinalIgnoreCase);
            bool isDocPr = hasVdtLabel
                && (t.StartsWith("Researcher:", StringComparison.OrdinalIgnoreCase)
                || t.StartsWith("ProgramManager:", StringComparison.OrdinalIgnoreCase)
                || t.StartsWith("Architect:", StringComparison.OrdinalIgnoreCase));
            bool isFinalIntegration = hasVdtLabel
                && PullRequestWorkflow.Labels.IsFinalIntegrationPr(pr.Labels, t, pr.HeadBranch);
            if (isDocPr || isFinalIntegration)
            {
                // Extract agent prefix (e.g., "Researcher:") and skip if a real issue
                // from the same agent already exists — the real issue is sufficient.
                var colonIdx = t.IndexOf(':');
                if (colonIdx > 0)
                {
                    var prefix = t[..(colonIdx + 1)];
                    if (_issues.Any(i => i.Title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)))
                        continue;
                }

                _syntheticPrNumbers.Add(pr.Number);
                _issues.Add(new PlatformWorkItem
                {
                    Number = pr.Number,
                    Title = pr.Title,
                    Body = pr.Body,
                    State = pr.IsMerged ? "closed" : pr.State,
                    CreatedAt = pr.CreatedAt,
                    UpdatedAt = pr.UpdatedAt,
                    Labels = pr.Labels,
                    Url = pr.Url,
                    AssignedAgent = pr.AssignedAgent
                });
            }
        }

        // --- Step 2a: Anchor Research/PMSpec/Architect phases when preserved across a mini-reset ---
        // After a mini-reset the current run has no new Researcher/PM/Architect PRs (the docs
        // were kept on disk), so Steps 1/2 leave those phases empty and the timeline starts
        // abruptly at Development. Reach back into the full raw PR list and graft the most
        // recent PR of each doc-phase prefix as a synthetic item if the phase is otherwise
        // empty — giving the user visible "Research ✓ / PM Spec ✓ / Architecture ✓" columns.
        string[] docPrefixes = { "Researcher:", "ProgramManager:", "Architect:" };
        foreach (var prefix in docPrefixes)
        {
            bool alreadyPresent = _issues.Any(i => i.Title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
            if (alreadyPresent) continue;

            var anchorPr = _rawPullRequests
                .Where(p => p.Title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(p => p.CreatedAt)
                .FirstOrDefault();
            if (anchorPr is null) continue;

            _syntheticPrNumbers.Add(anchorPr.Number);
            _issues.Add(new PlatformWorkItem
            {
                Number = anchorPr.Number,
                Title = anchorPr.Title,
                Body = anchorPr.Body,
                State = anchorPr.IsMerged ? "closed" : anchorPr.State,
                CreatedAt = anchorPr.CreatedAt,
                UpdatedAt = anchorPr.UpdatedAt,
                Labels = anchorPr.Labels,
                Url = anchorPr.Url,
                AssignedAgent = anchorPr.AssignedAgent
            });
            if (!_pullRequests.Any(p => p.Number == anchorPr.Number))
                _pullRequests.Add(anchorPr);
        }

        // --- Step 2b: Remove older engineering-task duplicates ---
        // When multiple runs create eng tasks for the same parent, keep only the latest burst.
        // Detect the latest burst: eng tasks created within 24 hours of the newest eng task.
        // (Previously 30 min — too aggressive; tasks can be created in waves over several hours.)
        // The run-cutoff filter at Step 1 already scopes to the current run, so this is a
        // safety net for multi-run repos where the same parent issue gets re-planned.
        var engTasks = _issues.Where(i => i.Labels.Any(l => l.Equals("engineering-task", StringComparison.OrdinalIgnoreCase))).ToList();
        if (engTasks.Count > 0)
        {
            var newestEngTime = engTasks.Max(e => e.CreatedAt);
            var burstCutoff = newestEngTime.AddHours(-24);
            var latestBurstNumbers = engTasks.Where(e => e.CreatedAt >= burstCutoff).Select(e => e.Number).ToHashSet();
            // Remove older eng tasks that aren't in the latest burst
            _issues = _issues.Where(i =>
                !i.Labels.Any(l => l.Equals("engineering-task", StringComparison.OrdinalIgnoreCase))
                || latestBurstNumbers.Contains(i.Number)
            ).ToList();
        }

        // --- Step 3: Build issue→PR links (for detail panel) ---
        var prsByIssue = new Dictionary<int, List<PlatformPullRequest>>();
        foreach (var pr in _pullRequests)
        {
            var linked = PullRequestWorkflow.ParseLinkedIssueNumber(pr.Body);
            if (linked.HasValue)
            {
                if (!prsByIssue.ContainsKey(linked.Value)) prsByIssue[linked.Value] = [];
                prsByIssue[linked.Value].Add(pr);
            }
        }

        // --- Step 4: Build parent→child issue relationships ---
        // Enhancement (PM) issues are parents; engineering-task issues are children.
        var childIssueNumbers = new HashSet<int>();
        var childrenByParent = new Dictionary<int, List<PlatformWorkItem>>();
        // Also build engineering-task → linked PRs for engineering view
        var engTaskPRs = new Dictionary<int, List<PlatformPullRequest>>();
        foreach (var issue in _issues)
        {
            foreach (var parentIssue in _issues)
            {
                if (parentIssue.Number == issue.Number) continue;
                var parentLabels = parentIssue.Labels.Select(l => l.ToLowerInvariant()).ToList();
                var childLabels = issue.Labels.Select(l => l.ToLowerInvariant()).ToList();
                if (parentLabels.Contains("enhancement") && childLabels.Contains("engineering-task"))
                {
                    if (issue.Body?.Contains($"#{parentIssue.Number}") == true)
                    {
                        if (!childrenByParent.ContainsKey(parentIssue.Number))
                            childrenByParent[parentIssue.Number] = [];
                        childrenByParent[parentIssue.Number].Add(issue);
                        childIssueNumbers.Add(issue.Number);
                    }
                }
            }

            // For engineering view: map PRs to their engineering-task issues
            if (issue.Labels.Any(l => l.Equals("engineering-task", StringComparison.OrdinalIgnoreCase)))
            {
                engTaskPRs[issue.Number] = prsByIssue.GetValueOrDefault(issue.Number, []).OrderBy(p => p.CreatedAt).ToList();
            }
        }

        // --- Step 5: Build groups sorted by issue number (ascending) ---
        // Engineering-task issues are top-level with linked PRs as children
        _groupLookup.Clear();
        var groups = new List<IssueGroup>();

        {
            // Engineering view: engineering-task issues become top-level in Development.
            // Non-engineering items (doc phases, enhancements) stay as-is.
            // Also treat issues with wave metadata in body as engineering tasks (foundation task may lack the label).
            foreach (var issue in _issues.OrderBy(i => i.Number))
            {
                var isEngTask = issue.Labels.Any(l => l.Equals("engineering-task", StringComparison.OrdinalIgnoreCase));
                var waveFromBody = ParseWaveFromBody(issue.Body);
                var hasWaveMetadata = waveFromBody.Length > 0;

                if (isEngTask || hasWaveMetadata)
                {
                    var g = new IssueGroup
                    {
                        Issue = issue,
                        LinkedPRs = engTaskPRs.GetValueOrDefault(issue.Number, []),
                        ChildIssues = [],
                        IsPullRequest = _syntheticPrNumbers.Contains(issue.Number),
                        Wave = waveFromBody,
                        DependsOn = ParseDependsOnFromBody(issue.Body)
                    };
                    groups.Add(g);
                    _groupLookup[issue.Number] = g;
                }
                else if (!childIssueNumbers.Contains(issue.Number))
                {
                    var g = new IssueGroup
                    {
                        Issue = issue,
                        // Exclude self-referencing PRs for synthetic PR issues (doc phases)
                        LinkedPRs = prsByIssue.GetValueOrDefault(issue.Number, [])
                            .Where(p => !_syntheticPrNumbers.Contains(issue.Number) || p.Number != issue.Number)
                            .OrderBy(p => p.CreatedAt).ToList(),
                        ChildIssues = [],
                        IsPullRequest = _syntheticPrNumbers.Contains(issue.Number)
                    };
                    groups.Add(g);
                    _groupLookup[issue.Number] = g;
                }
            }
        }
        // Always ensure child issues are in lookup for detail panel navigation
        foreach (var issue in _issues.Where(i => childIssueNumbers.Contains(i.Number)))
        {
            if (!_groupLookup.ContainsKey(issue.Number))
            {
                _groupLookup[issue.Number] = new IssueGroup
                {
                    Issue = issue,
                    LinkedPRs = prsByIssue.GetValueOrDefault(issue.Number, [])
                        .Where(p => !_syntheticPrNumbers.Contains(issue.Number) || p.Number != issue.Number)
                        .OrderBy(p => p.CreatedAt).ToList(),
                    ChildIssues = [],
                    IsPullRequest = _syntheticPrNumbers.Contains(issue.Number)
                };
            }
        }

        // --- Step 6: Group into phases ---
        // In PM view: "Development" shows enhancement issues (PM user stories) with eng-task children
        // In Engineering view: Development is split into wave sub-phases (W0, W1, W2, ...)
        var staticPhases = new[]
        {
            ("Research",      "🔍", "research"),
            ("PM Spec",       "📝", "pmspec"),
            ("Architecture",  "🏗️", "architecture"),
        };
        var tailPhases = new[]
        {
            ("Finalization",   "✅", "finalization")
        };

        _phases = new();

        // Add static pre-development phases
        foreach (var (name, icon, css) in staticPhases)
        {
            var items = groups.Where(g => ClassifyPhase(g) == name).ToList();
            if (items.Count > 0)
                _phases.Add(new NeonPhase { Name = name, Icon = icon, CssClass = css, Items = items });
        }

        if (_devViewMode == "engineering" || _devViewMode == "time")
        {
            // Split Development into wave sub-phases
            var devItems = groups.Where(g => ClassifyPhase(g).StartsWith("Development")).ToList();
            var waveGroups = devItems
                .GroupBy(g => (g.Wave is { Length: > 0 } ? g.Wave : "W1").ToUpperInvariant(), StringComparer.OrdinalIgnoreCase)
                .OrderBy(wg => wg.Key, StringComparer.OrdinalIgnoreCase)
                .ToList();

            foreach (var wg in waveGroups)
            {
                var waveName = $"Development {wg.Key}";
                var waveIcon = wg.Key == "W0" ? "🏗️" : "⚡";
                _phases.Add(new NeonPhase
                {
                    Name = waveName,
                    Icon = waveIcon,
                    CssClass = "development",
                    Items = wg.OrderBy(g => g.Issue.Number).ToList(),
                    IsWavePhase = true
                });
            }
        }

        // Add tail phases
        foreach (var (name, icon, css) in tailPhases)
        {
            var items = groups.Where(g => ClassifyPhase(g) == name).ToList();
            if (items.Count > 0)
                _phases.Add(new NeonPhase { Name = name, Icon = icon, CssClass = css, Items = items });
        }

        // Safety net: guarantee no duplicate phase columns by name (defensive against
        // concurrent rebuild races or classification bugs that could emit the same
        // phase twice). Keep first-wins ordering so static/wave/tail sequence is preserved.
        if (_phases.Count > 1)
        {
            _phases = _phases
                .GroupBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .ToList();
        }

        _closedCount = _issues.Count(i => i.State == "closed");
        _openCount = _issues.Count(i => i.State != "closed");
        // Truly completed = closed AND no open/unmerged PRs still pending review/merge
        _completedCount = _phases.SelectMany(p => p.Items)
            .Count(g => g.Issue.State == "closed" &&
                        !g.LinkedPRs.Any(p => !p.IsMerged && p.State != "closed"));

        if (_selectedIssue.HasValue)
        {
            if (_groupLookup.TryGetValue(_selectedIssue.Value, out var refreshedGroup))
                _selectedGroup = refreshedGroup;
            else
            {
                _selectedIssue = null;
                _selectedGroup = null;
            }
        }

        if (_selectedPr.HasValue)
        {
            var refreshedPr = _rawPullRequests.FirstOrDefault(p => p.Number == _selectedPr.Value);
            if (refreshedPr is not null) _selectedPrObj = refreshedPr;
            else { _selectedPr = null; _selectedPrObj = null; }
        }

        // Precompute winning screenshot URL per PR for card thumbnails
        PrecomputeWinnerScreenshots();
    }

    private string ClassifyPhase(IssueGroup group)
    {
        var issue = group.Issue;
        var title = issue.Title.ToLowerInvariant();
        var labels = issue.Labels.Select(l => l.ToLowerInvariant()).ToList();

        // Doc phases — always classify by title prefix regardless of state
        if (title.StartsWith("researcher:"))
            return "Research";
        if (title.StartsWith("programmanager:") || title.Contains("pm spec") || title.Contains("specification"))
            return "PM Spec";
        if (title.StartsWith("architect:"))
            return "Architecture";

        // Finalization: T-FINAL tasks, final review/validation, TestEngineer final checks
        if (title.Contains("[t-final]") || title.Contains("final integration")
            || title.Contains("final review") || title.Contains("final check") || title.Contains("final validation")
            || (title.StartsWith("testengineer:") && (title.Contains("final") || title.Contains("integration"))))
            return "Finalization";

        if (labels.Contains("engineering-task") || group.Wave is { Length: > 0 })
        {
            var wave = group.Wave is { Length: > 0 } ? group.Wave : "W1";
            return $"Development {wave}";
        }
        if (labels.Contains("enhancement"))
            return "hidden";

        // Fallback by title keywords
        if (title.Contains("planning") || title.Contains("engineering plan") || title.Contains("principalengineer"))
            return "Development";

        return "Development";
    }

    private List<NeonPhase> GetFilteredPhases()
    {
        var snapshot = _phases.ToList(); // snapshot to avoid concurrent modification during render
        if (_statusFilter == "all") return snapshot;

        var result = new List<NeonPhase>();
        foreach (var phase in snapshot)
        {
            var filtered = phase.Items.Where(g =>
            {
                if (_statusFilter == "open" && g.Issue.State == "closed") return false;
                if (_statusFilter == "closed" && g.Issue.State != "closed") return false;
                return true;
            }).ToList();

            // In Time View, skip phases that have no PRs to show timing for.
            // Synthetic PR items (IsPullRequest) only count if the underlying issue is closed (work done).
            if (_devViewMode == "time" && filtered.Count > 0)
            {
                var hasRealPRs = filtered.Any(g => g.LinkedPRs.Count > 0);
                var hasCompletedSyntheticPr = filtered.Any(g => g.IsPullRequest && g.Issue.State == "closed");
                if (!hasRealPRs && !hasCompletedSyntheticPr)
                    continue;
            }

            if (filtered.Count > 0)
                result.Add(new NeonPhase { Name = phase.Name, Icon = phase.Icon, CssClass = phase.CssClass, Items = filtered, IsWavePhase = phase.IsWavePhase });
        }
        return result;
    }

    private void SetFilter(string f) { _statusFilter = f; StateHasChanged(); }

    /// <summary>
    /// Returns placeholder phases for pipeline stages that haven't started yet.
    /// </summary>
    private List<(string Name, string Icon)> GetUpcomingPhases()
    {
        var allExpected = new[] { ("Research", "🔍"), ("PM Spec", "📝"), ("Architecture", "🏗️"), ("Development", "⚡"), ("Finalization", "✅") };

        var existingNames = _phases.Select(p => p.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        // A Development W0/W1 etc. counts as "Development" existing
        if (existingNames.Any(n => n.StartsWith("Development", StringComparison.OrdinalIgnoreCase)))
            existingNames.Add("Development");

        var upcoming = new List<(string Name, string Icon)>();
        bool foundLastExisting = false;
        foreach (var (name, icon) in allExpected)
        {
            if (existingNames.Contains(name))
            {
                foundLastExisting = true;
                continue;
            }
            if (foundLastExisting)
                upcoming.Add((name, icon));
        }
        return upcoming;
    }
