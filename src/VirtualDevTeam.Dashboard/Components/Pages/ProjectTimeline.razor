@page "/timeline"
@rendermode InteractiveServer
@using VirtualDevTeam.Core.DevPlatform.Models
@using VirtualDevTeam.Core.GitHub
@using VirtualDevTeam.Core.Strategies
@using VirtualDevTeam.Core.HealthMonitor
@using VirtualDevTeam.Dashboard.Services
@implements IAsyncDisposable
@inject IDashboardDataService DataService
@inject FlowTimelineTracker FlowTracker
@inject IStrategiesDataService StrategiesService
@inject CandidateStateStore CandidateStore
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IPlatformLinkService LinkService
@inject Microsoft.Extensions.Options.IOptionsMonitor<VirtualDevTeam.Core.Configuration.VirtualDevTeamConfig> AppConfig
@inject VirtualDevTeam.Core.DevPlatform.Capabilities.IReviewService ReviewService
@inject VirtualDevTeam.Core.Configuration.IRunBranchProvider BranchProvider
@inject VirtualDevTeam.Core.Agents.Steps.IAgentTaskTracker TaskTracker

<PageTitle>Virtual Dev Team — Project Timeline</PageTitle>

@if (_loading)
{
    <div class="ntl-loading">
        <div class="ntl-loading-ring"></div>
        <span>Syncing timeline…</span>
    </div>
}
else if (_phases.Count == 0)
{
    @if (_isRateLimited)
    {
        <div class="empty-state">
            <div class="empty-icon">⏳</div>
            <div class="empty-text">API rate-limited</div>
            <div class="empty-sub">Waiting for rate limit to reset. Timeline will load automatically when data becomes available.</div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🗺️</div>
            <div class="empty-text">No work items yet</div>
            <div class="empty-sub">Issues will appear here as agents create them</div>
        </div>
    }
}
else
{
    <!-- Top bar: title + stats + filter -->
    <div class="ntl-topbar" data-testid="page-timeline">
        <div class="ntl-topbar-left">
            <h1 class="ntl-title">Project Timeline</h1>
            <div class="ntl-stats">
                <span class="ntl-stat"><span class="ntl-stat-num">@_issues.Count</span> issues</span>
                <span class="ntl-stat-sep">·</span>
                <span class="ntl-stat"><span class="ntl-stat-num ntl-stat-done">@_closedCount</span> closed</span>
                <span class="ntl-stat-sep">·</span>
                <span class="ntl-stat"><span class="ntl-stat-num ntl-stat-open">@_openCount</span> open</span>
            </div>
        </div>
        <div class="ntl-topbar-right">
            <div class="ntl-theme-toggle">
                <button class="ntl-theme-btn @(_designTheme == "default" ? "active" : "")" @onclick='() => SetTheme("default")' title="Default neon theme">Default</button>
                <button class="ntl-theme-btn @(_designTheme == "cards" ? "active" : "")" @onclick='() => SetTheme("cards")' title="Card grid theme">Cards</button>
                <button class="ntl-theme-btn @(_designTheme == "metro" ? "active" : "")" @onclick='() => SetTheme("metro")' title="Metro minimal theme">Metro</button>
                <button class="ntl-theme-btn @(_designTheme == "blueprint" ? "active" : "")" @onclick='() => SetTheme("blueprint")' title="Blueprint flow theme">Blueprint</button>
            </div>
            <span class="ntl-topbar-divider">|</span>
            <div class="ntl-view-toggle" data-testid="timeline-view-toggle">
                <button class="ntl-view-btn @(_devViewMode == "engineering" ? "active" : "")" @onclick='() => SetDevView("engineering")' title="Show engineering tasks with linked PRs" data-testid="timeline-view-engineering">🔧 Engineering</button>
                <button class="ntl-view-btn @(_devViewMode == "time" ? "active" : "")" @onclick='() => SetDevView("time")' title="Show timing breakdown by phase and PR" data-testid="timeline-view-time">⏱️ Time View</button>
            </div>
            <span class="ntl-topbar-divider">|</span>
            <div class="ntl-filter-pills" data-testid="timeline-status-filter">
                <button class="ntl-pill @(_statusFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")' data-testid="timeline-status-all">All</button>
                <button class="ntl-pill @(_statusFilter == "open" ? "active" : "")" @onclick='() => SetFilter("open")' data-testid="timeline-status-open">Open</button>
                <button class="ntl-pill @(_statusFilter == "closed" ? "active" : "")" @onclick='() => SetFilter("closed")' data-testid="timeline-status-closed">Closed</button>
            </div>
            <button class="ntl-refresh-btn @(_refreshing ? "spinning" : "")" @onclick="ForceRefreshAsync" title="Force refresh" disabled="@_refreshing" data-testid="timeline-refresh"><svg class="ntl-refresh-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v2h-2"/></svg></button>
            <span class="ntl-topbar-divider">|</span>
            <div class="ntl-zoom-controls">
                <button class="ntl-zoom-btn" @onclick="ScrollToStart" title="Jump to beginning">⏮</button>
                <button class="ntl-zoom-btn" @onclick="ZoomOut" title="Zoom out">−</button>
                <span class="ntl-zoom-label">@(_zoomPercent)%</span>
                <button class="ntl-zoom-btn" @onclick="ZoomIn" title="Zoom in">+</button>
                <button class="ntl-zoom-btn" @onclick="ZoomFit" title="Fit all on screen">⊞</button>
                <button class="ntl-zoom-btn" @onclick="ScrollToEnd" title="Jump to end">⏭</button>
            </div>
            @if (_totalProjectTime > TimeSpan.Zero)
            {
                <span class="ntl-topbar-divider">|</span>
                <span class="ntl-time-total">Total: @FormatTimeDuration(_totalProjectTime)</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_storySuccessMessage))
    {
        <div class="config-pat-result config-pat-success new-story-success-banner" data-testid="new-story-success">
            <span>✓ @_storySuccessMessage</span>
        </div>
    }

    <!-- Overall progress -->
    <div class="ntl-progress-wrap">
        <div class="ntl-progress-bar">
            <div class="ntl-progress-fill" style="width: @(_issues.Count > 0 ? _completedCount * 100 / _issues.Count : 0)%"></div>
        </div>
        <span class="ntl-progress-label">@(_issues.Count > 0 ? _completedCount * 100 / _issues.Count : 0)%</span>
    </div>

    <!-- Horizontal timeline with full-height phase columns -->
    <div class="ntl-viewport" id="ntl-viewport">
        <button class="ntl-scroll-arrow ntl-scroll-arrow-left ntl-arrow-hidden" id="ntl-arrow-left" type="button" aria-label="Scroll timeline left">◀</button>
        <div class="ntl-scroll-area" id="ntl-scroll-area">
            <div class="ntl-timeline theme-@_designTheme" style="zoom: @(_zoomPercent)%;">
                @{ int nodeIdx = 0; }
                @foreach (var phase in GetFilteredPhases())
                {
                    var phaseKey = phase.Name;
                    var phaseClass = GetPhaseClass(phase.Name);
                    var phaseItems = phase.Items;
                    var phaseDone = phaseItems.Count(g =>
                        g.Issue.State == "closed" &&
                        !g.LinkedPRs.Any(p => !p.IsMerged && p.State != "closed"));

                    @* In Time View, skip columns that have no PR content to render *@
                    if (_devViewMode == "time")
                    {
                        var tvHasPRs = phaseItems.SelectMany(g => g.LinkedPRs).Any();
                        var tvHasSyntheticPRs = phaseItems.Any(g => g.IsPullRequest);
                        if (!tvHasPRs && !tvHasSyntheticPRs) { continue; }
                    }

                    <div @key="phaseKey" class="ntl-phase-column @phaseClass @(phase.IsWavePhase ? "wave-column" : "")">
                        <!-- Phase label — top-left -->
                        <div class="ntl-phase-label">
                            @if (phase.IsWavePhase)
                            {
                                <span class="ntl-phase-name ntl-wave-name">@phase.Name</span>
                                @if (_devViewMode != "time")
                                {
                                    var waveDur = GetPhaseDuration(phase);
                                    <span class="ntl-wave-badge">@phase.Items.Count tasks</span>
                                    @if (waveDur > TimeSpan.Zero)
                                    {
                                        <span class="ntl-phase-counter ntl-time-badge-small @GetTimeDurationClass(waveDur)" title="Wave duration">@FormatTimeDuration(waveDur)</span>
                                    }
                                }
                            }
                            else
                            {
                                <span class="ntl-phase-name">@phase.Name</span>
                            }
                            @if (_devViewMode == "time")
                            {
                                @* Issue 1 fix: Only ONE time badge per phase header — skip wave badge above, show only the phase counter here *@
                                var phaseDur = GetPhaseDuration(phase);
                                var phaseInProgress = phase.Items.Any(g => g.LinkedPRs.Any(p => !p.IsMerged && p.State != "closed"));
                                <span class="ntl-phase-counter ntl-time-badge @GetTimeDurationClass(phaseDur)">
                                    @FormatTimeDuration(phaseDur)
                                    @if (phaseInProgress) { <span class="pulse-dot"></span> }
                                </span>
                            }
                            else
                            {
                                var defaultPhaseDur = GetPhaseDuration(phase);
                                <span class="ntl-phase-counter">@phaseDone/@phaseItems.Count</span>
                                @if (defaultPhaseDur > TimeSpan.Zero)
                                {
                                    <span class="ntl-phase-counter ntl-time-badge-small @GetTimeDurationClass(defaultPhaseDur)" title="Phase duration">@FormatTimeDuration(defaultPhaseDur)</span>
                                }
                            }
                            @if (CanCreateStoryInPhase(phase) && phaseDone < phaseItems.Count && TryGetWaveIdForPhase(phase.Name, out var waveId))
                            {
                                <button type="button"
                                        class="ntl-wave-add-btn"
                                        title="Create a new story in @waveId"
                                        @onclick="() => OpenNewStoryWizard(waveId)">
                                    ＋
                                </button>
                            }
                        </div>

                        <!-- Glowing spine line through center -->
                        <div class="ntl-spine-segment"></div>

                        <!-- Nodes in this phase -->
                        <div class="ntl-phase-nodes">
                            @if (_devViewMode == "time")
                            {
                                var allPRsInPhase = phaseItems.SelectMany(g => g.LinkedPRs).Distinct().OrderBy(p => p.CreatedAt).ToList();
                                @* For doc phases that are synthetic PRs, show with lifecycle activities *@
                                if (allPRsInPhase.Count == 0 && phaseItems.Any(g => g.IsPullRequest))
                                {
                                    foreach (var group in phaseItems.Where(g => g.IsPullRequest))
                                    {
                                        var docPr = group.Issue;
                                        var docDuration = GetItemDuration(docPr);
                                        @* Derive lifecycle activities from matching PR timestamps *@
                                        var matchingPr = _pullRequests.FirstOrDefault(p => p.Number == docPr.Number);
                                        var docActivities = matchingPr != null ? GetPrTimeActivities(matchingPr) : new List<TimeActivity>();
                                        nodeIdx++;
                                        <div @key="@($"time-doc-{docPr.Number}")" class="ntl-node-cluster" style="--node-delay: @(nodeIdx * 0.06)s">
                                            <div class="ntl-connector"></div>
                                            <div class="ntl-cluster-body">
                                                <div class="ntl-node @(docPr.State == "closed" ? "ntl-node-closed" : "ntl-node-open")"
                                                     @onclick="() => SelectNode(docPr.Number)" title="@docPr.Title">
                                                    <div class="ntl-node-indicator @(docPr.State == "closed" ? "ind-merged" : "ind-open")"></div>
                                                    <div class="ntl-node-body">
                                                        <span class="ntl-node-num ntl-type-pr">PR #@docPr.Number</span>
                                                        <span class="ntl-node-title">@TruncateTitle(docPr.Title, 28)</span>
                                                    </div>
                                                    <span class="ntl-time-badge-inline @GetTimeDurationClass(docDuration)">@FormatTimeDuration(docDuration)</span>
                                                </div>
                                                @if (docActivities.Count > 0)
                                                {
                                                    <div class="ntl-children">
                                                        @foreach (var act in docActivities)
                                                        {
                                                            <div class="ntl-child-node ntl-time-activity @(act.IsInProgress ? "ntl-child-active" : "ntl-child-closed")"
                                                                 @onclick="() => SelectTimeActivity(act)" @onclick:stopPropagation="true"
                                                                 role="button" style="cursor: pointer;">
                                                                <span class="ntl-time-icon">@act.Icon</span>
                                                                <span class="ntl-child-label">@TruncateTitle(act.Label, 40)</span>
                                                                <span class="ntl-time-badge-sm @GetTimeDurationClass(act.Duration)">
                                                                    @FormatTimeDuration(act.Duration)
                                                                    @if (act.IsInProgress) { <span class="pulse-dot"></span> }
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                foreach (var pr in allPRsInPhase)
                                {
                                    var prMerged = pr.IsMerged;
                                    var prClosed = pr.State == "closed";
                                    var prDuration = GetPrDuration(pr);
                                    var prSpans = GetSpansForPr(pr.Number);
                                    var prSelected = _selectedPr == pr.Number;
                                    var prIndClass = prMerged ? "ind-merged" : prClosed ? "ind-closed-pr" : "ind-open";
                                    nodeIdx++;
                                    <div @key="@($"time-pr-{pr.Number}")" class="ntl-node-cluster" style="--node-delay: @(nodeIdx * 0.06)s">
                                        <div class="ntl-connector"></div>
                                        <div class="ntl-cluster-body">
                                            <div class="ntl-node @(prMerged ? "ntl-node-closed" : "ntl-node-open") @(prSelected ? "ntl-node-selected" : "")"
                                                 @onclick="() => SelectPr(pr.Number)" title="@pr.Title">
                                                <div class="ntl-node-indicator @prIndClass"></div>
                                                <div class="ntl-node-body">
                                                    <span class="ntl-node-num ntl-type-pr">PR #@pr.Number</span>
                                                    <span class="ntl-node-title">@TruncateTitle(pr.Title, 28)</span>
                                                </div>
                                                <span class="ntl-time-badge-inline @GetTimeDurationClass(prDuration)">@FormatTimeDuration(prDuration)</span>
                                            </div>
                                            @{
                                                var activities = GetPrTimeActivities(pr);
                                                if (activities.Count > 0)
                                                {
                                                    <div class="ntl-children">
                                                        @foreach (var act in activities)
                                                        {
                                                            <div class="ntl-child-node ntl-time-activity @(act.IsInProgress ? "ntl-child-active" : "ntl-child-closed")"
                                                                 @onclick="() => SelectTimeActivity(act)" @onclick:stopPropagation="true"
                                                                 role="button" style="cursor: pointer;">
                                                                <span class="ntl-time-icon">@act.Icon</span>
                                                                <span class="ntl-child-label">@TruncateTitle(act.Label, 40)</span>
                                                                <span class="ntl-time-badge-sm @GetTimeDurationClass(act.Duration)">
                                                                    @FormatTimeDuration(act.Duration)
                                                                    @if (act.IsInProgress) { <span class="pulse-dot"></span> }
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                            @foreach (var group in phaseItems)
                            {
                                var issue = group.Issue;
                                var hasOpenPr = group.LinkedPRs.Any(p => !p.IsMerged && p.State != "closed");
                                var isImplementationComplete = issue.State == "closed" && hasOpenPr;
                                var isClosed = issue.State == "closed" && !isImplementationComplete;
                                var isSelected = _selectedIssue == issue.Number;
                                var isAwaitingReview = issue.Labels.Any(l => l.Equals("awaiting-human-review", StringComparison.OrdinalIgnoreCase));
                                nodeIdx++;

                                <div @key="@($"issue-{issue.Number}")" class="ntl-node-cluster" style="--node-delay: @(nodeIdx * 0.06)s">
                                    <div class="ntl-connector"></div>
                                    <div class="ntl-cluster-body">
                                        <div class="ntl-node @(isClosed ? "ntl-node-closed" : "ntl-node-open") @(isSelected ? "ntl-node-selected" : "") @(isAwaitingReview ? "ntl-node-awaiting" : "")"
                                             @onclick="() => SelectNode(issue.Number)"
                                             title="@(group.DependsOn.Count > 0 ? $"Blocked by {string.Join(", ", group.DependsOn.Select(d => $"#{d}"))} — {issue.Title}" : issue.Title)">
                                            <div class="ntl-node-indicator @(isImplementationComplete ? "ind-impl-complete" : isClosed ? "ind-closed" : "ind-open")"></div>
                                            <div class="ntl-node-body">
                                                <span class="ntl-node-num ntl-type-@(group.IsPullRequest ? "pr" : "issue")">@(group.IsPullRequest ? "PR" : "Issue") #@issue.Number</span>
                                                <span class="ntl-node-title">@TruncateTitle(issue.Title, 34)</span>
                                            </div>
                                        </div>

                                        @* Child issue nodes *@
                                        @if (group.ChildIssues.Count > 0)
                                        {
                                            <div class="ntl-children">
                                                @foreach (var child in group.ChildIssues)
                                                {
                                                    var childClosed = child.State == "closed";
                                                    <div @key="@($"child-{child.Number}")" class="ntl-child-node @(childClosed ? "ntl-child-closed" : "ntl-child-open")"
                                                         @onclick="() => SelectNode(child.Number)" @onclick:stopPropagation="true"
                                                         title="@child.Title">
                                                        <div class="ntl-child-indicator @(childClosed ? "ind-closed" : "ind-open")"></div>
                                                        <span class="ntl-child-label">Issue #@child.Number @TruncateTitle(child.Title, 24)</span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @* Linked PR nodes (shown as children in engineering view) *@
                                        @if (_devViewMode != "time" && group.LinkedPRs.Count > 0)
                                        {
                                            <div class="ntl-children">
                                                @foreach (var pr in group.LinkedPRs)
                                                {
                                                    var prMerged = pr.IsMerged;
                                                    var prClosed = pr.State == "closed";
                                                    var prInProgress = pr.Labels.Any(l => l.Equals("in-progress", StringComparison.OrdinalIgnoreCase));
                                                    // Rework heuristic: PR is open + has awaiting-human-review label,
                                                    // OR has both in-progress AND ready-for-review labels (engineer is iterating).
                                                    var prRework = !prMerged && !prClosed && (
                                                        pr.Labels.Any(l => l.Equals("awaiting-human-review", StringComparison.OrdinalIgnoreCase))
                                                        || (prInProgress && pr.Labels.Any(l => l.Equals("ready-for-review", StringComparison.OrdinalIgnoreCase)))
                                                    );
                                                    var prActive = !prMerged && !prClosed && !prRework && prInProgress;
                                                    var prSelected = _selectedPr == pr.Number;
                                                    // Color mapping (per user spec):
                                                    //   merged    → magenta (ind-merged)
                                                    //   closed-not-merged → red (ind-closed-pr)
                                                    //   rework    → amber breathing (ind-rework)
                                                    //   active    → green breathing (ind-active)
                                                    //   open(no labels yet) → cyan breathing (ind-open)
                                                    var prClass = prMerged ? "ntl-child-merged" : prClosed ? "ntl-child-closed" : prRework ? "ntl-child-rework" : prActive ? "ntl-child-active" : "ntl-child-open";
                                                    var indClass = prMerged ? "ind-merged" : prClosed ? "ind-closed-pr" : prRework ? "ind-rework" : prActive ? "ind-active" : "ind-open";
                                                    <div @key="@($"pr-{pr.Number}")" class="ntl-child-node ntl-child-pr @prClass @(prSelected ? "ntl-child-selected" : "")"
                                                         @onclick="() => SelectPr(pr.Number)" @onclick:stopPropagation="true"
                                                         title="@pr.Title" role="button">
                                                        <div class="ntl-child-indicator @indClass"></div>
                                                        <span class="ntl-child-label">PR #@pr.Number @TruncateTitle(pr.Title, 24)</span>
                                                        @{
                                                            var defaultPrDur = GetPrDuration(pr);
                                                        }
                                                        @if (defaultPrDur > TimeSpan.Zero)
                                                        {
                                                            <span class="ntl-time-badge-sm @GetTimeDurationClass(defaultPrDur)" title="PR duration">@FormatTimeDuration(defaultPrDur)</span>
                                                        }
                                                        @if (_prWinnerScreenshots.TryGetValue(pr.Number, out var thumbUrl))
                                                        {
                                                            <img class="ntl-pr-thumb" src="@thumbUrl" alt="Preview" loading="lazy"
                                                                 onerror="this.style.display='none';" />
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            }
                        </div>
                    </div>

                    @* Phase connector arrow between columns *@
                    <div class="ntl-wave-connector">
                        <div class="ntl-wave-arrow">→</div>
                    </div>
                }

                @* Upcoming phase placeholders — show what's coming next (hidden in Time View) *@
                @if (_devViewMode != "time")
                {
                    @foreach (var upcoming in GetUpcomingPhases())
                    {
                        <div @key="@($"upcoming-{upcoming.Name}")" class="ntl-phase-column ntl-phase-upcoming @GetPhaseClass(upcoming.Name)">
                            <div class="ntl-phase-label">
                                <span class="ntl-phase-name">@upcoming.Name</span>
                                <span class="ntl-phase-counter ntl-upcoming-badge">Upcoming</span>
                            </div>
                            <div class="ntl-spine-segment ntl-spine-upcoming"></div>
                            <div class="ntl-phase-nodes ntl-upcoming-content">
                                <div class="ntl-upcoming-pulse">
                                    <div class="ntl-upcoming-ring"></div>
                                    <span class="ntl-upcoming-text">Awaiting agents…</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Edge fade overlays -->
        <div class="ntl-edge-fade ntl-edge-left"></div>
        <div class="ntl-edge-fade ntl-edge-right"></div>
        <button class="ntl-scroll-arrow ntl-scroll-arrow-right ntl-arrow-hidden" id="ntl-arrow-right" type="button" aria-label="Scroll timeline right">▶</button>
    </div>

    <!-- Detail panel for selected issue -->
    @if (_selectedIssue.HasValue && _selectedGroup is { } sg)
    {
        <div class="ntl-detail-panel">
            <div class="ntl-detail-header">
                <a class="ntl-detail-num ntl-type-@(sg.IsPullRequest ? "pr" : "issue")" href="@(sg.IsPullRequest ? LinkService.BuildPullRequestUrl(sg.Issue.Number, sg.Issue.Url) : LinkService.BuildIssueUrl(sg.Issue.Number, sg.Issue.Url))" target="@LinkService.TargetForUrl(sg.IsPullRequest ? LinkService.BuildPullRequestUrl(sg.Issue.Number, sg.Issue.Url) : LinkService.BuildIssueUrl(sg.Issue.Number, sg.Issue.Url))" title="@(LinkService.InternalNavigationDefault ? "View in dashboard" : $"Open on {LinkService.PlatformDisplayName}")">
                    @(sg.IsPullRequest ? "PR" : "Issue") #@sg.Issue.Number @(LinkService.InternalNavigationDefault ? "" : "↗")
                </a>
                @{
                    var detailHasOpenPr = sg.LinkedPRs.Any(p => !p.IsMerged && p.State != "closed");
                    var detailImplComplete = sg.Issue.State == "closed" && detailHasOpenPr;
                    var detailClosed = sg.Issue.State == "closed" && !detailImplComplete;
                }
                <span class="ntl-detail-state @(detailImplComplete ? "state-impl-complete" : detailClosed ? "state-closed" : "state-open")">
                    @(detailImplComplete ? "◐ Awaiting Merge" : detailClosed ? "✓ Closed" : "● Open")
                </span>
                <button class="ntl-detail-close" @onclick="() => SelectNode(null)">✕</button>
            </div>
            <h3 class="ntl-detail-title">@sg.Issue.Title</h3>
            <div class="ntl-detail-meta">
                @if (!string.IsNullOrEmpty(sg.Issue.AssignedAgent))
                {
                    <span class="ntl-detail-agent">👤 @sg.Issue.AssignedAgent</span>
                }
                <span class="ntl-detail-date">📅 <LocalTimeText Value="sg.Issue.CreatedAt" /></span>
            </div>
            @if (sg.Issue.Labels.Count > 0)
            {
                <div class="ntl-detail-labels">
                    @foreach (var label in sg.Issue.Labels)
                    {
                        <span class="ntl-label">@label</span>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(sg.Wave))
            {
                <div class="ntl-detail-wave">
                    <span class="ntl-detail-section-title">Wave &amp; Dependencies</span>
                    <div class="ntl-detail-wave-info">
                        <span class="ntl-wave-pill">📦 @sg.Wave</span>
                        @if (sg.DependsOn.Count > 0)
                        {
                            <span class="ntl-dep-pill">🔗 Blocked by @(string.Join(", ", sg.DependsOn.Select(d => $"#{d}")))</span>
                        }
                        else
                        {
                            <span class="ntl-dep-pill ntl-dep-none">No blockers</span>
                        }
                    </div>
                </div>
            }
