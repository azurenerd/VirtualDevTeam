    private async Task ScrollToEnd() { await JS.InvokeVoidAsync("eval", "var el=document.getElementById('ntl-scroll-area'); if(el) el.scrollTo({left:el.scrollWidth,behavior:'smooth'})"); }

    private async Task InitScrollArrowsAsync()
    {
        await JS.InvokeVoidAsync("eval",
            "(function() {" +
            "var sa = document.getElementById('ntl-scroll-area');" +
            "var left = document.getElementById('ntl-arrow-left');" +
            "var right = document.getElementById('ntl-arrow-right');" +
            "if (!sa || !left || !right) return;" +
            "function setVisible(el, visible) {" +
            "  if (!el) return;" +
            "  var isVisible = el.classList.contains('ntl-arrow-visible');" +
            "  if (visible) {" +
            "    if (isVisible) return;" +
            "    el.classList.remove('ntl-arrow-hidden');" +
            "    void el.offsetWidth;" +
            "    el.classList.add('ntl-arrow-visible');" +
            "    return;" +
            "  }" +
            "  if (!isVisible && el.classList.contains('ntl-arrow-hidden')) return;" +
            "  el.classList.remove('ntl-arrow-visible');" +
            "  el.classList.add('ntl-arrow-hidden');" +
            "}" +
            "function update() {" +
            "  setVisible(left, sa.scrollLeft > 10);" +
            "  setVisible(right, sa.scrollLeft + sa.clientWidth < sa.scrollWidth - 10);" +
            "}" +
            "sa.addEventListener('scroll', update, { passive: true });" +
            "new ResizeObserver(update).observe(sa);" +
            "left.onclick = function() { sa.scrollBy({ left: -sa.clientWidth * 0.7, behavior: 'smooth' }); };" +
            "right.onclick = function() { sa.scrollBy({ left: sa.clientWidth * 0.7, behavior: 'smooth' }); };" +
            "requestAnimationFrame(update);" +
            "setTimeout(update, 100);" +
            "})();");
    }

