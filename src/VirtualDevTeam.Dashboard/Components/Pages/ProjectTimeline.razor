    private record TimeActivity(string Icon, string Label, TimeSpan Duration, bool IsInProgress);

    private record SelectedTimeActivityInfo(string Icon, string Name, TimeSpan Duration, bool IsInProgress);

    private void SelectTimeActivity(TimeActivity act)
    {
