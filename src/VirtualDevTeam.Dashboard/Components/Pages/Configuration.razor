    private static VirtualDevTeamConfig DeepCopy(VirtualDevTeamConfig src)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(src);
        return System.Text.Json.JsonSerializer.Deserialize<VirtualDevTeamConfig>(json) ?? new();
    }

