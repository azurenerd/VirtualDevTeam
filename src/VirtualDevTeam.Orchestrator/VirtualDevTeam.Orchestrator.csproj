<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualDevTeam.Core\VirtualDevTeam.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.4" />
    <!-- System.Drawing.Common is used by ImageRegenAnomalyDetector to decode + downscale PNGs
         for perceptual hashing. The Runner is Windows-only (see Session.md), so the Windows-
         only nature of this package is fine. The detector is annotated with
         [SupportedOSPlatform("windows")] to make the platform constraint explicit. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- healthmon-false-research-complete: expose internal TryFireResearchDocSignalsAsync /
         TryFireArchitectureDocSignalsAsync to the integration test project so the new
         hardened doc-signal heuristic can be unit-tested deterministically. -->
    <InternalsVisibleTo Include="VirtualDevTeam.Integration.Tests" />
    <!-- imggen-rework-anomaly-detector: expose internal members of ImageRegenAnomalyDetector
         (ComputePerceptualHash, MinSizeBytes, PerceptualHash struct, etc.) to the Core test
         project so ImageRegenAnomalyDetectorTests can exercise the pHash path and size guards
         without relying on a public surface. -->
    <InternalsVisibleTo Include="VirtualDevTeam.Core.Tests" />
  </ItemGroup>

</Project>
