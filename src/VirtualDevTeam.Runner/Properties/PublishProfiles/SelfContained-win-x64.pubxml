<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained publish profile for VDT distribution.
  Produces a single-file exe that includes the .NET runtime.
  
  Usage:
    dotnet publish -c Release -p:PublishProfile=SelfContained-win-x64
    
  Output: bin/Release/net8.0/publish/win-x64/vdt.exe (~120MB)
  
  The exe includes:
  - .NET 8 runtime (no SDK required on target machine)
  - All VDT assemblies
  - Blazor Server static assets (_framework, _content)
  - appsettings.json defaults
  
  NOT included (deployed at runtime):
  - Prompt templates (extracted from embedded resources on first run)
  - SQLite databases (created in user-data directory)
  - Playwright browsers (installed by vdt check-deps)
-->
<Project>
  <PropertyGroup>
    <PublishDir>bin\publish\win-x64</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Don't trim — Blazor Server + DI + reflection need full types -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <AssemblyName>vdt</AssemblyName>
    <!-- The Runner self-contained single-file exe references the Dashboard (Web exe) and
         McpServer (console exe), both framework-dependent, and Dashboard+Runner each carry
         an appsettings.json. These are structural to VDT's layout, so relax the .NET 10 SDK's
         stricter publish validations (NETSDK1150 / NETSDK1152). -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
</Project>
