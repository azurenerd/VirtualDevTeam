<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtualDevTeam.Core\VirtualDevTeam.Core.csproj" />
    <ProjectReference Include="..\..\src\VirtualDevTeam.Agents\VirtualDevTeam.Agents.csproj" />
    <ProjectReference Include="..\..\src\VirtualDevTeam.Orchestrator\VirtualDevTeam.Orchestrator.csproj" />
    <ProjectReference Include="..\VirtualDevTeam.Integration.Tests\VirtualDevTeam.Integration.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude HelloWorldApp source files from compilation — they are test data, not code -->
    <Compile Remove="Content\HelloWorldApp\**\*.cs" />
    <Content Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
